---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Compagnon from '../components/Compagnon.astro';
import BarreOnglets from '../components/BarreOnglets.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import '../styles/appli.css';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
  path: string;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, path, breadcrumbs } = Astro.props;
// Le site tourne pour l'instant dans un sous-dossier de test (/TESTSITENV/) :
// on empêche son indexation tant que base !== '/'.
const isTestDeployment = import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` : la page va jusqu'aux bords de l'écran, et les
        `env(safe-area-inset-*)` valent enfin autre chose que zéro — sans quoi
        la barre d'onglets se glisse sous la barre d'accueil de l'iPhone. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      // Applique le thème mémorisé avant le premier rendu, pour éviter un flash
      // de la mauvaise couleur. Sans préférence enregistrée, le CSS suit
      // automatiquement les réglages système (prefers-color-scheme).
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
        // Sur téléphone, le site prend son habit d'application : les
        // rubriques marquées « data-pli » se replient (voir appli.css et
        // Pli.astro). Posé ici, avant le premier affichage, pour que la page
        // ne s'ouvre pas dépliée puis se replie sous les yeux.
        try {
          var etroit = window.matchMedia('(max-width: 719px)');
          var habit = function () {
            document.documentElement.classList.toggle('appli', etroit.matches);
          };
          habit();
          if (etroit.addEventListener) etroit.addEventListener('change', habit);
          else etroit.addListener(habit);
        } catch (e) {}
        // Le site lancé depuis son icône se tient en application. Posé avant le
        // premier affichage, sinon la page s'ouvre en site puis clignote.
        // « ?app=1 » permet de voir ce mode sans rien installer.
        try {
          if (
            window.matchMedia('(display-mode: standalone)').matches ||
            window.navigator.standalone === true ||
            new URLSearchParams(location.search).has('app')
          ) {
            document.documentElement.setAttribute('data-app', '');
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {/* Mode application : le site s'ajoute à l'écran d'accueil du téléphone et
        s'ouvre en plein écran. Sur iPhone, c'est la personne qui l'ajoute
        (Partager → Sur l'écran d'accueil) ; Android le propose tout seul. */}
    <link rel="manifest" href={withBase('/app/site.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/app/icone-180.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Nicolas Verdot" />
    {/* La couleur de la barre du téléphone suit l'en-tête, dans les deux thèmes. */}
    <meta name="theme-color" content="#fffdfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2027" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content={isTestDeployment ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Caveat:wght@600;700&family=Bricolage+Grotesque:opsz,wght@12..96,700..800&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} path={path} breadcrumbs={breadcrumbs} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    {/* Sur téléphone, les pages qui n'ont pas été découpées à la main le sont
        ici : chaque rubrique (une section avec un titre) se replie derrière une
        ligne, comme avec Pli.astro. La première rubrique après le haut de page
        reste ouverte : c'est l'essentiel de la page. Placé juste après le
        contenu, avant le pied de page, pour s'exécuter avant qu'on ne voie le
        bas de l'écran. Pour qu'une rubrique ne se replie jamais : data-pli-non.
        Pour tout replier, première rubrique comprise : data-pli-tout sur <main>
        ou sur un élément de la page. */}
    <script is:inline>
      (function () {
        var racine = document.documentElement;
        var main = document.querySelector('main');
        if (!main || main.querySelector('[data-pli]')) return;
        var fait = false;
        function replier() {
          if (fait || !racine.classList.contains('appli')) return;
          fait = true;
          var tout = !!document.querySelector('[data-pli-tout]');
          var vues = 0;
          var sections = main.querySelectorAll(':scope > section');
          for (var i = 1; i < sections.length; i++) {
            var s = sections[i];
            var h2 = s.querySelector('h2');
            if (!h2 || s.hasAttribute('data-pli-non') || s.getAttribute('data-section-name') === 'CTA final') continue;
            vues++;
            if (vues === 1 && !tout) continue;
            var sur = s.querySelector('.eyebrow');
            var propre = function (e) { return e.textContent.replace(/\s+/g, ' ').trim(); };
            var titre = propre(sur || h2);
            var note = sur ? propre(h2) : '';
            var num = titre.match(/^(\d+)\s*·\s*(.+)$/);
            // « 11 articles », « 8 formations » : le surtitre est un décompte,
            // c'est le titre qui nomme la rubrique. On les inverse.
            if (sur && !num && /^\d+\s+\D/.test(titre)) { note = titre; titre = propre(h2); }
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'pli-bouton';
            b.setAttribute('aria-expanded', 'false');
            b.setAttribute('data-pli-bouton', '');
            var html = '';
            if (num) html += '<span class="pli-num" aria-hidden="true"></span>';
            html += '<span class="pli-texte"><span class="pli-titre"></span>' + (sur ? '<span class="pli-note"></span>' : '') + '</span>';
            html += '<svg class="pli-chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';
            b.innerHTML = html;
            if (num) b.querySelector('.pli-num').textContent = num[1];
            b.querySelector('.pli-titre').textContent = num ? num[2] : titre;
            if (sur) b.querySelector('.pli-note').textContent = note;
            s.setAttribute('data-pli', '');
            s.insertBefore(b, s.firstChild);
          }
        }
        replier();
        // Si la fenêtre devient étroite après coup (rotation, redimensionnement).
        try {
          var mq = window.matchMedia('(max-width: 719px)');
          if (mq.addEventListener) mq.addEventListener('change', replier);
        } catch (e) {}
      })();
    </script>
    <Footer />
    {/* La coque du téléphone : la barre d'onglets n'apparaît qu'en dessous de
        720 px ; le Compagnon partout — en bas à droite sur ordinateur, au
        milieu de la barre sur téléphone. */}
    <BarreOnglets />
    {/* Après le pied de page : le Compagnon est en position fixe, sa place dans
        le flux n'a donc pas d'importance visuelle — mais elle en a pour le
        clavier et les lecteurs d'écran, qui le rencontrent en dernier, une fois
        le contenu de la page parcouru. */}
    <Compagnon />
  </body>
</html>

<script>
  // Les rubriques repliées du téléphone (voir Pli.astro). Un seul écouteur
  // pour toute la page.
  const basculer = (rubrique: Element, ouvrir?: boolean) => {
    const bouton = rubrique.querySelector(':scope > [data-pli-bouton]');
    const ouvert = rubrique.toggleAttribute('data-ouvert', ouvrir);
    bouton?.setAttribute('aria-expanded', String(ouvert));
    return bouton;
  };

  document.addEventListener('click', (e) => {
    const bouton = (e.target as Element).closest?.('[data-pli-bouton]');
    const rubrique = bouton?.parentElement;
    if (!bouton || !rubrique) return;
    basculer(rubrique);
    // Refermée depuis le bas d'une longue rubrique, sa ligne se retrouve
    // au-dessus de l'écran : on la ramène sous l'en-tête.
    const entete = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 0;
    if (bouton.getBoundingClientRect().top < entete) {
      window.scrollTo({ top: window.scrollY + bouton.getBoundingClientRect().top - entete - 8 });
    }
  });

  // Un lien vers une ancre (#constat, ou une fiche depuis le Compagnon) doit
  // ouvrir la rubrique qui la contient, sinon on atterrit sur une ligne fermée.
  const ouvrirLaCible = () => {
    let cible: Element | null = null;
    try {
      cible = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    } catch (e) {}
    const rubrique = cible?.closest('[data-pli]');
    if (!cible || !rubrique || rubrique.hasAttribute('data-ouvert')) return;
    basculer(rubrique, true);
    if (document.documentElement.classList.contains('appli')) cible.scrollIntoView();
  };
  ouvrirLaCible();
  window.addEventListener('hashchange', ouvrirLaCible);
</script>

<script>
  // Diagnostic d'un crash récurrent signalé sur mobile pendant le scroll
  // ("un problème récurrent est survenu", message de crash natif de
  // Safari) — persiste même en Private Browsing (donc pas un souci de
  // cache) et même après la suppression du backdrop-filter du header.
  // En attendant d'isoler la cause exacte, on désactive toutes les
  // animations liées au scroll sur tactile, comme si prefers-reduced-motion
  // était forcé — au pire un site plus statique sur mobile, au mieux ça
  // confirme (et corrige) un souci de coût GPU/mémoire cumulatif.
  const reduceMotion =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    window.matchMedia('(pointer: coarse)').matches;
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      // threshold: 0 (et non 0.15) : une section très haute (blog, catalogue
      // matériel) ne peut jamais atteindre 15% de visibilité dans le viewport
      // et resterait invisible à jamais. Le rootMargin garde l'effet "déclenche
      // un peu après l'entrée à l'écran".
      { threshold: 0, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
  }
</script>

<script>
  // Étiquettes de section pour la relecture — invisibles par défaut, ne
  // s'affichent que si l'URL contient ?labels (aucun impact pour un vrai
  // visiteur). Sert uniquement à pouvoir dire "garde X, change Y" en
  // pointant un nom plutôt qu'en décrivant une zone de la page.
  if (new URLSearchParams(location.search).has('labels')) {
    const style = document.createElement('style');
    style.textContent = `
      [data-section-name] { position: relative; outline: 1px dashed rgba(230, 57, 70, 0.6); outline-offset: -1px; }
      .__section-tag {
        position: absolute; top: 0; left: 0; z-index: 999;
        background: #e63946; color: #fff; font: 700 11px/1.4 monospace;
        padding: 3px 8px; border-radius: 0 0 4px 0; pointer-events: none;
        letter-spacing: 0.02em;
      }
    `;
    document.head.appendChild(style);
    document.querySelectorAll('[data-section-name]').forEach((el) => {
      const tag = document.createElement('span');
      tag.className = '__section-tag';
      tag.textContent = el.getAttribute('data-section-name') || '';
      el.prepend(tag);
    });
  }
</script>

<script>
  // Renforcement sitewide du système de révélation : les grilles de cartes
  // (offres, formations, blog, matériel, problèmes d'une offre...) gagnent
  // un pop-in échelonné par carte au lieu du simple fondu de bloc hérité de
  // [data-reveal] sur leur section parente — les deux coexistent sans
  // conflit (l'un anime la section, l'autre les enfants). Un seul script
  // ici plutôt que dupliqué page par page : s'applique automatiquement à
  // toute grille existante ou future portant une de ces classes.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  // Sur mobile, la barre d'adresse qui se rétracte/réapparaît pendant un
  // scroll (typiquement un swipe vertical, parfois avec une composante
  // horizontale) redimensionne la fenêtre. ScrollTrigger recalcule alors
  // tous ses triggers par défaut sur chaque resize — avec .batch() sur des
  // grilles de plusieurs dizaines d'éléments (blog, formations...), ce
  // recalcul répété peut geler ou faire planter la page. Fix officiel GSAP.
  ScrollTrigger.config({ ignoreMobileResize: true });

  const mm = gsap.matchMedia();
  // (pointer: fine) exclut le tactile — voir la note sur le crash mobile
  // récurrent plus haut dans ce fichier, même désactivation ici.
  mm.add('(prefers-reduced-motion: no-preference) and (pointer: fine)', () => {
    const grids = document.querySelectorAll<HTMLElement>('.cards, .article-grid, .product-grid, .formation-grid, .problem-list, .timeline');
    grids.forEach((grid) => {
      const items = Array.from(grid.children) as HTMLElement[];
      if (!items.length) return;
      gsap.set(items, { opacity: 0, y: 28, scale: 0.97 });
      ScrollTrigger.batch(items, {
        start: 'top 88%',
        onEnter: (batch) =>
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.65,
            ease: 'power3.out',
            stagger: 0.09,
            overwrite: true,
          }),
      });
    });

    return () => ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
