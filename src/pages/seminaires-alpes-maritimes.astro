---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTABlock from '../components/CTABlock.astro';
import { withBase } from '../utils/url';
import heroImg from '../assets/hero-contact.png';

// Un vrai paragraphe par bassin plutôt qu'une page par ville : des pages
// quasi identiques se concurrencent entre elles. Seule Sophia Antipolis a sa
// propre page, parce qu'elle a une matière distincte.
const villes = [
  {
    name: 'Séminaire à Nice',
    zone: 'Nice · Saint-Laurent-du-Var · Cagnes-sur-Mer',
    text: "Sièges régionaux, collectivités, entreprises de l'Arénas et de la plaine du Var : séminaires de direction, lancements de projet et séminaires d'équipe, dans vos locaux ou dans un lieu qui sort du quotidien. Je suis basé à Nice : la préparation se fait en présentiel.",
  },
  {
    name: 'Séminaire à Sophia Antipolis',
    zone: 'Valbonne · Biot · Mougins',
    text: "Équipes techniques et internationales, projets transverses, comités de site : des séminaires animés en français ou en anglais, pour des participants qui attendent une vraie question et un vrai résultat.",
    href: '/seminaire-sophia-antipolis/',
    link: 'Voir la page Sophia Antipolis',
  },
  {
    name: 'Séminaire à Antibes et Villeneuve-Loubet',
    zone: 'Antibes · Juan-les-Pins · Villeneuve-Loubet · Vallauris',
    text: "Entre Nice et Sophia Antipolis, des PME et des entreprises de taille intermédiaire qui veulent redonner de l'élan à une équipe ou lancer une nouvelle année sans traverser la France pour le faire.",
  },
  {
    name: 'Séminaire à Carros et dans la plaine du Var',
    zone: 'Carros · Le Broc · Saint-Jeannet · Gattières',
    text: "Entreprises industrielles et sites de production : des séminaires qui réunissent encadrement, production et fonctions support autour d'un projet, d'une réorganisation ou des priorités de l'année, avec des formats adaptés aux contraintes d'un site.",
  },
  {
    name: 'Séminaire à Cannes et Mandelieu',
    zone: 'Cannes · Le Cannet · Mandelieu-la-Napoule',
    text: "Conventions, événements d'entreprise et comités de direction, avec ou sans capture graphique en direct pour garder la mémoire de l'événement et la faire circuler ensuite.",
  },
  {
    name: 'Séminaire à Grasse',
    zone: 'Grasse · Mouans-Sartoux · Pays de Grasse',
    text: "Parfumerie, artisanat de luxe et PME industrielles familiales : clarifier une transmission, une réorganisation ou une nouvelle stratégie sans y laisser des mois.",
  },
  {
    name: 'Séminaire à Monaco',
    zone: 'Monaco · Menton · Beausoleil',
    text: "Comités exécutifs, associations et équipes internationales : un cadre exigeant, une facilitation à la hauteur, en français ou en anglais.",
    href: '/cas-clients/jci-monaco/',
    link: 'Voir le séminaire JCI Monaco',
  },
  {
    name: 'Séminaire en Provence-Alpes-Côte d’Azur',
    zone: 'Var · Bouches-du-Rhône · partout en France',
    text: "Toulon, Aix-en-Provence, Marseille et le reste de la région : j'interviens aussi pour des séminaires résidentiels, et partout en France pour des séminaires et des formations.",
  },
];

const formats = [
  { i: '1', title: 'Séminaire de direction (CODIR)', text: "Deux jours pour trancher les priorités, traiter les désaccords et repartir avec des décisions tenues.", href: '/seminaire-codir/' },
  { i: '2', title: 'Séminaire kick-off', text: "Lancer un projet, une feuille de route ou une nouvelle année avec des équipes qui savent quoi faire ensuite.", href: '/seminaire-kick-off/' },
  { i: '3', title: "Séminaire d'équipe et atelier", text: "Un format d'une journée ou plus court pour traiter un sujet précis : décision, organisation, tensions, projet.", href: '/seminaires-entreprise/' },
  { i: '4', title: 'Capture graphique en direct', text: "Une fresque visuelle réalisée pendant votre événement, qui en garde la mémoire et prolonge son impact.", href: '/offres/capture-graphique/' },
  { i: '5', title: 'Stratégie et adoption de l’IA', text: "Décider où l'IA crée de la valeur, tester sur le travail réel et faire adopter par les équipes.", href: '/accompagnement-ia-pme/' },
];

const missions = [
  {
    client: 'CEC',
    logo: '/logos/cec.png',
    title: "Donner à voir les idées clés pour mieux les ancrer et les mettre en action",
    text: "Capture graphique en direct, à Sophia Antipolis, du dernier rendez-vous d'une cohorte de dirigeants CEC — deux journées d'ateliers et de conférences.",
    slug: 'cec',
  },
  {
    client: 'JCI Monaco',
    logo: '/logos/jci-monaco.png',
    title: "Faire équipe autour d'une vision commune",
    text: "Conception et facilitation du séminaire de prise de présidence de la Jeune Chambre Économique de Monaco.",
    slug: 'jci-monaco',
  },
];

const faq = [
  {
    q: 'Intervenez-vous uniquement dans les Alpes-Maritimes ?',
    a: "Non. Je suis basé à Nice, ce qui rend mes interventions à Nice, Cannes, Sophia Antipolis, Antibes, Villeneuve-Loubet, Carros, Grasse, Mandelieu ou Monaco simples et sans frais de déplacement importants — mais j'interviens partout en Provence-Alpes-Côte d'Azur et en France pour des séminaires et des formations.",
  },
  {
    q: "Louez-vous des salles ou organisez-vous la logistique du séminaire ?",
    a: "Non. Je conçois et j'anime le séminaire : le cadrage, le déroulé, la facilitation le jour J et les suites. Le lieu, l'hébergement et la restauration restent à votre charge ou à celle de votre agence. Je vous aide en revanche à choisir un lieu adapté au travail prévu.",
  },
  {
    q: "Quelle différence entre un facilitateur et un animateur de séminaire ?",
    a: "Un animateur fait vivre une journée. Un facilitateur conçoit le chemin qui mène un groupe d'une question à une décision, puis tient ce cadre le jour J. Le premier se juge à l'ambiance, le second à ce qui a changé un mois après.",
  },
  {
    q: "Quel est le délai pour organiser un séminaire facilité ?",
    a: "Comptez idéalement trois à six semaines : un premier échange pour cadrer l'intention, une préparation avec le commanditaire, puis l'animation. Pour un atelier court, deux semaines peuvent suffire.",
  },
  {
    q: 'Travaillez-vous avec les collectivités et les associations ?',
    a: "Oui. J'accompagne des entreprises, des collectivités territoriales et des associations. Les démarches de concertation et les projets de territoire se prêtent particulièrement bien à la facilitation et à la capture graphique.",
  },
  {
    q: "Accompagnez-vous les PME de la région sur l'intelligence artificielle ?",
    a: "Oui. J'aide les dirigeants de PME des Alpes-Maritimes à décider où l'IA crée de la valeur, à choisir les cas d'usage prioritaires avec les métiers et la DSI, puis à les tester et à les faire adopter par les équipes. Trois portes d'entrée, de l'atelier de décision en comité de direction à un accompagnement de 90 jours.",
  },
  {
    q: "Pouvez-vous animer en anglais ?",
    a: "Oui, les ateliers et séminaires peuvent être animés en français ou en anglais, ce qui est fréquent pour les équipes internationales de Sophia Antipolis et de Monaco.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Séminaire d'entreprise à Nice, Cannes, Monaco — facilitateur"
  description="Séminaire de direction, kick-off ou séminaire d'équipe sur la Côte d'Azur : un facilitateur basé à Nice. Sophia Antipolis, Antibes, Cannes, Carros, Monaco."
  path="/seminaires-alpes-maritimes/"
>
  <PageHero
    eyebrow="Côte d'Azur · Alpes-Maritimes · Monaco"
    title="Séminaire d'entreprise à Nice et dans les Alpes-Maritimes :"
    titleAccent="un facilitateur"
    titleTail="basé dans le 06."
    summary="Séminaire de direction, kick-off de projet, séminaire d'équipe : je conçois et j'anime votre séminaire là où vos équipes travaillent — <strong>Nice, Sophia Antipolis, Antibes, Cannes, Carros, Grasse, Monaco</strong> — et partout en France."
    pills={['Séminaire de direction', 'Kick-off', "Séminaire d'équipe", 'Basé à Nice']}
    image={heroImg}
    imageAlt="Un facilitateur accueille une personne et lui indique un chemin, devant un panneau aux flèches vierges."
    flip
    tall
  />

  <section class="section" data-reveal>
    <div class="container split">
      <div>
        <p class="eyebrow">Pourquoi un facilitateur local</p>
        <h2>Sur la Côte d'Azur, la proximité change la préparation</h2>
        <p class="hero-copy">Un séminaire réussi se joue avant le jour J : comprendre l'intention, rencontrer le commanditaire, sentir le contexte. Être basé dans les Alpes-Maritimes me permet de préparer vos temps forts en présentiel, de repérer les lieux et d'intervenir sans les coûts et les aléas d'un intervenant qui traverse la France.</p>
        <div class="checks">
          {formats.map((f) => (
            <div class="check"><i>{f.i}</i><div><a href={withBase(f.href)}><strong>{f.title}</strong></a><br /><span class="muted">{f.text}</span></div></div>
          ))}
        </div>
      </div>
      <div class="quote">
        <blockquote>Le bon format au bon endroit : une salle à Sophia, une terrasse à Cannes ou votre siège à Nice — c'est le résultat qui compte.</blockquote>
        <cite>Nicolas Verdot — Facilitateur, Alpes-Maritimes</cite>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Zones d'intervention</p>
          <h2>De Nice à Monaco, de Carros à Cannes : où j'anime vos séminaires</h2>
        </div>
        <p>Chaque bassin a ses contextes. Les enjeux, eux, se ressemblent : clarifier, décider, faire avancer.</p>
      </div>
      <div class="cards">
        {villes.map((v) => (
          <article class="card">
            <div class="num">{v.zone}</div>
            <h3>{v.name}</h3>
            <p>{v.text}</p>
            <a class="card-link" href={withBase(v.href ?? '/contact/')}>{v.link ?? 'Parler de votre séminaire'}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Exemples de missions dans la région</p>
          <h2>Ce que ça a donné concrètement</h2>
        </div>
        <p>Deux missions récentes, à Sophia Antipolis et à Monaco — le contexte, le dispositif et ce que ça a produit.</p>
      </div>
      <div class="cards">
        {missions.map((m) => (
          <article class="card">
            <img src={withBase(m.logo)} alt={m.client} class="mission-card-logo" />
            <h3>{m.title}</h3>
            <p>{m.text}</p>
            <a class="card-link" href={withBase(`/cas-clients/${m.slug}/`)}>Découvrir le cas client</a>
          </article>
        ))}
      </div>
      <p class="missions-more"><a href={withBase('/cas-clients/')}>Voir tous les cas clients →</a></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Ce que vous obtenez</p>
      <h2>Un séminaire qui ne retombe pas le lundi suivant</h2>
      <p>Beaucoup de séminaires produisent de bons moments et peu de suites. Mon travail consiste à concevoir la conversation qui permettra à votre collectif de produire un résultat exploitable : des décisions assumées, des responsabilités claires, un plan d'action réaliste — et, si vous choisissez la <a href={withBase('/offres/capture-graphique/')}>capture graphique</a>, une trace visuelle que vos équipes gardent et réutilisent.</p>
      <p>Selon votre situation : un <a href={withBase('/seminaire-kick-off/')}>séminaire kick-off</a> pour lancer un projet, un <a href={withBase('/seminaire-codir/')}>séminaire de direction</a> pour votre comité, ou un <a href={withBase('/seminaires-entreprise/')}>séminaire d'entreprise</a> conçu sur mesure. Vous pouvez me confier toute l'animation, ou je vous accompagne en <a href={withBase('/offres/mentoring/')}>mentoring</a> pour que vous l'animiez vous-même. Et pour un enjeu d'équipe qui se joue dans la durée, le <a href={withBase('/offres/coaching-equipe/')}>coaching d'équipe</a>. Pour monter en compétence en interne, des <a href={withBase('/formations/')}>formations à l'intelligence collective et à la facilitation</a>.</p>
      <p>Et si la question du moment est «&nbsp;il faut qu'on fasse de l'IA, mais par où commencer&nbsp;?&nbsp;», l'<a href={withBase('/accompagnement-ia-pme/')}>accompagnement IA pour les PME</a> vous aide à décider où agir, à tester sur votre travail réel et à faire adopter — à Nice, Sophia Antipolis, Cannes ou Monaco.</p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Questions fréquentes</p>
          <h2>Avant de nous appeler</h2>
        </div>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTABlock
    eyebrow="Un séminaire en préparation ?"
    title="Parlons de votre prochain temps fort dans le 06."
    subtitle="Un premier échange de 30 minutes pour cadrer l'intention, le format et vérifier que mon intervention est pertinente."
  />
</Layout>

<style>
  .muted {
    color: var(--color-muted);
  }
  .mission-card-logo {
    display: block;
    height: 40px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    object-position: left center;
    margin-bottom: var(--space-4);
  }
  .missions-more {
    margin: var(--space-8) 0 0;
    text-align: center;
  }
</style>
