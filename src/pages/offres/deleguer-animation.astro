---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-deleguer-animation.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation complète de séminaires et ateliers',
  name: "Déléguer l'animation d'un temps collectif",
  description:
    "Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/deleguer-animation/'), Astro.site).toString(),
};

const icons: Record<string, string> = {
  compass: '<path d="M4 17c2.5-6 5 6 8 0s4.5-5 8 0"/><circle cx="4" cy="17" r="1" fill="currentColor" stroke="none"/><circle cx="20" cy="17" r="1" fill="currentColor" stroke="none"/>',
  chat: '<rect x="3" y="5" width="18" height="11" rx="2"/><path d="M8 16l-2 3v-3"/>',
  loop: '<path d="M4 12a8 8 0 0 1 13.5-5.8"/><path d="M20 12a8 8 0 0 1-13.5 5.8"/><path d="M17 3v4h-4"/><path d="M7 21v-4h4"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  flag: '<path d="M6 3v18"/><path d="M6 4h13l-3 4 3 4H6"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8.5 11h7M8.5 15h7"/>',
  pencil: '<path d="M4 20l1-4.2L15.8 5 19 8.2 8.2 19 4 20z"/><path d="M13.5 6.5l4 4"/>',
  chart: '<path d="M4 21V11M10 21V4M16 21v-8M4 21h16"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/>',
  network: '<circle cx="6" cy="6" r="2.3"/><circle cx="18" cy="6" r="2.3"/><circle cx="12" cy="18" r="2.3"/><path d="M8 7l3.2 9M16 7l-3.2 9M8.3 6h7.4"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  star: '<path d="M12 3l2.4 5.3 5.8.6-4.3 4 1.2 5.7L12 15.9 6.9 18.6l1.2-5.7-4.3-4 5.8-.6L12 3z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};

const valueItems = [
  { icon: 'target', title: 'Des priorités claires', text: "Pour concentrer l'énergie là où elle compte vraiment." },
  { icon: 'check', title: 'Des décisions assumées', text: 'Pour sortir des discussions sans fin et choisir une direction.' },
  { icon: 'people', title: 'Des équipes alignées', text: "Pour que chacun comprenne où l'on va et comment contribuer." },
  { icon: 'trending', title: 'Des actions concrètes', text: 'Pour transformer les décisions en résultats visibles.' },
];

const problems = [
  { icon: 'compass', title: "Le processus n'est pas clair", text: 'Vous marchez sur un terrain flou : le résultat final ne correspond pas toujours aux attentes du collectif.' },
  { icon: 'chat', title: 'Des ateliers participatifs mais peu productifs', text: "Des échanges riches, mais des décisions diluées qui n'aboutissent à rien de concret." },
  { icon: 'loop', title: 'Des discussions qui tournent en rond', text: 'Les mêmes sujets reviennent, les tensions perdurent et les décisions ne se concrétisent pas vraiment.' },
  { icon: 'person', title: 'Trop impliqué pour animer vous-même', text: 'Difficile de prendre du recul quand on est au cœur du sujet et acteur des décisions.' },
  { icon: 'people', title: 'Une participation inégale', text: "Quelques personnes monopolisent la parole, d'autres restent en retrait." },
  { icon: 'flag', title: "Trop d'enjeux pour improviser", text: 'Énergie, budget, temps : vous ne pouvez pas vous permettre un faux pas.' },
];

const basics = [
  { icon: 'people', title: 'Un bon ratio de facilitation', text: "Je facilite seul jusqu'à environ 15 personnes, pour que chacun soit vraiment vu et entendu." },
  { icon: 'clock', title: 'Un bon temps de préparation', text: "En général, une journée et demie de préparation pour une journée d'animation." },
  { icon: 'network', title: 'La co-facilitation pour les grands groupes', text: "Au-delà, je m'appuie sur mon réseau de facilitateurs partenaires pour les conventions et grands groupes." },
];

const costPoints = [
  "Le pourquoi n'est pas suffisamment clarifié.",
  'Le résultat attendu reste flou.',
  'Le format est choisi avant le besoin.',
  'Les mauvaises personnes sont réunies.',
  'La participation est confondue avec la délégation.',
  'Personne ne tient réellement le processus.',
  'La journée se termine sans vraie suite.',
];

const meetingStats = [
  { color: 'navy', number: '72 %', text: 'des réunions jugées inefficaces', source: 'Atlassian' },
  { color: 'blue', number: '55 %', text: 'sans prochaines étapes claires', source: 'Microsoft' },
  { color: 'clay', number: '77 %', text: "se terminent par… une nouvelle réunion", source: 'Atlassian' },
  { color: 'brick', number: '43 %', text: 'dominées par quelques personnes', source: 'Atlassian' },
];

const takeCharge = [
  {
    icon: 'clipboard',
    title: 'Avant',
    text: 'Cadrer le propos, le contexte, le mandat et les résultats clés à atteindre.',
    subtitle: 'Comprendre avant de concevoir',
    detail: [
      "Avant de parler de méthode, de Post-it ou de déroulé, il faut comprendre la situation.",
      "Pourquoi réunir ce collectif ? Pour faire quoi, concrètement ? Avec qui ? Autour de quelles questions ? Pour produire quoi ? Et surtout : <strong>comment ce qui sera produit va-t-il être utilisé ensuite ?</strong>",
      "Je cherche aussi à comprendre ce qui s'est passé avant et ce qui doit se passer après.",
      "Le quotidien des participants. Ce qu'ils vivent réellement. Les tensions ou contraintes qui peuvent influencer les échanges. Les informations dont ils disposent. Et même une question essentielle : <strong>ont-ils réellement les moyens de répondre à ce qu'on va leur demander ?</strong>",
      "On regarde aussi leur expérience passée de l'intelligence collective.",
      "Parce qu'un collectif qui a déjà vécu trois ateliers remplis de Post-it sans jamais voir ce qu'ils sont devenus ne part pas de zéro.",
      "Il peut avoir appris que « participer ne sert à rien », que « les ateliers sont du théâtre » ou simplement que « les Post-it, ça ne marche pas ».",
      "Le problème n'était probablement pas le Post-it.",
      "Le problème était souvent l'absence de sens, de suite ou de lien entre la méthode utilisée et ce que le collectif devait réellement produire.",
      "Cette phase de préparation sert donc aussi à <strong>réparer le sens</strong> avant de remettre les participants dans un nouveau processus collectif.",
    ],
  },
  {
    icon: 'pencil',
    title: 'Concevoir',
    text: "Concevoir l'animation idéale et le bon déroulé, en lien avec vos objectifs.",
    subtitle: 'Construire le chemin, pas empiler les méthodes',
    detail: [
      "Je ne pars pas d'un catalogue de méthodes ou d'un atelier déjà tout fait.",
      "On commence par clarifier ce qui doit être différent à la fin : une décision prise, des priorités partagées, une vision commune, des solutions construites, un plan d'action concret…",
      "Une fois l'intention clarifiée, je construis avec vous le <strong>macro-déroulé</strong>.",
      "Les grandes étapes de la journée ou du séminaire : ce que le collectif doit comprendre, explorer, confronter, décider ou construire, et dans quel ordre.",
      "Ce déroulé est challengé avec vous pour vérifier qu'il répond réellement à l'objectif.",
      "Puis vient le <strong>micro-déroulé</strong>.",
      "Chaque séquence est conçue précisément : les questions posées, les consignes, le temps, la composition des groupes, le niveau de participation attendu, les modalités de restitution et la manière dont les productions vont s'enchaîner.",
      "Je conçois également les supports qui vont aider le collectif à travailler : canevas, outils visuels, supports de réflexion, dispositifs de restitution, affichages…",
      "Le visuel n'est pas là pour décorer.",
      "Il sert à <strong>donner à voir</strong>, soutenir la réflexion, faciliter les interactions, mettre en relation les idées et permettre au groupe de construire à partir de ce qu'il produit.",
      "Et à la fin, il reste autre chose qu'une pile de Post-it et quelques photos prises avec un téléphone.",
    ],
  },
  {
    icon: 'people',
    title: 'Pendant',
    text: "Tenir le cadre, donner le ton, faciliter les échanges et obtenir l'adhésion.",
    subtitle: 'Poser le cadre et tenir le processus',
    detail: [
      "Le jour J, tout commence par le sens.",
      "Pourquoi sommes-nous là ? Qu'attend-on réellement de cette journée ? Sur quoi les participants peuvent-ils agir ? Qu'est-ce qui est déjà décidé ? Qu'est-ce qui est réellement ouvert à la discussion ?",
      "Le niveau de délégation doit être clair.",
      "Faire participer des personnes à une décision déjà prise sans le leur dire crée plus de frustration que d'engagement.",
      "J'accompagne donc aussi le sponsor ou le leader dans la manière de lancer la journée : poser l'intention, expliquer le cadre et donner au collectif les informations nécessaires pour pouvoir réfléchir et agir.",
      "Ensuite, je tiens le processus.",
      "Mon objectif n'est pas de faire parler tout le monde pour pouvoir dire que l'atelier était participatif. Il est de faire émerger ce qui compte, confronter les points de vue, rendre visibles les désaccords, faire converger lorsque c'est nécessaire et transformer les échanges en décisions ou en prochaines étapes concrètes.",
      "Je facilite les interactions, observe ce qui se passe dans le groupe, fais circuler la parole, rends visibles les points de vue, aide à approfondir lorsqu'on reste en surface, à confronter lorsqu'il le faut et à converger quand le moment est venu.",
      "Et si la réalité de la salle ne correspond plus au déroulé préparé, j'adapte.",
      "Vous pouvez rester pleinement dans votre rôle : apporter votre expertise, écouter, challenger, décider ou simplement prendre part aux échanges.",
      "Parce qu'un bon processus n'est pas celui qu'on applique parfaitement. C'est celui qui permet au groupe d'avancer.",
    ],
  },
  {
    icon: 'chart',
    title: 'Après',
    text: "Débriefer, mesurer l'écart, ancrer les décisions et préparer la suite.",
    subtitle: 'Comprendre ce qui s\'est joué et préparer la suite',
    detail: [
      "La facilitation ne s'arrête pas quand la dernière personne quitte la salle.",
      "Un temps de débrief permet de revenir sur ce qui s'est passé.",
      "Les moments forts. Les points de bascule. Ce qui a facilité ou freiné le collectif. Les sujets qui ont émergé. Les tensions ou signaux faibles qu'il serait dommage d'ignorer.",
      "On regarde aussi les productions, les décisions et les prochaines étapes.",
      "Et surtout : <strong>qu'est-ce que cette journée nous apprend sur ce qu'il faudrait maintenant mettre en place ?</strong>",
      "Cela peut concerner le suivi d'une décision, un autre temps collectif, une évolution dans la manière de travailler ensemble ou simplement une vigilance à garder dans les semaines qui suivent.",
      "Le séminaire n'est alors plus un événement isolé. Il devient une étape dans un processus plus large.",
    ],
  },
];
---

<Layout
  title="Déléguer l'animation d'un temps collectif — by Nicolas Verdot"
  description="Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes."
  path="/offres/deleguer-animation/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: "Déléguer l'animation", path: '/offres/deleguer-animation/' },
  ]}
>
  <section class="hero-split" data-reveal>
    <div class="container hero-split-inner">
      <div class="hero-split-text">
        <p class="eyebrow">Déléguer l'animation · Facilitation complète</p>
        <h1>Vous me déléguez la facilitation, je conçois et j'anime de bout en bout</h1>
        <p class="page-summary">Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes — sans que vous ayez à porter l'animation.</p>
        <div class="meta-pills">
          {['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions'].map((pill) => <span>{pill}</span>)}
        </div>
        <div class="hero-cta-row">
          <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
          <a href={withBase('/offres/mentoring/')} class="btn-outline">Vous préférez garder l'animation ? Voir le Mentoring</a>
        </div>
      </div>
      <div class="hero-split-image">
        <Image src={heroImg} alt="Un facilitateur anime un atelier collaboratif devant un groupe de participants, avec un support visuel couvert de notes autocollantes." widths={[400, 800, 1200]} sizes="(max-width: 900px) 100vw, 640px" />
      </div>
    </div>
  </section>

  <section class="value-band" data-reveal data-section-name="Investissement sécurisé">
    <div class="container value-band-inner">
      <h2>
        Vous investissez déjà du temps et de l'énergie pour réunir les bonnes personnes.
        <span class="accent-wrap">
          Sécurisons cet investissement.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="value-grid">
        {valueItems.map((v) => (
          <div class="value-item">
            <svg class="value-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[v.icon]} />
            <strong>{v.title}</strong>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ClientLogoStrip />

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous avez besoin de faire avancer un collectif. Mais…</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {problems.map((p) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="callout-box">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.star} /></span>
        <p><strong>Votre enjeu n'est pas seulement d'organiser un atelier.</strong><br /><span class="accent">C'est de créer les conditions pour que le collectif comprenne, décide et avance réellement.</span></p>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le vrai coût d'un atelier qui ne fonctionne pas</p>
        </div>
      </div>
      <div class="cost-columns">
        <div class="cost-col cost-col-highlight">
          <h3>Combien coûte vraiment un mauvais atelier ?</h3>
          <p>Le coût d'un atelier ne se voit pas sur la facture, ni dans le budget.</p>
          <p><strong>Le premier poste de dépense, c'est le temps des personnes que vous mobilisez.</strong></p>
          <div class="people-row" aria-hidden="true">
            {Array.from({ length: 10 }).map(() => (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.person} />
            ))}
          </div>
          <p class="cost-formula">20 participants<br />× 1 journée<br />× 500 € par personne</p>
          <p class="cost-total">= 20 000 €</p>
          <p class="cost-total-label">de temps collectif mobilisé</p>
        </div>
        <div class="cost-col">
          <h3>Être ensemble ne signifie pas avancer ensemble</h3>
          <p>Les études sur les réunions et le travail démontrent bien un trio de problèmes.</p>
          <div class="meeting-stats">
            {meetingStats.map((s) => (
              <div class={`meeting-stat meeting-stat-${s.color}`}>
                <span class="meeting-stat-number">{s.number}</span>
                <span class="meeting-stat-text">{s.text}<span class="meeting-stat-source">Source : {s.source}</span></span>
              </div>
            ))}
          </div>
        </div>
        <div class="cost-col">
          <h3>Comment une journée à 20 000, 30 000 ou 50 000 € peut-elle ne rien produire ?</h3>
          <ol class="cost-numbered">
            {costPoints.map((c) => <li>{c}</li>)}
          </ol>
        </div>
      </div>
      <div class="callout-box callout-box-row">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.target} /></span>
        <p>Parlons de votre contexte pour construire le bon dispositif, avant que ce temps collectif ne soit fixé.</p>
        <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">L'accompagnement</p>
          <h2>Ce que comprend l'accompagnement</h2>
        </div>
      </div>
      <div class="phase-timeline" aria-hidden="true">
        {takeCharge.map((t, i) => (
          <>
            <span class="phase-timeline-dot">{i + 1}</span>
            {i < takeCharge.length - 1 && <span class="phase-timeline-line"></span>}
          </>
        ))}
      </div>
      <div class="take-charge-grid">
        {takeCharge.map((t, i) => (
          <button type="button" class="take-charge-card" data-phase-trigger={t.title}>
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <span class="take-charge-more">En savoir plus →</span>
          </button>
        ))}
      </div>
      <p class="ideal-if"><strong>Idéal si :</strong> le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.</p>
    </div>
  </section>

  {takeCharge.map((t, i) => (
    <div class="phase-modal" data-phase-modal={t.title} hidden>
      <div class="phase-modal-backdrop" data-phase-modal-close></div>
      <div class="phase-modal-panel" role="dialog" aria-modal="true" aria-labelledby={`phase-modal-title-${i}`}>
        <button type="button" class="phase-modal-close" data-phase-modal-close aria-label="Fermer">✕</button>
        <span class="take-charge-num phase-modal-num">{i + 1}</span>
        <p class="eyebrow">{t.title}</p>
        <h3 id={`phase-modal-title-${i}`}>{t.subtitle}</h3>
        {t.detail.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </div>
  ))}

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {basics.map((b) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel et les contraintes."
    ctaLabel="Réserver un échange de cadrage"
    dark
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  /* --- Hero à deux colonnes : texte + illustration --- */
  .hero-split {
    padding: var(--space-16) 0 var(--space-8);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .hero-split-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
  }
  .hero-split h1 {
    font-size: clamp(2.5rem, 4.2vw, 3.75rem);
    margin: 0;
  }
  .hero-split .page-summary {
    margin: var(--space-4) 0 0;
    max-width: 56ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .hero-split .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .hero-split .meta-pills span {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .hero-split-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .hero-split-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .hero-split-inner {
      grid-template-columns: 1fr;
    }
    .hero-split-image {
      order: -1;
      max-width: 420px;
      margin: 0 auto;
    }
  }
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  /* --- Bandeau sombre entre le hero et les logos, même traitement que
     le bandeau "preuve" de la page d'accueil (fond --color-ink-solid). --- */
  .value-band {
    background: var(--color-ink-solid);
    padding: var(--space-12) 0;
  }
  .value-band-inner {
    text-align: center;
  }
  .value-band h2 {
    margin: 0 0 var(--space-8);
    color: var(--color-white);
  }
  .value-band .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .value-band .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
