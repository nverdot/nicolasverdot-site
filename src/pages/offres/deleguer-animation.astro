---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation complète de séminaires et ateliers',
  name: "Déléguer l'animation d'un temps collectif",
  description:
    "Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/deleguer-animation/'), Astro.site).toString(),
};

const problems = [
  {
    title: 'Vous ne savez pas comment construire le bon processus',
    text: "Vous maîtrisez votre sujet, mais pas forcément les méthodes d'intelligence collective. Quel format choisir ? Comment faire participer ? Comment passer des échanges à une décision concrète ?",
  },
  {
    title: 'Vos ateliers sont participatifs… mais produisent peu',
    text: "Des Post-it, des icebreakers, des discussions, une bonne énergie sur le moment… puis quelques semaines plus tard, difficile de dire ce qui a réellement changé.",
  },
  {
    title: 'Les discussions tournent en rond',
    text: "Les mêmes sujets reviennent, tout semble prioritaire, les points de vue s'opposent et les décisions ont du mal à émerger.",
  },
  {
    title: 'Vous êtes trop impliqué pour faciliter vous-même',
    text: "Difficile d'exprimer votre point de vue, écouter les autres et contribuer aux décisions tout en gérant le temps, la parole, les tensions et la dynamique du groupe.",
  },
  {
    title: 'Tout le monde ne participe pas vraiment',
    text: "Quelques personnes prennent beaucoup de place, d'autres restent en retrait. La hiérarchie, les désaccords ou les non-dits peuvent empêcher le collectif de réellement travailler ensemble.",
  },
  {
    title: "L'enjeu est trop important pour improviser",
    text: "Séminaire stratégique, transformation, décision structurante, lancement de projet… Vous mobilisez parfois des dizaines de personnes. Vous voulez que ce temps produise autre chose qu'une belle journée ensemble.",
  },
];

const bring = [
  {
    title: "Facilitation d'intelligence collective",
    text: "Je construis un processus qui permet aux participants de comprendre, contribuer, confronter leurs points de vue, décider et agir. Ce n'est pas simplement « faire participer » : chaque méthode est choisie en fonction de l'objectif recherché.",
  },
  {
    title: 'Facilitation graphique',
    text: 'Les idées, tensions, décisions et prochaines étapes deviennent visibles au fur et à mesure. Elle permet de maintenir l\'attention, de rendre les échanges plus accessibles, de construire une compréhension commune et de conserver une mémoire utile du séminaire.',
  },
  {
    title: 'Une approche ancrée dans le terrain',
    text: "Je ne propose pas un déroulé théorique déconnecté de la réalité : les contraintes des managers, les tensions dans les équipes, les transformations qui s'essoufflent, les décisions difficiles à faire vivre, les imprévus du jour J.",
  },
];

const includes = ['Les entretiens de cadrage', 'La conception du déroulé', 'Le choix des méthodes', 'La préparation des supports', 'La facilitation du jour J', 'La facilitation graphique', 'La synthèse des résultats', 'Le débrief et les prochaines étapes'];

const process = [
  { title: 'Cadrer', text: "Nous clarifions le contexte, les participants, les tensions, les objectifs et ce qui devra être différent à la fin." },
  { title: 'Concevoir', text: 'Je transforme l\'intention en processus : rythme, séquences, méthodes, consignes, supports et modalités de décision.' },
  { title: 'Préparer', text: 'Nous sécurisons les rôles, la logistique, les prises de parole, les supports et les situations sensibles.' },
  { title: 'Faciliter', text: 'Le jour J, je garde une position haute sur le processus et basse sur le contenu : le groupe travaille, je ne lui impose pas les réponses.' },
  { title: 'Ancrer', text: 'Les décisions sont rendues visibles et transformées en priorités, responsabilités et prochaines étapes.' },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: 'Séminaire stratégique', text: 'Faire travailler un collectif sur une vision, des choix structurants ou une feuille de route.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de décision', text: 'Transformer un sujet complexe en choix clairs, compris par les personnes concernées et suivis d\'actions.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Convention ou grand groupe', text: "Faire participer un nombre important de personnes sans transformer l'événement en succession de présentations descendantes." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];
---

<Layout
  title="Déléguer l'animation d'un temps collectif — by Nicolas Verdot"
  description="Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes."
  path="/offres/deleguer-animation/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: "Déléguer l'animation", path: '/offres/deleguer-animation/' },
  ]}
>
  <PageHero
    eyebrow="Déléguer l'animation · Facilitation complète"
    title="Vous me déléguez la facilitation, je conçois et j'anime de bout en bout"
    summary="Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes — sans que vous ayez à porter l'animation."
    pills={['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions']}
  />

  <div class="container hero-cta-row">
    <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
    <a href={withBase('/offres/mentoring/')} class="btn-outline">Vous préférez garder l'animation ? Voir le Mentoring</a>
  </div>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous avez besoin de faire avancer un collectif. Mais…</h2>
          <p>Réunir les bonnes personnes dans une salle ne suffit pas toujours à produire les bonnes décisions.</p>
        </div>
      </div>
      <div class="cards">
        {problems.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <p class="problem-statement"><strong>Votre enjeu n'est pas simplement d'organiser un atelier. C'est de créer les conditions pour que le collectif comprenne, décide et avance réellement.</strong></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ce que j'apporte</p>
          <h2>Trois choses que vous ne trouverez pas ensemble ailleurs</h2>
        </div>
      </div>
      <div class="cards">
        {bring.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Ce que vous me déléguez</p>
        <h2>Je conçois et j'anime, vous restez concentré sur le fond</h2>
        <ul class="includes-list">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
        <p class="muted"><strong>Idéal si :</strong> le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.</p>
      </div>
    </div>
  </section>

  <section class="section dark" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Mon processus</p>
          <h2>Cadrer → Concevoir → Préparer → Faciliter → Ancrer</h2>
        </div>
      </div>
      <div class="method process-method">
        {process.map((s, i) => (
          <div class="step">
            <b>{String(i + 1).padStart(2, '0')}</b>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel et les contraintes."
    ctaLabel="Réserver un échange de cadrage"
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: var(--space-8);
  }
  .problem-statement {
    margin: var(--space-8) auto 0;
    max-width: 640px;
    text-align: center;
    font-size: var(--text-xl);
    color: var(--color-navy);
  }
  .muted {
    color: var(--color-muted);
  }
  .includes-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
  }
  .includes-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-ink);
  }
  .includes-list li::before {
    content: '— ';
    color: var(--color-orange-ink);
  }
  .process-method {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .process-method .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .process-method .step strong {
    color: var(--color-white);
  }
  .process-method .step span {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
  }
  .methods-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
  }
  .methods-list li {
    position: relative;
    padding-left: var(--space-4);
    font-weight: 600;
    color: var(--color-navy);
  }
  .methods-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-orange-ink);
  }
  @media (max-width: 900px) {
    .process-method {
      grid-template-columns: 1fr;
    }
    .includes-list,
    .methods-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .includes-list,
    .methods-list {
      grid-template-columns: 1fr;
    }
  }
</style>
