---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation complète de séminaires et ateliers',
  name: "Déléguer l'animation d'un temps collectif",
  description:
    "Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/deleguer-animation/'), Astro.site).toString(),
};

const icons: Record<string, string> = {
  compass: '<path d="M4 17c2.5-6 5 6 8 0s4.5-5 8 0"/><circle cx="4" cy="17" r="1" fill="currentColor" stroke="none"/><circle cx="20" cy="17" r="1" fill="currentColor" stroke="none"/>',
  chat: '<rect x="3" y="5" width="18" height="11" rx="2"/><path d="M8 16l-2 3v-3"/>',
  loop: '<path d="M4 12a8 8 0 0 1 13.5-5.8"/><path d="M20 12a8 8 0 0 1-13.5 5.8"/><path d="M17 3v4h-4"/><path d="M7 21v-4h4"/>',
  person: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  flag: '<path d="M6 3v18"/><path d="M6 4h13l-3 4 3 4H6"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8.5 11h7M8.5 15h7"/>',
  pencil: '<path d="M4 20l1-4.2L15.8 5 19 8.2 8.2 19 4 20z"/><path d="M13.5 6.5l4 4"/>',
  chart: '<path d="M4 21V11M10 21V4M16 21v-8M4 21h16"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/>',
  network: '<circle cx="6" cy="6" r="2.3"/><circle cx="18" cy="6" r="2.3"/><circle cx="12" cy="18" r="2.3"/><path d="M8 7l3.2 9M16 7l-3.2 9M8.3 6h7.4"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  star: '<path d="M12 3l2.4 5.3 5.8.6-4.3 4 1.2 5.7L12 15.9 6.9 18.6l1.2-5.7-4.3-4 5.8-.6L12 3z"/>',
};

const problems = [
  { icon: 'compass', title: "Le processus n'est pas clair", text: 'Vous marchez sur un terrain flou : le résultat final ne correspond pas toujours aux attentes du collectif.' },
  { icon: 'chat', title: 'Des ateliers participatifs mais peu productifs', text: "Des échanges riches, mais des décisions diluées qui n'aboutissent à rien de concret." },
  { icon: 'loop', title: 'Des discussions qui tournent en rond', text: 'Les mêmes sujets reviennent, les tensions perdurent et les décisions ne se concrétisent pas vraiment.' },
  { icon: 'person', title: 'Trop impliqué pour animer vous-même', text: 'Difficile de prendre du recul quand on est au cœur du sujet et acteur des décisions.' },
  { icon: 'people', title: 'Une participation inégale', text: "Quelques personnes monopolisent la parole, d'autres restent en retrait." },
  { icon: 'flag', title: "Trop d'enjeux pour improviser", text: 'Énergie, budget, temps : vous ne pouvez pas vous permettre un faux pas.' },
];

const includes = ['Les entretiens de cadrage', 'La conception du déroulé', 'Le choix des méthodes', 'La préparation des supports', 'La facilitation du jour J', 'La facilitation graphique', 'La synthèse des résultats', 'Le débrief et les prochaines étapes'];

const basics = [
  { icon: 'people', title: 'Un bon ratio de facilitation', text: "Je facilite seul jusqu'à environ 15 personnes, pour que chacun soit vraiment vu et entendu." },
  { icon: 'clock', title: 'Un bon temps de préparation', text: "En général, une journée et demie de préparation pour une journée d'animation." },
  { icon: 'network', title: 'La co-facilitation pour les grands groupes', text: "Au-delà, je m'appuie sur mon réseau de facilitateurs partenaires pour les conventions et grands groupes." },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: 'Séminaire stratégique', text: 'Faire travailler un collectif sur une vision, des choix structurants ou une feuille de route.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de décision', text: 'Transformer un sujet complexe en choix clairs, compris par les personnes concernées et suivis d\'actions.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Convention ou grand groupe', text: "Faire participer un nombre important de personnes sans transformer l'événement en succession de présentations descendantes." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];

const costPoints = [
  "Le pourquoi n'est pas suffisamment clarifié.",
  'Le résultat attendu reste flou.',
  'Le format est choisi avant le besoin.',
  'Les mauvaises personnes sont réunies.',
  'La participation est confondue avec la délégation.',
  'Personne ne tient réellement le processus.',
  'La journée se termine sans vraie suite.',
];

const meetingStats = [
  { color: 'navy', number: '72 %', text: 'des réunions jugées inefficaces', source: 'Atlassian' },
  { color: 'blue', number: '55 %', text: 'sans prochaines étapes claires', source: 'Microsoft' },
  { color: 'orange', number: '77 %', text: "se terminent par… une nouvelle réunion", source: 'Atlassian' },
  { color: 'brick', number: '43 %', text: 'dominées par quelques personnes', source: 'Atlassian' },
];

const takeCharge = [
  { icon: 'clipboard', title: 'Avant', text: 'Cadrer le propos, le contexte, le mandat et les résultats clés à atteindre.' },
  { icon: 'pencil', title: 'Concevoir', text: "Concevoir l'animation idéale et le bon déroulé, en lien avec vos objectifs." },
  { icon: 'people', title: 'Pendant', text: "Tenir le cadre, donner le ton, faciliter les échanges et obtenir l'adhésion." },
  { icon: 'chart', title: 'Après', text: "Débriefer, mesurer l'écart, ancrer les décisions et préparer la suite." },
];
---

<Layout
  title="Déléguer l'animation d'un temps collectif — by Nicolas Verdot"
  description="Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes."
  path="/offres/deleguer-animation/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: "Déléguer l'animation", path: '/offres/deleguer-animation/' },
  ]}
>
  <PageHero
    eyebrow="Déléguer l'animation · Facilitation complète"
    title="Vous me déléguez la facilitation, je conçois et j'anime de bout en bout"
    summary="Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes — sans que vous ayez à porter l'animation."
    pills={['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions']}
  />

  <div class="container hero-cta-row">
    <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
    <a href={withBase('/offres/mentoring/')} class="btn-outline">Vous préférez garder l'animation ? Voir le Mentoring</a>
  </div>

  <ClientLogoStrip />

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous avez besoin de faire avancer un collectif. Mais…</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {problems.map((p) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="callout-box">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.star} /></span>
        <p><strong>Votre enjeu n'est pas seulement d'organiser un atelier.</strong><br /><span class="accent">C'est de créer les conditions pour que le collectif comprenne, décide et avance réellement.</span></p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le vrai coût d'un atelier qui ne fonctionne pas</p>
        </div>
      </div>
      <div class="cost-columns">
        <div class="cost-col cost-col-highlight">
          <h3>Combien coûte vraiment un mauvais atelier ?</h3>
          <p>Le coût d'un atelier ne se voit pas sur la facture, ni dans le budget.</p>
          <p><strong>Le premier poste de dépense, c'est le temps des personnes que vous mobilisez.</strong></p>
          <div class="people-row" aria-hidden="true">
            {Array.from({ length: 10 }).map(() => (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.person} />
            ))}
          </div>
          <p class="cost-formula">20 participants<br />× 1 journée<br />× 500 € par personne</p>
          <p class="cost-total">= 20 000 €</p>
          <p class="cost-total-label">de temps collectif mobilisé</p>
        </div>
        <div class="cost-col">
          <h3>Être ensemble ne signifie pas avancer ensemble</h3>
          <p>Les études sur les réunions et le travail démontrent bien un trio de problèmes.</p>
          <div class="meeting-stats">
            {meetingStats.map((s) => (
              <div class={`meeting-stat meeting-stat-${s.color}`}>
                <span class="meeting-stat-number">{s.number}</span>
                <span class="meeting-stat-text">{s.text}<span class="meeting-stat-source">Source : {s.source}</span></span>
              </div>
            ))}
          </div>
        </div>
        <div class="cost-col">
          <h3>Comment une journée à 20 000, 30 000 ou 50 000 € peut-elle ne rien produire ?</h3>
          <ol class="cost-numbered">
            {costPoints.map((c) => <li>{c}</li>)}
          </ol>
        </div>
      </div>
      <div class="callout-box callout-box-row">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.target} /></span>
        <p>Vous mobilisez déjà beaucoup pour réunir les bonnes personnes.<br />Je vous aide à faire de ce temps collectif un véritable levier de décisions et d'actions.</p>
        <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ce que je prends en charge</p>
        </div>
      </div>
      <div class="take-charge-grid">
        {takeCharge.map((t, i) => (
          <div class="take-charge-card">
            <span class="take-charge-num">{i + 1}</span>
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
      <div class="panel includes-panel">
        <h3>Ce que vous me déléguez</h3>
        <ul class="includes-list">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
        <p class="muted"><strong>Idéal si :</strong> le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.</p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {basics.map((b) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel et les contraintes."
    ctaLabel="Réserver un échange de cadrage"
    dark
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: var(--space-8);
  }
  .card p:not(:last-child) {
    margin-bottom: var(--space-3);
  }
  .muted {
    color: var(--color-muted);
  }
  .includes-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
  }
  .includes-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-ink);
  }
  .includes-list li::before {
    content: '— ';
    color: var(--color-orange-ink);
  }
  .includes-panel {
    margin-top: var(--space-8);
  }

  /* --- Icônes de carte (Le problème, Bon à savoir) --- */
  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-cream);
    color: var(--color-navy);
  }
  .card-icon svg {
    width: 22px;
    height: 22px;
  }
  .icon-cards .card h3 {
    font-size: var(--text-lg);
  }

  /* --- Encart bordé avec icône (rappel d'enjeu / CTA intermédiaire) --- */
  .callout-box {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-orange);
    background: color-mix(in srgb, var(--color-orange) 8%, var(--color-surface));
  }
  .callout-box-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-orange-ink);
  }
  .callout-box-icon svg {
    width: 20px;
    height: 20px;
  }
  .callout-box p {
    margin: 0;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.5;
  }
  .callout-box .accent {
    color: var(--color-orange-ink);
  }
  .callout-box-row {
    border-color: var(--color-blue);
    background: color-mix(in srgb, var(--color-blue) 6%, var(--color-surface));
    flex-wrap: wrap;
  }
  .callout-box-row .callout-box-icon {
    color: var(--color-blue);
  }
  .callout-box-row p {
    flex: 1;
    min-width: 240px;
    font-weight: 600;
  }
  .callout-box-row .btn {
    flex-shrink: 0;
  }

  /* --- "Le vrai coût" : 3 colonnes --- */
  .cost-columns {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }
  .cost-col {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .cost-col h3 {
    margin-top: 0;
    font-size: var(--text-lg);
  }
  .cost-col > p {
    color: var(--color-muted);
  }
  .cost-col-highlight {
    background: color-mix(in srgb, var(--color-orange) 10%, var(--color-surface));
    border-color: var(--color-orange);
    text-align: center;
  }
  .cost-col-highlight h3,
  .cost-col-highlight > p {
    text-align: left;
  }
  .people-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px;
    margin: var(--space-4) 0;
    color: var(--color-orange-ink);
  }
  .people-row svg {
    width: 16px;
    height: 16px;
  }
  .cost-formula {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.6;
  }
  .cost-total {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-3xl);
    color: var(--color-orange-ink);
  }
  .cost-total-label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .meeting-stats {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }
  .meeting-stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3);
    border-left: 3px solid var(--color-border);
    background: var(--color-cream);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .meeting-stat-number {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xl);
    min-width: 3.2em;
  }
  .meeting-stat-text {
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .meeting-stat-source {
    display: block;
    margin-top: 2px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .meeting-stat-navy { border-left-color: var(--color-navy); }
  .meeting-stat-navy .meeting-stat-number { color: var(--color-navy); }
  .meeting-stat-blue { border-left-color: var(--color-blue); }
  .meeting-stat-blue .meeting-stat-number { color: var(--color-blue); }
  .meeting-stat-orange { border-left-color: var(--color-orange); }
  .meeting-stat-orange .meeting-stat-number { color: var(--color-orange-ink); }
  .meeting-stat-brick { border-left-color: var(--color-brick); }
  .meeting-stat-brick .meeting-stat-number { color: var(--color-brick); }
  .cost-numbered {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: cost;
    display: grid;
    gap: var(--space-3);
  }
  .cost-numbered li {
    counter-increment: cost;
    position: relative;
    padding-left: var(--space-8);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.7;
  }
  .cost-numbered li::before {
    content: counter(cost);
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6em;
    height: 1.6em;
    border-radius: 999px;
    background: var(--color-orange);
    color: var(--color-navy);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-xs);
  }
  @media (max-width: 980px) {
    .cost-columns {
      grid-template-columns: 1fr;
    }
  }

  /* --- "Ce que je prends en charge" : 4 colonnes numérotées --- */
  .take-charge-grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .take-charge-card {
    position: relative;
    padding: var(--space-6) var(--space-4) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .take-charge-num {
    position: absolute;
    top: calc(var(--space-4) * -1);
    left: var(--space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
