              <span aria-hidden="true">{s.verdict === 'good' ? '✓' : '✗'}</span> {s.label}
            </span>
            <div class="prep-steps">
              {s.steps.map((step, i) => (
                <>
                  <span class="prep-step">{step}</span>
                  {i < s.steps.length - 1 && <span class="prep-arrow" aria-hidden="true">→</span>}
                </>
              ))}
            </div>
            <span class="prep-outcome">{s.outcome}</span>
          </div>
        ))}
      </div>

      <p class="callout-statement"><strong>Vous n'achetez pas des heures de facilitation. Vous investissez dans la capacité de votre équipe à avancer réellement — à mettre en balance le coût, souvent invisible, d'un collectif qui piétine, et la valeur d'une dynamique vraiment lancée, ancrée et durable.</strong></p>
