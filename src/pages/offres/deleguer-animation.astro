---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation complète de séminaires et ateliers',
  name: "Déléguer l'animation d'un temps collectif",
  description:
    "Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/deleguer-animation/'), Astro.site).toString(),
};

const problems = [
  {
    title: 'Vous ne savez pas comment construire le bon processus',
    text: "Vous maîtrisez votre sujet, mais pas forcément les méthodes d'intelligence collective. Quel format choisir ? Comment faire participer ? Comment passer des échanges à une décision concrète ?",
  },
  {
    title: 'Vos ateliers sont participatifs… mais produisent peu',
    text: "Des Post-it, des icebreakers, des discussions, une bonne énergie sur le moment… puis quelques semaines plus tard, difficile de dire ce qui a réellement changé.",
  },
  {
    title: 'Les discussions tournent en rond',
    text: "Les mêmes sujets reviennent, tout semble prioritaire, les points de vue s'opposent et les décisions ont du mal à émerger.",
  },
  {
    title: 'Vous êtes trop impliqué pour faciliter vous-même',
    text: "Difficile d'exprimer votre point de vue, écouter les autres et contribuer aux décisions tout en gérant le temps, la parole, les tensions et la dynamique du groupe.",
  },
  {
    title: 'Tout le monde ne participe pas vraiment',
    text: "Quelques personnes prennent beaucoup de place, d'autres restent en retrait. La hiérarchie, les désaccords ou les non-dits peuvent empêcher le collectif de réellement travailler ensemble.",
  },
  {
    title: "L'enjeu est trop important pour improviser",
    text: "Séminaire stratégique, transformation, décision structurante, lancement de projet… Vous mobilisez parfois des dizaines de personnes. Vous voulez que ce temps produise autre chose qu'une belle journée ensemble.",
  },
];

const bring = [
  {
    title: 'Un déroulé construit à partir du résultat attendu',
    texts: [
      "Je ne pars pas d'un catalogue de méthodes ou d'un atelier déjà tout fait.",
      "On commence par clarifier ce qui doit être différent à la fin : une décision prise, des priorités partagées, une vision commune, des solutions construites, un plan d'action concret…",
      "Je construis ensuite le chemin qui permettra au groupe d'y arriver : les bonnes séquences, les bonnes questions, le bon niveau de participation et les bons formats.",
    ],
  },
  {
    title: 'Un cadre tenu pour que vous puissiez vraiment participer',
    texts: [
      "Le jour J, je prends en charge le temps, les consignes, la circulation de la parole, les sous-groupes, les restitutions, les divergences, les moments où ça bloque… et les ajustements quand le programme prévu rencontre la réalité.",
      'Vous pouvez rester pleinement dans votre rôle : apporter votre expertise, écouter, challenger, décider ou simplement prendre part aux échanges.',
    ],
  },
  {
    title: "Un collectif que l'on aide à produire, pas seulement à participer",
    texts: [
      "Mon objectif n'est pas de faire parler tout le monde pour pouvoir dire que l'atelier était participatif.",
      "Il est de faire émerger ce qui compte, confronter les points de vue, rendre visibles les désaccords, faire converger lorsque c'est nécessaire et transformer les échanges en décisions ou en prochaines étapes concrètes.",
    ],
  },
  {
    title: 'Le visuel comme outil de travail',
    texts: [
      'La facilitation graphique est intégrée au processus quand elle apporte quelque chose.',
      "Elle permet de rendre visibles les idées, les liens, les tensions, les choix et les décisions au fur et à mesure. Le groupe peut voir ce qu'il construit, revenir dessus, compléter, corriger et avancer à partir d'une représentation commune.",
      "Et à la fin, il reste autre chose qu'une pile de Post-it et quelques photos prises avec un téléphone.",
    ],
  },
];

const includes = ['Les entretiens de cadrage', 'La conception du déroulé', 'Le choix des méthodes', 'La préparation des supports', 'La facilitation du jour J', 'La facilitation graphique', 'La synthèse des résultats', 'Le débrief et les prochaines étapes'];

const basics = [
  {
    title: 'Le bon ratio de facilitation',
    texts: [
      "Pour que chacun soit vraiment vu, entendu et actif dans les échanges, je facilite seul jusqu'à environ 15 personnes.",
      "Au-delà, je m'appuie sur mon réseau de facilitateurs et facilitatrices partenaires pour co-animer les grands groupes, conventions ou séminaires réunissant plusieurs dizaines, voire centaines de participants.",
    ],
  },
  {
    title: 'Le bon temps de préparation',
    texts: [
      "Une journée de facilitation ne se prépare pas la veille : je compte en général une journée et demie de préparation pour une journée d'animation.",
      "Trop tôt, le contexte a le temps de changer : de nouvelles informations émergent, les priorités bougent, et une partie de la conception doit être reprise.",
      "Trop tard, il ne reste plus le temps de poser les bonnes questions ni de vérifier que les parties prenantes sont alignées : on prépare dans l'urgence, et c'est le processus qui en paie le prix.",
    ],
  },
  {
    title: "Le temps d'alignement de l'équipe de facilitation",
    texts: [
      "Dès qu'un dispositif mobilise plusieurs facilitateurs, il faut aussi le temps que l'équipe se cale : partager la même lecture des enjeux, se répartir les rôles, s'accorder sur le déroulé et anticiper ensemble les moments délicats.",
      "Ce temps d'alignement fait partie intégrante de la préparation — il ne s'improvise pas plus que le reste.",
    ],
  },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: 'Séminaire stratégique', text: 'Faire travailler un collectif sur une vision, des choix structurants ou une feuille de route.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de décision', text: 'Transformer un sujet complexe en choix clairs, compris par les personnes concernées et suivis d\'actions.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Convention ou grand groupe', text: "Faire participer un nombre important de personnes sans transformer l'événement en succession de présentations descendantes." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];
---

<Layout
  title="Déléguer l'animation d'un temps collectif — by Nicolas Verdot"
  description="Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes."
  path="/offres/deleguer-animation/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: "Déléguer l'animation", path: '/offres/deleguer-animation/' },
  ]}
>
  <PageHero
    eyebrow="Déléguer l'animation · Facilitation complète"
    title="Vous me déléguez la facilitation, je conçois et j'anime de bout en bout"
    summary="Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes — sans que vous ayez à porter l'animation."
    pills={['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions']}
  />

  <div class="container hero-cta-row">
    <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
    <a href={withBase('/offres/mentoring/')} class="btn-outline">Vous préférez garder l'animation ? Voir le Mentoring</a>
  </div>

  <ClientLogoStrip />

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous avez besoin de faire avancer un collectif. Mais…</h2>
          <p>Réunir les bonnes personnes dans une salle ne suffit pas toujours à produire les bonnes décisions.</p>
        </div>
      </div>
      <div class="cards">
        {problems.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <p class="callout-statement"><strong>Votre enjeu n'est pas simplement d'organiser un atelier. C'est de créer les conditions pour que le collectif comprenne, décide et avance réellement.</strong></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ce que j'apporte</p>
          <h2>Ce que je prends en charge</h2>
          <p>Déléguer la facilitation, ce n'est pas simplement confier l'animation du jour J. Je prends en charge le processus qui doit permettre au collectif d'arriver quelque part.</p>
        </div>
      </div>
      <div class="cards bring-cards">
        {bring.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            {b.texts.map((t) => <p>{t}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Ce que vous me déléguez</p>
        <h2>Je conçois et j'anime, vous restez concentré sur le fond</h2>
        <ul class="includes-list">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
        <p class="muted"><strong>Idéal si :</strong> le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.</p>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container prose accompaniment-prose">
      <p class="eyebrow">Mon processus</p>
      <h2>Un accompagnement avant, pendant et après</h2>
      <p>Déléguer la facilitation, ce n'est pas simplement confier l'animation d'une journée.</p>
      <p>C'est se faire accompagner pour comprendre ce qui doit réellement être travaillé, concevoir le bon processus, créer les conditions pour que le collectif puisse produire quelque chose d'utile… et tirer les enseignements de ce qui s'est passé.</p>

      <h3>Avant — Comprendre avant de concevoir</h3>
      <p>Avant de parler de méthode, de Post-it ou de déroulé, il faut comprendre la situation.</p>
      <p class="question-lines">
        Pourquoi réunir ce collectif ?<br />
        Pour faire quoi, concrètement ?<br />
        Avec qui ?<br />
        Autour de quelles questions ?<br />
        Pour produire quoi ?<br />
        Et surtout : <strong>comment ce qui sera produit va-t-il être utilisé ensuite ?</strong>
      </p>
      <p>Je cherche aussi à comprendre ce qui s'est passé avant et ce qui doit se passer après.</p>
      <p class="question-lines">
        Le quotidien des participants.<br />
        Ce qu'ils vivent réellement.<br />
        Les tensions ou contraintes qui peuvent influencer les échanges.<br />
        Les informations dont ils disposent.<br />
        Et même une question essentielle : <strong>ont-ils réellement les moyens de répondre à ce qu'on va leur demander ?</strong>
      </p>
      <p>On regarde aussi leur expérience passée de l'intelligence collective.</p>
      <p>Parce qu'un collectif qui a déjà vécu trois ateliers remplis de Post-it sans jamais voir ce qu'ils sont devenus ne part pas de zéro.</p>
      <p>Il peut avoir appris que « participer ne sert à rien », que « les ateliers sont du théâtre » ou simplement que « les Post-it, ça ne marche pas ».</p>
      <p>Le problème n'était probablement pas le Post-it.</p>
      <p>Le problème était souvent l'absence de sens, de suite ou de lien entre la méthode utilisée et ce que le collectif devait réellement produire.</p>
      <p>Cette phase de préparation sert donc aussi à <strong>réparer le sens</strong> avant de remettre les participants dans un nouveau processus collectif.</p>

      <h3>Concevoir — Construire le chemin, pas empiler les méthodes</h3>
      <p>Une fois l'intention clarifiée, je construis avec vous le <strong>macro-déroulé</strong>.</p>
      <p>Les grandes étapes de la journée ou du séminaire : ce que le collectif doit comprendre, explorer, confronter, décider ou construire, et dans quel ordre.</p>
      <p>Ce déroulé est challengé avec vous pour vérifier qu'il répond réellement à l'objectif.</p>
      <p>Puis vient le <strong>micro-déroulé</strong>.</p>
      <p>Chaque séquence est conçue précisément : les questions posées, les consignes, le temps, la composition des groupes, le niveau de participation attendu, les modalités de restitution et la manière dont les productions vont s'enchaîner.</p>
      <p>Je conçois également les supports qui vont aider le collectif à travailler : canevas, outils visuels, supports de réflexion, dispositifs de restitution, affichages…</p>
      <p>Le visuel n'est pas là pour décorer.</p>
      <p>Il sert à <strong>donner à voir</strong>, soutenir la réflexion, faciliter les interactions, mettre en relation les idées et permettre au groupe de construire à partir de ce qu'il produit.</p>

      <h3>Pendant — Poser le cadre et tenir le processus</h3>
      <p>Le jour J, tout commence par le sens.</p>
      <p class="question-lines">
        Pourquoi sommes-nous là ?<br />
        Qu'attend-on réellement de cette journée ?<br />
        Sur quoi les participants peuvent-ils agir ?<br />
        Qu'est-ce qui est déjà décidé ?<br />
        Qu'est-ce qui est réellement ouvert à la discussion ?
      </p>
      <p>Le niveau de délégation doit être clair.</p>
      <p>Faire participer des personnes à une décision déjà prise sans le leur dire crée plus de frustration que d'engagement.</p>
      <p>J'accompagne donc aussi le sponsor ou le leader dans la manière de lancer la journée : poser l'intention, expliquer le cadre et donner au collectif les informations nécessaires pour pouvoir réfléchir et agir.</p>
      <p>Ensuite, je tiens le processus.</p>
      <p>Je facilite les interactions, observe ce qui se passe dans le groupe, fais circuler la parole, rends visibles les points de vue, aide à approfondir lorsqu'on reste en surface, à confronter lorsqu'il le faut et à converger quand le moment est venu.</p>
      <p>Et si la réalité de la salle ne correspond plus au déroulé préparé, j'adapte.</p>
      <p class="question-lines">
        Parce qu'un bon processus n'est pas celui qu'on applique parfaitement.<br />
        C'est celui qui permet au groupe d'avancer.
      </p>

      <h3>Après — Comprendre ce qui s'est joué et préparer la suite</h3>
      <p>La facilitation ne s'arrête pas quand la dernière personne quitte la salle.</p>
      <p>Un temps de débrief permet de revenir sur ce qui s'est passé.</p>
      <p class="question-lines">
        Les moments forts.<br />
        Les points de bascule.<br />
        Ce qui a facilité ou freiné le collectif.<br />
        Les sujets qui ont émergé.<br />
        Les tensions ou signaux faibles qu'il serait dommage d'ignorer.
      </p>
      <p>On regarde aussi les productions, les décisions et les prochaines étapes.</p>
      <p>Et surtout : <strong>qu'est-ce que cette journée nous apprend sur ce qu'il faudrait maintenant mettre en place ?</strong></p>
      <p>Cela peut concerner le suivi d'une décision, un autre temps collectif, une évolution dans la manière de travailler ensemble ou simplement une vigilance à garder dans les semaines qui suivent.</p>
      <p>Le séminaire n'est alors plus un événement isolé.</p>
      <p>Il devient une étape dans un processus plus large.</p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards">
        {basics.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            {b.texts.map((t) => <p>{t}</p>)}
          </article>
        ))}
      </div>
      <p class="callout-statement"><strong>Vous n'achetez pas des heures de facilitation. Vous investissez dans la capacité de votre équipe à avancer réellement — à mettre en balance le coût, souvent invisible, d'un collectif qui piétine, et la valeur d'une dynamique vraiment lancée, ancrée et durable.</strong></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel et les contraintes."
    ctaLabel="Réserver un échange de cadrage"
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: var(--space-8);
  }
  .callout-statement {
    margin: var(--space-8) auto 0;
    max-width: 640px;
    text-align: center;
    font-size: var(--text-xl);
    color: var(--color-navy);
  }
  .bring-cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .card p:not(:last-child) {
    margin-bottom: var(--space-3);
  }
  .muted {
    color: var(--color-muted);
  }
  .includes-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
  }
  .includes-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-ink);
  }
  .includes-list li::before {
    content: '— ';
    color: var(--color-orange-ink);
  }
  .accompaniment-prose h3 {
    margin-top: var(--space-12);
  }
  .question-lines {
    color: var(--color-navy);
    font-weight: 600;
  }
  .methods-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
  }
  .methods-list li {
    position: relative;
    padding-left: var(--space-4);
    font-weight: 600;
    color: var(--color-navy);
  }
  .methods-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-orange-ink);
  }
  @media (max-width: 900px) {
    .includes-list,
    .methods-list {
      grid-template-columns: 1fr 1fr;
    }
    .bring-cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .includes-list,
    .methods-list {
      grid-template-columns: 1fr;
    }
  }
</style>
