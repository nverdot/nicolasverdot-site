---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation complète de séminaires et ateliers',
  name: "Déléguer l'animation d'un temps collectif",
  description:
    "Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/deleguer-animation/'), Astro.site).toString(),
};

const problems = [
  {
    title: 'Vous ne savez pas comment construire le bon processus',
    text: "Vous maîtrisez votre sujet, mais pas forcément les méthodes d'intelligence collective. Quel format choisir ? Comment faire participer ? Comment passer des échanges à une décision concrète ?",
  },
  {
    title: 'Vos ateliers sont participatifs… mais produisent peu',
    text: "Des Post-it, des icebreakers, des discussions, une bonne énergie sur le moment… puis quelques semaines plus tard, difficile de dire ce qui a réellement changé.",
  },
  {
    title: 'Les discussions tournent en rond',
    text: "Les mêmes sujets reviennent, tout semble prioritaire, les points de vue s'opposent et les décisions ont du mal à émerger.",
  },
  {
    title: 'Vous êtes trop impliqué pour faciliter vous-même',
    text: "Difficile d'exprimer votre point de vue, écouter les autres et contribuer aux décisions tout en gérant le temps, la parole, les tensions et la dynamique du groupe.",
  },
  {
    title: 'Tout le monde ne participe pas vraiment',
    text: "Quelques personnes prennent beaucoup de place, d'autres restent en retrait. La hiérarchie, les désaccords ou les non-dits peuvent empêcher le collectif de réellement travailler ensemble.",
  },
  {
    title: "L'enjeu est trop important pour improviser",
    text: "Séminaire stratégique, transformation, décision structurante, lancement de projet… Vous mobilisez parfois des dizaines de personnes. Vous voulez que ce temps produise autre chose qu'une belle journée ensemble.",
  },
];

const includes = ['Les entretiens de cadrage', 'La conception du déroulé', 'Le choix des méthodes', 'La préparation des supports', 'La facilitation du jour J', 'La facilitation graphique', 'La synthèse des résultats', 'Le débrief et les prochaines étapes'];

const basics = [
  {
    title: 'Le bon ratio de facilitation',
    texts: [
      "Pour que chacun soit vraiment vu, entendu et actif dans les échanges, je facilite seul jusqu'à environ 15 personnes.",
      "Au-delà, je m'appuie sur mon réseau de facilitateurs et facilitatrices partenaires pour co-animer les grands groupes, conventions ou séminaires réunissant plusieurs dizaines, voire centaines de participants.",
    ],
  },
  {
    title: 'Le bon temps de préparation',
    texts: [
      "Une journée de facilitation ne se prépare pas la veille : je compte en général une journée et demie de préparation pour une journée d'animation.",
      "Trop tôt, le contexte a le temps de changer : de nouvelles informations émergent, les priorités bougent, et une partie de la conception doit être reprise.",
      "Trop tard, il ne reste plus le temps de poser les bonnes questions ni de vérifier que les parties prenantes sont alignées : on prépare dans l'urgence, et c'est le processus qui en paie le prix.",
    ],
  },
  {
    title: "Le temps d'alignement de l'équipe de facilitation",
    texts: [
      "Dès qu'un dispositif mobilise plusieurs facilitateurs, il faut aussi le temps que l'équipe se cale : partager la même lecture des enjeux, se répartir les rôles, s'accorder sur le déroulé et anticiper ensemble les moments délicats.",
      "Ce temps d'alignement fait partie intégrante de la préparation — il ne s'improvise pas plus que le reste.",
    ],
  },
];

const prepScenarios = [
  {
    verdict: 'bad',
    label: 'Trop tôt',
    steps: ['Préparation bouclée', 'Le contexte change', 'Il faut tout reprendre', 'Séminaire'],
    outcome: 'Sous tension',
  },
  {
    verdict: 'bad',
    label: 'Trop tard',
    steps: ['Lancement tardif', 'Préparation dans l\'urgence', 'Parties prenantes pas alignées', 'Séminaire'],
    outcome: 'Sous tension',
  },
  {
    verdict: 'good',
    label: 'Le bon rythme',
    steps: ['Lancement', "1,5 jour de préparation", 'Séminaire'],
    outcome: 'Prêt, sans être sous tension',
  },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: 'Séminaire stratégique', text: 'Faire travailler un collectif sur une vision, des choix structurants ou une feuille de route.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de décision', text: 'Transformer un sujet complexe en choix clairs, compris par les personnes concernées et suivis d\'actions.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Convention ou grand groupe', text: "Faire participer un nombre important de personnes sans transformer l'événement en succession de présentations descendantes." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];

const costPoints = [
  { lead: "Le pourquoi n'est pas suffisamment clarifié.", text: "On organise un séminaire sans avoir vraiment défini le problème à traiter." },
  { lead: 'Le résultat attendu reste flou.', text: 'Informer ? Décider ? Construire ? Ce ne sont pas les mêmes processus.' },
  { lead: 'Le format est choisi avant le besoin.', text: '« On va faire un World Café »… avant de savoir ce que ça doit produire.' },
  { lead: 'Personne ne tient réellement le processus.', text: "Les plus à l'aise occupent l'espace, la convergence est précipitée." },
  { lead: 'La journée se termine sans vraie suite.', text: "Personne ne sait précisément ce qui va être utilisé, par qui et quand." },
];

const meetingStats = [
  { number: '72 %', text: 'des réunions jugées inefficaces', source: 'Atlassian' },
  { number: '55 %', text: 'des réunions se terminent sans prochaines étapes claires', source: 'Microsoft' },
  { number: '77 %', text: 'des réunions se terminent par… une nouvelle réunion à organiser', source: 'Atlassian' },
  { number: '43 %', text: 'trouvent que quelques personnes dominent les échanges', source: 'Atlassian' },
];
---

<Layout
  title="Déléguer l'animation d'un temps collectif — by Nicolas Verdot"
  description="Je conçois et j'anime votre séminaire ou atelier de bout en bout : cadrage, conception, facilitation graphique, synthèse et prochaines étapes."
  path="/offres/deleguer-animation/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: "Déléguer l'animation", path: '/offres/deleguer-animation/' },
  ]}
>
  <PageHero
    eyebrow="Déléguer l'animation · Facilitation complète"
    title="Vous me déléguez la facilitation, je conçois et j'anime de bout en bout"
    summary="Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes — sans que vous ayez à porter l'animation."
    pills={['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions']}
  />

  <div class="container hero-cta-row">
    <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
    <a href={withBase('/offres/mentoring/')} class="btn-outline">Vous préférez garder l'animation ? Voir le Mentoring</a>
  </div>

  <ClientLogoStrip />

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous avez besoin de faire avancer un collectif. Mais…</h2>
          <p>Réunir les bonnes personnes dans une salle ne suffit pas toujours à produire les bonnes décisions.</p>
        </div>
      </div>
      <div class="cards">
        {problems.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <p class="callout-statement"><strong>Votre enjeu n'est pas simplement d'organiser un atelier. C'est de créer les conditions pour que le collectif comprenne, décide et avance réellement.</strong></p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose editorial-prose">
      <p class="eyebrow">Le vrai coût</p>
      <h2>Combien coûte vraiment un mauvais atelier ?</h2>
      <p>Le coût d'un atelier ne se résume pas à la salle et au déjeuner : le premier poste de dépense, c'est le temps des personnes que vous réunissez. 40 participants mobilisés une journée, à 500 € de coût complet moyen par personne, représentent déjà :</p>

      <div class="stat-callout">
        <span class="stat-number">20 000 €</span>
        <span class="stat-label">de temps collectif mobilisé — avant même la salle, le déplacement ou la restauration</span>
      </div>

      <p class="pull-quote">« Nous investissons déjà plusieurs dizaines de milliers d'euros dans ce temps collectif. Qu'allons-nous réellement en faire ? »</p>

      <div class="stat-grid">
        {meetingStats.map((s) => (
          <div class="stat-tile">
            <span class="stat-tile-number">{s.number}</span>
            <span class="stat-tile-text">{s.text}</span>
            <span class="stat-tile-source">{s.source}</span>
          </div>
        ))}
      </div>
      <p>Le problème n'est pas de réunir des personnes. C'est de créer les conditions qui leur permettront de produire quelque chose ensemble.</p>

      <h3>Un atelier perd souvent de la valeur avant même le jour J</h3>
      <ul class="cost-list">
        {costPoints.map((c) => (
          <li><strong>{c.lead}</strong> {c.text}</li>
        ))}
      </ul>

      <p class="pull-quote">« La dernière fois, on a mis des Post-it partout… et ça n'a servi à rien. »</p>
      <p>Je l'entends régulièrement. Le problème n'était probablement pas le Post-it — c'était ce qu'on lui avait demandé de faire, sans savoir comment le résultat serait utilisé. Et le prochain atelier commence déjà avec une dette : scepticisme, désengagement, impression de « refaire encore la même chose ».</p>

      <div class="stat-callout">
        <span class="stat-number">2 850 €</span>
        <span class="stat-label">de temps de travail par heure collective — pour ces mêmes 40 personnes</span>
      </div>

      <p>Une heure passée sur une consigne mal comprise ou une discussion qui tourne en boucle n'est pas seulement frustrante : elle a un coût. Et le plus important n'est parfois même pas celui de cette journée, mais de repartir sans décision, de devoir recommencer, ou de rendre le collectif un peu plus sceptique la prochaine fois qu'on lui proposera de « travailler ensemble ».</p>
      <p>La facilitation ne sert pas à mettre de l'animation dans un séminaire. Elle sert à sécuriser l'investissement que représente ce temps collectif.</p>
      <p class="callout-statement"><strong>Un atelier réussi ne se mesure pas au nombre de Post-it produits. Il se mesure à ce que le collectif est capable d'en faire.</strong></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container prose editorial-prose">
      <p class="eyebrow">Ce que je prends en charge</p>
      <h2>Un accompagnement avant, pendant et après</h2>
      <p>Déléguer la facilitation, ce n'est pas simplement confier l'animation d'une journée.</p>
      <p>C'est se faire accompagner pour comprendre ce qui doit réellement être travaillé, concevoir le bon processus, créer les conditions pour que le collectif puisse produire quelque chose d'utile… et tirer les enseignements de ce qui s'est passé.</p>

      <div class="steps-grid">
        <div class="step-card">
          <h3 id="avant"><span class="step-num">01</span> Avant</h3>
          <p>Avant la méthode, il faut comprendre la situation : pourquoi ce collectif, pour produire quoi, et comment ce sera utilisé ensuite. Je regarde aussi le vécu des participants et leur expérience passée de l'intelligence collective — un collectif échaudé par des ateliers sans suite ne part pas de zéro. Cette phase sert aussi à <strong>réparer le sens</strong> avant de le relancer dans un nouveau processus.</p>
        </div>
        <div class="step-card">
          <h3 id="concevoir"><span class="step-num">02</span> Concevoir</h3>
          <p>Je ne pars pas d'un catalogue de méthodes. Je construis avec vous le <strong>macro-déroulé</strong> — les grandes étapes et leur ordre — puis le <strong>micro-déroulé</strong> : questions, consignes, temps, composition des groupes, restitution. Le visuel n'est pas décoratif : il sert à <strong>donner à voir</strong> et laisser une trace exploitable, pas une pile de Post-it et des photos de téléphone.</p>
        </div>
        <div class="step-card">
          <h3 id="pendant"><span class="step-num">03</span> Pendant</h3>
          <p>Le jour J commence par le sens : pourquoi sommes-nous là, qu'est-ce qui est déjà décidé, qu'est-ce qui est réellement ouvert ? Faire participer sur une décision déjà prise crée plus de frustration que d'engagement. Ensuite, je tiens le processus — temps, parole, divergences, convergence — et j'adapte si la salle ne correspond plus au déroulé. Vous restez pleinement dans votre rôle.</p>
        </div>
        <div class="step-card">
          <h3 id="apres"><span class="step-num">04</span> Après</h3>
          <p>La facilitation ne s'arrête pas quand la salle se vide. Un débrief revient sur les moments forts et ce qui a freiné le collectif — et surtout : <strong>qu'est-ce que cette journée nous apprend sur ce qu'il faut faire ensuite ?</strong> Le séminaire devient une étape dans un processus plus large, pas un événement isolé.</p>
        </div>
      </div>

      <div class="panel includes-panel">
        <h3>Ce que vous me déléguez</h3>
        <ul class="includes-list">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
        <p class="muted"><strong>Idéal si :</strong> le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.</p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards">
        {basics.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            {b.texts.map((t) => <p>{t}</p>)}
          </article>
        ))}
      </div>

      <div class="prep-timeline">
        <p class="prep-timeline-caption">Le bon temps de préparation, en image</p>
        {prepScenarios.map((s) => (
          <div class={`prep-scenario prep-scenario-${s.verdict}`}>
            <span class="prep-scenario-label">
              <span aria-hidden="true">{s.verdict === 'good' ? '✓' : '✗'}</span> {s.label}
            </span>
            <div class="prep-steps">
              {s.steps.map((step, i) => (
                <>
                  <span class="prep-step">{step}</span>
                  {i < s.steps.length - 1 && <span class="prep-arrow" aria-hidden="true">→</span>}
                </>
              ))}
            </div>
            <span class="prep-outcome">{s.outcome}</span>
          </div>
        ))}
      </div>

      <p class="callout-statement"><strong>Vous n'achetez pas des heures de facilitation. Vous investissez dans la capacité de votre équipe à avancer réellement — à mettre en balance le coût, souvent invisible, d'un collectif qui piétine, et la valeur d'une dynamique vraiment lancée, ancrée et durable.</strong></p>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel et les contraintes."
    ctaLabel="Réserver un échange de cadrage"
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: var(--space-8);
  }
  .callout-statement {
    margin: var(--space-8) auto 0;
    max-width: 640px;
    text-align: center;
    font-size: var(--text-xl);
    color: var(--color-navy);
  }
  .pull-quote {
    margin: var(--space-8) 0;
    padding-left: var(--space-6);
    border-left: 4px solid var(--color-orange);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-navy);
  }
  .stat-callout {
    margin: var(--space-8) 0;
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--color-blue), var(--color-blue-strong));
    text-align: center;
  }
  .stat-callout .stat-number {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    color: var(--color-orange);
    line-height: 1;
  }
  .stat-callout .stat-label {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }
  .cost-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .cost-list li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--color-muted);
  }
  .cost-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 10px;
    height: 3px;
    background: var(--color-brick);
    border-radius: 2px;
  }
  .cost-list strong {
    display: block;
    color: var(--color-navy);
  }
  .card p:not(:last-child) {
    margin-bottom: var(--space-3);
  }
  .prep-timeline {
    margin-top: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-md);
    background: linear-gradient(145deg, var(--color-blue), var(--color-blue-strong));
    display: grid;
    gap: var(--space-4);
  }
  .prep-timeline-caption {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }
  .prep-scenario {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .prep-scenario-label {
    flex-shrink: 0;
    min-width: 130px;
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-white);
  }
  .prep-scenario-bad .prep-scenario-label span:first-child {
    color: var(--color-red-bright);
  }
  .prep-scenario-good .prep-scenario-label span:first-child {
    color: var(--color-orange);
  }
  .prep-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
  }
  .prep-step {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .prep-arrow {
    color: rgba(255, 255, 255, 0.45);
    font-weight: 700;
  }
  .prep-outcome {
    flex-shrink: 0;
    margin-left: auto;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
  }
  .prep-scenario-bad .prep-outcome {
    color: var(--color-red-bright);
    background: rgba(227, 67, 53, 0.18);
  }
  .prep-scenario-good .prep-outcome {
    color: var(--color-orange);
    background: rgba(255, 203, 0, 0.18);
  }
  @media (max-width: 640px) {
    .prep-scenario {
      flex-direction: column;
      align-items: flex-start;
    }
    .prep-outcome {
      margin-left: 0;
    }
  }
  .muted {
    color: var(--color-muted);
  }
  .includes-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
  }
  .includes-list li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--color-ink);
  }
  .includes-list li::before {
    content: '— ';
    color: var(--color-orange-ink);
  }
  .steps-grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .step-card {
    padding: var(--space-6);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .step-card p {
    margin: 0;
    color: var(--color-muted);
  }
  .step-card h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    padding: 0;
    border: none;
    font-size: var(--text-lg);
