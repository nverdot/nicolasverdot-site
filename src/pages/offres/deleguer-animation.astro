const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];

const costPoints = [
  {
    lead: "Le pourquoi n'est pas suffisamment clarifié.",
    text: "On organise « un séminaire d'équipe » ou « un atelier d'alignement » sans avoir vraiment défini le problème à traiter ni ce qui doit être différent à la fin.",
  },
  {
