---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-coaching-professionnel.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Coaching professionnel',
  name: 'Coaching professionnel',
  description:
    "Un coaching professionnel pour travailler la posture, les interactions, les croyances et la sécurité intérieure, avec une approche intégrant le corps et l'esprit.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/coaching-professionnel/'), Astro.site).toString(),
};

const situations = [
  { num: 'Posture', title: 'Une posture qui ne vous ressemble plus', text: 'Vous portez beaucoup, vous contrôlez davantage que vous ne le voudriez ou vous avez du mal à poser un cadre clair.' },
  { num: 'Tensions', title: 'Des tensions récurrentes', text: 'Une relation avec un collaborateur, un pair ou votre hiérarchie vous met régulièrement sous pression.' },
  { num: 'Équipe', title: "Une équipe que vous n'arrivez plus à mobiliser", text: "Vous multipliez les efforts, mais l'engagement ne suit pas et vous ne savez plus quoi changer." },
  { num: 'Transition', title: 'Une prise de poste ou un changement de rôle', text: 'Vous devez trouver une nouvelle manière d\'exister dans le système, sans reproduire vos anciens réflexes.' },
  { num: 'Décision', title: 'Une décision que vous repoussez', text: 'Vous connaissez les options, mais quelque chose bloque au moment de choisir ou d\'assumer les conséquences.' },
  { num: 'Énergie', title: 'Une fatigue de fond', text: 'Vous continuez à fonctionner, mais vous sentez que votre corps, votre attention ou vos émotions tirent le frein.' },
];

const topics = [
  'Trouver votre posture de leader', 'Poser un cadre clair', 'Dire non sans rompre la relation',
  'Gérer les tensions et les conflits', 'Préparer une conversation difficile', 'Renforcer votre confiance',
  'Sortir du surcontrôle', 'Déléguer réellement', 'Prendre une décision complexe',
  'Faire face à la pression', 'Réguler votre système nerveux', 'Traverser une prise de poste',
];

const steps = [
  'Premier échange pour comprendre votre situation et vérifier si le coaching est adapté',
  "Définition de l'objectif et du cadre de l'accompagnement",
  'Séances de travail à partir de situations réelles',
  'Mise en pratique entre les séances, dans votre contexte',
  'Ajustement et clôture pour consolider votre autonomie',
];

const principles = [
  { title: 'Un espace confidentiel', text: 'Un lieu où vous pouvez parler librement, sans avoir à protéger votre image ou votre rôle.' },
  { title: 'Un regard direct', text: 'Je ne cherche pas à vous rassurer à tout prix. Je vous aide à regarder ce qui est là, avec respect et franchise.' },
  { title: 'Pas de recette toute faite', text: 'Le travail part de votre contexte, de votre personnalité et de ce qui est possible pour vous.' },
  { title: 'Votre autonomie comme objectif', text: 'Le coaching doit vous rendre plus libre, pas dépendant de l\'accompagnement.' },
];

const faqs = [
  { q: 'Le coaching est-il adapté si je n\'ai pas de problème précis ?', a: 'Oui, mais il est utile d\'identifier une situation, une tension ou une évolution souhaitée pour donner une direction au travail.' },
  { q: 'Quelle est la différence avec du conseil ?', a: 'En conseil, je peux proposer des recommandations. En coaching, je vous aide à comprendre votre situation, faire émerger vos propres choix et développer votre capacité à agir.' },
  { q: 'Est-ce une thérapie ?', a: 'Non. Le coaching professionnel travaille sur des objectifs liés à votre vie professionnelle, votre posture et vos actions. Il ne remplace pas un accompagnement thérapeutique, psychologique ou médical.' },
  { q: "Qu'est-ce que la théorie polyvagale ?", a: 'Une grille de lecture du fonctionnement du système nerveux autonome et de nos réponses face à la sécurité, au danger ou à la pression. Je l\'utilise comme approche complémentaire, pas comme un diagnostic.' },
  { q: 'Le coaching peut-il être financé par mon entreprise ?', a: 'Oui, dans certains cas. Un contrat tripartite peut être mis en place avec l\'entreprise, tout en préservant la confidentialité des séances.' },
  { q: 'Est-ce confidentiel ?', a: 'Oui. Le contenu des séances reste confidentiel. Dans un accompagnement financé par une entreprise, les objectifs peuvent être partagés, mais pas le contenu des échanges sans votre accord.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Coaching professionnel — by Nicolas Verdot"
  description="Un coaching professionnel pour travailler la posture, les interactions, les croyances et la sécurité intérieure, avec une approche intégrant le corps et l'esprit."
  path="/offres/coaching-professionnel/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: 'Coaching professionnel', path: '/offres/coaching-professionnel/' },
  ]}
>
  <PageHero
    eyebrow="Coaching professionnel · Posture · Leadership"
    title="Vous êtes compétent."
    titleAccent="Mais quelque chose coince."
    summary="Dans votre posture, dans vos interactions, dans la manière dont vous tenez votre équipe ou traversez les tensions. Nous travaillons sur ce qui se passe réellement : <strong>les croyances</strong>, <strong>les réactions automatiques</strong>, la sécurité intérieure et les choix que vous n'arrivez plus à poser seul."
    pills={['Sur devis', '100 % individuel', 'En ligne ou en présentiel']}
    image={heroImg}
    imageAlt="Deux personnes assises en conversation, l'une prenant des notes dans un carnet, ambiance calme et posée."
    tall
  />

  <section class="section" data-reveal>
    <div class="container split">
      <div>
        <p class="eyebrow">Situations</p>
        <h2>Vous vous reconnaissez dans une ou plusieurs de ces situations ?</h2>
        <div class="checks">
          {situations.map((s) => (
            <div class="check"><i>✓</i><div><strong>{s.title}</strong><br /><span class="muted">{s.text}</span></div></div>
          ))}
        </div>
      </div>
      <div class="quote">
        <blockquote>Parfois, vous savez déjà ce qu'il faudrait faire. Le vrai sujet est ce qui vous empêche de le faire sereinement.</blockquote>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Promesse</p>
      <h2>Retrouver de la liberté dans votre manière d'agir</h2>
      <p class="hero-copy">Le coaching ne consiste pas à vous donner une liste de conseils. Il crée un espace pour observer votre situation avec plus de recul, comprendre les mécanismes qui se répètent et expérimenter d'autres façons d'agir — sur ce que vous pensez, ce que vous ressentez, ce que votre corps signale et ce que vous évitez.</p>
    </div>
  </section>

  <section class="section dark" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Approche corps-esprit</p>
      <h2>Quand les outils seuls ne suffisent plus</h2>
      <p>Nous pouvons comprendre intellectuellement une situation et pourtant continuer à réagir de la même manière. Sous pression, le système nerveux peut nous pousser à nous battre, fuir, nous figer ou nous couper de ce que nous ressentons.</p>
      <p>J'intègre une approche corps-esprit inspirée de la théorie polyvagale pour vous aider à repérer votre état interne, comprendre ce qui déclenche certaines réactions, retrouver davantage de sécurité et choisir une réponse plutôt que subir un automatisme.</p>
      <p class="fine">Cette approche ne remplace pas un suivi médical, psychologique ou thérapeutique lorsqu'il est nécessaire.</p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Sujets</p>
      <h2>Ce sur quoi nous pouvons travailler</h2>
      <div class="tool-tags">
        {topics.map((t) => <span class="tool-tag">{t}</span>)}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <p class="eyebrow">Déroulé</p>
      <h2>Comment se déroule le coaching ?</h2>
      <div class="timeline">
        {steps.map((step, i) => (
          <div class="timeline-item"><span>{i + 1}</span><strong>{step}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Principes</p>
          <h2>Ce que vous pouvez attendre de moi</h2>
        </div>
      </div>
      <div class="cards">
        {principles.map((p) => (
          <article class="card">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Format & tarif</p>
        <h2>Un accompagnement adapté à votre rythme</h2>
        <p class="muted"><strong>Coaching ciblé</strong> — quelques séances pour travailler une situation précise : prise de décision, conflit, posture, prise de poste ou conversation difficile.</p>
        <p class="muted"><strong>Coaching dans la durée</strong> — un accompagnement sur plusieurs mois pour faire évoluer en profondeur votre posture, vos relations et vos modes de fonctionnement.</p>
        <p class="muted">Séances individuelles, en visioconférence ou en présentiel, fréquence définie ensemble. Sur devis.</p>
        <a class="btn" href={withBase('/contact/')}>Prendre un premier rendez-vous</a>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose">
      <p class="eyebrow">FAQ</p>
      <h2>Questions fréquentes</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Vous n'avez pas besoin de devenir quelqu'un d'autre"
    title="Vous avez peut-être besoin de retrouver de la marge de manœuvre."
    subtitle="Prenons un premier temps pour regarder ce qui se passe, ce que vous voulez faire évoluer et si je suis la bonne personne pour vous accompagner."
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .muted {
    color: var(--color-muted);
  }
  .panel .btn {
    margin-top: var(--space-4);
  }
</style>
