---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-coaching-professionnel.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Coaching professionnel',
  name: 'Coaching professionnel',
  description:
    "Un coaching professionnel pour travailler la posture, les interactions, les croyances et la sécurité intérieure, avec une approche intégrant le corps et l'esprit.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/coaching-professionnel/'), Astro.site).toString(),
};

const icons: Record<string, string> = {
  compass: '<path d="M4 17c2.5-6 5 6 8 0s4.5-5 8 0"/><circle cx="4" cy="17" r="1" fill="currentColor" stroke="none"/><circle cx="20" cy="17" r="1" fill="currentColor" stroke="none"/>',
  heart: '<path d="M12 21s-7.5-4.6-10-9.3C.4 8.6 2.3 5 6 5c2 0 3.5 1.1 4.3 2.4C11.1 6.1 12.6 5 14.6 5c3.7 0 5.6 3.6 4 6.7C19.5 16.4 12 21 12 21z"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9.5 12l2 2 3-3.5"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  door: '<path d="M6 3h9v18H6z"/><path d="M15 3l4 1.5v15L15 21"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>',
  megaphone: '<path d="M3 11v2a2 2 0 0 0 2 2h1l3 5V4L6 9H5a2 2 0 0 0-2 2z"/><path d="M14 8a4 4 0 0 1 0 8"/><path d="M17 5a8 8 0 0 1 0 14"/>',
  network: '<circle cx="6" cy="6" r="2.3"/><circle cx="18" cy="6" r="2.3"/><circle cx="12" cy="18" r="2.3"/><path d="M8 7l3.2 9M16 7l-3.2 9M8.3 6h7.4"/>',
  ear: '<path d="M9 17.5c-2.5 0-4.5-2-4.5-4.5S6.5 8.5 9 8.5c2 0 3.5 1.3 4 3"/><path d="M9 8.5A5.5 5.5 0 1 1 9 19.5"/><path d="M12 12.5c0 1.4-1.1 2.5-2.5 2.5"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8.5 11h7M8.5 15h7"/>',
  pencil: '<path d="M4 20l1-4.2L15.8 5 19 8.2 8.2 19 4 20z"/><path d="M13.5 6.5l4 4"/>',
  gift: '<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 9v-1a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1"/><path d="M12 9v12"/><path d="M12 9c-1.5-4-6-5-6-2 0 1.5 2 2 6 2z"/><path d="M12 9c1.5-4 6-5 6-2 0 1.5-2 2-6 2z"/>',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  bulb: '<path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.5 1 1.3 1 2.1V16h6v-1.4c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 2z"/>',
};

const valueItems = [
  { icon: 'compass', title: 'Retrouver un cap clair', text: 'Sortir du brouillard pour voir plus clairement ce qui se joue et ce que vous voulez faire évoluer.' },
  { icon: 'heart', title: 'Reconnecter corps et tête', text: 'Comprendre ce que votre corps signale, avant que la tension ne prenne toute la place.' },
  { icon: 'shield', title: 'Retrouver de la sécurité intérieure', text: 'Sortir des réactions automatiques pour choisir votre réponse plutôt que la subir.' },
  { icon: 'target', title: 'Agir avec plus de liberté', text: 'Poser un cadre, dire non, décider — sans reproduire les mêmes blocages.' },
];

const problems = [
  { icon: 'door', title: 'Une posture qui ne vous ressemble plus', text: 'Vous portez beaucoup, vous contrôlez davantage que vous ne le voudriez, ou vous avez du mal à poser un cadre clair.' },
  { icon: 'megaphone', title: 'Des tensions récurrentes', text: 'Une relation avec un collaborateur, un pair ou votre hiérarchie vous met régulièrement sous pression.' },
  { icon: 'network', title: "Une équipe que vous n'arrivez plus à mobiliser", text: "Vous multipliez les efforts, mais l'engagement ne suit pas et vous ne savez plus quoi changer." },
  { icon: 'compass', title: 'Une prise de poste ou un changement de rôle', text: "Vous devez trouver une nouvelle manière d'exister dans le système, sans reproduire vos anciens réflexes." },
  { icon: 'target', title: 'Une décision que vous repoussez', text: 'Vous connaissez les options, mais quelque chose bloque au moment de choisir ou d\'assumer les conséquences.' },
  { icon: 'heart', title: 'Une fatigue de fond', text: 'Vous continuez à fonctionner, mais vous sentez que votre corps, votre attention ou vos émotions tirent le frein.' },
];

const costSigns = [
  'Le même conflit ou la même tension revient, sous une autre forme.',
  'Vous remettez la décision à plus tard, encore et encore.',
  "Votre entourage professionnel commence à s'adapter à votre fonctionnement plutôt que l'inverse.",
  'La fatigue de fond devient votre état par défaut.',
];

const takeCharge = [
  {
    icon: 'ear',
    title: 'Échange initial',
    text: 'Un premier échange pour comprendre votre situation et vérifier si le coaching est adapté.',
    subtitle: 'Vérifier que le coaching est la bonne réponse',
    detail: [
      "Avant de nous engager, j'ai besoin de comprendre votre situation : ce qui se répète, ce que vous avez déjà essayé, et ce que vous cherchez à faire évoluer.",
      "C'est aussi le moment de vérifier ensemble que le coaching est la bonne réponse. Si votre sujet relève davantage d'un accompagnement thérapeutique, médical ou psychologique, je vous le dirai directement.",
      "Si l'accompagnement est envisagé avec un financement par votre entreprise, on aborde aussi ce point : ce qui peut être partagé avec elle (les objectifs) et ce qui reste strictement confidentiel (le contenu des séances).",
    ],
  },
  {
    icon: 'clipboard',
    title: 'Cadrage',
    text: "Définition de l'objectif et du cadre de l'accompagnement.",
    subtitle: 'Poser un cadre clair avant de commencer',
    detail: [
      "Un coaching sans cadre clair perd vite en efficacité. On définit ensemble l'objectif de travail, le format le plus adapté — coaching ciblé sur une situation précise, ou coaching dans la durée pour un travail plus profond — et le rythme des séances.",
      "Si un contrat tripartite avec votre entreprise est nécessaire, c'est à ce moment qu'il est mis en place, dans le respect de la confidentialité des séances.",
      "Ce cadre n'est pas figé : il peut être ajusté en cours de route si votre situation évolue.",
    ],
  },
  {
    icon: 'pencil',
    title: 'Séances de travail',
    text: 'Des séances construites à partir de situations réelles que vous vivez.',
    subtitle: 'Travailler à partir de ce qui se passe réellement',
    detail: [
      "Chaque séance part d'une situation concrète que vous traversez — une tension, une décision, une interaction difficile — plutôt que d'exercices génériques déconnectés de votre quotidien.",
      "J'intègre une approche corps-esprit inspirée de la théorie polyvagale : au-delà de ce que vous pensez, on regarde aussi ce que votre corps signale et les réactions automatiques qui se déclenchent sous pression.",
      "L'objectif n'est pas de vous rassurer à tout prix, mais de vous aider à regarder ce qui est là, avec respect et franchise.",
    ],
  },
  {
    icon: 'network',
    title: 'Mise en pratique',
    text: 'Vous testez de nouvelles façons d\'agir directement dans votre contexte, entre les séances.',
    subtitle: 'Le vrai travail se passe entre les séances',
    detail: [
      "Ce qui se travaille en séance n'a de valeur que si vous pouvez le tester dans votre réalité : une conversation à mener autrement, un cadre à poser, une décision à assumer.",
      "Entre les séances, vous expérimentez dans votre contexte. On revient ensuite sur ce qui a fonctionné, ce qui a résisté et ce qu'il faut ajuster.",
      "C'est cet aller-retour entre séance et terrain qui fait bouger durablement les choses — pas la seule discussion en salle.",
    ],
  },
  {
    icon: 'gift',
    title: 'Ajustement et clôture',
    text: 'Un temps pour consolider ce qui a changé et gagner en autonomie.',
    subtitle: 'Terminer sans dépendance à l\'accompagnement',
    detail: [
      "Le coaching doit vous rendre plus libre, pas dépendant de l'accompagnement. La clôture est un temps dédié pour consolider ce qui a changé dans votre posture et vos façons d'agir.",
      "On revient ensemble sur le chemin parcouru depuis le premier échange, et sur ce qui vous appartient désormais pour continuer seul.",
      "Si de nouveaux sujets émergent par la suite, rien n'empêche de reprendre un accompagnement ciblé plus tard.",
    ],
  },
];

const basics = [
  { icon: 'network', title: 'Deux formats possibles', text: 'Coaching ciblé (quelques séances sur une situation précise) ou coaching dans la durée (plusieurs mois, pour une transformation plus profonde).' },
  { icon: 'lock', title: '100 % confidentiel', text: 'Le contenu des séances reste confidentiel, même dans un accompagnement financé par votre entreprise.' },
  { icon: 'target', title: 'Sur devis', text: 'Séances individuelles, en visioconférence ou en présentiel, fréquence définie ensemble.' },
];

const timingBrackets = [
  { color: 'navy', duration: 'Quelques jours', text: 'Un premier échange peut être programmé rapidement pour vérifier que le coaching est adapté à votre situation.' },
  { color: 'blue', duration: '3 à 6 séances', text: 'Un coaching ciblé sur une situation précise : décision, conflit, prise de poste, conversation difficile.' },
  { color: 'clay', duration: '3 à 6 mois', text: 'Un coaching dans la durée pour faire évoluer en profondeur votre posture et vos modes de fonctionnement.' },
  { color: 'brick', duration: 'Financement entreprise', text: "Prévoir un temps d'échange avec les RH pour mettre en place un contrat tripartite si nécessaire." },
];

const topics = [
  'Trouver votre posture de leader', 'Poser un cadre clair', 'Dire non sans rompre la relation',
  'Gérer les tensions et les conflits', 'Préparer une conversation difficile', 'Renforcer votre confiance',
  'Sortir du surcontrôle', 'Déléguer réellement', 'Prendre une décision complexe',
  'Faire face à la pression', 'Réguler votre système nerveux', 'Traverser une prise de poste',
];

const faqs = [
  { q: "Le coaching est-il adapté si je n'ai pas de problème précis ?", a: "Oui, mais il est utile d'identifier une situation, une tension ou une évolution souhaitée pour donner une direction au travail." },
  { q: 'Quelle est la différence avec du conseil ?', a: 'En conseil, je peux proposer des recommandations. En coaching, je vous aide à comprendre votre situation, faire émerger vos propres choix et développer votre capacité à agir.' },
  { q: 'Est-ce une thérapie ?', a: "Non. Le coaching professionnel travaille sur des objectifs liés à votre vie professionnelle, votre posture et vos actions. Il ne remplace pas un accompagnement thérapeutique, psychologique ou médical." },
  { q: "Qu'est-ce que la théorie polyvagale ?", a: "Une grille de lecture du fonctionnement du système nerveux autonome et de nos réponses face à la sécurité, au danger ou à la pression. Je l'utilise comme approche complémentaire, pas comme un diagnostic." },
  { q: 'Le coaching peut-il être financé par mon entreprise ?', a: 'Oui, dans certains cas. Un contrat tripartite peut être mis en place avec l\'entreprise, tout en préservant la confidentialité des séances.' },
  { q: 'Est-ce confidentiel ?', a: 'Oui. Le contenu des séances reste confidentiel. Dans un accompagnement financé par une entreprise, les objectifs peuvent être partagés, mais pas le contenu des échanges sans votre accord.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Coaching professionnel — by Nicolas Verdot"
  description="Un coaching professionnel pour travailler la posture, les interactions, les croyances et la sécurité intérieure, avec une approche intégrant le corps et l'esprit."
  path="/offres/coaching-professionnel/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: 'Coaching professionnel', path: '/offres/coaching-professionnel/' },
  ]}
>
  <section class="hero-bg" data-reveal>
    <Image src={heroImg} alt="Deux personnes assises en conversation, l'une prenant des notes dans un carnet, ambiance calme et posée." widths={[800, 1400, 2000]} sizes="100vw" class="hero-bg-img" />
    <div class="hero-bg-scrim" aria-hidden="true"></div>
    <div class="hero-bg-inner">
      <div class="hero-bg-copy">
        <p class="eyebrow">Coaching professionnel · Posture · Leadership</p>
        <h1>
          Vous êtes compétent.
          <span class="script-accent">Mais quelque chose coince.</span>
          <span class="hero-tail">Retrouvons ensemble votre marge de manœuvre.</span>
        </h1>
        <p class="page-summary">Dans votre posture, dans vos interactions, dans la manière dont vous tenez votre équipe ou traversez les tensions. Nous travaillons sur ce qui se passe réellement : <strong>les croyances</strong>, <strong>les réactions automatiques</strong>, la sécurité intérieure et les choix que vous n'arrivez plus à poser seul.</p>
        <div class="meta-pills">
          {['Sur devis', '100 % individuel', 'En ligne ou en présentiel'].map((pill) => <span>{pill}</span>)}
        </div>
        <div class="hero-cta-row">
          <a href={withBase('/contact/')} class="btn">Prendre un premier rendez-vous →</a>
          <a href={withBase('/offres/mentoring/')} class="btn-outline">Besoin d'accompagner un collaborateur ? Voir Mentoring</a>
        </div>
      </div>
    </div>
  </section>

  <section class="value-band" data-reveal data-section-name="Pourquoi un coaching">
    <div class="container value-band-inner">
      <h2>
        Vous savez déjà quoi faire.
        <span class="accent-wrap">
          Le vrai sujet est ce qui vous empêche de le faire sereinement.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="value-grid">
        {valueItems.map((v) => (
          <div class="value-item">
            <svg class="value-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[v.icon]} />
            <strong>{v.title}</strong>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ClientLogoStrip />

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Vous vous reconnaissez dans une ou plusieurs de ces situations ?</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {problems.map((p) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="callout-box">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.bulb} /></span>
        <p><strong>Parfois, vous savez déjà ce qu'il faudrait faire.</strong><br /><span class="accent">Le vrai sujet est ce qui vous empêche de le faire sereinement.</span></p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le vrai coût d'une situation qui s'enkyste</p>
        </div>
      </div>
      <div class="cost-columns">
        <div class="cost-col cost-col-highlight">
          <h3>Votre énergie et votre poste ont une vraie valeur</h3>
          <p>Le temps que vous passez sous tension, à contrôler ou à éviter un sujet, a un coût réel — pour vous et pour ceux qui vous entourent.</p>
          <p><strong>Sans un espace pour le travailler, ce coût continue de s'accumuler.</strong></p>
        </div>
        <div class="cost-col">
          <h3>Les signes qu'une situation s'enkyste</h3>
          <ol class="cost-numbered">
            {costSigns.map((c) => <li>{c}</li>)}
          </ol>
        </div>
        <div class="cost-col">
          <h3>Pourquoi ça ne se résout pas seul</h3>
          <p>Un système sous tension a tendance à répéter les mêmes réponses. Sans un regard extérieur et un espace dédié, il est difficile de sortir seul de ce qui se rejoue.</p>
        </div>
      </div>
      <div class="callout-box callout-box-row">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.heart} /></span>
        <p>Parlons de votre situation pour voir si le coaching peut vous aider à en sortir.</p>
        <a href={withBase('/contact/')} class="btn">Prendre un premier rendez-vous →</a>
      </div>
    </div>
  </section>

  <section class="section dark" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Approche corps-esprit</p>
      <h2>Quand les outils seuls ne suffisent plus</h2>
      <p>Nous pouvons comprendre intellectuellement une situation et pourtant continuer à réagir de la même manière. Sous pression, le système nerveux peut nous pousser à nous battre, fuir, nous figer ou nous couper de ce que nous ressentons.</p>
      <p>J'intègre une approche corps-esprit inspirée de la théorie polyvagale pour vous aider à repérer votre état interne, comprendre ce qui déclenche certaines réactions, retrouver davantage de sécurité et choisir une réponse plutôt que subir un automatisme.</p>
      <p class="fine">Cette approche ne remplace pas un suivi médical, psychologique ou thérapeutique lorsqu'il est nécessaire.</p>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Sujets</p>
      <h2>Ce sur quoi nous pouvons travailler</h2>
      <div class="tool-tags">
        {topics.map((t) => <span class="tool-tag">{t}</span>)}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Déroulé</p>
          <h2>Comment se déroule le coaching ?</h2>
        </div>
      </div>
      <div class="phase-timeline" aria-hidden="true">
        {takeCharge.map((_t, i) => (
          <>
            <span class="phase-timeline-dot">{i + 1}</span>
            {i < takeCharge.length - 1 && <span class="phase-timeline-line"></span>}
          </>
        ))}
      </div>
      <div class="take-charge-grid">
        {takeCharge.map((t) => (
          <button type="button" class="take-charge-card" data-phase-trigger={t.title}>
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <span class="take-charge-more">En savoir plus →</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {takeCharge.map((t, i) => (
    <div class="phase-modal" data-phase-modal={t.title} hidden>
      <div class="phase-modal-backdrop" data-phase-modal-close></div>
      <div class="phase-modal-panel" role="dialog" aria-modal="true" aria-labelledby={`phase-modal-title-${i}`}>
        <button type="button" class="phase-modal-close" data-phase-modal-close aria-label="Fermer">✕</button>
        <span class="take-charge-num phase-modal-num">{i + 1}</span>
        <p class="eyebrow">{t.title}</p>
        <h3 id={`phase-modal-title-${i}`}>{t.subtitle}</h3>
        {t.detail.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </div>
  ))}

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {basics.map((b) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Combien de temps">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Planification</p>
          <h2>Combien de temps faut-il prévoir ?</h2>
        </div>
      </div>

      <div class="timing-intro">
        <p class="timing-intro-lead">Un premier échange peut être programmé sous quelques jours</p>
        <p>La durée de l'accompagnement dépend de votre objectif — d'une situation précise à travailler en quelques séances, à un travail plus profond sur plusieurs mois.</p>
      </div>

      <h3 class="timing-subhead">Le bon timing</h3>
      <div class="timing-grid">
        {timingBrackets.map((t) => (
          <div class={`timing-item timing-item-${t.color}`}>
            <span class="timing-duration">{t.duration}</span>
            <span class="timing-text">{t.text}</span>
          </div>
        ))}
      </div>

      <div class="timing-callout">
        <p class="timing-callout-title">Vous ne savez pas encore quel format vous convient ?</p>
        <p>C'est justement l'objet du premier échange : identifier ensemble le format le plus adapté à votre situation.</p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose">
      <p class="eyebrow">FAQ</p>
      <h2>Questions fréquentes</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Vous n'avez pas besoin de devenir quelqu'un d'autre"
    title="Vous avez peut-être besoin de retrouver de la marge de manœuvre."
    subtitle="Prenons un premier temps pour regarder ce qui se passe, ce que vous voulez faire évoluer et si je suis la bonne personne pour vous accompagner."
    ctaLabel="Prendre un premier rendez-vous"
    dark
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-phase-trigger]'));
  const modals = Array.from(document.querySelectorAll<HTMLElement>('[data-phase-modal]'));

  function openModal(name: string) {
    const modal = modals.find((m) => m.dataset.phaseModal === name);
    if (!modal) return;
    modal.hidden = false;
    document.body.classList.add('case-modal-lock-scroll');
  }

  function closeModal(modal: HTMLElement) {
    modal.hidden = true;
    if (!modals.some((m) => !m.hidden)) {
      document.body.classList.remove('case-modal-lock-scroll');
    }
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const name = trigger.dataset.phaseTrigger;
      if (name) openModal(name);
    });
  });

  modals.forEach((modal) => {
    modal.querySelectorAll('[data-phase-modal-close]').forEach((el) => {
      el.addEventListener('click', () => closeModal(modal));
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach((modal) => {
        if (!modal.hidden) closeModal(modal);
      });
    }
  });
</script>
