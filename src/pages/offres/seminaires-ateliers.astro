---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Séminaires et ateliers de facilitation',
  name: 'Séminaires et ateliers de facilitation',
  description:
    "Concevoir et faciliter des séminaires qui font réellement avancer les équipes : intelligence collective, facilitation graphique, trois niveaux d'accompagnement selon ce que vous souhaitez garder en interne.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/seminaires-ateliers/'), Astro.site).toString(),
};

const pains = [
  'Un programme trop chargé et peu participatif',
  'Des prises de parole interminables',
  'Beaucoup d\'idées, mais aucune vraie décision',
  'Des participants qui décrochent',
  'Une énergie positive qui retombe dès le lendemain',
  'Des engagements qui ne sont jamais suivis',
];

const bring = [
  {
    title: "Facilitation d'intelligence collective",
    text: "Je construis un processus qui permet aux participants de comprendre, contribuer, confronter leurs points de vue, décider et agir. Ce n'est pas simplement « faire participer » : chaque méthode est choisie en fonction de l'objectif recherché.",
  },
  {
    title: 'Facilitation graphique',
    text: 'Les idées, tensions, décisions et prochaines étapes deviennent visibles au fur et à mesure. Elle permet de maintenir l\'attention, de rendre les échanges plus accessibles, de construire une compréhension commune et de conserver une mémoire utile du séminaire.',
  },
  {
    title: 'Une approche ancrée dans le terrain',
    text: "Je ne propose pas un déroulé théorique déconnecté de la réalité : les contraintes des managers, les tensions dans les équipes, les transformations qui s'essoufflent, les décisions difficiles à faire vivre, les imprévus du jour J.",
  },
];

const tiers = [
  {
    step: '1',
    title: 'Concevoir ensemble',
    subtitle: 'Co-construction de votre séminaire ou atelier',
    text: "Vous connaissez votre contexte, vos équipes et vos enjeux. J'apporte mon expertise de la facilitation, du processus et de la dynamique collective.",
    bullets: ["L'intention du séminaire", 'Les résultats attendus', 'Le niveau de participation', 'Le macro-déroulé', 'Les séquences et méthodes', 'Les rôles de chacun', 'Les modalités de suivi'],
    ideal: 'vous souhaitez rester impliqué dans la conception tout en étant accompagné par un expert.',
    cta: 'Co-construire mon séminaire',
  },
  {
    step: '2',
    title: 'Concevoir avec vous, vous laissez animer',
    subtitle: 'Mentoring de facilitateur',
    text: 'Vous animez, je vous aide à concevoir et à vous préparer.',
    bullets: ['Clarifier votre objectif', 'Concevoir le déroulé', 'Choisir les bonnes méthodes', 'Préparer les consignes', 'Anticiper les réactions du groupe', 'Travailler votre posture', 'Répéter les moments sensibles', "Débriefer après l'animation"],
    ideal: 'un manager, un chef de projet ou un facilitateur interne souhaite garder l\'animation.',
    cta: 'Être accompagné pour faciliter',
  },
  {
    step: '3',
    title: 'Vous me déléguez la facilitation',
    subtitle: 'Facilitation complète',
    text: "Je conçois et j'anime votre séminaire de bout en bout.",
    bullets: ['Les entretiens de cadrage', 'La conception du déroulé', 'Le choix des méthodes', 'La préparation des supports', 'La facilitation du jour J', 'La facilitation graphique', 'La synthèse des résultats', 'Le débrief et les prochaines étapes'],
    ideal: "le sujet est stratégique, sensible ou complexe, ou si vous souhaitez qu'une personne neutre garantisse le processus.",
    cta: 'Déléguer la facilitation',
  },
];

const compareRows = [
  { level: 'Co-construction', design: 'Ensemble', animation: 'Selon le projet' },
  { level: 'Mentoring', design: 'Ensemble', animation: 'Par vous' },
  { level: 'Facilitation complète', design: 'Par moi, avec votre validation', animation: 'Par moi' },
];

const process = [
  { title: 'Cadrer', text: "Nous clarifions le contexte, les participants, les tensions, les objectifs et ce qui devra être différent à la fin." },
  { title: 'Concevoir', text: 'Je transforme l\'intention en processus : rythme, séquences, méthodes, consignes, supports et modalités de décision.' },
  { title: 'Préparer', text: 'Nous sécurisons les rôles, la logistique, les prises de parole, les supports et les situations sensibles.' },
  { title: 'Faciliter', text: 'Le jour J, je garde une position haute sur le processus et basse sur le contenu : le groupe travaille, je ne lui impose pas les réponses.' },
  { title: 'Ancrer', text: 'Les décisions sont rendues visibles et transformées en priorités, responsabilités et prochaines étapes.' },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: 'Séminaire stratégique', text: 'Faire travailler un collectif sur une vision, des choix structurants ou une feuille de route.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de transformation', text: 'Faire participer les équipes à une évolution organisationnelle, culturelle, numérique ou managériale.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Convention ou grand groupe', text: "Faire participer un nombre important de personnes sans transformer l'événement en succession de présentations descendantes." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];
---

<Layout
  title="Séminaires et ateliers de facilitation — by Nicolas Verdot"
  description="Concevoir et faciliter des séminaires qui font réellement avancer les équipes : intelligence collective, facilitation graphique, trois niveaux d'accompagnement selon ce que vous souhaitez garder en interne."
  path="/offres/seminaires-ateliers/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: 'Séminaires et ateliers', path: '/offres/seminaires-ateliers/' },
  ]}
>
  <PageHero
    eyebrow="Séminaires · Ateliers · Facilitation"
    title="Concevoir et faciliter des séminaires qui font réellement avancer les équipes"
    summary="Intelligence collective, facilitation graphique et expérience du terrain pour transformer un temps collectif en décisions claires et en actions concrètes."
    pills={['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Conventions', 'Ateliers de transformation']}
  />

  <div class="container hero-cta-row">
    <a href={withBase('/contact/')} class="btn">Parler de votre séminaire →</a>
    <a href={withBase('/#accompagnements')} class="btn-outline">Découvrir les accompagnements</a>
  </div>

  <section class="section" data-reveal>
    <div class="container split">
      <div>
        <p class="eyebrow">Le problème</p>
        <h2>Un séminaire ne devrait pas être une réunion en plus</h2>
        <ul class="pain-list">
          {pains.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <div class="quote">
        <blockquote>Je vous aide à concevoir un temps collectif utile, engageant et orienté vers un résultat concret.</blockquote>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ce que j'apporte</p>
          <h2>Trois choses que vous ne trouverez pas ensemble ailleurs</h2>
        </div>
      </div>
      <div class="cards">
        {bring.map((b) => (
          <article class="card">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Trois manières de travailler ensemble</p>
          <h2>Quel niveau d'accompagnement vous convient ?</h2>
        </div>
        <p>C'est ici que la distinction compte : ce que vous gardez en interne, et ce que vous me déléguez.</p>
      </div>
      <div class="tier-grid">
        {tiers.map((t) => (
          <article class="tier-card">
            <span class="tier-step">{t.step}</span>
            <p class="tier-subtitle">{t.subtitle}</p>
            <h3>{t.title}</h3>
            <p class="tier-text">{t.text}</p>
            <p class="tier-includes">Nous construisons ensemble :</p>
            <ul class="tier-bullets">
              {t.bullets.map((b) => <li>{b}</li>)}
            </ul>
            <p class="tier-ideal"><strong>Idéal si :</strong> {t.ideal}</p>
            <a class="btn-outline tier-cta" href={withBase('/contact/')}>{t.cta}</a>
          </article>
        ))}
      </div>

      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr><th>Niveau</th><th>Conception</th><th>Animation</th></tr>
          </thead>
          <tbody>
            {compareRows.map((r) => (
              <tr><td>{r.level}</td><td>{r.design}</td><td>{r.animation}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section dark" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Mon processus</p>
          <h2>Cadrer → Concevoir → Préparer → Faciliter → Ancrer</h2>
        </div>
      </div>
      <div class="method process-method">
        {process.map((s, i) => (
          <div class="step">
            <b>{String(i + 1).padStart(2, '0')}</b>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Un séminaire à préparer ?"
    title="Vous n'avez pas besoin d'avoir déjà défini le programme."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, les participants, l'objectif réel, les contraintes et le niveau d'accompagnement dont vous avez besoin."
    ctaLabel="Réserver un échange de cadrage"
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .hero-cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: calc(var(--space-8) * -1);
    margin-bottom: var(--space-8);
  }
  .pain-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .pain-list li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--color-ink);
  }
  .pain-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 3px;
    background: var(--color-clay);
    border-radius: 2px;
  }
  .muted {
    color: var(--color-muted);
  }

  /* --- Trois niveaux d'accompagnement --- */
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .tier-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .tier-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }
  .tier-subtitle {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-orange-ink);
    margin: 0 0 var(--space-2);
  }
  .tier-card h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }
  .tier-text {
    color: var(--color-muted);
    margin: 0 0 var(--space-4);
  }
  .tier-includes {
    font-weight: 700;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
  }
  .tier-bullets {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .tier-bullets li::before {
    content: '— ';
    color: var(--color-orange-ink);
  }
  .tier-ideal {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .tier-cta {
    margin-top: auto;
    text-align: center;
  }

  .compare-table-wrap {
    margin-top: var(--space-8);
    overflow-x: auto;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 480px;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .compare-table th {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  .compare-table td:first-child {
    font-weight: 700;
    color: var(--color-navy);
  }

  /* --- Processus (étend .method/.step avec titre + texte) --- */
  .process-method {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .process-method .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .process-method .step strong {
    color: var(--color-white);
  }
  .process-method .step span {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
  }

  .methods-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
  }
  .methods-list li {
    position: relative;
    padding-left: var(--space-4);
    font-weight: 600;
    color: var(--color-navy);
  }
  .methods-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-orange-ink);
  }

  @media (max-width: 900px) {
    .tier-grid {
      grid-template-columns: 1fr;
    }
    .process-method {
      grid-template-columns: 1fr;
    }
    .methods-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .methods-list {
      grid-template-columns: 1fr;
    }
  }
</style>
