---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-capture-graphique.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Facilitation graphique et capture graphique en direct',
  name: 'Facilitation graphique et capture graphique en direct',
  description:
    "Pendant votre séminaire, conférence ou réunion stratégique, les échanges sont traduits en direct sous forme de fresque visuelle claire, mémorable et partageable.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/capture-graphique/'), Astro.site).toString(),
};

const variants = [
  {
    title: 'Capture graphique',
    text: "J'écoute et je synthétise visuellement vos tables rondes, conférences ou réunions stratégiques en temps réel. Vous repartez avec une fresque claire, mémorable et partageable — sans changer l'organisation de votre événement.",
    ideal: 'un événement déjà cadré, où vous voulez une trace visuelle forte du contenu.',
  },
  {
    title: 'Facilitation graphique du process',
    text: "J'intègre l'équipe d'organisation en amont pour co-concevoir le déroulé, puis je rends visuelles toutes les étapes de la réflexion collective. Vous repartez avec un processus qui permet de voir les idées émerger et les décisions se construire, pas seulement un résumé après coup.",
    ideal: "vous voulez que le visuel serve aussi à faire réfléchir et décider le groupe, pas uniquement à en garder une trace.",
  },
];

const checks = [
  { i: '1', title: 'Écouter en temps réel', text: "Je suis les prises de parole, les échanges et les moments clés de l'événement." },
  { i: '2', title: "Extraire l'essentiel", text: 'Les idées fortes, les décisions, les tensions, les messages importants et les liens entre les sujets.' },
  { i: '3', title: 'Structurer l\'information', text: 'Une organisation visuelle pour que les contenus restent compréhensibles après l\'événement.' },
  { i: '4', title: 'Créer une trace exploitable', text: 'Photographiée, numérisée, imprimée, partagée ou réutilisée dans vos communications internes.' },
];

const benefits = [
  { num: 'Attention', title: 'Engager les participants', text: 'Voir les idées apparaître en direct capte l\'attention et crée un point de repère commun.' },
  { num: 'Clarté', title: 'Clarifier les sujets complexes', text: 'Les concepts et les décisions deviennent plus faciles à comprendre.' },
  { num: 'Mémoire', title: 'Créer une mémoire collective', text: "La fresque rassemble les moments clés de l'événement dans un support unique." },
  { num: 'Valeur', title: 'Valoriser les contributions', text: 'Les participants voient que leurs idées sont écoutées, synthétisées et intégrées.' },
  { num: 'Impact', title: 'Renforcer les messages', text: 'Les interventions importantes deviennent plus mémorables et plus faciles à partager.' },
  { num: 'Durée', title: "Prolonger l'événement", text: 'La fresque continue à vivre dans les bureaux, présentations ou communications internes.' },
];

const events = [
  "Séminaires d'entreprise", 'Conférences', 'Conventions', 'Réunions stratégiques',
  'Comités de direction élargis', "Ateliers d'intelligence collective", 'Kick-offs',
  'Journées de transformation', 'Concertations', 'Tables rondes', 'Formations', 'Forums participatifs',
];

const steps = [
  'Échange initial sur les objectifs, le public et le programme',
  'Préparation : vocabulaire, enjeux, contenus disponibles, choix du format',
  'Jour J : capture en direct des idées, échanges et décisions',
  'Finalisation et livraison de la fresque',
];

const faqs = [
  { q: 'Est-ce que la capture graphique peut être projetée en direct ?', a: 'Oui. Une capture digitale peut être projetée en temps réel selon la configuration technique de l\'événement.' },
  { q: 'Quelle est la différence entre capture graphique et facilitation graphique ?', a: "La capture graphique consiste principalement à écouter et synthétiser visuellement les échanges d'un événement déjà cadré. La facilitation graphique du process va plus loin : j'interviens en amont sur la conception du déroulé, et le visuel aide directement le groupe à réfléchir, contribuer et décider — pas seulement à en garder une trace. Les deux options sont détaillées plus haut sur cette page." },
  { q: 'Pouvez-vous capturer plusieurs ateliers en parallèle ?', a: 'Seul, non. Pour plusieurs salles simultanées, je peux mobiliser un réseau de facilitateurs graphiques de confiance.' },
  { q: 'Peut-on garder la fresque originale ?', a: 'Oui, lorsque la capture est réalisée sur support physique et que cela est prévu dans le devis.' },
  { q: 'Pouvez-vous respecter notre charte graphique ?', a: 'Oui. Le style peut être adapté à votre identité, tout en conservant la lisibilité nécessaire à une capture réalisée en direct.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Facilitation graphique & capture graphique en direct — by Nicolas Verdot"
  description="Facilitation graphique : pendant votre séminaire ou conférence, les échanges sont traduits en direct sous forme de fresque visuelle claire et mémorable."
  path="/offres/capture-graphique/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: 'Facilitation graphique & capture graphique', path: '/offres/capture-graphique/' },
  ]}
>
  <PageHero
    eyebrow="Facilitation graphique · Capture graphique · Événementiel"
    title="Vos idées méritent"
    titleAccent="d'être vues et mémorisées."
    summary="Pendant votre séminaire, conférence ou réunion stratégique, je traduis visuellement en temps réel les idées, décisions et échanges. Une fresque prend forme, aide les participants à suivre, et crée <strong>une mémoire collective</strong> que vous pourrez conserver, partager et réutiliser."
    pills={['Sur devis', 'En direct', 'Partout en France']}
    image={heroImg}
    imageAlt="Un facilitateur graphique dessine une grande fresque colorée en direct devant un public nombreux, lors d'un événement."
    tall
  />

  <section class="section" data-reveal>
    <div class="container split">
      <div>
        <p class="eyebrow">Ce que je fais</p>
        <h2>Écouter, clarifier et rendre visible</h2>
        <p class="hero-copy">La facilitation graphique — dont la capture graphique (ou scribing) est la forme la plus directe — est une technique de transcription visuelle en temps réel. Je sélectionne l'essentiel, je structure l'information et je la transforme en mots-clés, pictogrammes, personnages et liens visuels — sous les yeux du groupe.</p>
        <div class="checks">
          {checks.map((c) => (
            <div class="check"><i>{c.i}</i><div><strong>{c.title}</strong><br /><span class="muted">{c.text}</span></div></div>
          ))}
        </div>
      </div>
      <div class="quote">
        <blockquote>Vos idées méritent mieux qu'un compte rendu que personne ne relira.</blockquote>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Deux façons de travailler ensemble</p>
          <h2>Capture pure, ou co-conception du process</h2>
        </div>
        <p>Selon si vous voulez une trace visuelle du contenu, ou que le visuel serve aussi à faire avancer la réflexion du groupe.</p>
      </div>
      <div class="cards">
        {variants.map((v) => (
          <article class="card">
            <h3>{v.title}</h3>
            <p>{v.text}</p>
            <p class="muted variant-ideal"><strong>Idéal si :</strong> {v.ideal}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bénéfices</p>
          <h2>Pourquoi intégrer une capture graphique ?</h2>
        </div>
      </div>
      <div class="cards">
        {benefits.map((b) => (
          <article class="card">
            <div class="num">{b.num}</div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container prose">
      <p class="eyebrow">Événements</p>
      <h2>Pour quels événements ?</h2>
      <div class="tool-tags">
        {events.map((e) => <span class="tool-tag">{e}</span>)}
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <p class="eyebrow">Déroulé</p>
      <h2>Comment cela fonctionne ?</h2>
      <div class="timeline">
        {steps.map((step, i) => (
          <div class="timeline-item"><span>{i + 1}</span><strong>{step}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Zone d'intervention & tarif</p>
        <h2>Basé à Nice, mobile partout en France</h2>
        <p class="muted">J'interviens facilement sur toute la Côte d'Azur (Nice, Cannes, Antibes, Sophia Antipolis, Monaco) et me déplace partout en France. La capture digitale peut aussi être réalisée à distance selon le format de l'événement. Pour plusieurs salles simultanées, je peux mobiliser un réseau de facilitateurs graphiques de confiance.</p>
        <p class="muted">Le tarif dépend de la durée, du format physique ou digital, du temps de préparation et des droits d'utilisation. Sur devis.</p>
        <a class="btn" href={withBase('/contact/')}>Parler de votre événement</a>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container prose">
      <p class="eyebrow">FAQ</p>
      <h2>Questions fréquentes</h2>
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Votre événement mérite une trace vivante"
    title="Faisons apparaître ce qui compte."
    subtitle="Parlons de votre événement, du public, du programme et de la manière dont vous souhaitez réutiliser la fresque après le jour J."
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .muted {
    color: var(--color-muted);
  }
  .panel .btn {
    margin-top: var(--space-4);
  }
  .variant-ideal {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }
</style>
