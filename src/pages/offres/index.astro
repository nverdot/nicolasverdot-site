---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import PriorityGrid from '../../components/PriorityGrid.astro';
import heroImg from '../../assets/offres/hero-accompagnements.png';
---

<Layout
  title="Les offres — by Nicolas Verdot"
  description="Sept façons de remettre un collectif en mouvement, du cadrage d'une décision à la capture graphique d'un temps fort. Trouvez celle qui correspond à votre situation."
  path="/offres/"
>
  <PageHero
    eyebrow="Accompagnements"
    title="Un accompagnement"
    titleAccent="sur mesure,"
    titleTail="selon vos besoins."
    summary="Pas de catalogue figé : chaque accompagnement part de <strong>votre contexte</strong>, de <strong>vos enjeux</strong> et de ce que vous voulez voir changer. Repérez ci-dessous ce qui s'en rapproche le plus, ou parlons-en directement."
    image={heroImg}
    imageAlt="Illustration d'un collectif au sommet d'une montagne : plusieurs groupes travaillent en parallèle - atelier autour d'une table, présentation, échange - autour d'un chemin qui bifurque, symbolisant les différentes façons d'être accompagné."
    tall
  />

  <PriorityGrid sectionName="Accompagnements" lead="" />

  <CTABlock
    eyebrow="Vous hésitez sur le bon point d'entrée ?"
    title="Partons de la situation, pas du catalogue."
    subtitle="Un échange de cadrage permet d'identifier ce qui doit réellement être traité et le niveau d'intervention utile."
  />
</Layout>
