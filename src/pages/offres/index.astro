---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import TroisPortes from '../../components/TroisPortes.astro';
---

<Layout
  title="Les offres — by Nicolas Verdot"
  description="Séminaires d'entreprise, stratégie IA, coaching et formations : trois façons de travailler ensemble, selon ce que vous venez chercher."
  path="/offres/"
>
  <PageHero
    eyebrow="Accompagnements"
    title="Vous savez ce qui doit changer."
    titleAccent="Voyons comment."
    summary="Un séminaire à réussir, l'IA à mettre en route, une équipe ou un dirigeant à faire grandir : choisissez la porte qui ressemble à <strong>votre situation</strong>, ou parlons-en directement."
  />

  {/* Trois besoins au lieu de six accompagnements au même niveau, plus l'IA,
      plus les formations (voir data/portes.ts). */}
  <TroisPortes eyebrow="Les offres" title="Trois besoins, trois portes" lead="Chaque porte a une offre principale. Les formats voisins sont listés en dessous, pour ceux qui savent déjà ce qu'ils cherchent." />

  <CTABlock
    eyebrow="Vous hésitez sur le bon point d'entrée ?"
    title="Partons de la situation, pas du catalogue."
    subtitle="Un échange de cadrage permet d'identifier ce qui doit réellement être traité et le niveau d'intervention utile."
  />
</Layout>
