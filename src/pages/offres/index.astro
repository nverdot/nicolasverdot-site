---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import PriorityGrid from '../../components/PriorityGrid.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-accompagnements.png';
---

<Layout
  title="Les offres — by Nicolas Verdot"
  description="Sept façons de remettre un collectif en mouvement, du cadrage d'une décision à la capture graphique d'un temps fort. Trouvez celle qui correspond à votre situation."
  path="/offres/"
>
  <PageHero
    eyebrow="Accompagnements"
    title="Remettre votre collectif en mouvement"
    summary="Chaque situation est différente. Repérez ci-dessous ce qui correspond le mieux à votre contexte, ou parlons-en directement si plusieurs sujets se combinent."
    image={heroImg}
    imageAlt="Illustration d'un collectif au sommet d'une montagne : plusieurs groupes travaillent en parallèle - atelier autour d'une table, présentation, échange - autour d'un chemin qui bifurque, symbolisant les différentes façons d'être accompagné."
    tall
  />

  <PriorityGrid sectionName="Accompagnements" lead="" />

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="formations-callout">
        <div>
          <p class="eyebrow">Se former plutôt qu'être accompagné</p>
          <h2>Vous préférez monter en compétences vous-même ?</h2>
          <p>Facilitation graphique, intelligence collective, IA appliquée, posture de leader facilitateur : découvrez le catalogue de formations.</p>
        </div>
        <a class="btn" href={withBase('/formations/')}>Voir les formations →</a>
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Vous hésitez sur le bon point d'entrée ?"
    title="Partons de la situation, pas du catalogue."
    subtitle="Un échange de cadrage permet d'identifier ce qui doit réellement être traité et le niveau d'intervention utile."
  />
</Layout>

<style>
  .formations-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
  }
  .formations-callout h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }
  .formations-callout p:not(.eyebrow) {
    margin: 0;
    color: var(--color-muted);
    max-width: 60ch;
  }
  .formations-callout .btn {
    flex-shrink: 0;
  }
  @media (max-width: 700px) {
    .formations-callout {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
