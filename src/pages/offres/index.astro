---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import PriorityGrid from '../../components/PriorityGrid.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-accompagnements.png';

const complementary = [
  { num: 'Visuel', title: 'Capture graphique en direct', text: 'Traduire vos séminaires et conférences en fresque visuelle mémorable.', href: withBase('/offres/capture-graphique/') },
  { num: 'Compétences', title: 'Formations', text: 'Facilitation graphique, intelligence collective, IA appliquée et leader facilitateur.', href: withBase('/formations/') },
];
---

<Layout
  title="Les offres — by Nicolas Verdot"
  description="Six façons de remettre un collectif en mouvement, du cadrage d'une décision à l'évolution de la posture d'un leader. Trouvez celle qui correspond à votre situation."
  path="/offres/"
>
  <PageHero
    eyebrow="Accompagnements"
    title="Remettre votre collectif en mouvement"
    summary="Chaque situation est différente. Repérez ci-dessous ce qui correspond le mieux à votre contexte, ou parlons-en directement si plusieurs sujets se combinent."
    image={heroImg}
    imageAlt="Illustration d'un collectif au sommet d'une montagne : plusieurs groupes travaillent en parallèle - atelier autour d'une table, présentation, échange - autour d'un chemin qui bifurque, symbolisant les différentes façons d'être accompagné."
  />

  <PriorityGrid sectionName="Accompagnements" />

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Autres formats</p>
          <h2>Deux formats complémentaires</h2>
        </div>
        <p>Utiles seuls ou intégrés à un accompagnement plus large.</p>
      </div>
      <div class="cards">
        {complementary.map((c) => (
          <article class="card">
            <div class="num">{c.num}</div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <a class="card-link" href={c.href}>Découvrir</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Vous hésitez sur le bon point d'entrée ?"
    title="Partons de la situation, pas du catalogue."
    subtitle="Un échange de cadrage permet d'identifier ce qui doit réellement être traité et le niveau d'intervention utile."
  />
</Layout>
