---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import ClientLogoStrip from '../../components/ClientLogoStrip.astro';
import { withBase } from '../../utils/url';
import heroImg from '../../assets/offres/hero-coaching-equipe.png';

const relatedCaseStudies = (
  await getCollection('caseStudies', ({ data }) => !data.draft && data.offerHref === '/offres/mentoring/')
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Mentoring de facilitateur',
  name: 'Mentoring de facilitateur',
  description:
    "Je co-construis votre séminaire ou atelier avec vous, et je vous prépare à l'animer vous-même : posture, déroulé, méthodes et répétition des moments sensibles.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: { '@type': 'Country', name: 'France' },
  url: new URL(withBase('/offres/mentoring/'), Astro.site).toString(),
};

const icons: Record<string, string> = {
  compass: '<path d="M4 17c2.5-6 5 6 8 0s4.5-5 8 0"/><circle cx="4" cy="17" r="1" fill="currentColor" stroke="none"/><circle cx="20" cy="17" r="1" fill="currentColor" stroke="none"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9.5 12l2 2 3-3.5"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  network: '<circle cx="6" cy="6" r="2.3"/><circle cx="18" cy="6" r="2.3"/><circle cx="12" cy="18" r="2.3"/><path d="M8 7l3.2 9M16 7l-3.2 9M8.3 6h7.4"/>',
  door: '<path d="M6 3h9v18H6z"/><path d="M15 3l4 1.5v15L15 21"/><circle cx="12" cy="12" r="0.8" fill="currentColor" stroke="none"/>',
  megaphone: '<path d="M3 11v2a2 2 0 0 0 2 2h1l3 5V4L6 9H5a2 2 0 0 0-2 2z"/><path d="M14 8a4 4 0 0 1 0 8"/><path d="M17 5a8 8 0 0 1 0 14"/>',
  bulb: '<path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.5 1 1.3 1 2.1V16h6v-1.4c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 2z"/>',
  heart: '<path d="M12 21s-7.5-4.6-10-9.3C.4 8.6 2.3 5 6 5c2 0 3.5 1.1 4.3 2.4C11.1 6.1 12.6 5 14.6 5c3.7 0 5.6 3.6 4 6.7C19.5 16.4 12 21 12 21z"/>',
  ear: '<path d="M9 17.5c-2.5 0-4.5-2-4.5-4.5S6.5 8.5 9 8.5c2 0 3.5 1.3 4 3"/><path d="M9 8.5A5.5 5.5 0 1 1 9 19.5"/><path d="M12 12.5c0 1.4-1.1 2.5-2.5 2.5"/>',
  clipboard: '<rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8.5 11h7M8.5 15h7"/>',
  pencil: '<path d="M4 20l1-4.2L15.8 5 19 8.2 8.2 19 4 20z"/><path d="M13.5 6.5l4 4"/>',
  gift: '<rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 9v-1a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1"/><path d="M12 9v12"/><path d="M12 9c-1.5-4-6-5-6-2 0 1.5 2 2 6 2z"/><path d="M12 9c1.5-4 6-5 6-2 0 1.5-2 2-6 2z"/>',
};

const valueItems = [
  { icon: 'compass', title: "Facilitation d'intelligence collective", text: 'Un processus qui permet aux participants de comprendre, contribuer, confronter leurs points de vue, décider et agir.' },
  { icon: 'shield', title: 'Une posture qui se travaille', text: 'Concevoir un déroulé est une chose. Tenir le cadre devant le groupe, encaisser un silence ou une tension, en est une autre.' },
  { icon: 'target', title: 'Une approche ancrée dans le terrain', text: 'Pas un déroulé théorique déconnecté de la réalité : contraintes des managers, tensions dans les équipes, imprévus du jour J.' },
  { icon: 'network', title: 'Une autonomie qui reste la vôtre', text: 'Vous gardez la main sur l\'animation. Mon rôle est de vous y préparer, pas de vous la retirer.' },
];

const problems = [
  { icon: 'door', title: 'Un programme trop chargé et peu participatif', text: "L'ordre du jour s'accumule, mais personne ne sait vraiment comment faire vivre le groupe autour." },
  { icon: 'megaphone', title: 'Des prises de parole interminables', text: 'Quelques voix occupent tout le temps de parole pendant que le reste du groupe se tait.' },
  { icon: 'bulb', title: "Beaucoup d'idées, mais aucune vraie décision", text: 'La réflexion collective produit des idées, mais rien qui engage concrètement le groupe.' },
  { icon: 'heart', title: 'Des participants qui décrochent', text: 'Sur un format long ou mal rythmé, l\'attention et l\'énergie du groupe finissent par retomber.' },
  { icon: 'target', title: 'Une énergie positive qui retombe dès le lendemain', text: "La journée s'est bien passée, mais rien de concret n'en ressort une fois de retour au bureau." },
  { icon: 'network', title: 'Des engagements qui ne sont jamais suivis', text: "Ce qui a été décidé en séminaire ne survit pas au retour au quotidien." },
];

const costSigns = [
  "Le programme est rempli, mais personne ne sait vraiment ce qu'on attend d'en sortir.",
  'Les décisions prises en séminaire ne sont jamais reprises derrière.',
  'Les mêmes personnes parlent, les autres se taisent.',
  "L'énergie du jour J retombe dès le lendemain, sans rien de concret.",
];

const takeCharge = [
  {
    icon: 'ear',
    title: 'Cadrer',
    text: 'Nous clarifions le contexte, les participants, les tensions, les objectifs et ce qui devra être différent à la fin.',
    subtitle: 'Comprendre avant de concevoir quoi que ce soit',
    detail: [
      "Avant de construire quoi que ce soit, je dois comprendre votre contexte : qui sont les participants, quelles tensions existent, quel est l'objectif réel derrière la demande.",
      "On regarde aussi ce qui devra être différent à la fin de la journée — la question qui guide toute la conception qui suit.",
    ],
  },
  {
    icon: 'clipboard',
    title: 'Concevoir',
    text: "Nous transformons l'intention en processus : rythme, séquences, méthodes, consignes, supports et modalités de décision.",
    subtitle: 'Construire le déroulé ensemble',
    detail: [
      "C'est le cœur de la co-construction : l'intention du séminaire, les résultats attendus, le niveau de participation souhaité, le macro-déroulé, les séquences et méthodes, les rôles de chacun et les modalités de suivi.",
      "Chaque méthode est choisie pour ce qu'elle produit, pas parce qu'elle est à la mode.",
    ],
  },
  {
    icon: 'pencil',
    title: 'Préparer',
    text: 'Nous sécurisons les rôles, la logistique, les prises de parole, les supports, les situations sensibles — et votre posture.',
    subtitle: 'Se préparer à tenir le cadre, pas seulement le déroulé',
    detail: [
      "Concevoir un déroulé est une chose. Le tenir devant le groupe en est une autre. On travaille votre objectif, vos méthodes, vos consignes, votre anticipation des réactions du groupe et votre posture.",
      "On répète aussi les moments sensibles — ceux où le silence, une tension ou une prise de parole difficile pourrait vous déstabiliser le jour J.",
    ],
  },
  {
    icon: 'network',
    title: 'Faciliter',
    text: "Le jour J, c'est vous qui animez. Je reste en soutien sur le processus, disponible si besoin selon la formule choisie.",
    subtitle: 'Vous gardez la main, avec un filet de sécurité',
    detail: [
      "Le jour J, vous animez. Selon la formule choisie, je peux rester disponible en soutien — en salle ou à distance — sur le processus, sans reprendre le micro à votre place.",
      "L'objectif reste que ce soit vous qui teniez l'espace devant votre groupe, du début à la fin.",
    ],
  },
  {
    icon: 'gift',
    title: 'Ancrer',
    text: 'Nous débriefons ensemble : ce qui a fonctionné, ce qui était difficile, ce qui nourrit votre prochaine animation.',
    subtitle: 'Transformer l\'expérience en compétence durable',
    detail: [
      "Après l'animation, on débriefe ensemble : ce qui a fonctionné, ce qui était difficile, ce que vous avez appris de vous-même en tenant ce rôle.",
      "C'est ce temps qui transforme une animation réussie en compétence durable, réutilisable sur votre prochain séminaire sans moi.",
    ],
  },
];

const basics = [
  { icon: 'network', title: "Deux formats d'accompagnement", text: "Rester impliqué dans la conception, ou uniquement vous préparer à l'animation si le déroulé est déjà prêt." },
  { icon: 'target', title: 'Méthodes choisies pour leur utilité', text: 'Méthodes ToP, World Café, Open Space, Fishbowl, Liberating Structures... jamais un point de départ, toujours un moyen.' },
  { icon: 'clipboard', title: 'Sur devis', text: "Accompagnement individuel, adapté au format du séminaire et à votre niveau d'expérience en facilitation." },
];

const timingBrackets = [
  { color: 'navy', duration: '2 à 3 semaines', text: 'Le temps minimum pour cadrer, concevoir et préparer un séminaire d\'une journée.' },
  { color: 'blue', duration: '4 à 6 semaines', text: 'Pour un format plus ambitieux, ou si vous découvrez la facilitation.' },
  { color: 'clay', duration: 'La semaine du jour J', text: 'Un dernier temps pour répéter ensemble les moments sensibles juste avant l\'animation.' },
  { color: 'brick', duration: 'Formation-action', text: "Prévoir plus de temps si l'objectif est aussi de monter en compétence sur la durée." },
];

const formats = [
  { title: "Séminaire d'alignement", text: 'Clarifier une direction commune, les priorités et les contributions de chacun.' },
  { title: "Réunion d'équipe régulière", text: 'Faire monter en compétence un manager qui anime déjà ses propres temps collectifs.' },
  { title: 'Atelier de résolution', text: 'Débloquer une situation complexe, analyser les causes et construire des réponses.' },
  { title: 'Atelier de transformation', text: 'Faire participer les équipes à une évolution organisationnelle, culturelle ou managériale.' },
  { title: 'Journée de cohésion utile', text: 'Renforcer les relations tout en travaillant sur un véritable enjeu collectif.' },
  { title: 'Formation-action', text: "Apprendre à faciliter en concevant et en animant un vrai sujet, pas un cas d'école." },
];

const methods = ['Les méthodes ToP', 'Le World Café', "L'Open Space", 'Le Fishbowl', 'Les Liberating Structures', 'Les ateliers de priorisation', 'Les conversations structurées', 'La facilitation graphique', 'Les métaphores et supports visuels'];
---

<Layout
  title="Mentoring de facilitateur — by Nicolas Verdot"
  description="Je co-construis votre séminaire ou atelier avec vous, et je vous prépare à l'animer vous-même : posture, déroulé, méthodes et répétition des moments sensibles."
  path="/offres/mentoring/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Les offres', path: '/offres/' },
    { name: 'Mentoring', path: '/offres/mentoring/' },
  ]}
>
  <section class="hero-bg" data-reveal>
    <Image src={heroImg} alt="Un groupe de collègues marche avec assurance sur une terrasse dominant un paysage dégagé, symbolisant l'autonomie retrouvée." widths={[800, 1400, 2000]} sizes="100vw" class="hero-bg-img" />
    <div class="hero-bg-scrim" aria-hidden="true"></div>
    <div class="hero-bg-inner">
      <div class="hero-bg-copy">
        <p class="eyebrow">Mentoring · Co-construction · Posture de facilitateur</p>
        <h1>
          Vous concevez et animez,
          <span class="script-accent">je vous accompagne</span>
          <span class="hero-tail">à chaque étape.</span>
        </h1>
        <p class="page-summary">Je co-construis votre séminaire ou atelier avec vous, et je vous prépare à <strong>l'animer vous-même</strong> — posture, déroulé, méthodes, répétition des moments sensibles.</p>
        <div class="meta-pills">
          {['Séminaires', 'Ateliers stratégiques', "Journées d'équipe", 'Formation-action'].map((pill) => <span>{pill}</span>)}
        </div>
        <div class="hero-cta-row">
          <a href={withBase('/contact/')} class="btn">Être accompagné pour faciliter →</a>
          <a href={withBase('/offres/deleguer-animation/')} class="btn-outline">Le sujet est trop sensible ? Déléguez-moi la facilitation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="value-band" data-reveal data-section-name="Ce que j'apporte">
    <div class="container value-band-inner">
      <h2>
        Vous connaissez votre contexte, vos équipes et vos enjeux. J'apporte
        <span class="accent-wrap">
          mon expertise
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
        de la facilitation, du processus et de la dynamique collective.
      </h2>
      <div class="value-grid">
        {valueItems.map((v) => (
          <div class="value-item">
            <svg class="value-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[v.icon]} />
            <strong>{v.title}</strong>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ClientLogoStrip />

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le problème</p>
          <h2>Un séminaire ne devrait pas être une réunion en plus</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {problems.map((p) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} /></span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
      <div class="callout-box">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.compass} /></span>
        <p><strong>Vous connaissez votre contexte, vos équipes et vos enjeux.</strong><br /><span class="accent">J'apporte mon expertise de la facilitation, du processus et de la dynamique collective.</span></p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Le vrai coût d'un séminaire mal préparé</p>
        </div>
      </div>
      <div class="cost-columns">
        <div class="cost-col cost-col-highlight">
          <h3>Vos séminaires ont un vrai coût</h3>
          <p>Le temps de préparation, la mobilisation de toute une équipe, le temps de présence — tout cela représente un investissement réel.</p>
          <p><strong>Sans un vrai processus, cet investissement produit peu de résultats durables.</strong></p>
        </div>
        <div class="cost-col">
          <h3>Les signes que le processus manque</h3>
          <ol class="cost-numbered">
            {costSigns.map((c) => <li>{c}</li>)}
          </ol>
        </div>
        <div class="cost-col">
          <h3>Pourquoi plus de contenu n'arrange rien</h3>
          <p>Le problème n'est presque jamais le sujet traité, mais le processus utilisé pour le traiter. Sans un déroulé pensé pour la participation et la décision, ajouter du contenu ne fait qu'aggraver la réunionite.</p>
        </div>
      </div>
      <div class="callout-box callout-box-row">
        <span class="callout-box-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.shield} /></span>
        <p>Parlons de votre prochain séminaire pour construire le processus qui le fera vraiment servir.</p>
        <a href={withBase('/contact/')} class="btn">Être accompagné pour faciliter →</a>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Déroulé</p>
          <h2>Cadrer → Concevoir → Préparer → Faciliter → Ancrer</h2>
        </div>
      </div>
      <div class="phase-timeline" aria-hidden="true">
        {takeCharge.map((_t, i) => (
          <>
            <span class="phase-timeline-dot">{i + 1}</span>
            {i < takeCharge.length - 1 && <span class="phase-timeline-line"></span>}
          </>
        ))}
      </div>
      <div class="take-charge-grid">
        {takeCharge.map((t) => (
          <button type="button" class="take-charge-card" data-phase-trigger={t.title}>
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} /></span>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            <span class="take-charge-more">En savoir plus →</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {takeCharge.map((t, i) => (
    <div class="phase-modal" data-phase-modal={t.title} hidden>
      <div class="phase-modal-backdrop" data-phase-modal-close></div>
      <div class="phase-modal-panel" role="dialog" aria-modal="true" aria-labelledby={`phase-modal-title-${i}`}>
        <button type="button" class="phase-modal-close" data-phase-modal-close aria-label="Fermer">✕</button>
        <span class="take-charge-num phase-modal-num">{i + 1}</span>
        <p class="eyebrow">{t.title}</p>
        <h3 id={`phase-modal-title-${i}`}>{t.subtitle}</h3>
        {t.detail.map((paragraph) => <p set:html={paragraph} />)}
      </div>
    </div>
  ))}

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Bon à savoir</p>
          <h2>Ce qu'il faut savoir pour bien s'organiser</h2>
        </div>
      </div>
      <div class="cards icon-cards">
        {basics.map((b) => (
          <article class="card">
            <span class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} /></span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Combien de temps">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Planification</p>
          <h2>Combien de temps faut-il prévoir ?</h2>
        </div>
      </div>

      <div class="timing-intro">
        <p class="timing-intro-lead">Idéalement : 2 à 6 semaines avant votre séminaire</p>
        <p>Le temps nécessaire dépend surtout de votre expérience de la facilitation et de l'ambition du format choisi.</p>
      </div>

      <h3 class="timing-subhead">Le bon timing</h3>
      <div class="timing-grid">
        {timingBrackets.map((t) => (
          <div class={`timing-item timing-item-${t.color}`}>
            <span class="timing-duration">{t.duration}</span>
            <span class="timing-text">{t.text}</span>
          </div>
        ))}
      </div>

      <div class="timing-callout">
        <p class="timing-callout-title">Votre séminaire est dans moins de deux semaines ?</p>
        <p>Parlons-en quand même. Selon votre expérience et le format choisi, une préparation accélérée reste parfois possible.</p>
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Les formats</p>
          <h2>Des situations concrètes, pas une liste de prestations</h2>
        </div>
      </div>
      <div class="cards">
        {formats.map((f) => (
          <article class="card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal>
    <div class="container">
      <div class="panel">
        <p class="eyebrow">Les méthodes</p>
        <h2>Des méthodes choisies pour leur utilité, pas pour suivre une mode</h2>
        <ul class="methods-list">
          {methods.map((m) => <li>{m}</li>)}
        </ul>
        <p class="muted">La méthode n'est jamais le point de départ. Je pars du résultat attendu, puis je construis le processus adapté.</p>
      </div>
    </div>
  </section>

  {relatedCaseStudies.length > 0 && (
    <section class="section" data-reveal data-section-name="Cas clients">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Cas clients</p>
            <h2>Ce que ça donne concrètement</h2>
          </div>
          <p><a href={withBase('/cas-clients/')}>Voir tous les cas clients →</a></p>
        </div>
        <div class="cards">
          {relatedCaseStudies.map((cs) => (
            <article class="card case-vignette">
              {cs.data.clientLogo ? (
                <img src={withBase(cs.data.clientLogo)} alt={cs.data.client} class="case-card-logo" />
              ) : (
                <div class="num">{cs.data.client}</div>
              )}
              <p class="case-vignette-label">La problématique</p>
              <p class="case-vignette-question">{cs.data.question}</p>
              <p class="case-vignette-label">Le cas</p>
              <h3>{cs.data.title}</h3>
              <p>{cs.data.summary}</p>
              <a class="card-link" href={withBase(`/cas-clients/${cs.slug}/`)}>Découvrir le cas client</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABlock
    eyebrow="Un séminaire à concevoir et à animer vous-même ?"
    title="Vous n'avez pas besoin d'être déjà un facilitateur expérimenté."
    subtitle="Pendant ce premier échange, nous clarifierons la situation, le sujet et le niveau de préparation dont vous avez besoin."
    ctaLabel="Être accompagné pour faciliter"
    dark
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Layout>

<style>
  .muted {
    color: var(--color-muted);
  }
  .methods-list {
    list-style: none;
    margin: var(--space-6) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
  }
  .methods-list li {
    position: relative;
    padding-left: var(--space-4);
    font-weight: 600;
    color: var(--color-navy);
  }
  .methods-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-orange-ink);
  }
  @media (max-width: 560px) {
    .methods-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-phase-trigger]'));
  const modals = Array.from(document.querySelectorAll<HTMLElement>('[data-phase-modal]'));

  function openModal(name: string) {
    const modal = modals.find((m) => m.dataset.phaseModal === name);
    if (!modal) return;
    modal.hidden = false;
    document.body.classList.add('case-modal-lock-scroll');
  }

  function closeModal(modal: HTMLElement) {
    modal.hidden = true;
    if (!modals.some((m) => !m.hidden)) {
      document.body.classList.remove('case-modal-lock-scroll');
    }
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const name = trigger.dataset.phaseTrigger;
      if (name) openModal(name);
    });
  });

  modals.forEach((modal) => {
    modal.querySelectorAll('[data-phase-modal-close]').forEach((el) => {
      el.addEventListener('click', () => closeModal(modal));
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach((modal) => {
        if (!modal.hidden) closeModal(modal);
      });
    }
  });
</script>
