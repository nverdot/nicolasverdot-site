---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTABlock from '../components/CTABlock.astro';
import { withBase } from '../utils/url';

const fuites = [
  {
    num: '1',
    title: 'Les présences en trop',
    text: "Inviter large rassure, mais chaque personne qui n'avait rien à décider coûte son temps — et dilue la décision de ceux qui l'avaient.",
  },
  {
    num: '2',
    title: 'Les réunions qui ne tranchent pas',
    text: "Une réunion qui se termine sans savoir quoi, qui et pour quand n'a rien produit. Le temps est passé, la décision reste à prendre.",
  },
  {
    num: '3',
    title: 'Les sujets qui reviennent',
    text: "C'est le goulet d'étranglement. Un sujet non tranché ne disparaît pas : il revient, réunion après réunion, et bloque tout ce qui en dépendait.",
  },
];

const faq = [
  {
    q: 'Comment le coût horaire est-il calculé ?',
    a: "À partir du salaire brut annuel, multiplié par 1,45 pour tenir compte des charges patronales, divisé par 1 600 heures travaillées par an. Les salaires proposés par défaut sont des ordres de grandeur, que vous pouvez ajuster au centime près si vous connaissez les vôtres.",
  },
  {
    q: 'Le résultat est-il exagéré ?',
    a: "C'est l'inverse : le calcul est volontairement prudent. Une réunion qui ne décide pas n'est comptée qu'à moitié perdue, et le calcul ignore complètement le coût des décisions retardées — les projets qui attendent, les équipes qui tournent au ralenti, les clients qui patientent. Dans la réalité, c'est souvent là que se trouve le plus gros montant.",
  },
  {
    q: 'Faut-il supprimer les réunions ?',
    a: "Non. Une organisation qui ne se réunit plus ne décide pas mieux, elle décide moins vite et moins bien. Le sujet n'est pas la quantité de réunions, c'est ce qui en sort : un cadre clair, un déroulé pensé, une décision tracée. C'est exactement ce que travaille la posture de leader facilitateur.",
  },
  {
    q: 'Mes réponses sont-elles enregistrées ?',
    a: "Non. Tout le calcul se fait dans votre navigateur : rien n'est envoyé, rien n'est stocké, aucune adresse e-mail n'est demandée. Si vous voulez en parler, vous copiez votre résultat en un clic et vous me l'apportez.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Combien coûte une réunion ? Le calculateur — by Nicolas Verdot"
  description="Calculez en une minute ce que vous coûte une réunion récurrente : coût annuel, part récupérable et point de blocage. Sans inscription."
  path="/cout-des-reunions/"
>
  <PageHero
    eyebrow="Outil gratuit"
    title="Combien vous coûte votre réunion ?"
    summary="Huit questions, moins d'une minute. Vous obtenez le <strong>coût annuel</strong> d'une de vos réunions récurrentes, la part que vous pourriez récupérer, et surtout <strong>le point précis qui coince</strong>."
    pills={['8 questions', 'Moins d’une minute', 'Sans inscription']}
  />

  <section class="section" data-reveal data-section-name="Calculateur">
    <div class="container">
      <div class="panel calc" data-calc>
        <!-- Barre de progression -->
        <div class="calc-top" data-top hidden>
          <button type="button" class="calc-back" data-back>← Retour</button>
          <div class="calc-bar"><i data-bar></i></div>
          <span class="calc-count" data-count></span>
        </div>

        <!-- 0 : intro -->
        <div class="calc-step is-active" data-step="0">
          <p class="accent-script calc-script">Et si on faisait le compte ?</p>
          <h2>Prenez une réunion précise.</h2>
          <p class="calc-lead">Le comité de direction, le point d'équipe du lundi, le suivi de projet du jeudi. Une réunion qui revient dans votre agenda, et dont vous vous demandez parfois ce qu'elle produit.</p>
          <button type="button" class="btn" data-next>Faire le calcul</button>
        </div>

        <!-- 1 : participants -->
        <div class="calc-step" data-step="1">
          <h2>Qui est autour de la table ?</h2>
          <p class="calc-lead">Pas besoin de connaître les salaires exacts — on part d'ordres de grandeur, que vous pouvez ajuster.</p>
          <div class="calc-row">
            <div class="calc-who">Direction<small>environ <span data-sal-label="dir"></span> k€ brut par an</small></div>
            <div class="calc-stepper" data-key="dir">
              <button type="button" aria-label="Retirer une personne de la direction">−</button>
              <output aria-live="polite">1</output>
              <button type="button" aria-label="Ajouter une personne de la direction">+</button>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-who">Managers<small>environ <span data-sal-label="man"></span> k€ brut par an</small></div>
            <div class="calc-stepper" data-key="man">
              <button type="button" aria-label="Retirer un manager">−</button>
              <output aria-live="polite">4</output>
              <button type="button" aria-label="Ajouter un manager">+</button>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-who">Collaborateurs<small>environ <span data-sal-label="col"></span> k€ brut par an</small></div>
            <div class="calc-stepper" data-key="col">
              <button type="button" aria-label="Retirer un collaborateur">−</button>
              <output aria-live="polite">3</output>
              <button type="button" aria-label="Ajouter un collaborateur">+</button>
            </div>
          </div>
          <details class="calc-adjust">
            <summary>Ajuster les salaires</summary>
            <div class="calc-sal">
              <label>Direction (k€ brut / an)<input type="number" min="15" max="500" step="5" data-sal="dir" /></label>
              <label>Managers (k€ brut / an)<input type="number" min="15" max="500" step="5" data-sal="man" /></label>
              <label>Collaborateurs (k€ brut / an)<input type="number" min="15" max="500" step="5" data-sal="col" /></label>
            </div>
          </details>
          <button type="button" class="btn calc-continue" data-next>Continuer</button>
        </div>

        <!-- 2 : durée -->
        <div class="calc-step" data-step="2">
          <h2>Combien de temps dure-t-elle ?</h2>
          <p class="calc-lead">En comptant le quart d'heure qui déborde.</p>
          <div class="calc-choices is-cols" data-q="dur">
            <button type="button" class="calc-choice" data-v="0.5">30 minutes</button>
            <button type="button" class="calc-choice" data-v="1">1 heure</button>
            <button type="button" class="calc-choice" data-v="2">2 heures</button>
            <button type="button" class="calc-choice" data-v="4">Une demi-journée</button>
          </div>
        </div>

        <!-- 3 : fréquence -->
        <div class="calc-step" data-step="3">
          <h2>À quelle fréquence revient-elle ?</h2>
          <div class="calc-choices is-cols" data-q="freq">
            <button type="button" class="calc-choice" data-v="220">Chaque jour</button>
            <button type="button" class="calc-choice" data-v="45">Chaque semaine</button>
            <button type="button" class="calc-choice" data-v="22">Tous les 15 jours</button>
            <button type="button" class="calc-choice" data-v="11">Chaque mois</button>
          </div>
        </div>

        <!-- 4 : décisions -->
        <div class="calc-step" data-step="4">
          <h2>Sur les 5 dernières, combien se sont terminées par une décision claire ?</h2>
          <p class="calc-lead">Une décision claire : on sait <strong>quoi</strong>, <strong>qui</strong> s'en charge et <strong>pour quand</strong>.</p>
          <div class="calc-choices is-scale" data-q="dec">
            <button type="button" class="calc-choice" data-v="0">0</button>
            <button type="button" class="calc-choice" data-v="1">1</button>
            <button type="button" class="calc-choice" data-v="2">2</button>
            <button type="button" class="calc-choice" data-v="3">3</button>
            <button type="button" class="calc-choice" data-v="4">4</button>
            <button type="button" class="calc-choice" data-v="5">5</button>
          </div>
          <div class="calc-legend"><span>Aucune</span><span>Toutes les cinq</span></div>
        </div>

        <!-- 5 : personnes en trop -->
        <div class="calc-step" data-step="5">
          <h2>Honnêtement, combien auraient pu ne pas venir ?</h2>
          <p class="calc-lead">Un compte rendu leur aurait suffi.</p>
          <div class="calc-row is-last">
            <div class="calc-who">Sur <span data-ntot></span> participants</div>
            <div class="calc-stepper" data-key="extra">
              <button type="button" aria-label="Moins de personnes en trop">−</button>
              <output aria-live="polite">0</output>
              <button type="button" aria-label="Plus de personnes en trop">+</button>
            </div>
          </div>
          <button type="button" class="btn calc-continue" data-next>Continuer</button>
        </div>

        <!-- 6 : sujets qui reviennent -->
        <div class="calc-step" data-step="6">
          <h2>Combien de fois un même sujet revient-il avant d'être tranché ?</h2>
          <div class="calc-choices" data-q="rep">
            <button type="button" class="calc-choice" data-v="1">Une fois, c'est réglé<small>On en parle, on décide.</small></button>
            <button type="button" class="calc-choice" data-v="2">Deux fois<small>« On en reparle la semaine prochaine. »</small></button>
            <button type="button" class="calc-choice" data-v="3">Trois fois ou plus<small>Certains sujets sont devenus des habitués.</small></button>
          </div>
        </div>

        <!-- 7 : qui anime -->
        <div class="calc-step" data-step="7">
          <h2>Qui anime cette réunion ?</h2>
          <div class="calc-choices" data-q="who">
            <button type="button" class="calc-choice" data-v="moi">Moi</button>
            <button type="button" class="calc-choice" data-v="manager">Un de mes managers</button>
            <button type="button" class="calc-choice" data-v="personne">Personne vraiment<small>Elle s'anime un peu toute seule.</small></button>
          </div>
        </div>

        <!-- 8 : ce que vous voulez -->
        <div class="calc-step" data-step="8">
          <h2>Ce que vous voudriez surtout</h2>
          <div class="calc-choices" data-q="want">
            <button type="button" class="calc-choice" data-v="animer">Mieux animer, moi ou mes managers</button>
            <button type="button" class="calc-choice" data-v="equipe">Que l'équipe décide autrement</button>
            <button type="button" class="calc-choice" data-v="deleguer">Qu'on s'occupe d'un temps fort pour nous<small>Séminaire, atelier, journée stratégique.</small></button>
            <button type="button" class="calc-choice" data-v="changement">Faire avancer un changement qui patine</button>
          </div>
        </div>

        <!-- 9 : résultat -->
        <div class="calc-step" data-step="9" data-result>
          <p class="calc-reslabel">Cette réunion vous coûte</p>
          <p class="calc-big"><span data-annual>0 €</span> <span class="calc-unit">par an</span></p>
          <p class="calc-per">soit <strong data-per></strong> à chaque fois, pour <span data-count-year></span> réunions dans l'année.</p>

          <p class="calc-recover">dont <b data-recover>0 €</b> que vous pourriez récupérer.</p>

          <div class="calc-leaks">
            <div class="calc-leak" data-leak="A">
              <div class="calc-leak-head"><span>Présences en trop</span><b></b></div>
              <div class="calc-track"><i></i></div>
            </div>
            <div class="calc-leak" data-leak="B">
              <div class="calc-leak-head"><span>Réunions qui ne tranchent pas</span><b></b></div>
              <div class="calc-track"><i></i></div>
            </div>
            <div class="calc-leak" data-leak="C">
              <div class="calc-leak-head"><span>Sujets qui reviennent</span><b></b></div>
              <div class="calc-track"><i></i></div>
            </div>
          </div>

          <div class="calc-diag">
            <p class="accent-script calc-script">Votre goulet d'étranglement</p>
            <h3 data-diag-title></h3>
            <p data-diag-text></p>
          </div>

          <div class="calc-offer">
            <p class="eyebrow">Ce que je vous propose</p>
            <h3 data-offer-name></h3>
            <p data-offer-text></p>
            <a class="card-link" data-offer-link href={withBase('/offres/')}>Découvrir cet accompagnement</a>
          </div>

          <div class="calc-actions">
            <a class="btn" data-book href="#">En parler 30 minutes</a>
            <button type="button" class="btn-outline" data-copy>Copier mon résultat</button>
            <button type="button" class="calc-restart" data-restart>Refaire le calcul</button>
          </div>
          <p class="calc-copied" data-copied hidden>Résultat copié. Vous pouvez le coller dans votre prise de rendez-vous ou dans un message.</p>

          <details class="calc-how">
            <summary>Comment ce chiffre est calculé</summary>
            <ul>
              <li>Coût horaire chargé = salaire brut annuel × 1,45 (charges patronales) ÷ 1 600 heures travaillées par an.</li>
              <li>Présences en trop : le temps des personnes qui auraient pu ne pas venir.</li>
              <li>Sujets qui reviennent : 15 % du temps quand un sujet revient deux fois, 30 % quand il revient trois fois ou plus.</li>
              <li>Réunions qui ne tranchent pas : seule <strong>la moitié</strong> du temps d'une réunion sans décision est comptée comme perdue.</li>
              <li>Ce chiffre ne compte que le temps passé en salle. Il ne compte pas le coût des décisions retardées, souvent bien plus élevé.</li>
            </ul>
          </details>
        </div>

        <!-- Compteur en direct, visible pendant les questions -->
        <p class="calc-ticker" data-ticker hidden>Une réunion comme celle-ci coûte déjà <b data-ticker-value></b>.</p>
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Les trois fuites">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Ce que le chiffre révèle</p>
          <h2>Le problème n'est pas le temps passé</h2>
        </div>
        <p>Une réunion longue qui tranche coûte moins cher qu'une réunion courte qui repousse. Trois fuites expliquent presque tout le montant que vous venez de voir.</p>
      </div>
      <div class="cards">
        {fuites.map((f) => (
          <article class="card">
            <div class="num">{f.num}</div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-reveal data-section-name="Ce qu'on peut y changer">
    <div class="container prose">
      <p class="eyebrow">Passer à l'action</p>
      <h2>Une décision qui traîne coûte plus cher que la réunion</h2>
      <p>Tant qu'un sujet n'est pas tranché, tout ce qui en dépend attend : les équipes, les budgets, les clients. C'est ce goulet d'étranglement qui explique la plupart des montants calculés sur cette page — et il ne se règle pas en raccourcissant les réunions, mais en changeant la manière dont on les tient.</p>
      <p><strong>Si c'est vous qui animez</strong>, le levier le plus rapide, c'est votre posture. Je vous prépare à animer vos propres temps collectifs en <a href={withBase('/offres/mentoring/')}>mentoring</a>, ou nous travaillons votre posture de dirigeant en <a href={withBase('/offres/coaching-professionnel/')}>coaching individuel</a>.</p>
      <p><strong>Si c'est le collectif qui coince</strong>, c'est la façon de décider ensemble qu'il faut reprendre : en <a href={withBase('/offres/coaching-equipe/')}>coaching d'équipe</a> dans la durée, ou en installant des pratiques d'<a href={withBase('/intelligence-collective/')}>intelligence collective</a> qui produisent des décisions et pas seulement des échanges.</p>
      <p><strong>Si un temps fort approche</strong>, séminaire ou atelier de décision, vous pouvez me <a href={withBase('/offres/deleguer-animation/')}>déléguer l'animation</a> : vous participez pleinement pendant que je tiens le cadre, et chacun repart avec la trace de ce qui a été décidé.</p>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Questions fréquentes">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Questions fréquentes</p>
          <h2>Sur ce calcul</h2>
        </div>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTABlock
    eyebrow="Votre chiffre vous a surpris ?"
    title="Voyons ce que vous pouvez récupérer."
    subtitle="Un premier échange de 30 minutes pour regarder vos temps collectifs et choisir par où commencer."
  />
</Layout>

<style>
  .calc {
    max-width: 780px;
    margin-inline: auto;
    padding: var(--space-12);
  }
  @media (max-width: 680px) {
    .calc {
      padding: var(--space-6);
    }
  }

  .calc-top {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .calc-top[hidden] {
    display: none;
  }
  .calc-back {
    border: 0;
    background: none;
    color: var(--color-muted);
    font: 500 var(--text-base) / 1 var(--font-body);
    cursor: pointer;
    padding: var(--space-2) 0;
  }
  .calc-bar {
    flex: 1;
    height: 8px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-border) 55%, transparent);
    overflow: hidden;
  }
  .calc-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--color-blue);
    transition: width var(--duration-standard) var(--ease-out);
  }
  .calc-count {
    font-size: var(--text-base);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .calc-step {
    display: none;
  }
  .calc-step.is-active {
    display: block;
  }
  .calc-step h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .calc-script {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-clay-ink);
  }
  .calc-lead {
    color: var(--color-muted);
    margin: var(--space-3) 0 var(--space-6);
  }
  .calc-continue {
    margin-top: var(--space-8);
  }

  /* Questions à choix */
  .calc-choices {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .calc-choices.is-cols {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  .calc-choices.is-scale {
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-2);
  }
  .calc-choice {
    text-align: left;
    background: var(--color-cream);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-6);
    font: 500 var(--text-lg) / 1.35 var(--font-body);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color var(--duration-hover) ease, background var(--duration-hover) ease, transform var(--duration-press) var(--ease-out);
  }
  .calc-choice small {
    display: block;
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-muted);
    margin-top: var(--space-1);
  }
  .calc-choices.is-scale .calc-choice {
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    padding: var(--space-4) 0;
  }
  /* Sous 480px, six colonnes tomberaient à 40px de large : sous la cible
     tactile de 44px. Deux rangées de trois gardent des boutons confortables. */
  @media (max-width: 480px) {
    .calc-choices.is-scale {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .calc-choice.is-on {
    border-color: var(--color-blue);
    background: var(--color-blue-soft);
  }
  .calc-choice:active {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .calc-choice:hover {
      border-color: var(--color-ink);
    }
    .calc-back:hover {
      color: var(--color-ink);
    }
  }
  .calc-legend {
    display: flex;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: var(--text-base);
    margin-top: var(--space-2);
  }

  /* Compteurs de participants */
  .calc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .calc-row.is-last {
    border-bottom: 0;
  }
  .calc-who {
    font-weight: 700;
  }
  .calc-who small {
    display: block;
    font-weight: 400;
    font-size: var(--text-base);
    color: var(--color-muted);
  }
  .calc-stepper {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .calc-stepper button {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--color-border);
    background: var(--color-cream);
    color: var(--color-ink);
    font: 500 1.5rem / 1 var(--font-body);
    cursor: pointer;
  }
  .calc-stepper output {
    min-width: 48px;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
  }
  .calc-adjust {
    margin-top: var(--space-6);
  }
  .calc-adjust summary {
    cursor: pointer;
    color: var(--color-blue);
    font-weight: 500;
  }
  .calc-sal {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .calc-sal label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .calc-sal input {
    width: 140px;
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--color-border);
    background: var(--color-cream);
    color: var(--color-ink);
    font: 500 var(--text-lg) var(--font-body);
    text-align: right;
  }

  /* Compteur en direct */
  .calc-ticker {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px dashed var(--color-border);
    color: var(--color-muted);
  }
  .calc-ticker[hidden] {
    display: none;
  }
  .calc-ticker b {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-ink);
  }

  /* Résultat */
  .calc-reslabel {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }
  .calc-big {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    font-size: clamp(3rem, 10vw, 4.75rem);
    line-height: 1;
    margin: var(--space-2) 0 0;
  }
  .calc-unit {
    font-size: 0.32em;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-muted);
  }
  .calc-per {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }
  .calc-recover {
    margin: var(--space-6) 0 0;
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-orange) 28%, var(--color-surface));
    color: var(--color-navy);
    font-size: var(--text-lg);
  }
  .calc-recover b {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-clay-ink);
    margin: 0 var(--space-2);
  }
  .calc-leaks {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .calc-leak-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .calc-leak-head b {
    font-family: var(--font-display);
    white-space: nowrap;
  }
  .calc-track {
    height: 14px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-border) 45%, transparent);
    overflow: hidden;
  }
  .calc-track i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--color-blue);
    transition: width 0.9s var(--ease-out);
  }
  .calc-leak.is-main .calc-track i {
    background: var(--color-clay);
  }
  .calc-leak.is-main .calc-leak-head span {
    font-weight: 700;
  }
  .calc-diag {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px dashed var(--color-border);
  }
  .calc-diag h3 {
    font-size: var(--text-2xl);
    margin: var(--space-2) 0 var(--space-3);
  }
  .calc-diag p {
    margin: 0;
  }
  .calc-offer {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-sm);
  }
  .calc-offer h3 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
  }
  .calc-offer p {
    margin: 0 0 var(--space-3);
  }
  .calc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .calc-restart {
    border: 0;
    background: none;
    color: var(--color-muted);
    font: 500 var(--text-base) var(--font-body);
    text-decoration: underline;
    cursor: pointer;
  }
  .calc-copied {
    margin: var(--space-3) 0 0;
    color: var(--color-clay-ink);
    font-size: var(--text-base);
  }
  .calc-copied[hidden] {
    display: none;
  }
  .calc-how {
    margin-top: var(--space-8);
    color: var(--color-muted);
  }
  .calc-how summary {
    cursor: pointer;
    color: var(--color-blue);
    font-weight: 500;
  }
  .calc-how ul {
    margin: var(--space-3) 0 0;
    padding-left: var(--space-6);
  }
  .calc-how li {
    margin-bottom: var(--space-2);
  }
</style>

<script>
  import { SITE } from '../data/site';
  import { withBase } from '../utils/url';

  const root = document.querySelector<HTMLElement>('[data-calc]');

  if (root) {
    const TOTAL_Q = 8;
    const RESULT = 9;

    const state = {
      dir: 1,
      man: 4,
      col: 3,
      extra: 0,
      sal: { dir: 90, man: 55, col: 35 } as Record<string, number>,
      dur: 1,
      freq: 45,
      dec: 5,
      rep: 1,
      who: 'moi',
      want: 'animer',
    } as Record<string, any>;

    let step = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const eur = (n: number) => `${Math.round(n).toLocaleString('fr-FR')} €`;
    const round = (n: number) => (n >= 10000 ? Math.round(n / 100) * 100 : Math.round(n / 10) * 10);
    const hourly = (k: number) => (k * 1000 * 1.45) / 1600;
    const people = () => state.dir + state.man + state.col;
    const perHour = () =>
      state.dir * hourly(state.sal.dir) + state.man * hourly(state.sal.man) + state.col * hourly(state.sal.col);

    function compute() {
      const n = people();
      const perMeeting = perHour() * state.dur;
      const annual = perMeeting * state.freq;
      const a = n ? (annual * Math.min(state.extra, n)) / n : 0;
      const rest = annual - a;
      const repShare: Record<number, number> = { 1: 0, 2: 0.15, 3: 0.3 };
      const c = rest * repShare[state.rep as number];
      const b = ((rest - c) * (5 - state.dec)) / 5 * 0.5;
      return { n, perMeeting, annual, a, b, c, recover: a + b + c };
    }

    /* Salaires ajustables */
    const salLabels = root.querySelectorAll<HTMLElement>('[data-sal-label]');
    const syncSalaries = () => {
      salLabels.forEach((el) => (el.textContent = String(state.sal[el.dataset.salLabel as string])));
      updateTicker();
    };
    root.querySelectorAll<HTMLInputElement>('[data-sal]').forEach((input) => {
      const key = input.dataset.sal as string;
      input.value = String(state.sal[key]);
      input.addEventListener('input', () => {
        const v = Number(input.value);
        if (v >= 15 && v <= 500) {
          state.sal[key] = v;
          syncSalaries();
        }
      });
    });

    /* Compteurs + / − */
    const extraOutput = root.querySelector<HTMLOutputElement>('[data-key="extra"] output');
    const clampExtra = () => {
      state.extra = Math.min(state.extra, people());
      if (extraOutput) extraOutput.textContent = String(state.extra);
    };
    root.querySelectorAll<HTMLElement>('.calc-stepper').forEach((stepper) => {
      const key = stepper.dataset.key as string;
      const output = stepper.querySelector('output') as HTMLOutputElement;
      const [minus, plus] = Array.from(stepper.querySelectorAll('button'));
      const max = () => (key === 'extra' ? people() : 30);
      const render = () => (output.textContent = String(state[key]));
      minus.addEventListener('click', () => {
        state[key] = Math.max(0, state[key] - 1);
        if (key !== 'extra' && people() === 0) state[key] = 1;
        render();
        clampExtra();
        updateTicker();
      });
      plus.addEventListener('click', () => {
        state[key] = Math.min(max(), state[key] + 1);
        render();
        updateTicker();
      });
      render();
    });

    /* Questions à choix : la réponse fait avancer */
    root.querySelectorAll<HTMLElement>('[data-q]').forEach((group) => {
      const key = group.dataset.q as string;
      const choices = Array.from(group.querySelectorAll<HTMLButtonElement>('.calc-choice'));
      choices.forEach((choice) => {
        choice.addEventListener('click', () => {
          choices.forEach((c) => c.classList.toggle('is-on', c === choice));
          const raw = choice.dataset.v as string;
          state[key] = Number.isNaN(Number(raw)) ? raw : Number(raw);
          window.setTimeout(() => go(step + 1), reduced ? 0 : 220);
        });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((b) =>
      b.addEventListener('click', () => go(step + 1)),
    );
    root.querySelector<HTMLButtonElement>('[data-back]')?.addEventListener('click', () => go(step - 1));
    root.querySelector<HTMLButtonElement>('[data-restart]')?.addEventListener('click', () => {
      root.querySelectorAll('.calc-choice.is-on').forEach((c) => c.classList.remove('is-on'));
      state.extra = 0;
      clampExtra();
      go(0);
    });

    /* Compteur en direct pendant les questions */
    const ticker = root.querySelector<HTMLElement>('[data-ticker]');
    const tickerValue = root.querySelector<HTMLElement>('[data-ticker-value]');
    function updateTicker() {
      if (!ticker || !tickerValue) return;
      const visible = step >= 2 && step < RESULT;
      ticker.hidden = !visible;
      if (visible) tickerValue.textContent = eur(round(perHour() * state.dur));
    }

    /* Navigation */
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.calc-step'));
    const top = root.querySelector<HTMLElement>('[data-top]');
    const bar = root.querySelector<HTMLElement>('[data-bar]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const ntot = root.querySelector<HTMLElement>('[data-ntot]');

    function go(n: number) {
      const previous = step;
      step = Math.max(0, Math.min(RESULT, n));
      steps.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.step) === step));
      if (top) top.hidden = step === 0 || step === RESULT;
      if (bar) bar.style.width = `${(step / TOTAL_Q) * 100}%`;
      if (count) count.textContent = `${step} / ${TOTAL_Q}`;
      if (ntot) ntot.textContent = String(people());
      if (step === RESULT) showResult();
      updateTicker();
      if (previous !== step && step > 0) {
        const y = root!.getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top: y, behavior: reduced ? 'auto' : 'smooth' });
      }
    }

    function countUp(el: HTMLElement | null, to: number) {
      if (!el) return;
      if (reduced) {
        el.textContent = eur(to);
        return;
      }
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / 1100);
        el.textContent = eur(to * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    /* Diagnostic et offre */
    const diagnostics: Record<string, () => [string, string]> = {
      a: () => [
        'Trop de monde autour de la table',
        `${state.extra} personne${state.extra > 1 ? 's' : ''} sur ${people()} aurai${state.extra > 1 ? 'ent' : 't'} pu faire autre chose. Inviter large rassure, mais chaque présence inutile se paie — et elle dilue la décision de ceux qui avaient quelque chose à trancher.`,
      ],
      b: () => [
        'Vous échangez, mais vous ne tranchez pas',
        `Seulement ${state.dec} réunion${state.dec > 1 ? 's' : ''} sur 5 se termine${state.dec > 1 ? 'nt' : ''} par une décision claire. Le problème n'est pas le temps passé : c'est ce qui en sort, et ce qui reste à faire une fois la salle vidée.`,
      ],
      c: () => [
        'Les mêmes sujets reviennent',
        "Un sujet non tranché ne disparaît pas : il revient, réunion après réunion, pendant que tout ce qui en dépend attend. C'est là que se forme le goulet d'étranglement, et il coûte bien plus que le temps passé à en reparler.",
      ],
      ok: () => [
        'Vos réunions tiennent la route',
        "Elles décident, sans monde en trop. L'enjeu n'est plus de réparer : c'est de tenir ce niveau quand la pression monte, et de le transmettre à ceux qui animeront à votre place.",
      ],
    };

    function offer(): [string, string, string] {
      const lead: Record<string, string> = {
        moi: 'Le levier le plus rapide, c’est vous. ',
        manager: 'Le levier, c’est celui ou celle qui anime. ',
        personne: 'Commencez par confier l’animation à quelqu’un, et préparez-le. ',
      };
      const offers: Record<string, [string, string, string]> = {
        animer: [
          'Le mentoring',
          `${lead[state.who]}Je vous prépare à animer vous-même : posture, déroulé, méthodes, répétition.`,
          '/offres/mentoring/',
        ],
        equipe: [
          "Le coaching d'équipe",
          "Séminaires, ateliers réguliers et coaching du manager, dans la durée, pour faire évoluer la façon de travailler et de décider.",
          '/offres/coaching-equipe/',
        ],
        deleguer: [
          "Déléguer l'animation d'un temps collectif",
          "Je conçois et j'anime votre séminaire ou votre atelier de bout en bout : cadrage, facilitation graphique, synthèse, prochaines étapes.",
          '/offres/deleguer-animation/',
        ],
        changement: [
          'Accompagnement des transformations',
          "Débloquer une transformation qui reste sur le papier, en créant les conditions d'un changement réellement adopté.",
          '/offres/accompagnement-transformation/',
        ],
      };
      return offers[state.who === 'personne' && state.want === 'animer' ? 'animer' : state.want];
    }

    let summary = '';

    function showResult() {
      const r = compute();
      countUp(root!.querySelector('[data-annual]'), round(r.annual));
      countUp(root!.querySelector('[data-recover]'), round(r.recover));
      const per = root!.querySelector<HTMLElement>('[data-per]');
      if (per) per.textContent = eur(round(r.perMeeting));
      const yearly = root!.querySelector<HTMLElement>('[data-count-year]');
      if (yearly) yearly.textContent = String(state.freq);

      const leaks: Record<string, number> = { A: r.a, B: r.b, C: r.c };
      const main = Object.entries(leaks).sort((x, y) => y[1] - x[1])[0];
      const max = Math.max(1, ...Object.values(leaks));
      root!.querySelectorAll<HTMLElement>('.calc-leak').forEach((el) => {
        const value = leaks[el.dataset.leak as string];
        const label = el.querySelector('b');
        if (label) label.textContent = eur(round(value));
        el.classList.toggle('is-main', el.dataset.leak === main[0] && main[1] > 0);
        const fill = el.querySelector<HTMLElement>('.calc-track i');
        if (fill) {
          fill.style.width = '0';
          requestAnimationFrame(() => requestAnimationFrame(() => (fill.style.width = `${(value / max) * 100}%`)));
        }
      });

      const key = r.recover < r.annual * 0.05 ? 'ok' : main[0].toLowerCase();
      const [diagTitle, diagText] = diagnostics[key]();
      const titleEl = root!.querySelector<HTMLElement>('[data-diag-title]');
      const textEl = root!.querySelector<HTMLElement>('[data-diag-text]');
      if (titleEl) titleEl.textContent = diagTitle;
      if (textEl) textEl.textContent = diagText;

      const [offerName, offerText, offerPath] = offer();
      const nameEl = root!.querySelector<HTMLElement>('[data-offer-name]');
      const offerTextEl = root!.querySelector<HTMLElement>('[data-offer-text]');
      const linkEl = root!.querySelector<HTMLAnchorElement>('[data-offer-link]');
      if (nameEl) nameEl.textContent = offerName;
      if (offerTextEl) offerTextEl.textContent = offerText;
      if (linkEl) linkEl.href = withBase(offerPath);

      const bookEl = root!.querySelector<HTMLAnchorElement>('[data-book]');
      if (bookEl) {
        bookEl.href = SITE.bookingUrl;
        bookEl.target = '_blank';
        bookEl.rel = 'noopener';
      }

      summary = [
        `Coût de ma réunion : ${eur(round(r.annual))} par an (${eur(round(r.perMeeting))} par réunion, ${state.freq} par an).`,
        `Récupérable : ${eur(round(r.recover))}.`,
        `Présences en trop : ${eur(round(r.a))} · Réunions sans décision : ${eur(round(r.b))} · Sujets qui reviennent : ${eur(round(r.c))}.`,
        `Mon point de blocage : ${diagTitle}.`,
        `Ce que je cherche : ${offerName}.`,
      ].join('\n');

      const copied = root!.querySelector<HTMLElement>('[data-copied]');
      if (copied) copied.hidden = true;
    }

    root.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
      const copied = root!.querySelector<HTMLElement>('[data-copied]');
      try {
        await navigator.clipboard.writeText(summary);
        if (copied) copied.hidden = false;
      } catch {
        if (copied) {
          copied.textContent = "La copie automatique n'est pas autorisée par votre navigateur : sélectionnez le résultat à la main.";
          copied.hidden = false;
        }
      }
    });

    syncSalaries();
  }
</script>
