---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Cas clients — by Nicolas Verdot"
  description="Ce que donnent concrètement les accompagnements : contexte, défi, dispositif conçu et résultats, situation par situation."
  path="/cas-clients/"
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Cas clients', path: '/cas-clients/' },
  ]}
>
  <PageHero
    eyebrow="Cas clients"
    title="Ce que ça donne concrètement"
    summary="Le contexte, le défi, le dispositif conçu et les résultats — situation par situation, sans chiffres ni témoignages inventés."
  />

  <section class="section" data-reveal>
    <div class="container">
      <div class="cards">
        {caseStudies.map((cs) => (
          <article class="card">
            {cs.data.clientLogo ? (
              <img src={withBase(cs.data.clientLogo)} alt={cs.data.client} class="case-card-logo" />
            ) : (
              <div class="num">{cs.data.client}</div>
            )}
            <h3>{cs.data.title}</h3>
            <p>{cs.data.summary}</p>
            <a class="card-link" href={withBase(`/cas-clients/${cs.slug}/`)}>Découvrir le cas client</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTABlock
    eyebrow="Une situation similaire ?"
    title="Parlons de votre contexte et de ce qui doit avancer."
    subtitle="Chaque accompagnement part d'une situation précise, jamais d'une méthode plaquée à l'avance."
  />
</Layout>

<style>
  .case-card-logo {
    display: block;
    height: 32px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    margin-bottom: var(--space-3);
  }
</style>
