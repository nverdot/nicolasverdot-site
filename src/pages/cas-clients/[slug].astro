---
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import Lightbox from '../../components/Lightbox.astro';
import { withBase } from '../../utils/url';
import { factsheetIcon } from '../../utils/factsheetIcons';
import { findPriorityByHref } from '../../data/priorities';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies', ({ data }) => !data.draft);
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs },
  }));
}

interface Props {
  cs: CollectionEntry<'caseStudies'>;
}

const { cs } = Astro.props;
const { Content } = await cs.render();

const ctaTitle = cs.data.ctaTitle ?? 'Un besoin similaire dans votre organisation ?';
const ctaSubtitle = cs.data.ctaSubtitle ?? "Parlons de votre contexte pour identifier l'accompagnement le plus utile.";
const offerLabel = cs.data.offerLabel ?? "Voir l'offre";
const relatedPriority = cs.data.offerHref ? findPriorityByHref(cs.data.offerHref) : undefined;

// Piste "structurée" (nouveau template) si les nouveaux champs sont renseignés,
// sinon on retombe sur le rendu markdown existant — le temps de migrer les autres cas.
const hasStructuredContent = Boolean(
  cs.data.role || (cs.data.process && cs.data.process.length > 0) || (cs.data.chapters && cs.data.chapters.length > 0)
);

const metaItems = cs.data.factsheet ?? [];
const finaliteItem = metaItems.find((i) => i.label === 'Finalité');
const smallMetaItems = metaItems.filter((i) => i !== finaliteItem).slice(0, 4);

const processIcons = ['eye', 'board', 'search', 'bulb', 'check'];

const icons: Record<string, string> = {
  eye: '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
  board: '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 20h8M12 16v4"/>',
  search: '<circle cx="10" cy="10" r="7"/><path d="M20 20l-5.2-5.2"/>',
  bulb: '<path d="M9 18h6M10 22h4M12 2a6 6 0 0 0-4 10.5c.6.5 1 1.3 1 2.1V16h6v-1.4c0-.8.4-1.6 1-2.1A6 6 0 0 0 12 2z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  checkmark: '<path d="M5 12l5 5L20 7"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-2 5-5 2 2-5 5-2z"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6"/>',
};

const caseStudySchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: cs.data.title,
  description: cs.data.summary,
  about: cs.data.client,
  inLanguage: 'fr-FR',
  author: {
    '@type': 'Person',
    name: 'Nicolas Verdot',
    jobTitle: 'Facilitateur, coach professionnel et formateur',
    url: new URL(withBase('/a-propos/'), Astro.site).toString(),
  },
  publisher: {
    '@type': 'Person',
    name: 'Nicolas Verdot',
  },
  mainEntityOfPage: new URL(withBase(`/cas-clients/${cs.slug}/`), Astro.site).toString(),
};
---

<Layout
  title={`${cs.data.client} — ${cs.data.title} — by Nicolas Verdot`}
  description={cs.data.summary}
  path={`/cas-clients/${cs.slug}/`}
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Cas clients', path: '/cas-clients/' },
    { name: cs.data.client, path: `/cas-clients/${cs.slug}/` },
  ]}
>
  <article class="case">
    <!-- CaseStudyHero -->
    <header class="case-hero">
      <div class="container case-hero-grid">
        <div class="case-hero-copy">
          <a href={withBase('/cas-clients/')} class="back-link">← Tous les cas clients</a>
          <div class="case-client">
            {cs.data.clientLogo && <img src={withBase(cs.data.clientLogo)} alt={cs.data.client} class="case-client-logo" />}
            <p class="eyebrow">Cas client · {cs.data.client}</p>
          </div>
          <h1>{cs.data.title}</h1>
          <p class="case-subtitle">{cs.data.subtitle}</p>
          <p class="case-lead">{cs.data.summary}</p>
          <div class="case-hero-actions">
            <a href={withBase('/contact/')} class="btn">Parler de votre besoin</a>
            {relatedPriority && (
              <a class="case-hero-offer-link" href={withBase(cs.data.offerHref!)}>
                Découvrir l'offre : {relatedPriority.title} →
              </a>
            )}
          </div>
        </div>
        <div class="case-hero-media">
          {cs.data.heroImage ? (
            <img src={withBase(cs.data.heroImage)} alt={cs.data.heroImageAlt ?? cs.data.title} class="case-hero-photo" />
          ) : (
            <div class="case-hero-placeholder" role="img" aria-label="Emplacement photo à venir">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M21 16l-5-5-4 4-3-3-6 6"/></svg>
              <span>Photo à venir</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- CaseStudyMeta -->
    {metaItems.length > 0 && (
      <section class="case-meta" data-reveal>
        <div class="container case-meta-grid">
          {smallMetaItems.map((item) => (
            <div class="case-meta-card">
              <span class="case-meta-icon" aria-hidden="true">{factsheetIcon(item.label)}</span>
              <strong>{item.label}</strong>
              <p>{item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a> : item.value}</p>
            </div>
          ))}
          {finaliteItem && (
            <div class="case-meta-card case-meta-card-lead">
              <span class="case-meta-icon" aria-hidden="true">{factsheetIcon(finaliteItem.label)}</span>
              <strong>{finaliteItem.label}</strong>
              <p>{finaliteItem.value}</p>
            </div>
          )}
        </div>
      </section>
    )}

    {hasStructuredContent ? (
      <>
        <!-- CaseStudyChallenge -->
        <section class="section case-challenge" data-reveal>
          <div class="container case-challenge-grid">
            <div>
              <p class="eyebrow">Le point de départ</p>
              <div class="case-question-frame">
                <p>{cs.data.question}</p>
              </div>
              {cs.data.challengeText && <p class="case-challenge-text">{cs.data.challengeText}</p>}
            </div>
            {cs.data.process && cs.data.process.length > 0 && (
              <div class="case-challenge-chain" aria-hidden="true">
                {cs.data.process.map((step, i) => (
                  <>
                    <div class="case-chain-step">
                      <span class="case-chain-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[processIcons[i % processIcons.length]]} /></span>
                      <span>{step.title}</span>
                    </div>
                    {i < cs.data.process!.length - 1 && <span class="case-chain-arrow">→</span>}
                  </>
                ))}
              </div>
            )}
          </div>
        </section>

        <!-- CaseStudyRole -->
        {cs.data.role && (
          <section class="section alt case-role" data-reveal>
            <div class="container">
              <div class="section-head">
                <div>
                  <p class="eyebrow">Notre rôle</p>
                  <h2>Répartir la responsabilité du fond et celle du processus</h2>
                </div>
              </div>
              <div class="case-role-grid">
                <div class="case-role-col">
                  <div class="case-role-head">
                    <span class="case-role-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.compass} /></span>
                    <h3>{cs.data.role.expertiseTitle}</h3>
                  </div>
                  <ul>
                    {cs.data.role.expertiseItems.map((item) => (
                      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.checkmark} />{item}</li>
                    ))}
                  </ul>
                </div>
                <div class="case-role-col case-role-col-accent">
                  <div class="case-role-head">
                    <span class="case-role-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.shield} /></span>
                    <h3>{cs.data.role.responsibilityTitle}</h3>
                  </div>
                  <ul>
                    {cs.data.role.responsibilityItems.map((item) => (
                      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons.checkmark} />{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- CaseStudyProcess -->
        {cs.data.process && cs.data.process.length > 0 && (
          <section class="section case-process" data-reveal>
            <div class="container">
              <div class="section-head">
                <div>
                  <p class="eyebrow">Le processus</p>
                  <h2>Comment nous avons travaillé</h2>
                </div>
              </div>
              <div class="case-process-frieze">
                {cs.data.process.map((step, i) => (
                  <>
                    <div class="case-process-step">
                      <span class="case-process-num">{i + 1}</span>
                      <span class="case-process-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[processIcons[i % processIcons.length]]} /></span>
                      <strong>{step.title}</strong>
                      <p>{step.text}</p>
                    </div>
                    {i < cs.data.process!.length - 1 && <span class="case-process-line" aria-hidden="true"></span>}
                  </>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- CaseStudyChapter (repeated) -->
        {cs.data.chapters && cs.data.chapters.map((chapter, ci) => (
          <section class={`section ${ci % 2 === 0 ? 'alt' : ''} case-chapter`} data-reveal>
            <div class="container">
              <div class="case-chapter-head">
                <span class="case-chapter-num">{chapter.number}</span>
                <div>
                  <p class="eyebrow">{chapter.title}</p>
                  <h2>{chapter.subtitle}</h2>
                </div>
              </div>
              <div class="case-chapter-grid">
                <div class="case-chapter-text">
                  <p><strong>Le contexte.</strong> {chapter.context}</p>
                  <p><strong>Le défi.</strong> {chapter.challenge}</p>
                  <p><strong>L'accompagnement.</strong> {chapter.approach}</p>
                </div>
                {chapter.image && (
                  <img src={withBase(chapter.image)} alt={chapter.imageAlt ?? chapter.title} class="case-chapter-photo" data-lightbox-scope />
                )}
              </div>
              <p class="case-chapter-results-title">{chapter.resultsTitle}</p>
              <div class="case-chapter-results">
                {chapter.results.map((r) => (
                  <div class="case-result-card">
                    <span class="case-result-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons.checkmark} /></span>
                    <strong>{r.title}</strong>
                    <p>{r.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        ))}

        <!-- CaseStudyGallery -->
        {cs.data.gallery && (
          <section class="section alt case-gallery-section" data-reveal data-lightbox-scope>
            <div class="container">
              <div class="case-gallery-grid">
                <div class="case-gallery-copy">
                  <p class="eyebrow">Facilitation graphique</p>
                  <h2>{cs.data.gallery.title}</h2>
                  {cs.data.gallery.text && <p>{cs.data.gallery.text}</p>}
                  {cs.data.gallery.process.length > 0 && (
                    <div class="case-gallery-process">
                      {cs.data.gallery.process.map((step, i) => (
                        <>
                          <span>{step}</span>
                          {i < cs.data.gallery!.process.length - 1 && <span class="case-gallery-process-arrow" aria-hidden="true">→</span>}
                        </>
                      ))}
                    </div>
                  )}
                </div>
                <div class="case-gallery-media">
                  {cs.data.gallery.images.length > 0 ? (
                    cs.data.gallery.images.map((img) => (
                      <img src={withBase(img.src)} alt={img.alt} class={img.wide ? 'case-gallery-wide' : ''} />
                    ))
                  ) : (
                    <div class="case-hero-placeholder case-gallery-placeholder" role="img" aria-label="Emplacements photos de fresque à venir">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M21 16l-5-5-4 4-3-3-6 6"/></svg>
                      <span>Photos de fresque à venir</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- CaseStudyImpact -->
        {cs.data.impact && cs.data.impact.length > 0 && (
          <section class="section case-impact" data-reveal>
            <div class="container">
              <div class="section-head">
                <div>
                  <p class="eyebrow">Ce que ça a changé</p>
                  <h2>Ce que la facilitation a changé</h2>
                </div>
              </div>
              <div class="case-impact-grid">
                {cs.data.impact.map((item) => (
                  <div class="case-impact-card">
                    <span class="case-impact-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.spark} /></span>
                    <strong>{item.title}</strong>
                    <p>{item.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        <!-- Closing editorial -->
        {cs.data.closingText && (
          <section class="section dark case-closing" data-reveal>
            <div class="container case-closing-inner">
              {cs.data.closingTitle && <h2>{cs.data.closingTitle}</h2>}
              <p>{cs.data.closingText}</p>
            </div>
          </section>
        )}
      </>
    ) : (
      <div class="container prose">
        <div class="case-question-frame">
          <p>{cs.data.question}</p>
        </div>
        <div class="case-content" data-case-content data-lightbox-scope>
          <Content />
        </div>
      </div>
    )}
  </article>

  <Lightbox />

  <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />

  <CTABlock
    title={ctaTitle}
    subtitle={ctaSubtitle}
    {...(cs.data.offerHref ? { secondaryLabel: offerLabel, secondaryHref: withBase(cs.data.offerHref) } : {})}
  />
</Layout>

<style>
  /* --- CaseStudyHero --- */
  .case-hero {
    padding: var(--space-12) 0;
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-bottom: 1px solid var(--color-border);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .case-hero { background: var(--color-cream); }
  }
  :root[data-theme='dark'] .case-hero { background: var(--color-cream); }
  .case-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
  }
  .case-client {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .case-client-logo {
    height: 40px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
  }
  .case-hero-copy h1 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    max-width: 22ch;
  }
  .case-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-blue);
    font-weight: 600;
    margin: 0 0 var(--space-4);
    max-width: 46ch;
  }
  .case-lead {
    color: var(--color-muted);
    max-width: 52ch;
    margin: 0 0 var(--space-6);
  }
  .case-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .case-hero-offer-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .case-hero-media {
    position: relative;
  }
  .case-hero-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    display: block;
  }
  .case-hero-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    border: 1.5px dashed var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .case-hero-placeholder svg { width: 32px; height: 32px; opacity: 0.6; }

  /* --- CaseStudyMeta --- */
  .case-meta { padding: var(--space-8) 0 0; }
  .case-meta-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.3fr;
    gap: var(--space-3);
  }
  .case-meta-card {
    padding: var(--space-4);
    border-radius: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .case-meta-card-lead {
    background: color-mix(in srgb, var(--color-orange) 12%, var(--color-surface));
    border-color: var(--color-orange);
  }
  .case-meta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--color-blue-soft);
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }
  .case-meta-card-lead .case-meta-icon { background: var(--color-orange); }
  .case-meta-card strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-navy);
    margin-bottom: 2px;
  }
  .case-meta-card p {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.4;
  }
  .case-meta-card-lead p { color: var(--color-ink); }

  /* --- CaseStudyChallenge --- */
  .case-challenge-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: start;
  }
  .case-question-frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: var(--space-6);
    margin: var(--space-2) 0 var(--space-4);
  }
  .case-question-frame p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-navy);
    line-height: 1.4;
  }
  .case-challenge-text {
    color: var(--color-muted);
    line-height: 1.7;
  }
  .case-challenge-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }
  .case-chain-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
    width: 84px;
  }
  .case-chain-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-blue-soft);
    color: var(--color-blue);
  }
  .case-chain-icon svg { width: 16px; height: 16px; }
  .case-chain-step span:last-child {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .case-chain-arrow { color: var(--color-border); font-size: var(--text-lg); }

  /* --- CaseStudyRole --- */
  .case-role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  .case-role-col {
    padding: var(--space-6);
    border-radius: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .case-role-col-accent {
    background: var(--color-ink-solid);
    border-color: var(--color-ink-solid);
  }
  .case-role-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .case-role-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--color-blue-soft);
    color: var(--color-blue);
    flex-shrink: 0;
  }
  .case-role-col-accent .case-role-icon { background: var(--color-orange); color: var(--color-navy); }
  .case-role-col h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-navy);
  }
  .case-role-col-accent h3 { color: var(--color-white); }
  .case-role-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .case-role-col li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink);
    line-height: 1.5;
  }
  .case-role-col-accent li { color: rgba(255, 255, 255, 0.9); }
  .case-role-col li svg {
    width: 16px;
