---
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import Lightbox from '../../components/Lightbox.astro';
import { withBase } from '../../utils/url';
import { factsheetIcon } from '../../utils/factsheetIcons';
import { findPriorityByHref } from '../../data/priorities';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('caseStudies', ({ data }) => !data.draft);
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs },
  }));
}

interface Props {
  cs: CollectionEntry<'caseStudies'>;
}

const { cs } = Astro.props;
const { Content } = await cs.render();

const ctaTitle = cs.data.ctaTitle ?? 'Un besoin similaire dans votre organisation ?';
const ctaSubtitle = cs.data.ctaSubtitle ?? "Parlons de votre contexte pour identifier l'accompagnement le plus utile.";
const offerLabel = cs.data.offerLabel ?? "Voir l'offre";
const relatedPriority = cs.data.offerHref ? findPriorityByHref(cs.data.offerHref) : undefined;

const caseStudySchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: cs.data.title,
  description: cs.data.summary,
  about: cs.data.client,
  inLanguage: 'fr-FR',
  author: {
    '@type': 'Person',
    name: 'Nicolas Verdot',
    jobTitle: 'Facilitateur, coach professionnel et formateur',
    url: new URL(withBase('/a-propos/'), Astro.site).toString(),
  },
  publisher: {
    '@type': 'Person',
    name: 'Nicolas Verdot',
  },
  mainEntityOfPage: new URL(withBase(`/cas-clients/${cs.slug}/`), Astro.site).toString(),
};
---

<Layout
  title={`${cs.data.client} — ${cs.data.title} — by Nicolas Verdot`}
  description={cs.data.summary}
  path={`/cas-clients/${cs.slug}/`}
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Cas clients', path: '/cas-clients/' },
    { name: cs.data.client, path: `/cas-clients/${cs.slug}/` },
  ]}
>
  <article class="case">
    <header class="case-hero">
      <div class="container">
        <a href={withBase('/cas-clients/')} class="back-link">← Tous les cas clients</a>
        <div class="case-client">
          {cs.data.clientLogo && <img src={withBase(cs.data.clientLogo)} alt={cs.data.client} class="case-client-logo" />}
          <p class="eyebrow">Cas client — {cs.data.client}</p>
        </div>
        <h1>{cs.data.title}</h1>
        <p class="case-subtitle">{cs.data.subtitle}</p>

        {relatedPriority && (
          <a class="case-offer-tag" href={withBase(cs.data.offerHref!)}>
            # {relatedPriority.title}
          </a>
        )}

        {cs.data.factsheet && cs.data.factsheet.length > 0 && (
          <dl class="case-factsheet">
            {cs.data.factsheet.map((item) => (
              <div class="case-factsheet-item">
                <dt><span aria-hidden="true">{factsheetIcon(item.label)}</span> {item.label}</dt>
                <dd>
                  {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a> : item.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <div class="container prose">
      <div class="case-question-frame">
        <p>{cs.data.question}</p>
      </div>

      <div class="case-content" data-case-content data-lightbox-scope>
        <Content />
      </div>
    </div>
  </article>

  <Lightbox />

  <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />

  <CTABlock
    title={ctaTitle}
    subtitle={ctaSubtitle}
    {...(cs.data.offerHref ? { secondaryLabel: offerLabel, secondaryHref: withBase(cs.data.offerHref) } : {})}
  />
</Layout>

<style>
  .case-hero {
    padding: var(--space-8) 0 var(--space-6);
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy);
    text-decoration: none;
  }
  .case-client {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .case-client-logo {
    height: 56px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }
  .case-hero h1 {
    max-width: 44ch;
  }
  .case-subtitle {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin: 0;
    max-width: 60ch;
  }
  .case-offer-tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin: var(--space-3) 0 0;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-navy);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease-out, border-color 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .case-offer-tag:hover {
      background: var(--color-cream);
      border-color: var(--color-navy);
    }
  }
  .case-factsheet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: var(--space-8) 0 0;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .case-factsheet-item dt {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }
  .case-factsheet-item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
    line-height: 1.4;
  }
  .case-factsheet-item dd a {
    color: var(--color-navy);
    font-weight: 600;
  }
  .case-question-frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    margin: var(--space-2) 0 var(--space-8);
  }
  .case-question-frame p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-navy);
    line-height: 1.4;
  }
  .case-content {
    line-height: 1.75;
  }
  .case-content :global(h2) {
    font-size: var(--text-2xl);
    margin-top: var(--space-8);
  }
  .case-content :global(h3) {
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin-top: var(--space-6);
  }
  .case-content :global(blockquote) {
    margin: var(--space-4) 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-orange);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-navy);
    font-style: italic;
  }
  .case-content :global(blockquote p) {
    margin: 0;
  }
  .case-content :global(ul) {
    padding-left: var(--space-6);
  }
  .case-content :global(li) {
    margin-bottom: var(--space-2);
  }
  .case-content :global(a) {
    color: var(--color-navy);
    font-weight: 600;
  }
  .case-content :global(.case-gallery) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin: var(--space-6) 0;
  }
  .case-content :global(.case-gallery-wide) {
    margin: var(--space-6) 0;
  }
  .case-content :global(.case-gallery figure),
  .case-content :global(figure.case-gallery-wide) {
    margin: 0;
  }
  .case-content :global(.case-gallery img),
  .case-content :global(.case-gallery-wide img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    cursor: zoom-in;
    transition: opacity 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .case-content :global(.case-gallery img:hover),
    .case-content :global(.case-gallery-wide img:hover) {
      opacity: 0.85;
    }
  }
  .case-content :global(figcaption) {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-style: italic;
  }
  @media (max-width: 700px) {
    .case-content :global(.case-gallery) {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .case-question-frame {
      padding: var(--space-4);
    }
    .case-question-frame p {
      font-size: var(--text-lg);
    }
  }
</style>
