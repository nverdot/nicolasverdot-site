---
import PageSeminaire from '../components/PageSeminaire.astro';

// Page d'entrée depuis Google sur « coach agile », « coaching Scrum / SAFe /
// Kanban ». Elle n'est pas dans le menu : elle est rangée sous la troisième
// porte (data/portes.ts) et renvoie vers le coaching d'équipe, la
// transformation et les formations.
//
// Tout ce qui est affirmé ici vient de pages déjà publiées : le parcours
// (a-propos), les missions Air France-KLM et Urssaf / Acoss (cas clients),
// les trois formations de la catégorie « Agile, produit & amélioration
// continue ». Aucune certification n'est mentionnée : Nicolas ne m'en a
// confirmé aucune. Les « signes » sont des cas de figure fréquents, pas des
// citations de clients.
---

<PageSeminaire
  seo={{
    title: 'Coach agile : Scrum, SAFe, Kanban — Nicolas Verdot',
    description:
      "Coach agile à Nice et partout en France : Scrum, SAFe, Kanban. J'aide vos équipes à livrer régulièrement et à se synchroniser, sans plaquer un cadre.",
    path: '/coaching-agile/',
    fil: 'Coaching agile',
    serviceType: 'Coaching agile',
    serviceName: 'Coaching agile : Scrum, SAFe, Kanban',
  }}
  parent={{ name: 'Les offres', path: '/offres/' }}
  signature="Nicolas Verdot — coach agile et facilitateur, Nice"
  renvoiSeminaires={false}
  zones={['Nice', 'Sophia Antipolis', 'Alpes-Maritimes', "Provence-Alpes-Côte d'Azur", 'France']}
  hero={{
    eyebrow: 'Coach agile · Scrum · SAFe · Kanban',
    title: 'Coach agile :',
    titleAccent: 'des équipes qui livrent,',
    titleTail: 'pas un cadre de plus.',
    summary:
      "Les rituels sont en place, les tableaux sont pleins, et la livraison ne suit toujours pas. J'accompagne vos équipes et leurs rôles clés — Scrum Masters, Product Owners, Release Train Engineers, managers — pour que <strong>Scrum, SAFe ou Kanban</strong> servent vos enjeux métiers, au lieu de s'y ajouter.",
    pills: ['Scrum', 'SAFe', 'Kanban', 'Coaching des rôles agiles'],
  }}
  signaux={{
    eyebrow: 'Ce qui revient souvent',
    title: 'Six signes que l’agilité s’est installée sans produire d’effet',
