      {
        title: 'On livre, mais pas ce qui compte',
        text: "Le backlog avance. Le lien avec les enjeux métiers, lui, s'est perdu en route.",
      },
      {
        title: 'Des équipes qui s’attendent',
        text: "Chaque équipe tient ses engagements. Ce sont les dépendances entre équipes qui bloquent tout.",
      },
      {
        title: 'Des rôles flous',
        text: "Product Owner, Scrum Master, manager : chacun a un titre, peu savent qui décide quoi.",
      },
      {
        title: 'Un cadre appliqué à la lettre',
        text: "Scrum ou SAFe ont été déployés tels quels. Le terrain, lui, n'a pas été consulté.",
      },
      {
        title: 'Des rétrospectives qui tournent en rond',
        text: "Les mêmes irritants reviennent d'un sprint à l'autre, sans suite.",
      },
    ],
    chute:
      "<strong>Le problème est rarement le cadre que vous avez choisi.</strong><br /><span class=\"accent\">C'est ce qu'on lui demande de résoudre à la place des personnes.</span>",
  }}
  resultats={{
    eyebrow: 'Ce que l’on vise',
    title: 'Une organisation qui se synchronise et qui apprend',
    intro: "Les objectifs sont fixés avec vous au départ. Voici ceux qui reviennent le plus souvent.",
    items: [
      { title: 'Des équipes reliées aux enjeux métiers', text: "Un lien direct entre ce que l'entreprise cherche à obtenir et ce que les équipes construisent." },
      { title: 'Des priorités et des dépendances visibles', text: "Chacun voit ce qui passe en premier, et ce qui dépend de qui." },
      { title: 'Des rôles clarifiés', text: "Des interactions plus nettes entre Product Owners, Scrum Masters, managers et équipes." },
      { title: 'Une livraison plus régulière', text: "Un rythme tenable, plutôt que des à-coups suivis de retards." },
