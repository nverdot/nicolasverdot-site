  .secteurs-note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 980px) {
    .chemin {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
