    color: var(--color-muted);
  }
  .option-dirigeant p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Offre pilote ---------- */
  .pilote {
    max-width: 50rem;
    margin: 0 auto;
    padding: var(--space-8);
