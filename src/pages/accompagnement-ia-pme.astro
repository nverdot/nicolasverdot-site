    .benefices,
    .chiffres,
    .feux {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .limites,
    .local,
    .reconnaitre,
    .dsi {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
  @media (max-width: 640px) {
    .benefices,
    .chiffres,
    .feux,
    .capacites {
      grid-template-columns: minmax(0, 1fr);
    }
    .option-dirigeant,
    .pilote {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>
