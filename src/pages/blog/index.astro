---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
---

<Layout
  title="Blog — by Nicolas Verdot"
  description="Le blog est en cours de construction."
  path="/blog/"
>
  <PageHero
    eyebrow="Blog"
    title="Cette page arrive bientôt"
    summary="Le blog est en cours de construction. En attendant, parlons directement de votre situation."
  />

  <CTABlock
    title="Une question, un sujet à traiter maintenant ?"
    subtitle="Pas besoin d'attendre un article : on peut en parler directement."
  />
</Layout>
