---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import { withBase } from '../../utils/url';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// L'ordre des piliers suit ce que les visiteurs viennent chercher en premier :
// les séminaires et la décision d'abord, le parcours personnel en dernier.
const piliers = [
  { nom: 'Réunions et séminaires', ancre: 'reunions-seminaires', page: '/seminaires-entreprise/', lien: "Voir les séminaires d'entreprise" },
  { nom: 'Décision et priorisation', ancre: 'decision', page: '/seminaire-codir/', lien: 'Voir le séminaire de direction' },
  { nom: 'Leadership et autonomie', ancre: 'leadership', page: '/offres/coaching-equipe/', lien: "Voir le coaching d'équipe" },
  { nom: 'Intelligence collective concrète', ancre: 'intelligence-collective', page: '/intelligence-collective/', lien: "Comprendre l'intelligence collective" },
  { nom: 'Pensée visuelle', ancre: 'pensee-visuelle', page: '/offres/capture-graphique/', lien: 'Voir la capture graphique' },
  { nom: 'Parcours personnel', ancre: 'parcours', page: '/a-propos/', lien: 'Qui suis-je' },
].map((p) => ({ ...p, articles: articles.filter((a) => a.data.pillar === p.nom) })).filter((p) => p.articles.length > 0);

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Le blog de Nicolas Verdot',
  url: new URL(withBase('/blog/'), Astro.site).toString(),
  blogPost: articles.map((a) => ({
    '@type': 'BlogPosting',
    headline: a.data.title,
    datePublished: a.data.publishDate.toISOString(),
    url: new URL(withBase(`/blog/${a.slug}/`), Astro.site).toString(),
  })),
};
---

<Layout
  title="Blog : séminaires, décision collective, facilitation"
  description={`${articles.length} articles pour préparer un séminaire, décider en comité de direction et animer des réunions utiles. Écrits par un facilitateur, depuis le terrain.`}
  path="/blog/"
>
  <PageHero
    eyebrow="Blog"
    title="Séminaires, décisions,"
    titleAccent="réunions utiles."
    summary={`<strong>${articles.length} articles</strong> écrits depuis le terrain, pour préparer un séminaire, décider à plusieurs et faire avancer un collectif.`}
  />

  <nav class="section blog-sommaire" aria-label="Thèmes du blog">
    <div class="container">
      <ul>
        {piliers.map((p) => (
          <li><a href={`#${p.ancre}`}>{p.nom} <span>({p.articles.length})</span></a></li>
        ))}
      </ul>
    </div>
  </nav>

  {piliers.map((p, i) => (
    <section class={`section${i % 2 === 0 ? ' alt' : ''}`} id={p.ancre} data-section-name={p.nom}>
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{p.articles.length} articles</p>
            <h2>{p.nom}</h2>
          </div>
          <p><a href={withBase(p.page)}>{p.lien} →</a></p>
        </div>
        <div class="cards">
          {p.articles.map((a) => (
            <article class="card">
              <div class="num">{dateFormatter.format(a.data.publishDate)}</div>
              <h3><a href={withBase(`/blog/${a.slug}/`)}>{a.data.title}</a></h3>
              <p>{a.data.description}</p>
              <a class="card-link" href={withBase(`/blog/${a.slug}/`)} aria-label={`Lire l'article : ${a.data.title}`}>Lire l'article</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <CTABlock
    title="Une question, un sujet à traiter maintenant ?"
    subtitle="Pas besoin d'attendre un article : on peut en parler directement."
  />
</Layout>

<style>
  .blog-sommaire {
    padding-block: var(--space-8) 0;
  }
  .blog-sommaire ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .blog-sommaire a {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: none;
  }
  .blog-sommaire a span {
    color: var(--color-muted);
    font-weight: 400;
  }
  .card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .card h3 a:hover {
    text-decoration: underline;
  }
</style>
