---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import heroImg from '../../assets/hero-a-propos.png';
---

<Layout
  title="Blog — by Nicolas Verdot"
  description="Le blog est en cours de construction."
  path="/blog/"
>
  <PageHero
    eyebrow="Blog"
    title="Cette page arrive"
    titleAccent="bientôt."
    summary="Le blog est en cours de construction. En attendant, parlons directement de <strong>votre situation</strong>."
    image={heroImg}
    imageAlt="Un facilitateur vu de dos, une pause sur un chemin en hauteur, un carnet de croquis à la main."
    flip
    tall
  />

  <CTABlock
    title="Une question, un sujet à traiter maintenant ?"
    subtitle="Pas besoin d'attendre un article : on peut en parler directement."
  />
</Layout>
