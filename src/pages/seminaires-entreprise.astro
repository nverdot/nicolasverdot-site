---
import Layout from '../layouts/Layout.astro';
import CTABlock from '../components/CTABlock.astro';
import CoutSeminaire from '../components/CoutSeminaire.astro';
import ClientLogoStrip from '../components/ClientLogoStrip.astro';
import { withBase } from '../utils/url';
import action from '../assets/nicolas-action.jpeg';


const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: "Conception et animation de séminaires d'entreprise",
  name: "Séminaire d'entreprise conçu et animé par un facilitateur",
  description:
    "Conception et animation de séminaires d'entreprise : séminaire de direction, kick-off de projet, séminaire d'équipe, convention. Cadrage, déroulé sur mesure, facilitation le jour J, synthèse visuelle et suites.",
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Alpes-Maritimes' },
    { '@type': 'City', name: 'Nice' },
    { '@type': 'City', name: 'Sophia Antipolis' },
    { '@type': 'City', name: 'Cannes' },
    { '@type': 'Country', name: 'Monaco' },
    { '@type': 'AdministrativeArea', name: "Provence-Alpes-Côte d'Azur" },
    { '@type': 'Country', name: 'France' },
  ],
  url: new URL(withBase('/seminaires-entreprise/'), Astro.site).toString(),
};

// Les trois situations qui déclenchent un séminaire. Chacune a sa page : le
// visiteur arrive rarement en cherchant « un séminaire », plus souvent avec
// un projet à lancer ou un comité de direction à remettre d'accord.
const situations = [
  {
    num: 'Vous lancez un projet',
    title: 'Séminaire kick-off',
    text: "Un projet, une feuille de route ou une nouvelle année à lancer. Les équipes doivent comprendre, contribuer et repartir en sachant qui fait quoi.",
    href: '/seminaire-kick-off/',
    link: 'Voir le séminaire kick-off',
  },
  {
    num: 'Votre comité de direction',
    title: 'Séminaire CODIR',
    text: "Des directeurs compétents, mais chacun dans son périmètre. Deux jours pour trancher les priorités, traiter les désaccords et repartir avec des décisions tenues.",
    href: '/seminaire-codir/',
    link: 'Voir le séminaire de direction',
  },
  {
    num: 'Vous construisez la suite',
    title: 'Atelier feuille de route',
    text: "Une stratégie à traduire en priorités, une démarche agile à installer : un atelier ou une série d'ateliers pour bâtir une feuille de route que les équipes s'approprient.",
    href: '/cas-clients/urssaf-acoss/',
    link: 'Voir le cas Urssaf / Acoss',
  },
  {
    num: 'Vous animez vous-même',
    title: 'Co-préparation et mentoring',
    text: "Quelqu'un chez vous tient l'animation. Je co-prépare avec cette personne : le déroulé, les questions, les moments sensibles. C'est ce que je fais chez PwC, sur une série d'ateliers d'une demi-journée animés par une personne de l'équipe.",
    href: '/offres/mentoring/',
    link: 'Voir le mentoring',
  },
  {
    num: 'Une équipe qui patine',
    title: "Coaching d'équipe",
    text: "Les mêmes blocages reviennent malgré les plans d'action. Un séminaire seul ne suffira pas : il faut un dispositif dans la durée.",
    href: '/offres/coaching-equipe/',
    link: "Voir le coaching d'équipe",
  },
];

// Questions formulées comme on les tape dans un moteur de recherche. Les
// réponses reprennent ce que dit déjà le reste de la page : aucun chiffre
// nouveau n'y est introduit.
const faq = [
  {
    q: "Combien coûte l'animation d'un séminaire d'entreprise ?",
    a: "Le tarif dépend du nombre de participants, du temps de préparation, des entretiens en amont, des supports, du nombre de facilitateurs et de la restitution attendue. Le lieu, les repas et la logistique restent à votre charge. Le premier poste de dépense d'un séminaire n'est d'ailleurs pas l'animation : c'est le temps des personnes que vous réunissez.",
  },
  {
    q: 'Animateur, intervenant, facilitateur de séminaire : quelle différence ?',
    a: "Un intervenant apporte un contenu, souvent une conférence. Un animateur fait vivre la journée. Un facilitateur conçoit le chemin qui mène le groupe d'une question à une décision, puis tient ce cadre le jour J, sans prendre parti sur le fond. Pour un séminaire qui doit produire des décisions, c'est ce troisième rôle qu'il vous faut.",
  },
  {
    q: "Comment organiser un séminaire d'entreprise qui serve à quelque chose ?",
    a: "En commençant par l'intention, pas par le lieu : qu'est-ce qui doit avoir changé à la fin ? Viennent ensuite le choix des participants, le déroulé, puis les suites, prévues avant même le jour J. La méthode complète est dans l'article <a href=\"/blog/organiser-seminaire-equipe/\">Organiser un séminaire d'équipe qui change vraiment quelque chose</a>.",
  },
  {
    q: 'Séminaire de travail, séminaire de cohésion, team building : que choisir ?',
    a: "Un team building crée un bon moment partagé. Un séminaire de cohésion travaille la relation et la confiance. Un séminaire de travail produit des décisions sur un sujet précis. Je conçois et j'anime des séminaires de travail ; la cohésion y vient en décidant ensemble, pas en parallèle.",
  },
  {
    q: 'Vous occupez-vous du lieu et de la logistique ?',
    a: "Non. Je conçois et j'anime le séminaire. Le lieu, l'hébergement et la restauration restent à votre charge ou à celle de votre agence événementielle, avec laquelle je travaille volontiers. Je vous aide en revanche à choisir un lieu adapté au travail prévu.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};

