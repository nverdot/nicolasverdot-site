<style>
  /* Le reste des styles de cette page (hero plein fond, bandeau de valeur,
     coût de l'inaction, timeline de phases + popups, combien de temps,
     vignettes cas clients...) vit maintenant dans global.css, sous "Gabarit
     de page offre" — extrait d'ici pour être réutilisé sur les autres pages
     /offres/ sans dupliquer ~700 lignes de CSS à chaque fois. Ne restent ici
     que les deux utilitaires propres à cette page. */
  .muted {
    color: var(--color-muted);
  }
  .versus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .versus-col {
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  /* Fond jaune de la marque : c'est la colonne que l'on veut voir en premier.
     Le texte reste en bleu nuit fixe, lisible en thème clair comme sombre. */
  .versus-oui {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: #122033;
    box-shadow: var(--shadow-md);
  }
  .versus-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: var(--space-6);
    border-radius: var(--radius-sm);
  }
  .versus-non .versus-photo {
    filter: grayscale(0.5);
  }
  .versus-label {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .versus-oui .versus-label {
    color: #122033;
  }
  .versus-col h3 {
    margin: 0 0 var(--space-4);
  }
  .versus-oui h3 {
    color: #122033;
  }
  .versus-col ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .versus-col li {
    position: relative;
    padding-left: var(--space-6);
  }
  .versus-col li::before {
    content: '×';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    color: var(--color-muted);
  }
  .versus-non li {
    color: var(--color-muted);
  }
  .versus-oui li::before {
    content: '→';
    color: #122033;
  }
  .versus-oui li strong {
    color: #122033;
  }
  .versus-chute {
    margin: var(--space-8) 0 0;
    font-size: var(--text-lg);
  }
  @media (max-width: 760px) {
    .versus {
      grid-template-columns: minmax(0, 1fr);
    }
    .versus-col {
      padding: var(--space-6) var(--space-4);
    }
  }
  .intervention-format {
    font-weight: 700;
    color: var(--color-navy);
  }
  .situation-card {
    text-decoration: none;
    color: inherit;
  }
  .situations-more {
    margin: var(--space-8) 0 0;
  }
  .card p:not(:last-child) {
    margin-bottom: var(--space-3);
  }
</style>

<style is:global>
  body.case-modal-lock-scroll {
    overflow: hidden;
  }
</style>

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-phase-trigger]'));
  const modals = Array.from(document.querySelectorAll<HTMLElement>('[data-phase-modal]'));

  function openModal(name: string) {
    const modal = modals.find((m) => m.dataset.phaseModal === name);
    if (!modal) return;
    modal.hidden = false;
    document.body.classList.add('case-modal-lock-scroll');
  }

  function closeModal(modal: HTMLElement) {
    modal.hidden = true;
    if (!modals.some((m) => !m.hidden)) {
      document.body.classList.remove('case-modal-lock-scroll');
    }
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const name = trigger.dataset.phaseTrigger;
      if (name) openModal(name);
    });
  });

  modals.forEach((modal) => {
    modal.querySelectorAll('[data-phase-modal-close]').forEach((el) => {
      el.addEventListener('click', () => closeModal(modal));
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach((modal) => {
        if (!modal.hidden) closeModal(modal);
      });
    }
  });
</script>
