---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTABlock from '../components/CTABlock.astro';
import PriorityGrid from '../components/PriorityGrid.astro';
import ClientLogoStrip from '../components/ClientLogoStrip.astro';
import Pli from '../components/Pli.astro';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import portrait from '../assets/nicolas-portrait-2026.jpg';

// Convention icônes du site : traits feutre currentColor, viewBox 24×24
// (mêmes tracés que Footer.astro, pour rester cohérent d'une section à l'autre).
const icons: Record<string, string> = {
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
};

// Ce que change un accompagnement — pas de chiffre ni de témoignage inventés :
// le "+ de 15" du hero est le compte réel du bandeau de logos clients ci-dessous.
const proofItems = [
  { icon: 'target', title: 'Des priorités claires', text: "Pour concentrer l'énergie là où elle compte vraiment." },
  { icon: 'check', title: 'Des décisions assumées', text: 'Pour sortir des discussions sans fin et choisir une direction.' },
  { icon: 'people', title: 'Des équipes alignées', text: "Pour que chacun comprenne où l'on va et comment contribuer." },
  { icon: 'trending', title: 'Des actions concrètes', text: 'Pour transformer les décisions en résultats visibles.' },
];

// Les séminaires, par situation : c'est par là que le visiteur se reconnaît
// (« je lance un projet », « mon comité de direction patine »), pas par le
// mot « facilitation ».
const seminaires = [
  {
    num: 'Vous lancez un projet',
    titre: 'Séminaire kick-off',
    texte: "Un projet, une feuille de route, une nouvelle année. Les équipes repartent en sachant pourquoi, qui fait quoi, et par quoi commencer lundi.",
    lien: 'Le séminaire kick-off',
    href: '/seminaire-kick-off/',
  },
  {
    num: 'Votre comité de direction',
    titre: 'Séminaire CODIR',
    texte: "Deux jours pour trancher les priorités, traiter les désaccords qui traînent et repartir avec des décisions que chacun défendra.",
    lien: 'Le séminaire de direction',
    href: '/seminaire-codir/',
  },
  {
    num: 'Vous déployez l’IA',
    titre: 'Stratégie de déploiement IA',
    texte: "Décider où l'IA crée de la valeur, dans quel ordre l'introduire, et embarquer les métiers et la DSI. En comité de direction, puis avec les équipes.",
    lien: 'La stratégie de déploiement IA',
    href: '/accompagnement-ia-pme/',
  },
  {
    num: 'Près de chez vous',
    titre: 'Nice, Sophia Antipolis, Monaco',
    texte: "Basé à Nice, je prépare vos séminaires sur place dans les Alpes-Maritimes, en français ou en anglais, et j'interviens partout en France.",
    lien: 'Les séminaires dans le 06',
    href: '/seminaires-alpes-maritimes/',
  },
];

const resourceArticles = [
  { slug: 'reunionite-sept-signes', title: 'Réunionite : sept signes que vos réunions tournent à vide', description: 'Sept signes concrets que vos réunions tournent à vide, et un remède actionnable pour chacun.', visual: 'orange' },
  { slug: 'organiser-seminaire-equipe', title: 'Organiser un séminaire d\'équipe qui change vraiment quelque chose', description: "Intention, déroulé, lieu, facilitation, suites : la méthode pour un séminaire qui produit des effets durables.", visual: 'orange' },
  { slug: 'daci-raci-qui-decide', title: 'Qui décide quoi : clarifier les rôles avec DACI et RACI', description: 'La matrice RACI et son cousin DACI clarifient qui décide, qui fait, qui est consulté.', visual: '' },
];

---

<Layout
  title="Facilitateur de séminaires et stratégie IA à Nice — Nicolas Verdot"
  description="Séminaire de direction, kick-off, stratégie IA : j'aide les dirigeants de la Côte d'Azur à décider, puis à embarquer leurs équipes. Nice, Sophia Antipolis, PACA."
  path="/"
>
  <Hero />

  {/* Première porte : les séminaires, par situation. */}
  <section class="section alt ia-portes" data-pli data-reveal data-section-name="Séminaires : trois situations">
    <Pli titre="Quatre situations fréquentes" note="Kick-off, comité de direction, IA, près de chez vous" />
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Séminaires d'entreprise · Déploiement de l'IA</p>
          <h2>Vous réunissez vos équipes&nbsp;? Faites qu'il en sorte quelque chose.</h2>
        </div>
        <p>
          Je conçois et j'anime votre séminaire de bout en bout&nbsp;: le cadrage, le déroulé, le jour J et les
          suites. Vous restez dans votre rôle de dirigeant.
        </p>
      </div>
      <div class="cards cards-quatre">
        {seminaires.map((s) => (
          <a class="card ia-porte" href={withBase(s.href)}>
            <span class="num">{s.num}</span>
            <h3>{s.titre}</h3>
            <p>{s.texte}</p>
            <span class="card-link">{s.lien}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ClientLogoStrip />

  <section class="proof-band" data-pli data-reveal data-section-name="Bénéfices">
    <Pli titre="Ce que ça change" note="Priorités, décisions, alignement, actions" />
    <div class="container proof-inner">
      <h2>
        Quand l'essentiel devient visible,
        <span class="accent-wrap">
          le collectif avance.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="proof-grid">
        {proofItems.map((p) => (
          <div class="proof-item">
            <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            <strong>{p.title}</strong>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="partner-intro section" data-pli data-reveal data-section-name="Nicolas Verdot, votre partenaire">
    <Pli titre="Qui je suis" note="Et les questions auxquelles je vous aide à répondre" />
    <div class="container split split-top">
      <div class="split-photo portrait portrait-overlay-wrap">
        <Image src={portrait} alt="Portrait de Nicolas Verdot" width={800} height={800} />
        <div class="portrait-overlay">
          <p class="portrait-name">Nicolas VERDOT</p>
          <p class="portrait-role">Booster de leaders et d'équipes</p>
        </div>
      </div>
      <div>
        <h2>Un partenaire pour franchir un cap et mettre votre collectif en mouvement</h2>
        <p>Depuis plus de dix ans, j'accompagne les équipes et les organisations dans les moments où le collectif doit franchir une étape. J'observe ce qui se joue dans les interactions, les rôles, les habitudes et les modes de décision, et je fais émerger les points de vue, les attentes, les désaccords et les idées qui ont besoin d'être entendus pour permettre au groupe d'avancer.</p>
        <div class="partner-questions">
          <h3>Les questions auxquelles je vous aide à répondre</h3>
          <ul>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Comment mettre en place <strong>l'agilité</strong> dans votre organisation&nbsp;?</span></li>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Quelle est la <strong>place du manager</strong> dans une organisation agile&nbsp;?</span></li>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Comment <strong>fluidifier le delivery</strong> et livrer plus régulièrement&nbsp;?</span></li>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Comment <strong>faire équipe au sein du CODIR</strong> et oser se dire les choses&nbsp;?</span></li>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Comment aligner tout le monde sur <strong>une vision et des priorités claires</strong>&nbsp;?</span></li>
            <li><span class="partner-q-mark" aria-hidden="true">?</span><span>Comment <strong>déployer l'IA</strong> dans vos équipes sans laisser personne au bord du chemin&nbsp;?</span></li>
          </ul>
        </div>
        <p><a class="card-link" href={withBase('/a-propos/')}>Qui je suis et comment je travaille</a></p>
      </div>
    </div>
  </section>

  <PriorityGrid pli="Six façons de travailler ensemble" pliNote="Du séminaire clé en main au coaching individuel" />

  <section class="resources section alt" data-pli data-reveal data-section-name="Les ressources">
    <Pli titre="Trois articles pour commencer" note="Des méthodes utilisables sans moi" />
    <div class="container">
      <div class="section-head">
        <h2>Pour commencer à débloquer les choses</h2>
      </div>
      <div class="resources-grid">
        {resourceArticles.map((a) => (
          <a class="resource-card" href={withBase(`/blog/${a.slug}/`)}>
            <div class={`article-visual resource-visual ${a.visual}`}></div>
            <div class="resource-body">
              <h3>{a.title}</h3>
              <p>{a.description}</p>
              <span class="card-link">Lire l'article</span>
            </div>
          </a>
        ))}
      </div>
      <p class="complementary-label"><a href={withBase('/blog/')}>Voir tous les articles</a></p>
    </div>
  </section>

  <CTABlock
    dark
    title="Un collectif qui patine, ça se débloque."
    subtitle="Racontez-moi la situation, ce qui bloque, et ce que vous voulez vraiment voir changer — le reste, on le construit ensemble."
  />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Le trait sous "le collectif avance." se dessine de gauche à droite au
  // scroll, une seule fois, et reste acquis ensuite — pas de redessin/effacement
  // à chaque passage. Un aller-retour de scroll (fréquent sur mobile avec le
  // rebond élastique en haut de page) rejouait ce tween en boucle avant/arrière
  // (toggleActions ... reverse), ce qui est à la fois une animation trop
  // fréquente pour un simple flourish décoratif et un point instable signalé
  // sur mobile. Seul cet exemplaire du motif .ink-underline (celui du bandeau
  // bénéfices) est concerné. Trigger sur la SECTION (pas le path, trop fin
  // pour un calcul fiable) et seuil à 65% : sur un grand écran, le bandeau
  // peut déjà dépasser 85% de hauteur de viewport dès le chargement, ce qui
  // déclenchait l'anim avant même que l'utilisateur ait scrollé jusqu'à elle.
  mm.add('(prefers-reduced-motion: no-preference) and (pointer: fine)', () => {
    const section = document.querySelector<HTMLElement>('.proof-band');
    const path = document.querySelector<SVGPathElement>('.proof-inner .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none none',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });

  // Même motif .ink-underline, troisième exemplaire indépendant : le trait sous
  // "avancer durablement." dans le panneau d'expertise. Même correctif : joué
  // une seule fois, jamais rejoué en arrière.
  mm.add('(prefers-reduced-motion: no-preference) and (pointer: fine)', () => {
    const section = document.querySelector<HTMLElement>('.partner-approach-expertise');
    const path = document.querySelector<SVGPathElement>('.partner-approach-expertise .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 75%',
        toggleActions: 'play none none none',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });

  // Frise "Ensemble, mettons votre collectif en mouvement" : chaque pastille
  // numérotée passe du bleu au jaune au fil du scroll, pour donner une
  // sensation de progression le long des étapes (et repasse au bleu en
  // remontant, comme les traits .ink-underline).
  mm.add('(prefers-reduced-motion: no-preference) and (pointer: fine)', () => {
    const nums = gsap.utils.toArray<HTMLElement>('.trust-step-num');
    const triggers = nums.map((num) =>
      ScrollTrigger.create({
        trigger: num,
        start: 'top 75%',
        onEnter: () => num.classList.add('is-active'),
        onLeaveBack: () => num.classList.remove('is-active'),
      })
    );

    return () => triggers.forEach((t) => t.kill());
  });
</script>

<style>
  /* --- Les trois portes IA, sous le hero --- */
  /* Quatre cartes : une ligne sur grand écran, deux par deux en dessous,
     plutôt que trois cartes et une orpheline. */
  @media (min-width: 700px) {
    .cards-quatre {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1180px) {
    .cards-quatre {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ia-porte {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .ia-porte .card-link {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-blue);
  }
  .complementary-label {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .complementary-label a {
    color: var(--color-blue);
    font-weight: 600;
  }

  /* --- Bandeau noir "preuve" (4 bénéfices) --- */
  .proof-band {
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }
  .proof-inner {
    text-align: center;
  }
  .proof-inner h2 {
    color: var(--color-white);
    margin: 0 0 var(--space-8);
  }
  .proof-inner .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .proof-inner .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1040px;
    margin-inline: auto;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .proof-item:first-child {
    border-left: none;
  }
  .proof-icon {
    width: 28px;
    height: 28px;
    color: var(--color-orange);
  }
  .proof-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }
  .proof-item strong {
    display: block;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  @media (max-width: 800px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-4);
    }
    .proof-item {
      border-left: none;
    }
  }

  /* --- "concrets" souligné au feutre (même trait que "tout avance") --- */
  .circled {
    position: relative;
    display: inline-block;
  }
  .circled .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }


  /* --- Nicolas Verdot, votre partenaire --- */
  .partner-intro h2 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }
  .partner-intro p {
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .partner-intro .tool-tags {
    margin: var(--space-2) 0 0;
  }
  .split-top {
    align-items: start;
  }
  .portrait-overlay-wrap {
    position: relative;
  }
  .portrait-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: linear-gradient(180deg, rgba(18, 32, 51, 0) 0%, rgba(18, 32, 51, 0.85) 35%, rgba(18, 32, 51, 0.97) 60%);
    text-align: center;
  }
  .portrait-name {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-white);
  }
  .portrait-role {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-orange);
    line-height: 1.2;
  }
  .partner-questions {
    margin: var(--space-6) 0;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  .partner-questions h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-clay-ink);
  }
  .partner-questions ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .partner-questions li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--color-ink);
  }
  .partner-questions li:last-child {
    padding-bottom: 0;
  }
  .partner-questions strong {
    font-weight: 700;
    color: var(--color-navy);
  }
  .partner-q-mark {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-orange);
    color: var(--color-ink-solid);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
  }
  @media (max-width: 480px) {
    .partner-questions {
      padding: var(--space-4);
    }
  }
        /* --- Faire confiance : frise verticale d'un seul échange qui débouche
     sur deux issues, dans une colonne volontairement plus étroite que les
     autres sections pour se lire comme un petit schéma, pas un pavé de texte. */
  /* --- Ressources / articles --- */
  .resources {
    padding: var(--space-16) 0;
  }
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .resource-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    transition: transform var(--duration-hover) var(--ease-out), box-shadow var(--duration-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .resource-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-sm);
    }
  }
  .resource-visual {
    height: 120px;
  }
  .resource-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    flex: 1;
  }
  .resource-card h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-navy);
  }
  .resource-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .resource-card .card-link {
    margin-top: auto;
    padding-top: var(--space-2);
  }
  @media (max-width: 900px) {
    .resources-grid {
      grid-template-columns: 1fr;
    }
  }

  /* --- "Ma façon de travailler" (bandeau navy, traits + photo) --- */
  .working-style {
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }
  .working-style .eyebrow {
    color: var(--color-orange);
  }
  .traits-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .trait {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .trait-icon {
    width: 26px;
    height: 26px;
    color: var(--color-orange);
  }
  .trait strong {
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  .trait span {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
  }
  @media (max-width: 900px) {
    .traits-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .traits-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

</style>
