---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTABlock from '../components/CTABlock.astro';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import portrait from '../assets/nicolas-portrait.png';
import action from '../assets/nicolas-action.jpeg';

// Convention icônes du site : traits feutre currentColor, viewBox 24×24
// (mêmes tracés que Footer.astro, pour rester cohérent d'une section à l'autre).
const icons: Record<string, string> = {
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  heart: '<path d="M12 21s-7-4.4-9.5-8.6C.5 8.6 3 5 6.6 5c2 0 3.5 1 5.4 3 1.9-2 3.4-3 5.4-3 3.6 0 6.1 3.6 4.1 7.4C19 16.6 12 21 12 21z"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
  flag: '<path d="M5 21V4"/><path d="M5 4h14l-3 5 3 5H5"/>',
};

// Ce que change un accompagnement — pas de chiffre ni de témoignage inventés :
// le "+ de 15" du hero est le compte réel du bandeau de logos clients ci-dessous.
const proofItems = [
  { icon: 'target', title: 'Des priorités claires', text: "Pour concentrer l'énergie là où elle compte vraiment." },
  { icon: 'check', title: 'Des décisions assumées', text: 'Pour sortir des discussions sans fin et choisir une direction.' },
  { icon: 'people', title: 'Des équipes alignées', text: "Pour que chacun comprenne où l'on va et comment contribuer." },
  { icon: 'trending', title: 'Des actions concrètes', text: 'Pour transformer les décisions en résultats visibles.' },
];

const traits = [
  { icon: 'heart', title: 'Humaine', text: 'toujours.' },
  { icon: 'eye', title: 'Visuelle', text: 'pour mieux comprendre.' },
  { icon: 'target', title: 'Pragmatique', text: "au service de l'action." },
  { icon: 'bolt', title: 'Directe', text: 'sans détour.' },
  { icon: 'flag', title: 'Engagée', text: 'à vos côtés.' },
];

const resourceArticles = [
  { slug: 'reunionite-sept-signes', title: 'Réunionite : sept signes que vos réunions tournent à vide', description: 'Sept signes concrets que vos réunions tournent à vide, et un remède actionnable pour chacun.' },
  { slug: 'organiser-seminaire-equipe', title: 'Organiser un séminaire d\'équipe qui change vraiment quelque chose', description: "Intention, déroulé, lieu, facilitation, suites : la méthode pour un séminaire qui produit des effets durables." },
  { slug: 'daci-raci-qui-decide', title: 'Qui décide quoi : clarifier les rôles avec DACI et RACI', description: 'La matrice RACI et son cousin DACI clarifient qui décide, qui fait, qui est consulté.' },
];

const clients = [
  { name: 'Air France KLM', logo: '/logos/air-france-klm.png' },
  { name: 'Louis Vuitton', logo: '/logos/louis-vuitton.svg' },
  { name: 'PwC', logo: '/logos/pwc.webp' },
  { name: 'MG2Mix', logo: '/logos/mg2mix.png' },
  { name: 'Ressource SI', logo: '/logos/ressources.png' },
  { name: 'Mairie de Valbonne' },
  { name: 'JCI Monaco', logo: '/logos/jci-monaco.png' },
  { name: 'URSSAF', logo: '/logos/urssaf.webp' },
  { name: "Commune d'Angers" },
  { name: 'CAF Rhône-Alpes' },
  { name: 'CEC', logo: '/logos/cec.png' },
  { name: 'Fibois Sud' },
  { name: 'Osan We', logo: '/logos/osanwe.png' },
  { name: 'IA2P' },
  { name: 'MediaSchool' },
];

const priorities = [
  { title: 'Décider ensemble, plus vite et plus clairement', text: 'Transformer un sujet complexe en décisions claires, comprises et suivies d\'actions.', href: withBase('/offres/decider-ensemble/') },
  { title: "Aligner l'équipe autour d'une direction commune", text: 'Créer une direction commune et remettre le collectif en mouvement autour de priorités réellement partagées.', href: withBase('/offres/aligner-equipe/') },
  { title: 'Réussir un séminaire ou un temps collectif clé', text: 'Concevoir et faciliter un temps collectif qui produit vraiment quelque chose, pas une réunion de plus.', href: withBase('/offres/seminaires-ateliers/') },
  { title: 'Accompagner une transformation', text: 'Donner du sens au changement, impliquer les équipes et transformer une intention stratégique en réalité opérationnelle.', href: withBase('/offres/accompagnement-transformation/') },
  { title: 'Installer une dynamique durable', text: 'Faire évoluer la manière de travailler, de décider et de responsabiliser les équipes dans le temps.', href: withBase('/offres/dynamique-durable/') },
  { title: 'Renforcer la posture des leaders', text: 'Travailler la posture, les interactions et la sécurité intérieure du leader.', href: withBase('/offres/coaching-professionnel/') },
];
---

<Layout
  title="Facilitateur professionnel, coach et formateur — by Nicolas Verdot"
  description="Séminaires facilités, ateliers d'intelligence collective, facilitation graphique, coaching et formations : trouvez le service qui débloquera votre équipe — et passez de la discussion à l'action."
  path="/"
>
  <Hero />

  <section class="proof-band" data-reveal data-section-name="Bénéfices">
    <div class="container proof-inner">
      <h2>
        Quand l'essentiel devient visible,
        <span class="accent-wrap">
          le collectif avance.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="proof-grid">
        {proofItems.map((p) => (
          <div class="proof-item">
            <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            <strong>{p.title}</strong>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="trust" data-reveal data-section-name="Logos clients">
    <div class="client-marquee">
      <div class="client-marquee-track">
        {[...clients, ...clients].map((c, i) => (
          <span class="client-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
            {c.logo ? <img src={withBase(c.logo)} alt={c.name} loading="lazy" /> : <span class="client-text">{c.name}</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="partner-intro section" data-reveal data-section-name="Nicolas Verdot, votre partenaire">
    <div class="container split">
      <div class="split-photo portrait portrait-overlay-wrap">
        <Image src={portrait} alt="Portrait de Nicolas Verdot" width={640} height={853} />
        <div class="portrait-overlay">
          <p class="portrait-name">Nicolas VERDOT</p>
          <p class="portrait-role">Booster de leaders et d'équipes</p>
        </div>
      </div>
      <div>
        <h2>Un partenaire pour passer un cap et (re)mettre votre collectif en mouvement</h2>
        <p class="partner-lead"><strong>Imaginez…</strong></p>
        <ul class="partner-imagine-list">
          <li>Vos décisions se prennent plus vite, parce qu'elles sont mieux préparées.</li>
          <li>Vos équipes savent ce qu'elles ont à faire et pourquoi.</li>
          <li>Les tensions se traitent avant de bloquer le travail.</li>
          <li>Votre collectif retrouve l'énergie d'avancer, ensemble.</li>
        </ul>
        <p>Un collectif qui patine n'a pas besoin d'une méthode de plus : il a besoin qu'on comprenne pourquoi il patine. C'est mon métier depuis plus de dix ans — lire les interactions, les rôles et les non-dits qui freinent une équipe, puis concevoir le processus de collaboration et de décision qui la remet en mouvement. Une expertise concrète, au service d'un seul objectif : faire avancer votre organisation.</p>
        <div class="tool-tags">
          <span class="tool-tag">Facilitation</span>
          <span class="tool-tag">Coaching</span>
          <span class="tool-tag">Intelligence collective</span>
          <span class="tool-tag">Agilité</span>
          <span class="tool-tag">Pensée visuelle</span>
        </div>
        <p>Peu importe le moment — une croissance à accompagner, un coup dur à traverser, un nouveau projet à lancer, une communauté à associer à une décision. Peu importe le secteur — IT, IA, industrie, association ou collectivité. Le vrai sujet reste le même : faire fonctionner l'humain. Je fais discuter, émerger ce qui compte, construire un plan d'action et apprendre de ce qui a été tenté — pour installer une vraie culture apprenante dans la durée.</p>
      </div>
    </div>
  </section>

  <section class="trust-block section alt" data-reveal data-section-name="Faire confiance">
    <div class="container prose">
      <h2>Ensemble, mettons votre collectif en mouvement</h2>
      <p class="trust-lead">Ne restez pas seul face à ce qui bloque — surtout si vous n'arrivez pas encore à en identifier clairement la cause.</p>
      <p>Pour vous aider à avancer, je commence toujours par un premier échange approfondi pour comprendre votre situation réelle : les enjeux, les personnes concernées, ce qui a déjà été tenté. Avec mon expérience du terrain et un franc-parler que vous apprécierez vite, nous explorons ensemble des pistes d'action — et nous apprenons à nous connaître, pour travailler ensuite en confiance.</p>
      <p>À l'issue de cet échange, deux options s'offrent à vous :</p>
      <ul class="trust-options">
        <li>Soit il vous a suffi à y voir clair : vous savez comment agir et n'avez plus besoin de moi. Parfait, ravi d'avoir été utile.</li>
        <li>Soit vous souhaitez être accompagné davantage, et nous construisons ensemble un dispositif concret — séminaire, atelier, coaching, formation ou facilitation — avec un point d'étape pour ajuster ou passer au sujet suivant.</li>
      </ul>
      <p class="fine">Cet accompagnement s'adresse aux entreprises comme aux collectivités et associations. Je n'interviens pas sur des sujets techniques ou logiciels : mon terrain, c'est la manière dont un collectif décide, coopère et avance.</p>
      <a class="btn" href={SITE.bookingUrl} target="_blank" rel="noopener">Réserver un premier échange →</a>
    </div>
  </section>

  <section class="priorities section" data-reveal data-section-name="Vos priorités">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Quelle est votre priorité ?</h2>
        </div>
        <p>Ce sont les défis qui reviennent le plus souvent, seuls ou combinés, dans mes accompagnements. Lesquels sont les vôtres ?</p>
      </div>
      <div class="priority-grid">
        {priorities.map((p, i) => (
          <a class="priority-card" href={p.href}>
            <span class="priority-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="working-style" data-reveal data-section-name="Ma façon de travailler">
    <div class="container working-style-inner">
      <div class="working-traits">
        <div class="traits-grid">
          {traits.map((t) => (
            <div class="trait">
              <svg class="trait-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
              <strong>{t.title}</strong>
              <span>{t.text}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="working-bio">
        <Image src={action} alt="Nicolas Verdot en pleine facilitation graphique" width={320} height={320} class="working-photo" />
        <div>
          <p class="working-name">Je suis Nicolas Verdot</p>
          <p class="working-text">Facilitateur, coach et formateur, j'aide les leaders et les équipes à faire avancer les sujets qui ne peuvent pas être résolus seuls ou uniquement derrière un écran.</p>
          <p class="working-text">J'interviens à la croisée de la facilitation, du coaching, de l'intelligence collective, de l'agilité et de la pensée visuelle.</p>
          <a class="card-link working-link" href={withBase('/a-propos/')}>Découvrir mon parcours et mon approche</a>
        </div>
      </div>
    </div>
  </section>

  <section class="resources" data-reveal data-section-name="Les ressources">
    <div class="container">
      <div class="section-head">
        <h2>Pour commencer à débloquer les choses</h2>
      </div>
      <div class="resources-grid">
        {resourceArticles.map((a) => (
          <a class="resource-card" href={withBase(`/blog/${a.slug}/`)}>
            <h3>{a.title}</h3>
            <p>{a.description}</p>
            <span class="card-link">Lire l'article</span>
          </a>
        ))}
      </div>
      <p class="complementary-label"><a href={withBase('/blog/')}>Voir tous les articles</a></p>
    </div>
  </section>

  <CTABlock
    dark
    title="Un projet important mérite mieux qu'une réunion de plus."
    subtitle="Parlons de la situation, de ce qui bloque et de ce que vous aimeriez réellement voir évoluer."
    ctaLabel="Parler de mon projet"
    secondaryLabel="Découvrir les accompagnements"
    secondaryHref={withBase('/#accompagnements')}
  />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Le trait sous "le collectif avance." se dessine de gauche à droite au
  // scroll et se redessine à chaque passage — descendre le trace, remonter
  // l'efface — plutôt que de rester acquis une fois pour toutes. Seul cet
  // exemplaire du motif .ink-underline (celui du bandeau bénéfices) est
  // concerné. Trigger sur la SECTION (pas le path, trop fin pour un calcul
  // fiable) et seuil à 65% : sur un grand écran, le bandeau peut déjà
  // dépasser 85% de hauteur de viewport dès le chargement, ce qui
  // déclenchait l'anim avant même que l'utilisateur ait scrollé jusqu'à elle.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.proof-band');
    const path = document.querySelector<SVGPathElement>('.proof-inner .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none reverse',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });
</script>

<style>
  .complementary-label {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .complementary-label a {
    color: var(--color-blue);
    font-weight: 600;
  }

  /* --- Bandeau noir "preuve" (4 bénéfices) --- */
  .proof-band {
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }
  .proof-inner {
    text-align: center;
  }
  .proof-inner h2 {
    color: var(--color-white);
    margin: 0 0 var(--space-8);
  }
  .proof-inner .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .proof-inner .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1040px;
    margin-inline: auto;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .proof-item:first-child {
    border-left: none;
  }
  .proof-icon {
    width: 28px;
    height: 28px;
    color: var(--color-orange);
  }
  .proof-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }
  .proof-item strong {
    display: block;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  @media (max-width: 800px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-4);
    }
    .proof-item {
      border-left: none;
    }
  }

  /* --- "concrets" souligné au feutre (même trait que "tout avance") --- */
  .circled {
    position: relative;
    display: inline-block;
  }
  .circled .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }


  /* --- Nicolas Verdot, votre partenaire --- */
  .partner-intro h2 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }
  .partner-intro p {
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .partner-intro .tool-tags {
    margin: var(--space-2) 0 var(--space-6);
  }
  .portrait-overlay-wrap {
    position: relative;
  }
  .portrait-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-8) var(--space-4) var(--space-4);
    background: linear-gradient(180deg, rgba(18, 32, 51, 0) 0%, rgba(18, 32, 51, 0.9) 65%);
    text-align: center;
  }
  .portrait-name {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 253, 250, 0.75);
  }
  .portrait-role {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-orange);
    line-height: 1.2;
  }
  .partner-lead {
    font-family: var(--font-display);
    color: var(--color-orange-ink);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .partner-imagine-list {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-navy);
    line-height: 1.5;
  }
  .partner-imagine-list li {
    padding-left: var(--space-6);
    position: relative;
  }
  .partner-imagine-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-orange);
  }

  /* --- Faire confiance --- */
  .trust-lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-navy);
    line-height: 1.4;
  }
  .trust-block p {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-ink);
  }
  .trust-options {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  .trust-options li {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
  }
  .trust-block .fine {
    max-width: 560px;
    margin-bottom: var(--space-6);
  }

  /* --- Vos priorités --- */
  .priority-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .priority-card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-hover) var(--ease-out), box-shadow var(--duration-hover) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .priority-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
  }
  .priority-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-border);
    margin-bottom: var(--space-3);
  }
  .priority-card h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .priority-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .priority-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .priority-grid {
      grid-template-columns: 1fr;
    }
  }


  /* --- Ressources / articles --- */
  .resources {
    padding: var(--space-16) 0;
  }
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .resource-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-decoration: none;
    transition: transform var(--duration-hover) var(--ease-out), box-shadow var(--duration-hover) ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .resource-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-sm);
    }
  }
  .resource-card h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-navy);
  }
  .resource-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .resource-card .card-link {
    margin-top: auto;
    padding-top: var(--space-2);
  }
  @media (max-width: 900px) {
    .resources-grid {
      grid-template-columns: 1fr;
