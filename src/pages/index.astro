---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LoopCircle from '../components/LoopCircle.astro';
import CTABlock from '../components/CTABlock.astro';
import { withBase } from '../utils/url';
import portrait from '../assets/nicolas-portrait.png';
import action from '../assets/nicolas-action.jpeg';

// Convention icônes du site : traits feutre currentColor, viewBox 24×24
// (mêmes tracés que Footer.astro, pour rester cohérent d'une section à l'autre).
const icons: Record<string, string> = {
  bulb: '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.1 1-1.8A6 6 0 0 0 12 3z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>',
  pencil: '<path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 6.5l2.5 2.5"/>',
  cap: '<path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  heart: '<path d="M12 21s-7-4.4-9.5-8.6C.5 8.6 3 5 6.6 5c2 0 3.5 1 5.4 3 1.9-2 3.4-3 5.4-3 3.6 0 6.1 3.6 4.1 7.4C19 16.6 12 21 12 21z"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/>',
  flag: '<path d="M5 21V4"/><path d="M5 4h14l-3 5 3 5H5"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M14.5 9.5l-2 5-5 2 2-5z"/>',
  knot: '<path d="M9 9a3 3 0 1 0 3 3V9a3 3 0 1 1 3 3"/><path d="M9 15a3 3 0 1 1 3-3v6a3 3 0 1 0 3-3"/>',
  bridge: '<path d="M2 18h20"/><path d="M4 18v-4a8 8 0 0 1 16 0v4"/><path d="M8 18v-3M12 18v-4M16 18v-3"/>',
  lighthouse: '<path d="M10 21h4M9 21l1-14h4l1 14"/><path d="M9.5 11h5M10 7h4"/><path d="M12 3v2M8 4.5l1.3 1M16 4.5l-1.3 1"/>',
  path: '<path d="M4 20C8 15 6 11 10 9s6 2 10-5"/><circle cx="4" cy="20" r="1" fill="currentColor" stroke="none"/><circle cx="14" cy="4" r="1" fill="currentColor" stroke="none"/>',
};

// Ce que change un accompagnement — pas de chiffre ni de témoignage inventés :
// le "+ de 15" du hero est le compte réel du bandeau de logos clients ci-dessous.
const proofItems = [
  { icon: 'target', title: 'Des priorités claires', text: "Pour concentrer l'énergie là où elle compte vraiment." },
  { icon: 'check', title: 'Des décisions assumées', text: 'Pour sortir des discussions sans fin et choisir une direction.' },
  { icon: 'people', title: 'Des équipes alignées', text: "Pour que chacun comprenne où l'on va et comment contribuer." },
  { icon: 'trending', title: 'Des actions concrètes', text: 'Pour transformer les décisions en résultats visibles.' },
];

// Quatre grandes portes d'entrée plutôt qu'une liste de prestations.
const offerCards = [
  {
    icon: 'grid',
    title: 'Séminaires et ateliers',
    text: 'Pour permettre à un collectif de comprendre, décider, prioriser et construire ensemble.',
    cta: 'Découvrir les séminaires et ateliers',
    href: withBase('/offres/seminaires-ateliers/'),
  },
  {
    icon: 'trending',
    title: 'Accompagnement des transformations',
    text: "Pour donner du sens au changement, impliquer les équipes et transformer une intention stratégique en réalité opérationnelle.",
    cta: "Découvrir l'accompagnement",
    href: withBase('/offres/accompagnement-transformation/'),
  },
  {
    icon: 'user',
    title: 'Coaching et mentoring des leaders',
    text: 'Pour prendre du recul, clarifier sa posture et agir avec davantage de justesse.',
    cta: 'Découvrir le coaching',
    href: withBase('/offres/coaching-professionnel/'),
  },
  {
    icon: 'pencil',
    title: 'Facilitation et capture graphique',
    text: "Pour rendre les échanges visibles, maintenir l'attention et produire une mémoire collective utile.",
    cta: 'Découvrir la facilitation graphique',
    href: withBase('/offres/capture-graphique/'),
  },
];

const traits = [
  { icon: 'heart', title: 'Humaine', text: 'toujours.' },
  { icon: 'eye', title: 'Visuelle', text: 'pour mieux comprendre.' },
  { icon: 'target', title: 'Pragmatique', text: "au service de l'action." },
  { icon: 'bolt', title: 'Directe', text: 'sans détour.' },
  { icon: 'flag', title: 'Engagée', text: 'à vos côtés.' },
];

const principles = [
  { icon: 'eye', title: 'Rendre visible', text: 'Les enjeux, les tensions, les idées et les décisions deviennent compréhensibles par tous.' },
  { icon: 'people', title: 'Faire participer', text: 'Les personnes concernées contribuent réellement au travail et ne subissent pas une décision déjà prise.' },
  { icon: 'trending', title: 'Transformer en action', text: 'Chaque accompagnement doit produire des décisions, des priorités et une suite concrète.' },
];

const situations = [
  { icon: 'compass', title: 'Préparer un séminaire qui produit quelque chose' },
  { icon: 'knot', title: 'Aligner une équipe autour d\'une direction commune' },
  { icon: 'bridge', title: 'Faire avancer un projet complexe ou bloqué' },
  { icon: 'people', title: 'Accompagner une transformation' },
  { icon: 'lighthouse', title: 'Remobiliser une équipe' },
  { icon: 'path', title: 'Aider un leader à prendre du recul' },
];

const processSteps = [
  { title: "Clarifier l'intention", text: 'Pourquoi réunir ces personnes ? Qu\'est-ce qui doit réellement changer ?' },
  { title: 'Concevoir le bon processus', text: 'Choisir les étapes, les méthodes et le niveau de participation adapté.' },
  { title: 'Mettre le collectif au travail', text: 'Créer un cadre sécurisant, rythmé et orienté vers un résultat.' },
  { title: 'Faire émerger une décision claire', text: 'Rendre visibles les convergences, les désaccords et les arbitrages.' },
  { title: "Organiser le passage à l'action", text: 'Définir les responsabilités, les premières étapes et le suivi.' },
];

const resourceArticles = [
  { slug: 'reunionite-sept-signes', title: 'Réunionite : sept signes que vos réunions tournent à vide', description: 'Sept signes concrets que vos réunions tournent à vide, et un remède actionnable pour chacun.' },
  { slug: 'organiser-seminaire-equipe', title: 'Organiser un séminaire d\'équipe qui change vraiment quelque chose', description: "Intention, déroulé, lieu, facilitation, suites : la méthode pour un séminaire qui produit des effets durables." },
  { slug: 'daci-raci-qui-decide', title: 'Qui décide quoi : clarifier les rôles avec DACI et RACI', description: 'La matrice RACI et son cousin DACI clarifient qui décide, qui fait, qui est consulté.' },
];

const clients = [
  { name: 'Air France KLM', logo: '/logos/air-france-klm.png' },
  { name: 'Louis Vuitton', logo: '/logos/louis-vuitton.svg' },
  { name: 'PwC', logo: '/logos/pwc.webp' },
  { name: 'MG2Mix', logo: '/logos/mg2mix.png' },
  { name: 'Ressource SI', logo: '/logos/ressources.png' },
  { name: 'Mairie de Valbonne' },
  { name: 'JCI Monaco', logo: '/logos/jci-monaco.png' },
  { name: 'URSSAF', logo: '/logos/urssaf.webp' },
  { name: "Commune d'Angers" },
  { name: 'CAF Rhône-Alpes' },
  { name: 'CEC', logo: '/logos/cec.png' },
  { name: 'Fibois Sud' },
  { name: 'Osan We', logo: '/logos/osanwe.png' },
  { name: 'IA2P' },
  { name: 'MediaSchool' },
];
---

<Layout
  title="Facilitateur professionnel, coach et formateur — by Nicolas Verdot"
  description="Séminaires facilités, ateliers d'intelligence collective, facilitation graphique, coaching et formations : trouvez le service qui débloquera votre équipe — et passez de la discussion à l'action."
  path="/"
>
  <Hero />

  <section class="proof-band" data-reveal data-section-name="Bénéfices">
    <div class="container proof-inner">
      <h2>
        Quand l'essentiel devient visible,
        <span class="accent-wrap">
          le collectif avance.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="proof-grid">
        {proofItems.map((p) => (
          <div class="proof-item">
            <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            <strong>{p.title}</strong>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="trust" data-reveal data-section-name="Logos clients">
    <div class="client-marquee">
      <div class="client-marquee-track">
        {[...clients, ...clients].map((c, i) => (
          <span class="client-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
            {c.logo ? <img src={withBase(c.logo)} alt={c.name} loading="lazy" /> : <span class="client-text">{c.name}</span>}
          </span>
        ))}
      </div>
    </div>
  </section>

  <LoopCircle />

  <section class="value-prop" data-reveal data-section-name="Proposition de valeur">
    <div class="container">
      <div class="value-intro">
        <p class="eyebrow">Ma proposition de valeur</p>
        <p class="value-statement">Je ne viens pas avec une solution toute faite. Je crée les conditions pour que les bonnes personnes puissent comprendre la situation, construire une réponse pertinente et s'engager réellement dans sa mise en œuvre.</p>
      </div>
      <div class="principles-grid">
        {principles.map((p, i) => (
          <div class="principle">
            <div class="principle-top">
              <span class="principle-num">{String(i + 1).padStart(2, '0')}</span>
              <svg class="principle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            </div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
      <div class="path-strip">
        <span class="path-label">Ma méthode, en une phrase</span>
        <div class="path-steps">
          <span class="path-step">Comprendre</span>
          <span class="path-arrow" aria-hidden="true">→</span>
          <span class="path-step">Décider</span>
          <span class="path-arrow" aria-hidden="true">→</span>
          <span class="path-step">Agir</span>
        </div>
      </div>
    </div>
  </section>

  <section class="situations" data-reveal data-section-name="Vos situations">
    <div class="container">
      <div class="section-head">
        <h2>À quel moment avez-vous besoin de remettre votre collectif en mouvement ?</h2>
      </div>
      <div class="situations-grid">
        {situations.map((s) => (
          <div class="situation-card">
            <svg class="situation-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            <p>{s.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="accompagnements" data-reveal data-section-name="Offres">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Accompagnements</p>
        <h2>Quatre façons de faire avancer votre collectif</h2>
      </div>
      <div class="offer-rows">
        {offerCards.map((o, i) => (
          <div class={`offer-row${i % 2 === 1 ? ' reverse' : ''}`}>
            <div class="offer-row-text">
              <h3>{o.title}</h3>
              <p>{o.text}</p>
              <a class="card-link" href={o.href}>{o.cta}</a>
            </div>
            <div class="offer-row-visual" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={icons[o.icon]} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process" data-reveal data-section-name="Comment ça se passe">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Comment ça se passe</p>
        <h2>Un accompagnement qui ne commence pas directement par un atelier</h2>
      </div>
      <div class="process-path">
        <svg class="process-line" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
          <path d="M20 30 C 150 5, 220 55, 350 30 S 550 5, 650 30 S 850 55, 980 25" />
        </svg>
        {processSteps.map((s, i) => (
          <div class="process-step">
            <span class="process-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="working-style" data-reveal data-section-name="Ma façon de travailler">
    <div class="container working-style-inner">
      <div class="working-traits">
        <p class="eyebrow">Ma façon de travailler</p>
        <div class="traits-grid">
          {traits.map((t) => (
            <div class="trait">
              <svg class="trait-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} />
              <strong>{t.title}</strong>
              <span>{t.text}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="working-bio">
        <Image src={action} alt="Nicolas Verdot en pleine facilitation graphique" width={320} height={320} class="working-photo" />
        <div>
          <p class="working-name">Je suis Nicolas Verdot</p>
          <p class="working-text">Facilitateur, coach et formateur, j'aide les leaders et les équipes à faire avancer les sujets qui ne peuvent pas être résolus seuls ou uniquement derrière un écran.</p>
          <p class="working-text">J'interviens à la croisée de la facilitation, du coaching, de l'intelligence collective, de l'agilité et de la pensée visuelle.</p>
          <a class="card-link working-link" href={withBase('/a-propos/')}>Découvrir mon parcours et mon approche</a>
        </div>
      </div>
    </div>
  </section>

  <section class="resources" data-reveal data-section-name="Les ressources">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Les ressources</p>
        <h2>Pour commencer à débloquer les choses</h2>
      </div>
      <div class="resources-grid">
        {resourceArticles.map((a) => (
          <a class="resource-card" href={withBase(`/blog/${a.slug}/`)}>
            <h3>{a.title}</h3>
            <p>{a.description}</p>
            <span class="card-link">Lire l'article</span>
          </a>
        ))}
      </div>
      <p class="complementary-label"><a href={withBase('/blog/')}>Voir tous les articles</a></p>
    </div>
  </section>

  <CTABlock
    dark
    title="Un projet important mérite mieux qu'une réunion de plus."
    subtitle="Parlons de la situation, de ce qui bloque et de ce que vous aimeriez réellement voir évoluer."
    ctaLabel="Parler de mon projet"
    secondaryLabel="Découvrir les accompagnements"
    secondaryHref={withBase('/#accompagnements')}
  />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Le trait sous "le collectif avance." se dessine de gauche à droite au
  // scroll et se redessine à chaque passage — descendre le trace, remonter
  // l'efface — plutôt que de rester acquis une fois pour toutes. Seul cet
  // exemplaire du motif .ink-underline (celui du bandeau bénéfices) est
  // concerné. Trigger sur la SECTION (pas le path, trop fin pour un calcul
  // fiable) et seuil à 65% : sur un grand écran, le bandeau peut déjà
  // dépasser 85% de hauteur de viewport dès le chargement, ce qui
  // déclenchait l'anim avant même que l'utilisateur ait scrollé jusqu'à elle.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.proof-band');
    const path = document.querySelector<SVGPathElement>('.proof-inner .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none reverse',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });
</script>

<style>
  .complementary-label {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .complementary-label a {
    color: var(--color-blue);
    font-weight: 600;
  }

  /* --- Bandeau noir "preuve" (4 bénéfices) --- */
  .proof-band {
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }
  .proof-inner {
    text-align: center;
  }
  .proof-inner h2 {
    color: var(--color-white);
    margin: 0 0 var(--space-8);
  }
  .proof-inner .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .proof-inner .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1040px;
    margin-inline: auto;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .proof-item:first-child {
    border-left: none;
  }
  .proof-icon {
    width: 28px;
    height: 28px;
    color: var(--color-orange);
  }
  .proof-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }
  .proof-item strong {
    display: block;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  @media (max-width: 800px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-4);
    }
    .proof-item {
      border-left: none;
    }
  }

  /* --- "concrets" souligné au feutre (même trait que "tout avance") --- */
  .circled {
    position: relative;
    display: inline-block;
  }
  .circled .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }


  /* --- Proposition de valeur --- */
  .value-prop {
    padding: var(--space-16) 0;
  }
  .value-intro {
    max-width: 760px;
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  .value-statement {
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 1.1rem + 1.4vw, var(--text-2xl));
    color: var(--color-navy);
    line-height: 1.35;
  }
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    max-width: 1040px;
    margin-inline: auto;
  }
  .principle {
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  .principle-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .principle-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-border);
  }
  .principle-icon {
    width: 26px;
    height: 26px;
    color: var(--color-orange-ink);
  }
  .principle h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .principle p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* Le cadre en une phrase : trois étiquettes reliées par des flèches,
     posées dans leur propre bloc distinct plutôt qu'en texte flottant. */
  .path-strip {
    max-width: 1040px;
    margin: var(--space-8) auto 0;
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .path-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .path-steps {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
