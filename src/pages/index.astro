---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTABlock from '../components/CTABlock.astro';
import ExpertiseExplorer from '../components/ExpertiseExplorer.astro';
import PriorityGrid from '../components/PriorityGrid.astro';
import CaseStudyModal from '../components/CaseStudyModal.astro';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import portrait from '../assets/nicolas-portrait.png';

// Convention icônes du site : traits feutre currentColor, viewBox 24×24
// (mêmes tracés que Footer.astro, pour rester cohérent d'une section à l'autre).
const icons: Record<string, string> = {
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
};

// Ce que change un accompagnement — pas de chiffre ni de témoignage inventés :
// le "+ de 15" du hero est le compte réel du bandeau de logos clients ci-dessous.
const proofItems = [
  { icon: 'target', title: 'Des priorités claires', text: "Pour concentrer l'énergie là où elle compte vraiment." },
  { icon: 'check', title: 'Des décisions assumées', text: 'Pour sortir des discussions sans fin et choisir une direction.' },
  { icon: 'people', title: 'Des équipes alignées', text: "Pour que chacun comprenne où l'on va et comment contribuer." },
  { icon: 'trending', title: 'Des actions concrètes', text: 'Pour transformer les décisions en résultats visibles.' },
];

const resourceArticles = [
  { slug: 'reunionite-sept-signes', title: 'Réunionite : sept signes que vos réunions tournent à vide', description: 'Sept signes concrets que vos réunions tournent à vide, et un remède actionnable pour chacun.', visual: 'orange' },
  { slug: 'organiser-seminaire-equipe', title: 'Organiser un séminaire d\'équipe qui change vraiment quelque chose', description: "Intention, déroulé, lieu, facilitation, suites : la méthode pour un séminaire qui produit des effets durables.", visual: 'orange' },
  { slug: 'daci-raci-qui-decide', title: 'Qui décide quoi : clarifier les rôles avec DACI et RACI', description: 'La matrice RACI et son cousin DACI clarifient qui décide, qui fait, qui est consulté.', visual: '' },
];

const clients: { name: string; logo?: string; href?: string; caseStudySlug?: string }[] = [
  { name: 'Air France KLM', logo: '/logos/air-france-klm.png' },
  { name: 'Louis Vuitton', logo: '/logos/louis-vuitton.svg' },
  { name: 'PwC', logo: '/logos/pwc.webp' },
  { name: 'MG2Mix', logo: '/logos/mg2mix.png', href: withBase('/cas-clients/mg2mix/'), caseStudySlug: 'mg2mix' },
  { name: 'Ressources', logo: '/logos/ressources.png', href: withBase('/cas-clients/ressources/'), caseStudySlug: 'ressources' },
  { name: 'Mairie de Valbonne' },
  { name: 'JCI Monaco', logo: '/logos/jci-monaco.png' },
  { name: 'URSSAF', logo: '/logos/urssaf.webp' },
  { name: "Commune d'Angers" },
  { name: 'CAF Rhône-Alpes' },
  { name: 'CEC', logo: '/logos/cec.png' },
  { name: 'Fibois Sud' },
  { name: 'Osan We', logo: '/logos/osanwe.png' },
  { name: 'IA2P' },
  { name: 'MediaSchool' },
];

const journeyStepsBeforeFork = [
  {
    title: 'Vous me partagez votre situation',
    lead: "Vous m'expliquez votre contexte, votre intention et ce que vous aimeriez voir émerger. Votre besoin peut déjà être très clair, ou encore difficile à formuler. Vous pouvez vouloir :",
    items: [
      'lancer un nouveau projet',
      'construire collectivement la suite',
      "mobiliser des collaborateurs autour d'un enjeu",
      'associer des parties prenantes à une décision',
      'créer ou faire vivre une communauté',
      'préparer un séminaire ou une rencontre',
      'accompagner une transformation',
      'dépasser une difficulté ou un blocage',
    ],
    closing: 'Nous partons simplement de là où vous en êtes.',
  },
  {
    title: 'Nous clarifions ce qui compte vraiment',
    lead: "Lors d'un premier échange approfondi, nous explorons ensemble :",
    items: [
      'ce que vous souhaitez obtenir',
      'les personnes à associer',
      'les enjeux et les contraintes',
      'ce qui existe déjà',
      'ce qui a éventuellement été tenté',
      'les conditions nécessaires pour avancer',
    ],
    closing: 'Je vous apporte mon regard extérieur, mon expérience du terrain et mon franc-parler pour vous aider à prendre du recul, poser les bonnes questions et faire émerger ce qui compte réellement.',
  },
  {
    title: 'Nous faisons émerger les premières pistes',
    lead: 'Nous identifions les prochaines étapes possibles : les personnes à réunir, les conversations à provoquer, les décisions à préparer et le niveau de participation à créer.',
    closing: "Cet échange permet souvent d'y voir déjà beaucoup plus clair. Il nous permet aussi de faire connaissance et de vérifier que nous avons envie de travailler ensemble, dans une relation simple, directe et de confiance.",
  },
];

const journeyStepsAfterFork = [
  {
    title: 'Nous avançons, apprenons et ajustons',
    lead: "Nous mettons en œuvre l'accompagnement, puis nous prenons le temps d'observer ce qu'il a réellement produit. Un point d'étape permet de :",
    items: [
      'mesurer les avancées',
      "tirer les enseignements de l'expérience",
      'ajuster la démarche',
      'préparer la suite',
      'ou permettre au collectif de continuer en autonomie',
    ],
    closing: "L'objectif n'est pas seulement de réussir un atelier, un séminaire ou une rencontre. Il est aussi d'aider votre organisation à mieux coopérer, décider et apprendre dans la durée.",
  },
];

---

<Layout
  title="Facilitateur professionnel, coach et formateur — by Nicolas Verdot"
  description="Séminaires facilités, ateliers d'intelligence collective, facilitation graphique, coaching et formations : trouvez le service qui débloquera votre équipe — et passez de la discussion à l'action."
  path="/"
>
  <Hero />

  <section class="proof-band" data-reveal data-section-name="Bénéfices">
    <div class="container proof-inner">
      <h2>
        Quand l'essentiel devient visible,
        <span class="accent-wrap">
          le collectif avance.
          <svg class="ink-underline" viewBox="0 0 300 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 70 2, 150 14, 296 6" /></svg>
        </span>
      </h2>
      <div class="proof-grid">
        {proofItems.map((p) => (
          <div class="proof-item">
            <svg class="proof-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.icon]} />
            <strong>{p.title}</strong>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="trust" data-reveal data-section-name="Logos clients">
    <div class="client-marquee">
      <div class="client-marquee-track">
        {[...clients, ...clients].map((c, i) => {
          const inner = c.logo ? <img src={withBase(c.logo)} alt={c.name} loading="lazy" /> : <span class="client-text">{c.name}</span>;
          return c.href ? (
            <a class="client-item" href={c.href} data-case-study-trigger={c.caseStudySlug} aria-hidden={i >= clients.length ? 'true' : undefined} tabindex={i >= clients.length ? -1 : undefined}>
              {inner}
            </a>
          ) : (
            <span class="client-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
              {inner}
            </span>
          );
        })}
      </div>
    </div>
  </section>

  <CaseStudyModal />

  <section class="partner-intro section" data-reveal data-section-name="Nicolas Verdot, votre partenaire">
    <div class="container split split-top">
      <div class="split-photo portrait portrait-overlay-wrap">
        <Image src={portrait} alt="Portrait de Nicolas Verdot" width={640} height={853} />
        <div class="portrait-overlay">
          <p class="portrait-name">Nicolas VERDOT</p>
          <p class="portrait-role">Booster de leaders et d'équipes</p>
        </div>
      </div>
      <div>
        <h2>Un partenaire pour franchir un cap et mettre votre collectif en mouvement</h2>
        <p class="partner-lead"><strong>Imaginez…</strong></p>
        <ul class="partner-imagine-list">
          <li>Vos équipes comprennent la direction et savent comment y contribuer.</li>
          <li>Vos décisions sont mieux préparées, plus rapides et réellement mises en œuvre.</li>
          <li>Les bonnes personnes participent aux bonnes conversations, au bon moment.</li>
          <li>Les idées émergent, se confrontent et deviennent des actions concrètes.</li>
          <li>Votre collectif avance avec davantage de clarté, d'engagement et d'autonomie.</li>
        </ul>
        <p>Lancer un nouveau projet, construire une vision commune, accompagner une croissance, préparer une transformation, faire vivre une communauté ou dépasser une situation qui s'enlise : chaque contexte est différent.</p>
        <p>Mais une même question revient souvent :</p>
      </div>
    </div>

    <div class="container">
      <div class="partner-question-frame">
        <p>Comment permettre aux personnes concernées de comprendre, décider et construire ensemble ?</p>
      </div>
    </div>

    <div class="container">
      <div class="partner-approach">
        <div class="partner-approach-text">
          <p>Depuis plus de dix ans, j'accompagne les équipes et les organisations dans les moments où le collectif doit franchir une étape. J'observe ce qui se joue dans les interactions, les rôles, les habitudes et les modes de décision, et je fais émerger les points de vue, les attentes, les désaccords et les idées qui ont besoin d'être entendus pour permettre au groupe d'avancer.</p>
          <p>Je conçois ensuite les espaces de travail, les conversations et les processus de collaboration adaptés à votre situation : pour explorer un sujet, partager une vision, prendre une décision, construire une solution ou passer à l'action.</p>
        </div>
        <div class="partner-approach-expertise">
          <p class="partner-expertise-title">
            Une expertise concrète au service d'un objectif simple : permettre à votre collectif d'
            <span class="accent-wrap">
              avancer durablement.
              <svg class="ink-underline" viewBox="0 0 260 16" preserveAspectRatio="none" aria-hidden="true"><path d="M4 10 C 60 2, 200 14, 256 6" /></svg>
            </span>
          </p>
          <ExpertiseExplorer />
        </div>
      </div>
    </div>
  </section>

  <section class="trust-block section alt" data-reveal data-section-name="Faire confiance">
    <div class="container">
    <div class="trust-inner">
      <h2>Ensemble, mettons votre collectif en mouvement</h2>

      <div class="trust-timeline">
        {journeyStepsBeforeFork.map((step, i) => (
          <div class="trust-step">
            <span class="trust-step-num">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.lead}</p>
              {step.items && (
                <ul class="trust-step-list">
                  {step.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
              <p class="trust-step-closing">{step.closing}</p>
            </div>
          </div>
        ))}

        <div class="trust-step">
          <span class="trust-step-num">4</span>
          <div>
            <h3>Vous choisissez la suite</h3>
            <div class="trust-fork">
              <div class="trust-outcome trust-outcome-closed">
                <span class="trust-outcome-label">Vous avancez en autonomie</span>
                <p>L'échange vous a permis de clarifier votre intention, d'identifier les prochaines étapes ou de trouver une manière concrète d'agir. Vous avez ce qu'il vous faut pour poursuivre sans moi. Parfait, je suis ravi d'avoir pu vous être utile.</p>
              </div>
              <div class="trust-outcome trust-outcome-featured">
                <span class="trust-outcome-label">Nous construisons un accompagnement</span>
                <p>Nous concevons ensemble un dispositif adapté à votre contexte et au résultat recherché : séminaire, atelier, facilitation, coaching, formation, accompagnement de communauté. Pas de solution toute faite ni de format plaqué à l'avance.</p>
              </div>
            </div>
          </div>
        </div>

        {journeyStepsAfterFork.map((step, i) => (
          <div class="trust-step">
            <span class="trust-step-num">{i + 5}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.lead}</p>
              {step.items && (
                <ul class="trust-step-list">
                  {step.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
              <p class="trust-step-closing">{step.closing}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="trust-expertise">
        <h3>Une expertise centrée sur l'humain</h3>
        <p>J'accompagne les entreprises, les collectivités et les associations, quels que soient leur secteur et la nature de leurs projets. Science, industrie, technologie, intelligence artificielle, vente, conseil ou services : les métiers et les expertises changent, mais les enjeux humains restent souvent les mêmes.</p>
        <p>Mon terrain se situe là où les personnes doivent se comprendre, contribuer, décider, coopérer et construire ensemble pour faire avancer un projet, une équipe, une communauté ou une organisation.</p>
      </div>

      <a class="btn" href={SITE.bookingUrl} target="_blank" rel="noopener">Réserver un premier échange →</a>
    </div>
    </div>
  </section>

  <PriorityGrid />

  <section class="resources section alt" data-reveal data-section-name="Les ressources">
    <div class="container">
      <div class="section-head">
        <h2>Pour commencer à débloquer les choses</h2>
      </div>
      <div class="resources-grid">
        {resourceArticles.map((a) => (
          <a class="resource-card" href={withBase(`/blog/${a.slug}/`)}>
            <div class={`article-visual resource-visual ${a.visual}`}></div>
            <div class="resource-body">
              <h3>{a.title}</h3>
              <p>{a.description}</p>
              <span class="card-link">Lire l'article</span>
            </div>
          </a>
        ))}
      </div>
      <p class="complementary-label"><a href={withBase('/blog/')}>Voir tous les articles</a></p>
    </div>
  </section>

  <CTABlock
    dark
    title="Un collectif qui patine, ça se débloque."
    subtitle="Racontez-moi la situation, ce qui bloque, et ce que vous voulez vraiment voir changer — le reste, on le construit ensemble."
    ctaLabel="Parler de mon projet"
    secondaryLabel="Découvrir les accompagnements"
    secondaryHref={withBase('/offres/')}
  />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Le trait sous "le collectif avance." se dessine de gauche à droite au
  // scroll et se redessine à chaque passage — descendre le trace, remonter
  // l'efface — plutôt que de rester acquis une fois pour toutes. Seul cet
  // exemplaire du motif .ink-underline (celui du bandeau bénéfices) est
  // concerné. Trigger sur la SECTION (pas le path, trop fin pour un calcul
  // fiable) et seuil à 65% : sur un grand écran, le bandeau peut déjà
  // dépasser 85% de hauteur de viewport dès le chargement, ce qui
  // déclenchait l'anim avant même que l'utilisateur ait scrollé jusqu'à elle.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.proof-band');
    const path = document.querySelector<SVGPathElement>('.proof-inner .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 65%',
        toggleActions: 'play none none reverse',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });

  // Même motif .ink-underline, troisième exemplaire indépendant : le trait sous
  // "avancer durablement." dans le panneau d'expertise.
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const section = document.querySelector<HTMLElement>('.partner-approach-expertise');
    const path = document.querySelector<SVGPathElement>('.partner-approach-expertise .ink-underline path');
    if (!section || !path) return;

    const length = path.getTotalLength();
    gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });

    const tween = gsap.to(path, {
      strokeDashoffset: 0,
      duration: 1,
      delay: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 75%',
        toggleActions: 'play none none reverse',
      },
    });

    return () => tween.scrollTrigger?.kill();
  });

  // Frise "Ensemble, mettons votre collectif en mouvement" : chaque pastille
  // numérotée passe du bleu au jaune au fil du scroll, pour donner une
  // sensation de progression le long des étapes (et repasse au bleu en
  // remontant, comme les traits .ink-underline).
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const nums = gsap.utils.toArray<HTMLElement>('.trust-step-num');
    const triggers = nums.map((num) =>
      ScrollTrigger.create({
        trigger: num,
        start: 'top 75%',
        onEnter: () => num.classList.add('is-active'),
        onLeaveBack: () => num.classList.remove('is-active'),
      })
    );

    return () => triggers.forEach((t) => t.kill());
  });
</script>

<style>
  .complementary-label {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .complementary-label a {
    color: var(--color-blue);
    font-weight: 600;
  }

  /* --- Bandeau noir "preuve" (4 bénéfices) --- */
  .proof-band {
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-12) 0;
  }
  .proof-inner {
    text-align: center;
  }
  .proof-inner h2 {
    color: var(--color-white);
    margin: 0 0 var(--space-8);
  }
  .proof-inner .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .proof-inner .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.15em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    max-width: 1040px;
    margin-inline: auto;
  }
  .proof-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-2);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .proof-item:first-child {
    border-left: none;
  }
  .proof-icon {
    width: 28px;
    height: 28px;
    color: var(--color-orange);
  }
  .proof-item p {
    margin: 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }
  .proof-item strong {
    display: block;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  @media (max-width: 800px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8) var(--space-4);
    }
    .proof-item {
      border-left: none;
    }
  }

  /* --- "concrets" souligné au feutre (même trait que "tout avance") --- */
  .circled {
    position: relative;
    display: inline-block;
  }
  .circled .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }


  /* --- Nicolas Verdot, votre partenaire --- */
  .partner-intro h2 {
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }
  .partner-intro p {
    font-size: var(--text-lg);
    line-height: 1.6;
  }
  .partner-intro .tool-tags {
    margin: var(--space-2) 0 0;
  }
  .split-top {
    align-items: start;
  }
  .partner-question-frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-top: var(--space-6);
    text-align: center;
  }
  .partner-question-frame p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.35;
  }
  .partner-approach {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-12);
  }
  .partner-approach-text p + p {
    margin-top: var(--space-4);
  }
  .partner-approach-expertise {
    background: var(--color-ink-solid);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-8) var(--space-8);
    box-shadow: var(--shadow-lg);
  }
  .partner-expertise-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.4;
    margin: 0;
  }
  .partner-approach-expertise .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .partner-approach-expertise .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.1em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
  }
  .partner-approach-expertise :global(.expertise-explorer) {
    margin-top: var(--space-6);
  }
  @media (max-width: 900px) {
    .partner-approach {
      grid-template-columns: 1fr;
    }
  }
  .portrait-overlay-wrap {
    position: relative;
  }
  .portrait-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-6) var(--space-4) var(--space-4);
    background: linear-gradient(180deg, rgba(18, 32, 51, 0) 0%, rgba(18, 32, 51, 0.85) 35%, rgba(18, 32, 51, 0.97) 60%);
    text-align: center;
  }
  .portrait-name {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-white);
  }
  .portrait-role {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
