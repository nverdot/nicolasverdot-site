---
/**
 * La fiche d'une formation.
 *
 * Une page n'est generee que pour les formations qui portent un `programme`
 * complet dans `src/data/formations.ts`. Les autres restent des cartes du
 * catalogue : mieux vaut pas de page qu'une page vide qui promet un programme
 * et n'en donne pas.
 *
 * L'ordre des blocs n'est pas cosmetique, c'est l'ordre dans lequel la decision
 * se prend :
 *
 *   1. « est-ce que ca me parle ? »   -> le contexte
 *   2. « est-ce que c'est pour moi ? » -> public, prerequis, et surtout quand
 *      ce n'est PAS pour vous — dit tot, pas cache en bas de page
 *   3. « qu'est-ce qu'on y fait ? »    -> le deroule, sequence par sequence
 *   4. « qu'est-ce que j'en repars ? » -> objectifs et livrables
 *   5. « comment ca se passe ? »       -> les modalites
 *
 * Les criteres qui font eliminer — duree, format, niveau — sont repetes en
 * tete dans un bandeau : on ne doit pas avoir a scroller pour savoir si le
 * format tient dans son agenda.
 */
import Layout from '../../layouts/Layout.astro';
import CTABlock from '../../components/CTABlock.astro';
import { formationGroups } from '../../data/formations';
import { withBase } from '../../utils/url';
import { SITE } from '../../data/site';

export function getStaticPaths() {
  return formationGroups.flatMap((groupe) =>
    groupe.items
      .filter((f) => f.programme)
      .map((f) => ({ params: { slug: f.slug }, props: { formation: f, univers: groupe.universe } }))
  );
}

const { formation, univers } = Astro.props;
const p = formation.programme!;

const icones: Record<string, string> = {
  duree: '<circle cx="12" cy="12" r="9"/><path d="M12 7.4V12l3.2 1.9"/>',
  format: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  niveau: '<path d="M4 20V10M10 20V4M16 20v-8M22 20h-20"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>',
  sac: '<path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2"/>',
};

/* Schema.org « Course » : c'est ce qui fait apparaitre la duree et le mode
   d'enseignement dans les resultats de recherche. */
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: formation.title,
  description: formation.summary,
  provider: {
    '@type': 'Person',
    name: 'Nicolas Verdot',
    url: new URL(withBase('/a-propos/'), Astro.site).toString(),
  },
  url: new URL(withBase(`/formations/${formation.slug}/`), Astro.site).toString(),
  teaches: p.objectifs,
  coursePrerequisites: p.prerequis.join(' '),
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'blended',
    courseWorkload: formation.duration,
  },
};
---

<Layout
  title={`${formation.title} — formation | by Nicolas Verdot`}
  description={formation.summary}
  path={`/formations/${formation.slug}/`}
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: 'Formations', path: '/formations/' },
    { name: formation.title, path: `/formations/${formation.slug}/` },
  ]}
>
  <section class="fiche-hero" data-reveal data-section-name="En-tête de la formation">
    <div class="container">
      <p class="eyebrow">{univers}</p>
      <h1>{formation.title}</h1>
      <p class="fiche-summary">{formation.summary}</p>

      {/* Les trois criteres qui font eliminer, avant tout le reste. */}
      <ul class="fiche-specs">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones.duree} />
          <span><small>Durée</small>{formation.duration}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones.format} />
          <span><small>Format</small>{formation.format}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones.niveau} />
          <span><small>Niveau</small>{formation.level}</span>
        </li>
      </ul>

      <div class="fiche-actions">
        <a class="btn" href={SITE.bookingUrl} target="_blank" rel="noopener">Caler cette formation →</a>
        <a class="btn-outline" href={withBase('/formations/')}>Voir tout le catalogue</a>
      </div>
    </div>
  </section>

  <section class="section" data-reveal data-section-name="Le contexte">
    <div class="container prose">
      <h2>Pourquoi cette formation</h2>
      {p.contexte.map((t) => <p>{t}</p>)}
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Pour qui">
    <div class="container">
      <div class="fiche-duo">
        <div>
          <h2>À qui elle s'adresse</h2>
          <ul class="fiche-liste">
            {p.pourQui.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div>
          <h2>Prérequis</h2>
          <ul class="fiche-liste">
            {p.prerequis.map((t) => <li>{t}</li>)}
          </ul>
        </div>
      </div>

      {/* Dit tot et en clair : ce qui fait perdre le plus de temps a tout le
          monde, c'est une formation suivie par quelqu'un qui cherchait autre
          chose. */}
      {p.pasPourVous && (
        <p class="fiche-pasvous">
          <strong>Quand ce n'est pas la bonne formation.</strong> {p.pasPourVous}
        </p>
      )}
    </div>
  </section>

  <section class="section" data-reveal data-section-name="Le déroulé">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{p.deroule.length} séquences</p>
          <h2>Ce qu'on y fait</h2>
        </div>
      </div>
      <ol class="fiche-deroule">
        {p.deroule.map((etape, i) => (
          <li>
            <span class="fiche-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Objectifs et livrables">
    <div class="container">
      <div class="fiche-duo">
        <div>
          <h2>Objectifs pédagogiques</h2>
          <p class="fiche-chapo">À l'issue de cette formation, le participant sera capable de&nbsp;:</p>
          <ul class="fiche-coches">
            {p.objectifs.map((o) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones.check} />
                <span>{o}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Vous repartez avec</h2>
          <ul class="fiche-coches fiche-coches-sac">
            {p.livrables.map((l) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icones.sac} />
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-reveal data-section-name="Modalités">
    <div class="container prose">
      <h2>Comment ça se passe</h2>
      <ul class="fiche-liste">
        {p.modalites.map((m) => <li>{m}</li>)}
      </ul>
      <p class="fiche-note">
        Formation accessible aux personnes en situation de handicap&nbsp;: dites-le-moi en amont, nous
        adaptons le format, les supports et le rythme. Tarifs et modalités de financement communiqués lors
        de l'échange de cadrage.
      </p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <CTABlock
    dark
    title="On cale cette formation ?"
    subtitle="Un échange de cadrage d'abord : qui vous voulez former, sur quoi, et ce qui devra avoir changé ensuite. Le programme s'ajuste à partir de là."
    ctaLabel="Réserver un échange"
    secondaryLabel="Voir tout le catalogue"
    secondaryHref={withBase('/formations/')}
  />
</Layout>

<style>
  .fiche-hero {
    padding: var(--space-16) 0 var(--space-12);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-orange) 12%, var(--color-cream)), var(--color-cream));
  }
  .fiche-hero h1 {
    margin: 0 0 var(--space-4);
  }
  .fiche-summary {
    margin: 0 0 var(--space-8);
    font-size: var(--text-lg);
    color: var(--color-muted);
  }

  .fiche-specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }
  .fiche-specs li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .fiche-specs svg {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--color-clay);
  }
  .fiche-specs span {
    font-weight: 600;
    line-height: 1.25;
  }
  .fiche-specs small {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fiche-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .fiche-duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
  }
  .fiche-duo h2 {
    font-size: var(--text-2xl);
  }
  .fiche-chapo {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }

  .fiche-liste {
    margin: 0;
    padding-left: 1.2rem;
  }
  .fiche-liste li {
    margin-bottom: var(--space-3);
    color: var(--color-muted);
  }

  .fiche-coches {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fiche-coches li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-4);
    color: var(--color-muted);
  }
  .fiche-coches svg {
    width: 22px;
    height: 22px;
    margin-top: 0.15em;
    color: var(--color-blue);
  }
  .fiche-coches-sac svg {
    color: var(--color-clay);
  }

  /* Le « ce n'est pas pour vous » : un encadré terre cuite, lisible comme une
     mise en garde honnête et pas comme une clause en petits caractères. */
  .fiche-pasvous {
    max-width: var(--prose-max);
    margin: var(--space-12) 0 0;
    padding: var(--space-6);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-clay) 8%, var(--color-surface));
    box-shadow: inset 3px 0 0 var(--color-clay);
    color: var(--color-muted);
  }
  .fiche-pasvous strong {
    color: var(--color-navy);
  }

  .fiche-deroule {
    display: grid;
    gap: var(--space-8);
    max-width: 44rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .fiche-deroule li {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }
  .fiche-num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-orange);
    color: #122033;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
  }
  .fiche-deroule h3 {
    margin: 0.5rem 0 var(--space-2);
    font-size: var(--text-xl);
  }
  .fiche-deroule p {
    margin: 0;
    color: var(--color-muted);
  }

  .fiche-note {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px dashed var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 860px) {
    .fiche-duo {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
