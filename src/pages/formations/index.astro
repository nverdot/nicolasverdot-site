---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABlock from '../../components/CTABlock.astro';
import heroImg from '../../assets/hero-seminaires-alpes-maritimes.png';
---

<Layout
  title="Formations — by Nicolas Verdot"
  description="Le catalogue de formations est en cours de construction."
  path="/formations/"
>
  <PageHero
    eyebrow="Formations"
    title="Cette page arrive"
    titleAccent="bientôt."
    summary="Le catalogue de formations est en cours de construction. En attendant, parlons directement de <strong>votre besoin de montée en compétence</strong>."
    image={heroImg}
    imageAlt="Un facilitateur anime un atelier en petit groupe sur une terrasse dominant la Méditerranée."
    tall
  />

  <CTABlock
    title="Un besoin de formation à préciser dès maintenant ?"
    subtitle="Facilitation graphique, intelligence collective, posture de leader facilitateur : parlons-en directement."
  />
</Layout>
