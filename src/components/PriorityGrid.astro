---
import { priorities } from '../data/priorities';
import { withBase } from '../utils/url';

interface Props {
  sectionName?: string;
}

const { sectionName = 'Vos priorités' } = Astro.props;
---

<section class="priorities section" data-reveal data-section-name={sectionName}>
  <div class="container">
    <div class="priorities-intro">
      <h2>Quelle avancée voulez-vous rendre possible ?</h2>
      <p class="priorities-lead">Lancer un projet, prendre une décision, mobiliser une équipe, accompagner une transformation ou faire évoluer une posture…</p>
      <p>Voici les besoins que je rencontre le plus souvent dans mes accompagnements. Ils peuvent se présenter seuls ou se combiner selon votre situation.</p>
    </div>
    <div class="priority-grid">
      {priorities.map((p, i) => (
        <a class="priority-card" href={p.href}>
          <span class="priority-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <span class="card-link">Découvrir cette offre</span>
        </a>
      ))}
    </div>
    <div class="priorities-closing">
      <p class="priorities-closing-question">Plusieurs sujets à adresser en même temps ?</p>
      <p>C'est fréquent — et ce n'est pas un problème. Parlons-en pour clarifier ensemble ce qui produira le plus de valeur pour votre collectif.</p>
      <a class="btn" href={withBase('/contact/')}>Parler de votre situation →</a>
    </div>
  </div>
</section>

<style>
  .priorities-intro {
    max-width: 720px;
    margin: 0 0 var(--space-8);
  }
  .priorities-intro h2 {
    margin: 0 0 var(--space-4);
  }
  .priorities-lead {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-navy);
    line-height: 1.5;
    margin: 0 0 var(--space-3);
  }
  .priorities-intro p:not(.priorities-lead) {
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }
  .priority-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .priority-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-hover) var(--ease-out), box-shadow var(--duration-hover) var(--ease-out);
  }
  .priority-card .card-link {
    margin-top: auto;
    padding-top: var(--space-3);
  }
  @media (hover: hover) and (pointer: fine) {
    .priority-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }
  }
  .priority-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-border);
    margin-bottom: var(--space-3);
  }
  .priority-card h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .priority-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .priority-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .priority-grid {
      grid-template-columns: 1fr;
    }
  }
  .priorities-closing {
    max-width: 720px;
    margin-top: var(--space-8);
  }
  .priorities-closing-question {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }
  .priorities-closing p:not(.priorities-closing-question) {
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-4);
  }
</style>
