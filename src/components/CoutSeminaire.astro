---
// Calculatrice « combien coûte votre séminaire » : le jour J (temps des
// participants), la préparation en interne, le lieu et les repas.
// Tout se calcule dans le navigateur, rien n'est envoyé.
// Les valeurs de départ sont des exemples que le visiteur remplace par les
// siennes : ce ne sont pas des prix de marché. L'animation n'est pas comptée,
// elle se chiffre au cadrage.
// La liste des types d'atelier vit dans src/data/tempsCollectifs.ts.
import { tempsCollectifs as types, profils, frequences } from '../data/tempsCollectifs';

const depart = types[0];

// Chiffres de l'enquête Atlassian « Workplace Woes: Meetings » (5 000 salariés
// de bureau, quatre continents), vérifiés à la source le 8 octobre 2026. Ils
// portent sur les réunions, pas sur les séminaires : la calculatrice les
// applique donc au conditionnel (« si cette journée ressemblait à… »).
const SOURCE = 'https://www.atlassian.com/blog/workplace-woes-meetings';
---

<section class="section alt cout-seminaire" data-reveal data-section-name="Calculatrice : le coût de votre séminaire" id="cout-seminaire">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">2 · Ce que disent les chiffres</p>
        <h2>Et si cette journée ressemblait à une réunion ordinaire&nbsp;?</h2>
      </div>
    </div>

    <div data-cout-seminaire data-profils={JSON.stringify(profils.map((pr) => ({ id: pr.id, label: pr.label.toLowerCase() })))}>
      {/* Le contexte, écrit en clair : il se réécrit à chaque changement dans
          la calculatrice, pour que les chiffres parlent d'une situation précise. */}
      <p class="cs-contexte"><strong>Imaginons.</strong> <span data-cs-out="contexte">—</span></p>

      {/* Les chiffres d'abord : ils disent pourquoi le calcul qui suit compte.
          Le pourcentage est fixe (c'est la donnée de l'enquête) ; la ligne du
          dessous se recalcule avec le séminaire saisi plus bas. */}
      <div class="cs-stats">
        <div class="cs-stat">
          <p class="cs-stat-chiffre">72&nbsp;%</p>
          <p class="cs-stat-texte"><strong>des réunions sont jugées inefficaces.</strong> Ici&nbsp;: <span data-cs-out="perdu">—</span> de temps collectif sans effet<span data-cs-out="paran-perdu"></span>.</p>
        </div>
        <div class="cs-stat">
          <p class="cs-stat-chiffre">76&nbsp;%</p>
          <p class="cs-stat-texte"><strong>des salariés se disent épuisés les jours chargés en réunions.</strong> Ici&nbsp;: <span data-cs-out="vides">—</span> repartiraient vidées.</p>
        </div>
        <div class="cs-stat">
          <p class="cs-stat-chiffre">54&nbsp;%</p>
          <p class="cs-stat-texte"><strong>quittent souvent une réunion sans prochaine étape claire.</strong> Ici&nbsp;: <span data-cs-out="flou">—</span> ne sauraient pas qui fait quoi.</p>
        </div>
        <p class="cs-stats-source">Chiffres sur les réunions&nbsp;: <a href={SOURCE} target="_blank" rel="noopener">enquête Atlassian auprès de 5&nbsp;000 salariés</a>, appliqués à la situation décrite ci-dessus, que vous pouvez modifier plus bas. Un séminaire bien conçu sert précisément à ne pas leur ressembler.</p>
      </div>

    <div class="cs-calc-tete">
      <h3>Et chez vous&nbsp;? Mettez vos chiffres.</h3>
      <p>Une réunion qui revient chaque semaine, un séminaire, un kick-off&nbsp;: choisissez, ajustez, le texte et les montants suivent. Rien n'est envoyé, le calcul se fait sur votre écran.</p>
    </div>
    <div class="cs-grid">
      <form class="cs-form" onsubmit="return false">
        {/* Une liste déroulante plutôt que sept pastilles : alignées sur
            quatre lignes inégales, elles faisaient brouillon. */}
        <label class="cs-field cs-field-type">
          <span>Quel temps collectif&nbsp;?</span>
          <select data-cs-type>
            {types.map((t, i) => (
              <option value={t.id} selected={i === 0} data-label={t.label} data-participants={JSON.stringify(t.participants)} data-jours={t.jours} data-prepa={t.prepa} data-paran={t.parAn} data-lieu={t.lieu}>{t.label}</option>
            ))}
          </select>
        </label>

        {/* Une journée de directeur ne coûte pas une journée de collaborateur :
            on compte donc les participants profil par profil. */}
        <fieldset class="cs-profils">
          <legend>Qui sera dans la salle&nbsp;?</legend>
          <div class="cs-profils-tete" aria-hidden="true">
            <span></span>
            <span>Nombre</span>
            <span>Coût d'une journée (€)</span>
          </div>
          {profils.map((pr) => (
            <div class="cs-profil">
              <span class="cs-profil-nom">{pr.label}</span>
              <input type="number" inputmode="numeric" min="0" max="2000" step="1" value={depart.participants[pr.id] ?? 0} data-cs-nb={pr.id} aria-label={`Nombre de ${pr.label.toLowerCase()}`} />
              <input type="number" inputmode="numeric" min="0" step="50" value={pr.cout} data-cs-cout={pr.id} aria-label={`Coût d'une journée, ${pr.label.toLowerCase()}`} />
            </div>
          ))}
          <small>Coût d'une journée = salaire chargé ramené au jour. Ces montants sont des exemples&nbsp;: mettez les vôtres.</small>
        </fieldset>

        <div class="cs-fields">
          <label class="cs-field">
            <span>Durée (jours)</span>
            <input type="number" inputmode="decimal" min="0.5" max="10" step="0.5" value={depart.jours} data-cs="jours" />
            <small>0,5 = une demi-journée.</small>
          </label>
          <label class="cs-field">
            <span>Fréquence</span>
            <select data-cs-freq>
              {frequences.map((f) => <option value={f.parAn} data-phrase={f.phrase} selected={f.parAn === depart.parAn}>{f.label}</option>)}
            </select>
            <small>Sur une année de travail&nbsp;: 46 semaines, 11 mois.</small>
          </label>
          <label class="cs-field">
            <span>Préparation interne (jours)</span>
            <input type="number" inputmode="decimal" min="0" step="0.5" value={depart.prepa} data-cs="prepa" />
            <small>Toutes personnes confondues&nbsp;: cadrage, programme, invitations, logistique. Comptée au coût d'un manager.</small>
          </label>
          <label class="cs-field">
            <span>Lieu et repas (€ par personne)</span>
            <input type="number" inputmode="numeric" min="0" step="10" value={depart.lieu} data-cs="lieu" />
            <small>Par jour, hébergement compris. Reprenez votre devis, ou mettez 0 si cela se tient chez vous.</small>
          </label>
          <label class="cs-field">
            <span>Déplacements (€ au total)</span>
            <input type="number" inputmode="numeric" min="0" step="100" value="0" data-cs="trajets" />
          </label>
        </div>
      </form>

      <div class="cs-result" aria-live="polite">
        <p class="cs-result-label" data-cs-out="titre">Ce temps collectif mobilise</p>
        <p class="cs-total" data-cs-out="total">—</p>
        <dl class="cs-lines">
          <div><dt>Le jour J <span data-cs-out="detail">temps des participants</span></dt><dd data-cs-out="jourj">—</dd></div>
          <div><dt>La préparation <span>temps passé en interne</span></dt><dd data-cs-out="prepa">—</dd></div>
          <div><dt>Le lieu et les repas <span>location, restauration, hébergement</span></dt><dd data-cs-out="lieu">—</dd></div>
          <div data-cs-row="trajets"><dt>Les déplacements</dt><dd data-cs-out="trajets">—</dd></div>
        </dl>
        <p class="cs-heure">Soit <strong data-cs-out="heure">—</strong> par heure passée ensemble.</p>
        <p class="cs-an" data-cs-row="an">Sur un an&nbsp;: <strong data-cs-out="an">—</strong></p>
        <p class="cs-note">L'animation n'est pas comptée ici&nbsp;: elle se chiffre lors du cadrage. Elle sert à une chose, que cette somme produise des décisions et des suites.</p>
        <slot />
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  const racine = document.querySelector<HTMLElement>('[data-cout-seminaire]');
  if (racine) {
    const euros = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const champ = (nom: string) => racine.querySelector<HTMLInputElement>(`[data-cs="${nom}"]`)!;
    const sortie = (nom: string) => racine.querySelector<HTMLElement>(`[data-cs-out="${nom}"]`)!;
    const lire = (nom: string) => Math.max(0, parseFloat(champ(nom).value.replace(',', '.')) || 0);
    // Une journée : 7 heures de travail ensemble.
    const HEURES_PAR_JOUR = 7;

    const nombres = Array.from(racine.querySelectorAll<HTMLInputElement>('[data-cs-nb]'));
    const couts = Array.from(racine.querySelectorAll<HTMLInputElement>('[data-cs-cout]'));
    const frequence = racine.querySelector<HTMLSelectElement>('[data-cs-freq]')!;
    const typeSelect = racine.querySelector<HTMLSelectElement>('[data-cs-type]')!;
    const profils = JSON.parse(racine.dataset.profils ?? '[]') as { id: string; label: string }[];
    const valeur = (el?: HTMLInputElement | null) => Math.max(0, parseFloat((el?.value ?? '').replace(',', '.')) || 0);
    const coutDe = (id: string) => valeur(couts.find((c) => c.dataset.csCout === id));

    const duree = (jours: number) => {
      if (jours === 0.5) return 'une matinée';
      if (jours === 1) return 'une journée';
      if (jours === 1.5) return 'un jour et demi';
      return `${String(jours).replace('.', ',')} jours`;
    };
    const liste = (mots: string[]) =>
      mots.length <= 1 ? mots.join('') : `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}`;

    const calculer = () => {
      const jours = lire('jours');
      const parAn = Math.max(1, parseInt(frequence.value, 10) || 1);
      // Le jour J se compte profil par profil : nombre × jours × coût de la journée.
      let participants = 0;
      let jourJ = 0;
      const presents: string[] = [];
      nombres.forEach((el) => {
        const nb = valeur(el);
        const id = el.dataset.csNb ?? '';
        participants += nb;
        jourJ += nb * jours * coutDe(id);
        if (nb > 0) presents.push(`${nb} ${profils.find((p) => p.id === id)?.label ?? ''}`);
      });
      // La préparation est le plus souvent portée par des managers.
      const prepa = lire('prepa') * (coutDe('managers') || coutDe('equipes') || coutDe('direction'));
      const lieu = participants * jours * lire('lieu');
      const trajets = lire('trajets');
      const total = jourJ + prepa + lieu + trajets;
      const annuel = total * parAn;
      const heures = jours * HEURES_PAR_JOUR;

      // Le contexte, en une phrase qui suit la saisie.
      const type = typeSelect.selectedOptions[0]?.dataset.label?.toLowerCase() ?? 'temps collectif';
      const rythme = frequence.selectedOptions[0]?.dataset.phrase ?? '';
      const debut = `${type.charAt(0).toUpperCase()}${type.slice(1)}`;
      sortie('contexte').textContent =
        `${debut} : ${liste(presents) || 'personne pour le moment'}. Durée : ${duree(jours)}. ${rythme}`.trim();

      sortie('titre').textContent = parAn > 1 ? 'Chaque séance mobilise' : 'Ce temps collectif mobilise';
      sortie('detail').textContent = `${participants} personne${participants > 1 ? 's' : ''} pendant ${duree(jours)}`;
      sortie('jourj').textContent = euros.format(jourJ);
      sortie('prepa').textContent = euros.format(prepa);
      sortie('lieu').textContent = euros.format(lieu);
      sortie('trajets').textContent = euros.format(trajets);
      sortie('total').textContent = euros.format(total);
      sortie('heure').textContent = heures > 0 ? euros.format(total / heures) : '—';
      sortie('an').textContent = `${euros.format(annuel)} pour ${parAn} séances`;
      racine.querySelector<HTMLElement>('[data-cs-row="an"]')!.hidden = parAn === 1;
      racine.querySelector<HTMLElement>('[data-cs-row="trajets"]')!.hidden = trajets === 0;

      const personnes = (part: number) => {
        const n = Math.round(participants * part);
        return `${n} personne${n > 1 ? 's' : ''} sur ${participants}`;
      };
      sortie('perdu').textContent = euros.format(annuel * 0.72);
      sortie('paran-perdu').textContent = parAn > 1 ? ' par an' : '';
      sortie('vides').textContent = personnes(0.76);
      sortie('flou').textContent = personnes(0.54);
    };

    [...nombres, ...couts].forEach((el) => el.addEventListener('input', calculer));
    racine.querySelectorAll<HTMLInputElement>('[data-cs]').forEach((el) => el.addEventListener('input', calculer));
    frequence.addEventListener('change', calculer);
    typeSelect.addEventListener('change', () => {
      const choix = typeSelect.selectedOptions[0];
      if (!choix) return;
      const repartition = JSON.parse(choix.dataset.participants ?? '{}') as Record<string, number>;
      nombres.forEach((el) => {
        el.value = String(repartition[el.dataset.csNb ?? ''] ?? 0);
      });
      champ('jours').value = choix.dataset.jours ?? '';
      champ('prepa').value = choix.dataset.prepa ?? '';
      champ('lieu').value = choix.dataset.lieu ?? '0';
      frequence.value = choix.dataset.paran ?? '1';
      calculer();
    });
    calculer();
  }
</script>

<style>
