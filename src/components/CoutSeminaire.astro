---
// Calculatrice « combien coûte votre séminaire » : le jour J (temps des
// participants), la préparation en interne, le lieu et les repas.
// Tout se calcule dans le navigateur, rien n'est envoyé.
// Les valeurs de départ sont des exemples que le visiteur remplace par les
// siennes : ce ne sont pas des prix de marché. L'animation n'est pas comptée,
// elle se chiffre au cadrage.
// La liste des types d'atelier vit dans src/data/tempsCollectifs.ts.
import { tempsCollectifs as types, profils, frequences, durees, parDefaut } from '../data/tempsCollectifs';

const depart = types.find((t) => t.id === parDefaut) ?? types[0];

// Chiffres de l'enquête Atlassian « Workplace Woes: Meetings » (5 000 salariés
// de bureau, quatre continents), vérifiés à la source le 8 octobre 2026. Ils
// portent sur les réunions, pas sur les séminaires : la calculatrice les
// applique donc au conditionnel (« si cette journée ressemblait à… »).
// Une icône par notion, pour repérer d'un coup d'œil ce que l'on règle.
// Même convention que le reste du site : trait feutre, viewBox 24×24.
const ico: Record<string, string> = {
  type: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  duree: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/>',
  frequence: '<path d="M4 12a8 8 0 0 1 13.5-5.8"/><path d="M20 12a8 8 0 0 1-13.5 5.8"/><path d="M17 3v4h-4"/><path d="M7 21v-4h4"/>',
  salle: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  direction: '<path d="M6 3v18"/><path d="M6 4h13l-3 4 3 4H6"/>',
  managers: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  equipes: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>',
  prepa: '<rect x="5" y="4" width="14" height="17" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8.5 11h7M8.5 15h7"/>',
  lieu: '<path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  trajets: '<path d="M3 16l1.5-5.5A2 2 0 0 1 6.4 9h11.2a2 2 0 0 1 1.9 1.5L21 16v3h-3v-2H6v2H3z"/><circle cx="7.5" cy="14.5" r="1" fill="currentColor" stroke="none"/><circle cx="16.5" cy="14.5" r="1" fill="currentColor" stroke="none"/>',
  inefficace: '<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>',
  energie: '<rect x="3" y="8" width="16" height="9" rx="2"/><path d="M21 11v3"/><path d="M6 11v3"/>',
  flou: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.4-1 .9-1 1.7"/><circle cx="12" cy="16.5" r="0.8" fill="currentColor" stroke="none"/>',
};
ico.remonte = '<path d="M12 20V6"/><path d="M6 11l6-6 6 6"/><path d="M5 20h14"/>';
const svg = (nom: string) =>
  `<svg class="cs-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ico[nom]}</svg>`;

const SOURCE = 'https://www.atlassian.com/blog/workplace-woes-meetings';
// McKinsey Quarterly, « Three keys to faster, better decisions », mai 2019,
// enquête auprès de plus de 1 200 managers. Lu dans le texte le 8 octobre 2026 :
// 61 % jugent inefficace au moins la moitié du temps passé à décider, et
// l'article cite parmi les causes les rôles flous et le manque de délégation,
// qui font remonter les décisions plus haut qu'il ne faudrait. Il ne donne PAS
// de pourcentage propre à la délégation : on n'en invente pas.
const SOURCE_DECISION = 'https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/three-keys-to-faster-better-decisions';
---

<section class="section alt cout-seminaire" data-reveal data-section-name="Calculatrice : le coût de votre séminaire" id="cout-seminaire">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">2 · Ce que disent les chiffres</p>
        <h2>Et si cette journée ressemblait à une réunion ordinaire&nbsp;?</h2>
      </div>
    </div>

    <div data-cout-seminaire data-profils={JSON.stringify(profils.map((pr) => ({ id: pr.id, label: pr.label.toLowerCase(), singulier: pr.singulier })))}>
      {/* Le contexte, écrit en clair : il se réécrit à chaque changement dans
          la calculatrice, pour que les chiffres parlent d'une situation précise. */}
      <p class="cs-contexte"><strong>Imaginons.</strong> <span data-cs-out="contexte">—</span></p>

      {/* Les chiffres d'abord : ils disent pourquoi le calcul qui suit compte.
          Le pourcentage est fixe (c'est la donnée de l'enquête) ; la ligne du
          dessous se recalcule avec le séminaire saisi plus bas. */}
      <div class="cs-stats">
        <div class="cs-stat">
          <p class="cs-stat-chiffre"><Fragment set:html={svg('inefficace')} />72&nbsp;%</p>
          <p class="cs-stat-texte"><strong>des réunions sont jugées inefficaces.</strong> Ici&nbsp;: <span data-cs-out="perdu">—</span> de temps collectif sans effet<span data-cs-out="paran-perdu"></span>.</p>
        </div>
        <div class="cs-stat">
          <p class="cs-stat-chiffre"><Fragment set:html={svg('energie')} />76&nbsp;%</p>
          <p class="cs-stat-texte"><strong>des salariés se disent épuisés les jours chargés en réunions.</strong> Ici&nbsp;: <span data-cs-out="vides">—</span> repartiraient vidées.</p>
        </div>
        <div class="cs-stat">
          <p class="cs-stat-chiffre"><Fragment set:html={svg('flou')} />54&nbsp;%</p>
          <p class="cs-stat-texte"><strong>quittent souvent une réunion sans prochaine étape claire.</strong> Ici&nbsp;: <span data-cs-out="flou">—</span> ne sauraient pas qui fait quoi.</p>
        </div>
        <div class="cs-stat">
          <p class="cs-stat-chiffre"><Fragment set:html={svg('remonte')} />61&nbsp;%</p>
          <p class="cs-stat-texte"><strong>des managers jugent inefficace au moins la moitié du temps passé à décider.</strong> En cause, entre autres&nbsp;: des rôles flous et trop peu de délégation. Les décisions remontent alors plus haut qu'il ne faudrait.</p>
        </div>
        <p class="cs-stats-source">Sources&nbsp;: <a href={SOURCE} target="_blank" rel="noopener">enquête Atlassian auprès de 5&nbsp;000 salariés</a> pour les trois premiers chiffres, qui portent sur les réunions et sont appliqués à la situation décrite ci-dessus&nbsp;; <a href={SOURCE_DECISION} target="_blank" rel="noopener">enquête McKinsey auprès de 1&nbsp;200 managers</a> pour le quatrième. Un séminaire bien conçu sert précisément à ne pas leur ressembler.</p>
      </div>

    <div class="cs-calc-tete">
      <h3>Et chez vous&nbsp;? Mettez vos chiffres.</h3>
      <p>Réunion récurrente, comité de pilotage, CODIR, séminaire trimestriel ou annuel&nbsp;: choisissez, ajustez, le texte et les montants suivent. Rien n'est envoyé, le calcul se fait sur votre écran.</p>
    </div>
    <div class="cs-grid">
      <form class="cs-form" onsubmit="return false">
        {/* Trois groupes numérotés, chacun dans son cadre : on voit d'un coup
            d'œil que « Qui sera dans la salle ? » est une rubrique à part. */}
        <fieldset class="cs-groupe">
          <legend><i>1</i>Le temps collectif</legend>
        {/* Une liste déroulante plutôt que sept pastilles : alignées sur
            quatre lignes inégales, elles faisaient brouillon. */}
        <label class="cs-field cs-field-type">
          <span><Fragment set:html={svg('type')} />Lequel&nbsp;?</span>
          <select data-cs-type>
            {types.map((t) => (
              <option value={t.id} selected={t.id === depart.id} data-label={t.label} data-phrase={t.phrase} data-description={t.description} data-participants={JSON.stringify(t.participants)} data-jours={t.jours} data-prepa={t.prepa} data-paran={t.parAn} data-lieu={t.lieu}>{t.label}</option>
            ))}
          </select>
          <small data-cs-out="description">{depart.description}</small>
        </label>

        {/* Durée et fréquence viennent tout de suite après le type : ce sont
            elles qui définissent le temps collectif, avant de dire qui y vient. */}
        <div class="cs-fields">
          <label class="cs-field">
            <span><Fragment set:html={svg('duree')} />Durée</span>
            <select data-cs="jours">
              {durees.map((d) => <option value={d.jours} data-phrase={d.phrase} selected={d.jours === depart.jours}>{d.label}</option>)}
            </select>
          </label>
          <label class="cs-field">
            <span><Fragment set:html={svg('frequence')} />Fréquence</span>
            <select data-cs-freq>
              {frequences.map((f) => <option value={f.parAn} data-phrase={f.phrase} selected={f.parAn === depart.parAn}>{f.label}</option>)}
            </select>
            <small>Sur une année de travail&nbsp;: 46 semaines, 11 mois.</small>
          </label>
        </div>
        </fieldset>

        {/* Une journée de directeur ne coûte pas une journée de collaborateur :
            on compte donc les participants profil par profil. */}
        <fieldset class="cs-groupe cs-profils">
          <legend><i>2</i>Qui sera dans la salle&nbsp;?</legend>
          <div class="cs-profils-tete" aria-hidden="true">
            <span></span>
            <span>Nombre</span>
            <span>Coût d'une journée (€)</span>
          </div>
          {profils.map((pr) => (
            <div class="cs-profil">
              <span class="cs-profil-nom"><Fragment set:html={svg(pr.id)} />{pr.label}</span>
              <input type="number" inputmode="numeric" min="0" max="2000" step="1" value={depart.participants[pr.id] ?? 0} data-cs-nb={pr.id} aria-label={`Nombre de ${pr.label.toLowerCase()}`} />
              <input type="number" inputmode="numeric" min="0" step="50" value={pr.cout} data-cs-cout={pr.id} aria-label={`Coût d'une journée, ${pr.label.toLowerCase()}`} />
            </div>
          ))}
          <small>Coût d'une journée = salaire chargé ramené au jour. Ces montants sont des exemples&nbsp;: mettez les vôtres.</small>
        </fieldset>

        <fieldset class="cs-groupe">
          <legend><i>3</i>Préparation et logistique</legend>
        <div class="cs-fields">
          <label class="cs-field">
            <span><Fragment set:html={svg('prepa')} />Préparation interne (jours)</span>
            <input type="number" inputmode="decimal" min="0" step="0.5" value={depart.prepa} data-cs="prepa" />
            <small>Toutes personnes confondues&nbsp;: cadrage, programme, invitations, logistique. Comptée au coût d'un manager.</small>
          </label>
          <label class="cs-field">
            <span><Fragment set:html={svg('lieu')} />Lieu et repas (€ par personne)</span>
            <input type="number" inputmode="numeric" min="0" step="10" value={depart.lieu} data-cs="lieu" />
            <small>Par jour, hébergement compris. Reprenez votre devis, ou mettez 0 si cela se tient chez vous.</small>
          </label>
          <label class="cs-field">
            <span><Fragment set:html={svg('trajets')} />Déplacements (€ au total)</span>
            <input type="number" inputmode="numeric" min="0" step="100" value="0" data-cs="trajets" />
          </label>
        </div>
        </fieldset>
      </form>

      <div class="cs-result" aria-live="polite">
        <p class="cs-result-label" data-cs-out="titre">Ce temps collectif mobilise</p>
        <p class="cs-total" data-cs-out="total">—</p>
        <dl class="cs-lines">
          <div><dt><Fragment set:html={svg('salle')} />Le jour J <span data-cs-out="detail">temps des participants</span></dt><dd data-cs-out="jourj">—</dd></div>
          <div><dt><Fragment set:html={svg('prepa')} />La préparation <span>temps passé en interne</span></dt><dd data-cs-out="prepa">—</dd></div>
          <div><dt><Fragment set:html={svg('lieu')} />Le lieu et les repas <span>location, restauration, hébergement</span></dt><dd data-cs-out="lieu">—</dd></div>
          <div data-cs-row="trajets"><dt><Fragment set:html={svg('trajets')} />Les déplacements</dt><dd data-cs-out="trajets">—</dd></div>
        </dl>
        <p class="cs-heure">Soit <strong data-cs-out="heure">—</strong> par heure passée ensemble.</p>
        <p class="cs-an" data-cs-row="an">Sur un an&nbsp;: <strong data-cs-out="an">—</strong></p>
        <p class="cs-note">L'animation n'est pas comptée ici&nbsp;: elle se chiffre lors du cadrage. Elle sert à une chose, que cette somme produise des décisions et des suites.</p>
        <slot />
      </div>
    </div>
    </div>
  </div>
</section>

<script>
  const racine = document.querySelector<HTMLElement>('[data-cout-seminaire]');
  if (racine) {
    const euros = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const champ = (nom: string) => racine.querySelector<HTMLInputElement>(`[data-cs="${nom}"]`)!;
    const sortie = (nom: string) => racine.querySelector<HTMLElement>(`[data-cs-out="${nom}"]`)!;
    const lire = (nom: string) => Math.max(0, parseFloat(champ(nom).value.replace(',', '.')) || 0);
    // Une journée : 7 heures de travail ensemble.
    const HEURES_PAR_JOUR = 7;

    const nombres = Array.from(racine.querySelectorAll<HTMLInputElement>('[data-cs-nb]'));
    const couts = Array.from(racine.querySelectorAll<HTMLInputElement>('[data-cs-cout]'));
    const frequence = racine.querySelector<HTMLSelectElement>('[data-cs-freq]')!;
    const typeSelect = racine.querySelector<HTMLSelectElement>('[data-cs-type]')!;
    const profils = JSON.parse(racine.dataset.profils ?? '[]') as { id: string; label: string; singulier: string }[];
    const valeur = (el?: HTMLInputElement | null) => Math.max(0, parseFloat((el?.value ?? '').replace(',', '.')) || 0);
    const coutDe = (id: string) => valeur(couts.find((c) => c.dataset.csCout === id));

    const dureeSelect = racine.querySelector<HTMLSelectElement>('select[data-cs="jours"]')!;
    const duree = () => dureeSelect.selectedOptions[0]?.dataset.phrase ?? '';
    const liste = (mots: string[]) =>
      mots.length <= 1 ? mots.join('') : `${mots.slice(0, -1).join(', ')} et ${mots[mots.length - 1]}`;

    const calculer = () => {
      const jours = lire('jours');
      const parAn = Math.max(1, parseInt(frequence.value, 10) || 1);
      // Le jour J se compte profil par profil : nombre × jours × coût de la journée.
      let participants = 0;
      let jourJ = 0;
      const presents: string[] = [];
      nombres.forEach((el) => {
        const nb = valeur(el);
        const id = el.dataset.csNb ?? '';
        participants += nb;
        jourJ += nb * jours * coutDe(id);
        const profil = profils.find((p) => p.id === id);
        if (nb > 0) presents.push(`${nb} ${nb > 1 ? profil?.label ?? '' : profil?.singulier ?? ''}`);
      });
      // La préparation est le plus souvent portée par des managers.
      const prepa = lire('prepa') * (coutDe('managers') || coutDe('equipes') || coutDe('direction'));
      const lieu = participants * jours * lire('lieu');
      const trajets = lire('trajets');
      const total = jourJ + prepa + lieu + trajets;
      const annuel = total * parAn;
      const heures = jours * HEURES_PAR_JOUR;

      // Le contexte, en une phrase qui suit la saisie.
      const rythme = frequence.selectedOptions[0]?.dataset.phrase ?? '';
      const choisi = typeSelect.selectedOptions[0];
      sortie('description').textContent = choisi?.dataset.description ?? '';
      sortie('contexte').textContent = presents.length
        ? `${choisi?.dataset.phrase ?? 'Un temps collectif'} : ${liste(presents)}, réunis ${duree()}, ${rythme}.`
        : 'Indiquez qui sera dans la salle.';

      sortie('titre').textContent = parAn > 1 ? 'Chaque séance mobilise' : 'Ce temps collectif mobilise';
      sortie('detail').textContent = `${participants} personne${participants > 1 ? 's' : ''} pendant ${duree()}`;
      sortie('jourj').textContent = euros.format(jourJ);
      sortie('prepa').textContent = euros.format(prepa);
      sortie('lieu').textContent = euros.format(lieu);
      sortie('trajets').textContent = euros.format(trajets);
      sortie('total').textContent = euros.format(total);
      sortie('heure').textContent = heures > 0 ? euros.format(total / heures) : '—';
      sortie('an').textContent = `${euros.format(annuel)} pour ${parAn} séances`;
      racine.querySelector<HTMLElement>('[data-cs-row="an"]')!.hidden = parAn === 1;
      racine.querySelector<HTMLElement>('[data-cs-row="trajets"]')!.hidden = trajets === 0;

      const personnes = (part: number) => {
        const n = Math.round(participants * part);
        return `${n} personne${n > 1 ? 's' : ''} sur ${participants}`;
      };
      sortie('perdu').textContent = euros.format(annuel * 0.72);
      sortie('paran-perdu').textContent = parAn > 1 ? ' par an' : '';
      sortie('vides').textContent = personnes(0.76);
      sortie('flou').textContent = personnes(0.54);
    };

    [...nombres, ...couts].forEach((el) => el.addEventListener('input', calculer));
    racine.querySelectorAll<HTMLElement>('[data-cs]').forEach((el) => {
      el.addEventListener('input', calculer);
      el.addEventListener('change', calculer);
    });
    frequence.addEventListener('change', calculer);
    typeSelect.addEventListener('change', () => {
      const choix = typeSelect.selectedOptions[0];
      if (!choix) return;
      const repartition = JSON.parse(choix.dataset.participants ?? '{}') as Record<string, number>;
      nombres.forEach((el) => {
        el.value = String(repartition[el.dataset.csNb ?? ''] ?? 0);
      });
      champ('jours').value = choix.dataset.jours ?? '';
      champ('prepa').value = choix.dataset.prepa ?? '';
      champ('lieu').value = choix.dataset.lieu ?? '0';
      frequence.value = choix.dataset.paran ?? '1';
      calculer();
    });
    // À chaque chargement, un exemple différent : le visiteur ne voit pas
    // toujours le même cas, et comprend que la simulation se règle.
    typeSelect.selectedIndex = Math.floor(Math.random() * typeSelect.options.length);
    typeSelect.dispatchEvent(new Event('change'));
  }
</script>

<style>
  .cs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .cs-form {
    display: grid;
    gap: var(--space-4);
  }
  /* Chaque rubrique est un cadre, avec son numéro et son titre. */
  .cs-groupe {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .cs-groupe > legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    float: left;
    width: 100%;
    margin: 0 0 var(--space-2);
    padding: 0 0 var(--space-3);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-navy);
    font-size: var(--text-lg);
    font-weight: 800;
  }
  .cs-groupe > legend + * {
    clear: both;
  }
  .cs-groupe > legend i {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-orange);
    color: #122033;
    font-style: normal;
    font-weight: 800;
  }
  .cs-profils {
    gap: var(--space-3);
  }
  /* Les lignes sont en retrait sous « Qui sera dans la salle ? », et la case
     du nombre est étroite : deux ou trois chiffres suffisent. */
  .cs-profils-tete,
  .cs-profil {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem 7.5rem;
    gap: var(--space-3);
    align-items: center;
  }
  .cs-profil input[data-cs-nb] {
    text-align: center;
    padding-inline: var(--space-2);
  }
  .cs-profils-tete {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .cs-profil-nom {
    color: var(--color-navy);
    font-weight: 600;
  }
  .cs-profil input {
    width: 100%;
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    color: var(--color-navy);
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .cs-profil input:focus-visible {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }
  .cs-profils small {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .cs-field > span {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-navy);
    font-weight: 700;
  }
  .cs-types-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cs-type {
    position: relative;
    cursor: pointer;
  }
  .cs-type input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .cs-type span {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-cream);
    color: var(--color-navy);
    font-weight: 600;
  }
  .cs-type input:checked + span {
    border-color: var(--color-orange);
    background: var(--color-orange);
    color: var(--color-ink-solid);
  }
  .cs-type input:focus-visible + span {
    outline: 2px solid var(--color-navy);
    outline-offset: 2px;
  }
  .cs-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
  }
  .cs-field {
    display: flex;
    flex-direction: column;
  }
  .cs-field input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
