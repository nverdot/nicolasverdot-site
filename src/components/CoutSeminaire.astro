    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 900px) {
    .cs-stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .cs-result :global(.btn) {
    margin-top: var(--space-6);
  }
  @media (max-width: 900px) {
    .cs-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cs-result {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .cs-fields {
      grid-template-columns: minmax(0, 1fr);
    }
    .cs-form {
      padding: var(--space-4);
    }
  }
</style>
