---
/**
 * La démonstration : un mur d'atelier qui passe de la récolte à la décision.
 *
 * La page décrivait le processus sans jamais le montrer. Or c'est exactement
 * le genre de chose qu'un paragraphe rend abstraite et qu'une image rend
 * évidente : on voit le désordre devenir un tri, le tri devenir des scénarios,
 * et les scénarios devenir une décision signée.
 *
 * Deux partis pris de fabrication :
 *
 *   1. AUCUN JAVASCRIPT. Les quatre temps sont quatre boutons radio, et c'est
 *      le CSS qui déplace les papiers (`:has()`). Ça marche sans script, au
 *      clavier nativement, et les flèches du clavier passent d'un temps à
 *      l'autre sans qu'on ait rien à coder.
 *   2. Les papiers ne sont pas redessinés d'un temps à l'autre : ce sont les
 *      MÊMES éléments qui se déplacent. C'est le mouvement qui raconte — voir
 *      le désordre se ranger sous des critères vaut tous les paragraphes.
 *
 * Le dernier temps porte le propos du site : la décision est cerclée à la
 * main, et la réserve du DAF reste écrite à côté. L'IA a instruit, le
 * collectif a tranché, le désaccord n'a pas été lissé.
 */

/* Chaque papier porte sa place dans le désordre (x, y, inclinaison) et, pour
   le tri, la colonne où il atterrit et son rang dans cette colonne. Les
   positions sont écrites à la main : un placement aléatoire produit des
   chevauchements et des trous, qui se lisent comme un bug, pas comme un mur. */
const papiers = [
  { t: 'Deux équipes font le même travail', x: 4, y: 8, r: -3, col: 0, rang: 0 },
  { t: 'Le client ne sait plus qui appeler', x: 36, y: 5, r: 2, col: 0, rang: 1 },
  { t: 'On perd 3 jours par dossier en allers-retours', x: 68, y: 9, r: -2, col: 0, rang: 2 },

  { t: 'Les délais sont tenus à 60 %', x: 6, y: 27, r: 4, col: 0, rang: 3 },
  { t: 'Les outils ne se parlent pas', x: 37, y: 24, r: -4, col: 0, rang: 4 },
  { t: 'Budget voté jusqu’en juin', x: 68, y: 28, r: 2, col: 2, rang: 0 },

  { t: 'Personne ne veut lâcher son périmètre', x: 3, y: 45, r: 3, col: 1, rang: 0 },
  { t: 'Turnover à 22 % sur le support', x: 35, y: 43, r: -2, col: 1, rang: 1 },
  { t: 'Trois managers partent à la retraite', x: 67, y: 46, r: -3, col: 2, rang: 1 },

  { t: 'Deux sites, deux cultures', x: 7, y: 63, r: 3, col: 1, rang: 2 },
  { t: 'On a déjà tenté en 2023', x: 38, y: 61, r: -3, col: 1, rang: 3 },
  { t: 'Le comité ne siège qu’une fois par mois', x: 68, y: 64, r: 3, col: 2, rang: 2 },

  { t: 'La DSI est déjà en surcharge', x: 21, y: 80, r: 2, col: 1, rang: 4 },
];

const colonnes = [
  { titre: 'Ce qui pousse', teinte: 'pousse' },
  { titre: 'Ce qui freine', teinte: 'freine' },
  { titre: 'Non négociable', teinte: 'dur' },
];

const scenarios = [
  {
    cle: 'A',
    titre: 'Fusionner les deux équipes',
    texte: 'Une seule équipe, un seul périmètre, au 1ᵉʳ septembre.',
    objection: 'Turnover déjà à 22 % : fusionner maintenant, c’est risquer d’en perdre davantage.',
  },
  {
    cle: 'B',
    titre: 'Un guichet unique, équipes inchangées',
    texte: 'Une entrée client unique dès juin, organisation interne conservée.',
    objection: 'Traite le symptôme côté client, pas le double emploi côté interne.',
  },
  {
    cle: 'C',
    titre: 'Rien avant juin, préparer la bascule',
    texte: 'On instruit, on décide en juillet avec le nouveau budget.',
    objection: 'Trois départs en retraite d’ici là : on décidera sans ceux qui savent.',
  },
];

const temps = [
  { id: 'recolte', libelle: '1 · La récolte', legende: 'Tout ce que le groupe a sur la table, sans ordre. Quarante minutes de post-it, comme d’habitude — l’IA ne sert à rien ici, et c’est très bien.' },
  { id: 'tri', libelle: '2 · Le tri', legende: 'Le groupe choisit ses trois critères. Le reclassement, qui prenait une heure de débat sur « où on met celui-là », se fait en deux minutes et reste discutable — on déplace ce qu’on veut.' },
  { id: 'scenarios', libelle: '3 · Les scénarios', legende: 'Trois scénarios instruits à partir de la matière triée, chacun avec l’objection la plus forte qu’on puisse lui opposer. Le groupe arbitre entre des options documentées, plus entre des intuitions.' },
  { id: 'decision', libelle: '4 · La décision', legende: 'Le collectif tranche, et la réserve du DAF reste écrite à côté de la décision. L’IA a instruit, elle n’a pas voté — et le désaccord n’a pas été lissé.' },
];
---

<figure class="demo">
  {/* Quatre boutons radio : c'est eux qui pilotent tout, sans une ligne de
      script. Les fleches du clavier passent d'un temps a l'autre nativement. */}
  <fieldset class="demo-temps">
    <legend class="sr-only">Choisir le temps de l’atelier à afficher</legend>
    {temps.map((t, i) => (
      <>
        <input class="sr-only" type="radio" name="demo-temps" id={`demo-${t.id}`} checked={i === 0} />
        <label for={`demo-${t.id}`}>{t.libelle}</label>
      </>
    ))}
  </fieldset>

  <div class="demo-mur">
    {/* Les en-tetes de colonnes du tri : caches au temps 1. */}
    <div class="demo-colonnes" aria-hidden="true">
      {colonnes.map((c) => (
        <span class={`demo-colonne demo-colonne-${c.teinte}`}>{c.titre}</span>
      ))}
    </div>

    {papiers.map((p) => (
      <span
        class="demo-papier"
        style={`--x:${p.x}%; --y:${p.y}%; --r:${p.r}deg; --tx:${4 + p.col * 32}%; --ty:${20 + p.rang * 14}%;`}
        data-col={p.col}
      >
        {p.t}
      </span>
    ))}

    <div class="demo-scenarios" aria-hidden="true">
      {scenarios.map((s) => (
        <article class="demo-scenario" data-cle={s.cle}>
          <p class="demo-scenario-cle">Scénario {s.cle}</p>
          <h4>{s.titre}</h4>
          <p class="demo-scenario-texte">{s.texte}</p>
          <p class="demo-scenario-objection"><strong>L’objection&nbsp;:</strong> {s.objection}</p>
        </article>
      ))}
    </div>

    {/* Le cercle trace a la main autour du scenario retenu, et le tampon de
        decision. Rien de tout ca n'est produit par la machine. */}
    <svg class="demo-cercle" viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M12 60 C 12 18, 60 8, 100 9 C 148 10, 190 22, 189 60 C 188 100, 142 112, 100 111 C 52 110, 11 100, 14 56" />
    </svg>

    <div class="demo-tampon" aria-hidden="true">
      <p class="demo-tampon-titre">Décidé</p>
      <p>Guichet unique au 1ᵉʳ juin. Porté par la direction des opérations. Point d’étape le 15 avril.</p>
      <p class="demo-tampon-reserve">
        <strong>Réserve conservée —</strong> le DAF&nbsp;: «&nbsp;ça ne règle pas le double emploi, à rouvrir en septembre.&nbsp;»
      </p>
    </div>
  </div>

  {/* Une legende par temps : seule celle du temps choisi s'affiche. */}
  <figcaption>
    {temps.map((t) => (
      <span class="demo-legende" data-pour={t.id}>{t.legende}</span>
    ))}
  </figcaption>
</figure>

<style>
  .demo {
    container-type: inline-size;
    margin: 0;
  }

  /* --- les quatre onglets --- */
  .demo-temps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding: 0;
    border: 0;
  }
  .demo-temps label {
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1.5px var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: box-shadow var(--duration-hover) ease, background var(--duration-hover) ease, color var(--duration-hover) ease;
  }
  .demo-temps input:checked + label {
    background: var(--color-navy);
    box-shadow: none;
    color: var(--color-cream);
  }
  .demo-temps input:focus-visible + label {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* --- le mur --- */
  .demo-mur {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 20% 15%, color-mix(in srgb, var(--color-orange) 10%, transparent) 0 30%, transparent 60%),
      var(--color-cream);
    box-shadow: inset 0 0 0 1px var(--color-border);
    overflow: hidden;
  }

  .demo-papier {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 27%;
    padding: 1.1cqw 1.3cqw;
    border-radius: 3px;
    background: var(--color-surface);
    box-shadow: 0 1px 2px rgba(18, 32, 51, 0.16), 0 6px 14px rgba(18, 32, 51, 0.09);
    color: var(--color-navy);
    font-family: var(--font-script);
    font-size: 2.3cqw;
    font-weight: 700;
    line-height: 1.2;
    rotate: var(--r);
    transition:
      left 0.75s var(--ease-out),
      top 0.75s var(--ease-out),
      rotate 0.75s var(--ease-out),
      opacity 0.4s ease,
      scale 0.5s var(--ease-out);
  }
  /* Un liseré de couleur à gauche selon la colonne d'arrivée : au temps 1 il
     ne veut rien dire, au temps 2 il confirme le tri d'un coup d'œil. */
  .demo-papier[data-col='0'] { box-shadow: inset 4px 0 0 var(--color-blue), 0 1px 2px rgba(18,32,51,.16), 0 6px 14px rgba(18,32,51,.09); }
  .demo-papier[data-col='1'] { box-shadow: inset 4px 0 0 var(--color-clay), 0 1px 2px rgba(18,32,51,.16), 0 6px 14px rgba(18,32,51,.09); }
  .demo-papier[data-col='2'] { box-shadow: inset 4px 0 0 var(--color-navy), 0 1px 2px rgba(18,32,51,.16), 0 6px 14px rgba(18,32,51,.09); }

  .demo-colonnes {
    position: absolute;
    inset: 4% 4% auto 4%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2%;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .demo-colonne {
    padding-bottom: 0.6cqw;
    border-bottom: 2px solid var(--color-border);
    font-size: 1.6cqw;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .demo-colonne-pousse { border-bottom-color: var(--color-blue); color: var(--color-blue); }
  .demo-colonne-freine { border-bottom-color: var(--color-clay); color: var(--color-clay-ink); }
  .demo-colonne-dur { border-bottom-color: var(--color-navy); color: var(--color-navy); }

  .demo-scenarios {
    position: absolute;
    inset: 8% 4% auto 4%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5%;
    opacity: 0;
    scale: 0.97;
    pointer-events: none;
    transition: opacity 0.45s ease, scale 0.45s var(--ease-out);
  }
  .demo-scenario {
    padding: 2cqw;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border), var(--shadow-sm);
  }
  .demo-scenario-cle {
    margin: 0 0 0.6cqw;
    color: var(--color-muted);
    font-size: 1.4cqw;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .demo-scenario h4 {
    margin: 0 0 0.8cqw;
    font-family: var(--font-display);
    font-size: 2.1cqw;
    font-weight: 800;
    line-height: 1.15;
  }
  .demo-scenario-texte {
    margin: 0 0 1cqw;
    color: var(--color-muted);
    font-size: 1.7cqw;
    line-height: 1.35;
  }
  .demo-scenario-objection {
    margin: 0;
    padding-top: 0.9cqw;
    border-top: 1px dashed var(--color-border);
    color: var(--color-muted);
    font-size: 1.6cqw;
    line-height: 1.35;
  }
  .demo-scenario-objection strong {
    color: var(--color-clay-ink);
  }

  /* Un cercle trace a la main doit ENTOURER la carte, pas la traverser : il
     lui faut donc etre plus grand qu'elle. Cale sur les bords de la carte du
     milieu, il coupait le texte en haut et en bas. */
  .demo-cercle {
    position: absolute;
    left: 32.5%;
    top: 4%;
    width: 35%;
    height: 60%;
    fill: none;
    stroke: var(--color-clay);
    stroke-width: 2.4;
    stroke-linecap: round;
    opacity: 0;
    transition: opacity 0.5s ease 0.25s;
  }

  .demo-tampon {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 5%;
    padding: 2cqw 2.4cqw;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-orange) 26%, var(--color-surface));
    color: var(--color-navy);
    opacity: 0;
    translate: 0 8%;
    transition: opacity 0.45s ease 0.15s, translate 0.45s var(--ease-out) 0.15s;
  }
  .demo-tampon-titre {
    margin: 0 0 0.5cqw;
    color: var(--color-clay-ink);
    font-family: var(--font-script);
    font-size: 2.6cqw;
    font-weight: 700;
    line-height: 1;
  }
  .demo-tampon p {
    margin: 0;
    font-size: 1.75cqw;
    line-height: 1.4;
  }
  .demo-tampon-reserve {
    margin-top: 0.9cqw !important;
    color: var(--color-muted);
    font-size: 1.55cqw !important;
  }

  /* --- les quatre états, pilotés par le bouton radio coché --------------- */

  /* 2 · le tri : les papiers rejoignent leur colonne, bien à plat. */
  .demo:has(#demo-tri:checked) .demo-papier,
  .demo:has(#demo-scenarios:checked) .demo-papier,
  .demo:has(#demo-decision:checked) .demo-papier {
    left: var(--tx);
    top: var(--ty);
    rotate: 0deg;
  }
  .demo:has(#demo-tri:checked) .demo-colonnes {
    opacity: 1;
  }

  /* 3 · les scénarios : la matière triée s'efface derrière eux. */
  .demo:has(#demo-scenarios:checked) .demo-papier,
  .demo:has(#demo-decision:checked) .demo-papier {
    opacity: 0.12;
    scale: 0.9;
  }
  .demo:has(#demo-scenarios:checked) .demo-scenarios,
  .demo:has(#demo-decision:checked) .demo-scenarios {
    opacity: 1;
    scale: 1;
  }

  /* 4 · la décision : le cercle à la main, et le relevé. */
  .demo:has(#demo-decision:checked) .demo-cercle,
  .demo:has(#demo-decision:checked) .demo-tampon {
    opacity: 1;
    translate: 0 0;
  }
  .demo:has(#demo-decision:checked) .demo-scenario:not([data-cle='B']) {
    opacity: 0.45;
  }

  /* --- la légende --- */
  figcaption {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .demo-legende {
    display: none;
  }
  .demo:has(#demo-recolte:checked) [data-pour='recolte'],
  .demo:has(#demo-tri:checked) [data-pour='tri'],
  .demo:has(#demo-scenarios:checked) [data-pour='scenarios'],
  .demo:has(#demo-decision:checked) [data-pour='decision'] {
    display: block;
    max-width: 62ch;
  }

  /* Sur téléphone, un mur de treize papiers n'est plus lisible : on passe en
     format portrait, avec moins de texte par papier et des cartes empilées. */
  @container (max-width: 640px) {
    .demo-mur {
      aspect-ratio: 3 / 4;
    }
    .demo-papier {
      width: 44%;
      font-size: 3.6cqw;
    }
    .demo-papier[data-col] {
      --tx: 4%;
    }
    .demo-scenarios {
      grid-template-columns: minmax(0, 1fr);
      inset: 6% 5% auto 5%;
      gap: 2%;
    }
    .demo-scenario h4 { font-size: 4cqw; }
    .demo-scenario-cle { font-size: 2.6cqw; }
    .demo-scenario-texte,
    .demo-scenario-objection { font-size: 3cqw; }
    .demo-cercle { left: 4%; width: 92%; top: 5%; height: 27%; }
    .demo-tampon p { font-size: 3.1cqw; }
    .demo-tampon-titre { font-size: 4.6cqw; }
    .demo-tampon-reserve { font-size: 2.8cqw !important; }
    .demo-colonne { font-size: 2.6cqw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-papier,
    .demo-colonnes,
    .demo-scenarios,
    .demo-cercle,
    .demo-tampon {
      transition: none;
    }
  }
</style>
