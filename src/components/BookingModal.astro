---
import { SITE } from '../data/site';

interface Props {
  label: string;
  class?: string;
}

const { label, class: className = 'btn' } = Astro.props;
const embedUrl = `${SITE.bookingUrl}?embed=true`;
---

<a class={className} href={SITE.bookingUrl} target="_blank" rel="noopener" data-booking-trigger>{label}</a>

<div class="booking-modal" data-booking-modal hidden>
  <div class="booking-modal-backdrop" data-booking-modal-close></div>
  <div class="booking-modal-panel" role="dialog" aria-modal="true" aria-label="Réserver un premier échange">
    <button type="button" class="booking-modal-close" data-booking-modal-close aria-label="Fermer">✕</button>
    <iframe data-booking-iframe title="Prendre rendez-vous" loading="lazy"></iframe>
  </div>
</div>

<script define:vars={{ embedUrl }}>
  const triggers = Array.from(document.querySelectorAll('[data-booking-trigger]'));
  const modal = document.querySelector('[data-booking-modal]');
  if (triggers.length && modal) {
    // Sort de la section d'origine : si un ancêtre data-reveal est encore
    // dans son état "transform au repos" (voir Layout.astro), il crée un
    // nouveau containing block pour position:fixed, et la modale se
    // positionne alors par rapport à cet ancêtre scrollé au lieu du
    // viewport. Même correctif que CaseStudyModal/PhaseModal.
    document.body.appendChild(modal);
    const iframe = modal.querySelector('[data-booking-iframe]');
    let lastFocused = null;

    function closeModal() {
      modal.removeAttribute('data-open');
      // Le panneau et le fond transitionnent séparément (pas la modale
      // elle-même) : un transitionend écouté sur `modal` ne matcherait
      // jamais e.target après remontée par bubbling. Un délai fixe aligné
      // sur la plus longue transition (220ms) est plus simple et fiable.
      setTimeout(() => { modal.hidden = true; }, 220);
      document.body.classList.remove('booking-modal-lock-scroll');
      lastFocused?.focus();
    }

    function openModal(trigger) {
      lastFocused = trigger;
      if (!iframe.getAttribute('src')) iframe.src = embedUrl;
      modal.hidden = false;
      void modal.offsetHeight;
      modal.setAttribute('data-open', '');
      document.body.classList.add('booking-modal-lock-scroll');
      modal.querySelector('[data-booking-modal-close]')?.focus();
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(trigger);
      });
    });

    modal.querySelectorAll('[data-booking-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.hasAttribute('data-open')) closeModal();
    });
  }
</script>

<style is:global>
  body.booking-modal-lock-scroll {
    overflow: hidden;
  }
</style>

<style>
  /* Voir la même règle dans CaseStudyModal.astro : sans elle,
     display: flex l'emporte sur [hidden] { display: none } et le panneau
     reste mis en page/peint en continu même invisible. */
  .booking-modal[hidden] {
    display: none;
  }
  .booking-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .booking-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 22, 39, 0.6);
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .booking-modal[data-open] .booking-modal-backdrop {
    opacity: 1;
  }
  .booking-modal-panel {
    position: relative;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 480px;
    height: min(720px, 85vh);
    transform: scale(0.95);
    opacity: 0;
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms ease-out;
    overflow: hidden;
  }
  .booking-modal[data-open] .booking-modal-panel {
    transform: scale(1);
    opacity: 1;
  }
  .booking-modal-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 1;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: var(--text-sm);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-sm);
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .booking-modal-close:hover {
      background: var(--color-cream);
    }
  }
  .booking-modal-close:active {
    transform: scale(0.94);
  }
  .booking-modal-panel iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
