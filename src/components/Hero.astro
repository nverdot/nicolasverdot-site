---
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';
import heroBg from '../assets/hero-mountain.jpg';
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <Image src={heroBg} alt="" class="hero-bg" widths={[640, 1200, 1920]} sizes="100vw" aria-hidden="true" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">
        Mettre vos équipes
        <span class="script-accent">en mouvement</span>
        <span class="hero-tail">autour des projets qui comptent vraiment.</span>
      </h1>

      <p class="hero-lead">
        J'accompagne les leaders, les managers et les équipes à <strong>voir clair</strong>, <strong>prendre les bonnes décisions</strong> et <strong>passer réellement à l'action</strong>.
      </p>

      <div class="hero-actions">
        <a href={withBase('/#accompagnements')} class="btn">Voir les accompagnements →</a>
        <a href={withBase('/contact/')} class="btn-outline">Échangeons ensemble</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 33%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    max-width: 600px;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-10);
    }
    .hero :global(.hero-bg) {
      object-position: 75% 33%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding-top: var(--space-10);
    }
    .hero :global(.hero-bg) {
      position: static;
      width: 100%;
      height: 220px;
      order: 2;
      margin-top: var(--space-8);
      border-radius: var(--radius-md);
    }
    .hero-scrim {
      display: none;
    }
    .hero-inner {
      order: 1;
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
