---
import { getImage } from 'astro:assets';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import action from '../assets/nicolas-action.jpeg';

const photo = await getImage({ src: action, width: 1100, format: 'webp' });
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <div class="hero-inner">
    <div class="hero-copy">
      {/* Octobre 2026 : une seule promesse pour les deux offres. Qu'il
          s'agisse d'un séminaire ou de l'IA, le dirigeant achète la même
          chose : une décision prise à plusieurs, puis portée par ceux qui
          doivent la faire vivre. Les deux boutons sont les deux portes. */}
      <p class="hero-kicker">Séminaires de direction · Kick-off · Stratégie IA — Nice · Sophia Antipolis · Monaco · PACA</p>

      <h1 id="hero-title">
        Une direction qui tranche.
        <span class="script-accent">Des équipes qui s'en emparent.</span>
        <span class="hero-tail">Sur un projet, une stratégie ou l'IA.</span>
      </h1>

      <p class="hero-lead">
        J'aide les dirigeants et leurs comités de direction à <strong>décider ce qui compte</strong>, puis à
        <strong>embarquer les équipes</strong> qui devront le faire vivre. Le temps d'un
        <strong>séminaire</strong> ou <strong>dans la durée</strong>&nbsp;: lancement de projet, feuille de
        route, transformation, coaching d'équipe, place de l'IA dans l'entreprise. Ma méthode&nbsp;: la
        <strong>facilitation visuelle</strong>, qui rend les échanges et les décisions lisibles par tous.
      </p>

      <div class="hero-actions">
        <a href={withBase('/seminaires-entreprise/')} class="btn">Préparer un séminaire →</a>
        <a href={withBase('/offres/')} class="btn-outline">Voir les accompagnements</a>
      </div>
    </div>

    {/* Une vraie photo, à côté du texte : la facilitation visuelle est ce qui
        distingue ces séminaires, autant la montrer telle qu'elle est. */}
    <figure class="hero-figure">
      <img src={photo.src} alt="Nicolas Verdot, feutre en main, dessine une fresque en direct pendant un atelier." width={photo.attributes.width} height={photo.attributes.height} loading="eager" decoding="async" />
      <figcaption>Ce qui se dit et se décide est dessiné en direct, sous les yeux de tous.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    flex: 1 1 0;
    min-width: 0;
    max-width: 680px;
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero {
      padding: var(--space-8) 0;
    }
    .hero-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
    .hero-copy {
      max-width: none;
    }
  }
</style>
