---
import { getImage } from 'astro:assets';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import heroBg from '../assets/hero-mountain.jpg';
import heroBgMobile from '../assets/hero-mountain-mobile.png';

const desktopSrcset = (
  await Promise.all(
    [640, 1200, 1920].map(async (w) => {
      const img = await getImage({ src: heroBg, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileSrcset = (
  await Promise.all(
    [480, 750, 940].map(async (w) => {
      const img = await getImage({ src: heroBgMobile, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileFallback = await getImage({ src: heroBgMobile, width: 750, format: 'webp' });
---

{/* La photo porte la classe `hero-photo`, et surtout PAS `hero-bg` :
    `.hero-bg` est deja pris dans global.css par le <section> d'en-tete des
    pages d'offre, avec un `padding: 96px 0 64px`. Sur une <img>, ce padding
    retrecit la boite de contenu — a laquelle `object-fit` s'applique — et
    l'illustration se retrouvait encadree de creme en haut et en bas alors que
    sa boite, elle, faisait bien toute la hauteur. */}
<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <picture>
    <source media="(max-width: 640px)" srcset={mobileSrcset} sizes="100vw" />
    <img class="hero-photo" src={mobileFallback.src} srcset={desktopSrcset} sizes="100vw" alt="" aria-hidden="true" />
  </picture>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      {/* Octobre 2026 : une seule promesse pour les deux offres. Qu'il
          s'agisse d'un séminaire ou de l'IA, le dirigeant achète la même
          chose : une décision prise à plusieurs, puis portée par ceux qui
          doivent la faire vivre. Les deux boutons sont les deux portes. */}
      <p class="hero-kicker">Séminaires de direction · Kick-off · Stratégie IA — Nice · Sophia Antipolis · Monaco</p>

      <h1 id="hero-title">
        Une direction qui tranche.
        <span class="script-accent">Des équipes qui s'en emparent.</span>
        <span class="hero-tail">Sur un projet, une stratégie ou l'IA.</span>
      </h1>

      <p class="hero-lead">
        J'aide les dirigeants et leurs comités de direction à <strong>décider ce qui compte</strong>, puis à
        <strong>embarquer les équipes</strong> qui devront le faire vivre. Deux façons de commencer&nbsp;: un
        <strong>séminaire</strong> conçu et animé pour qu'il en sorte des décisions, ou un accompagnement pour
        savoir <strong>où l'IA a vraiment sa place</strong> chez vous.
      </p>

      <div class="hero-actions">
        <a href={withBase('/seminaires-entreprise/')} class="btn">Préparer un séminaire →</a>
        <a href={withBase('/accompagnement-ia-pme/')} class="btn-outline">Décider où mettre l'IA</a>
      </div>

      {/* Le diagnostic reste accessible depuis le hero, en second rideau : le
          clic l'ouvre toujours sur place (voir CoutInaction, prop « modal »). */}
      <p class="hero-tool-note">
        Une décision qui n'arrive pas&nbsp;?
        <a href={withBase('/outils/cout-de-linaction/')}>Pourquoi ça ne se décide pas chez vous</a>&nbsp;:
        douze questions, deux minutes, et vous repartez avec <strong>la cause</strong> du blocage.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 33%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    max-width: 640px;
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* La ligne sous le bouton : elle dit le prix à payer (douze questions) et ce
     qu'on obtient. Un bouton seul laisse craindre un formulaire ; cette phrase
     lève la crainte sans devenir un deuxième appel à l'action. */
  .hero-tool-note {
    max-width: 44ch;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-8);
    }
    .hero :global(.hero-photo) {
      object-position: 75% 33%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      /* Le hero porte désormais une accroche, un titre en trois temps, deux
         boutons et l'entrée de l'outil : la hauteur suit le contenu au lieu
         d'être imposée, sinon le dernier bloc tombe sous la ligne de flottaison
         du dégradé et se lit sur la photo. */
      min-height: 0;
      align-items: flex-start;
      padding-top: var(--space-8);
    }
    .hero :global(.hero-photo) {
      object-position: 45% 15%;
    }
    /* Deux boutons et la note du diagnostic : le texte descend plus bas
       qu'avant, le voile creme le suit pour qu'il ne se lise pas sur la photo. */
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 80%,
        color-mix(in srgb, var(--color-cream) 80%, transparent) 90%,
        color-mix(in srgb, var(--color-cream) 45%, transparent) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
