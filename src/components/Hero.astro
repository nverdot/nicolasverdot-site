---
import { getImage } from 'astro:assets';
import { withBase } from '../utils/url';
import { SITE } from '../data/site';
import action from '../assets/nicolas-action.jpeg';

const photo = await getImage({ src: action, width: 1100, format: 'webp' });

/*
 * Les tuiles de l'accueil, sur téléphone seulement. Une application s'ouvre
 * sur ce qu'on peut y faire, pas sur un texte : comprendre une offre, voir ce
 * que ça donne, simuler, lire. Ce sont de vrais liens vers de vraies pages —
 * les mêmes que dans le menu, rangées par intention.
 */
const tuiles = [
  { href: '/seminaires-entreprise/', titre: 'Séminaires', note: 'Conçus et animés pour vous', trace: 'M9 10.2a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4zM3.4 19c.4-3 2.6-4.9 5.6-4.9s5.2 1.9 5.6 4.9M16.4 10.4a2.3 2.3 0 1 0 0-4.6M17 14.3c2 .5 3.3 2.1 3.6 4.7' },
  { href: '/accompagnement-ia-pme/', titre: 'Stratégie IA', note: 'Par où commencer', trace: 'M11 4.5l1.7 4.8 4.8 1.7-4.8 1.7L11 17.5l-1.7-4.8L4.5 11l4.8-1.7zM18 15.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z' },
  { href: '/offres/', titre: 'Les offres', note: 'Six façons de travailler ensemble', trace: 'M4.5 5h6v6h-6zM13.5 5h6v6h-6zM4.5 14h6v6h-6zM13.5 14h6v6h-6z' },
  { href: '/cas-clients/', titre: 'Cas clients', note: 'Ce que ça donne sur le terrain', trace: 'M4 8h16v11H4zM9 8V6.2a1.2 1.2 0 0 1 1.2-1.2h3.6A1.2 1.2 0 0 1 15 6.2V8M4 12.5h16' },
  { href: '/outils/cout-de-linaction/', titre: 'Simulateur', note: 'Ce que coûte l’inaction', trace: 'M6 3.5h12v17H6zM9 7.5h6M9 11.5h.01M12 11.5h.01M15 11.5h.01M9 15.5h.01M12 15.5h.01M15 15.5h.01' },
  { href: '/blog/', titre: 'Comprendre', note: 'Articles et méthodes', trace: 'M12 6.5c-2-1.3-4.6-1.6-7.5-1v12c2.9-.6 5.5-.3 7.5 1 2-1.3 4.6-1.6 7.5-1v-12c-2.9-.6-5.5-.3-7.5 1zM12 6.5v12' },
];
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <div class="hero-inner">
    <div class="hero-copy">
      {/* Octobre 2026 : une seule promesse pour les deux offres. Qu'il
          s'agisse d'un séminaire ou de l'IA, le dirigeant achète la même
          chose : une décision prise à plusieurs, puis portée par ceux qui
          doivent la faire vivre. Les deux boutons sont les deux portes. */}
      {/* Quoi et qui, en une ligne : les mots que l'on cherche (séminaire,
          IA), puis le nom. Sur téléphone, les villes s'effacent. */}
      <p class="hero-kicker">Séminaires de direction · Stratégie IA · Nicolas Verdot, facilitateur<span class="hero-kicker-lieux"> — Nice · Sophia Antipolis · Monaco · PACA</span></p>

      {/* Le titre dit ce que le dirigeant veut, avec ses mots : « il n'en est
          rien resté » est ce qu'il raconte du séminaire précédent. La phrase
          suivante décrit ce qu'il vit, la troisième ce que je fais. */}
      <h1 id="hero-title">
        Un séminaire dont il reste quelque chose
        <span class="script-accent">le lundi matin.</span>
      </h1>

      <p class="hero-lead">
        On se réunit, on discute, on tombe d'accord. Puis chacun retourne à ses urgences.
        <span class="hero-lead-moi">Je conçois et j'anime vos séminaires pour que vous en repartiez avec des
        <strong>décisions prises</strong>, des <strong>responsables nommés</strong> et une
        <strong>suite déjà calée</strong>.</span>
        {/* Sur téléphone, on s'arrête là : la suite est dans les rubriques. */}
        <span class="hero-lead-suite">Même exigence quand le sujet est l'IA&nbsp;: décider par où commencer, avec
        ceux qui devront s'en servir. Ma méthode&nbsp;: la <strong>facilitation visuelle</strong>, qui rend
        les échanges et les décisions lisibles par tous.</span>
      </p>

      <div class="hero-actions">
        <a href={SITE.bookingUrl} class="btn" target="_blank" rel="noopener">Réserver 30 minutes</a>
        <a href={withBase('/seminaires-entreprise/')} class="btn-outline">Découvrir les séminaires</a>
      </div>

      <p class="hero-etiquette hero-etiquette--tuiles">Par où commencer</p>
      <nav class="tuiles" aria-label="Par où commencer">
        {tuiles.map((t) => (
          <a class="tuile" href={withBase(t.href)}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={t.trace} />
            </svg>
            <strong>{t.titre}</strong>
            <span>{t.note}</span>
          </a>
        ))}
      </nav>
    </div>

    {/* Une vraie photo, à côté du texte : la facilitation visuelle est ce qui
        distingue ces séminaires, autant la montrer telle qu'elle est. */}
    <figure class="hero-figure">
      <img src={photo.src} alt="Nicolas Verdot, feutre en main, dessine une fresque en direct pendant un atelier." width={photo.attributes.width} height={photo.attributes.height} loading="eager" decoding="async" />
      <figcaption>Ce qui se dit et se décide est dessiné en direct, sous les yeux de tous.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    flex: 1 1 0;
    min-width: 0;
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }
  /* « Ce que je fais » passe à la ligne : d'abord ce que vit le dirigeant,
     puis la réponse. */
  .hero-lead-moi {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-ink);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Les tuiles et la ligne « ce que vous y gagnez » n'existent que sur
     téléphone : sur ordinateur, le paragraphe complet le dit déjà. */
  .tuiles,
  .hero-etiquette {
    display: none;
  }

  /* --- téléphone : l'écran d'accueil d'une application ---
     Le titre, une phrase, puis six tuiles à toucher. Les deux boutons
     s'effacent : les tuiles mènent aux mêmes pages, et à quatre autres. */
  @media (max-width: 719px) {
    .hero {
      padding: var(--space-6) 0;
    }
    .hero-inner {
      gap: var(--space-4);
      padding-inline: var(--space-4);
    }
    /* Un seul bouton sur téléphone : le rendez-vous. La découverte passe
       par les tuiles, juste en dessous. */
    .hero-kicker-lieux,
    .hero-lead-suite,
    .hero-actions .btn-outline {
      display: none;
    }
    .hero-actions {
      margin-bottom: var(--space-6);
    }
    .hero-kicker {
      margin-bottom: var(--space-3);
      letter-spacing: 0.12em;
    }
    /* Le bloc d'ouverture est court — une ligne, un titre, une phrase — et se
       lit centré, comme l'écran d'accueil d'une application. Les listes et les
       tuiles, elles, restent alignées à gauche : on les parcourt de l'œil. */
    .hero-kicker,
    .hero-copy h1,
    .hero-lead {
      text-align: center;
      text-wrap: balance;
    }
    .hero-etiquette {
      display: block;
      margin: 0 0 var(--space-2);
      color: var(--color-muted);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .tuiles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
    .tuile {
      display: grid;
      align-content: start;
      gap: 2px;
      min-height: 6.5rem;
      padding: var(--space-3);
      border-radius: 18px;
      background: var(--color-surface);
      box-shadow: inset 0 0 0 1.5px var(--color-border);
      color: var(--color-navy);
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }
    .tuile:active {
      transform: scale(0.98);
    }
    .tuile svg {
      box-sizing: content-box;
      margin-bottom: var(--space-2);
      padding: 7px;
      border-radius: 12px;
      background: var(--color-orange);
      color: var(--color-ink-solid);
    }
    .tuile strong {
      font-family: var(--font-display);
      font-size: var(--text-base);
      line-height: 1.2;
    }
    .tuile span {
      color: var(--color-muted);
      font-size: var(--text-sm);
      line-height: 1.3;
    }
    /* Les deux premières tuiles sont les deux offres d'entrée. */
    .tuile:nth-child(-n + 2) {
      background: var(--color-ink-solid);
      box-shadow: none;
      color: var(--color-white);
    }
    .tuile:nth-child(-n + 2) span {
      color: #c6d0df;
    }
    .hero-figure img {
      width: 100%;
      height: 10rem;
      border-radius: 18px;
      object-fit: cover;
    }
    .hero-figure figcaption {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding: var(--space-8) 0;
    }
    .hero-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
    .hero-copy {
      max-width: none;
    }
  }
</style>
