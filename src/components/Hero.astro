---
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';
import heroBg from '../assets/hero-mountain.jpg';
import iconVoirClair from '../assets/icon-voir-clair.png';
import iconPrendreDecisions from '../assets/icon-prendre-decisions.png';
import iconPasserAction from '../assets/icon-passer-action.png';

const steps = [
  { icon: iconVoirClair, label: 'Voir clair' },
  { icon: iconPrendreDecisions, label: 'Prendre les bonnes décisions' },
  { icon: iconPasserAction, label: "Passer réellement à l'action" },
];
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <Image src={heroBg} alt="" class="hero-bg" widths={[640, 1200, 1920]} sizes="100vw" aria-hidden="true" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">
        Mettre vos équipes
        <span class="script-accent">en mouvement</span>
        <span class="hero-tail">autour des projets qui comptent vraiment.</span>
      </h1>

      <div class="hero-steps">
        {steps.map((s, i) => (
          <>
            {i > 0 && <span class="step-dash" aria-hidden="true"></span>}
            <div class="hero-step">
              <span class="hero-step-icon"><Image src={s.icon} alt="" width={96} height={96} /></span>
              <span class="hero-step-label">{s.label}</span>
            </div>
          </>
        ))}
      </div>

      <p class="hero-lead">
        J'accompagne les leaders, les managers et les équipes à <strong>voir clair</strong>, <strong>prendre les bonnes décisions</strong> et <strong>passer réellement à l'action</strong>.
      </p>

      <div class="hero-actions">
        <a href={withBase('/#accompagnements')} class="btn">Voir les accompagnements →</a>
        <a href={withBase('/contact/')} class="btn-outline">Échangeons ensemble</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 33%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    max-width: 600px;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-steps {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  .hero-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    width: 110px;
  }
  .hero-step-icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding: 10px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    flex-shrink: 0;
  }
  .hero-step-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .hero-step-label {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-navy);
    line-height: 1.25;
  }
  .step-dash {
    width: 20px;
    height: 0;
    margin-top: 38px;
    border-top: 2px dashed rgba(18, 32, 51, 0.3);
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-10);
    }
    .hero :global(.hero-bg) {
      object-position: 75% 33%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding-top: var(--space-10);
    }
    .hero :global(.hero-bg) {
      position: static;
      width: 100%;
      height: 220px;
      order: 2;
      margin-top: var(--space-8);
      border-radius: var(--radius-md);
    }
    .hero-scrim {
      display: none;
    }
    .hero-inner {
      order: 1;
    }
    .hero-steps {
      gap: var(--space-2);
    }
    .step-dash {
      display: none;
    }
    .hero-step {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
