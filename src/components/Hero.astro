---
import { getImage } from 'astro:assets';
import { withBase } from '../utils/url';
import heroBg from '../assets/hero-mountain.jpg';
import heroBgMobile from '../assets/hero-mountain-mobile.png';

const desktopSrcset = (
  await Promise.all(
    [640, 1200, 1920].map(async (w) => {
      const img = await getImage({ src: heroBg, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileSrcset = (
  await Promise.all(
    [480, 750, 940].map(async (w) => {
      const img = await getImage({ src: heroBgMobile, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileFallback = await getImage({ src: heroBgMobile, width: 750, format: 'webp' });
---

{/* La photo porte la classe `hero-photo`, et surtout PAS `hero-bg` :
    `.hero-bg` est deja pris dans global.css par le <section> d'en-tete des
    pages d'offre, avec un `padding: 96px 0 64px`. Sur une <img>, ce padding
    retrecit la boite de contenu — a laquelle `object-fit` s'applique — et
    l'illustration se retrouvait encadree de creme en haut et en bas alors que
    sa boite, elle, faisait bien toute la hauteur. */}
<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <picture>
    <source media="(max-width: 640px)" srcset={mobileSrcset} sizes="100vw" />
    <img class="hero-photo" src={mobileFallback.src} srcset={desktopSrcset} sizes="100vw" alt="" aria-hidden="true" />
  </picture>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      {/* Les trois verbes que vend ce site, posés avant le titre : converger,
          décider, agir. C'est la promesse en trois mots, et elle revient
          ensuite dans le lead et dans l'outil de diagnostic. */}
      <p class="hero-kicker">Converger · Décider · Agir</p>

      <h1 id="hero-title">
        Produire va désormais très vite.
        <span class="script-accent">Décider ensemble,</span>
        <span class="hero-tail">c'est là que tout ralentit.</span>
      </h1>

      {/*
        Le lead ne dit pas « vos réunions coûtent cher ». Ce serait vrai, et
        sans effet : les entreprises le savent depuis vingt ans et ne le règlent
        pas. Elles ne le règlent pas parce que reporter est confortable et que
        trancher fait des perdants — c'est cette raison-là qu'il faut nommer ici,
        parce que c'est elle qui fait appeler quelqu'un de l'extérieur.
      */}
      <p class="hero-lead">
        L'IA a fait fondre le temps d'exécution. Le temps de décision, lui, n'a pas bougé — et si ça dure,
        ce n'est pas faute d'outils&nbsp;: trancher oblige à nommer ce que le collectif préfère éviter.
        Mon travail est là&nbsp;: faire <strong>converger</strong>, faire <strong>décider</strong>,
        faire <strong>agir</strong>.
      </p>

      {/*
        Une seule action, et ce n'est pas le catalogue.
        « Voir les accompagnements » demandait au visiteur de s'intéresser à ce
        que je vends avant d'avoir reconnu son problème — et le menu y mène
        déjà. Le hero ouvre donc sur le diagnostic : on repart avec quelque
        chose sur SA situation, pas avec une liste de prestations.

        Le chiffre n'est pas la promesse affichée : il est la raison de
        répondre aux douze questions. Ce qu'on vient chercher, c'est pourquoi ça
        ne bouge pas.
      */}
      <div class="hero-actions">
        <a href={withBase('/outils/cout-de-linaction/')} class="btn">
          Pourquoi ça ne se décide pas chez vous&nbsp;? →
        </a>
      </div>
      <p class="hero-tool-note">
        Douze questions, deux minutes. Vous repartez avec <strong>la cause</strong> du blocage — celle qui
        ressort de vos réponses, pas celle que vous auriez déclarée — et avec ce qu'elle vous coûte chaque mois.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 33%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    max-width: 640px;
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* La ligne sous le bouton : elle dit le prix à payer (douze questions) et ce
     qu'on obtient. Un bouton seul laisse craindre un formulaire ; cette phrase
     lève la crainte sans devenir un deuxième appel à l'action. */
  .hero-tool-note {
    max-width: 44ch;
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-8);
    }
    .hero :global(.hero-photo) {
      object-position: 75% 33%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      /* Le hero porte désormais une accroche, un titre en trois temps, deux
         boutons et l'entrée de l'outil : la hauteur suit le contenu au lieu
         d'être imposée, sinon le dernier bloc tombe sous la ligne de flottaison
         du dégradé et se lit sur la photo. */
      min-height: 0;
      align-items: flex-start;
      padding-top: var(--space-8);
    }
    .hero :global(.hero-photo) {
      object-position: 45% 15%;
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
