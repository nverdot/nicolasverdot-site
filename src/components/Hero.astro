---
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';
import heroBg from '../assets/hero-mountain.jpg';

// Convention icônes du site : traits feutre currentColor, viewBox 24×24.
const steps = [
  { icon: '<circle cx="10" cy="10" r="6"/><path d="M15 15l6 6"/>', label: 'Voir clair' },
  { icon: '<path d="M12 3v18"/><path d="M12 7h7l-2 2.5 2 2.5h-7"/>', label: 'Prendre les bonnes décisions' },
  { icon: '<path d="M3 20l6-10 4 6 3-4 5 8z"/><path d="M14 6v6M14 6l3 1.5-3 1.5"/>', label: "Passer réellement à l'action" },
];
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <Image src={heroBg} alt="" class="hero-bg" widths={[640, 1200, 1920]} sizes="100vw" aria-hidden="true" />
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">
        Mettre vos équipes
        <span class="script-accent">en mouvement</span>
        <span class="hero-tail">autour des projets qui comptent vraiment.</span>
      </h1>

      <div class="hero-steps">
        {steps.map((s, i) => (
          <>
            {i > 0 && <span class="step-dash" aria-hidden="true"></span>}
            <div class="hero-step">
              <span class="hero-step-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} /></span>
              <span>{s.label}</span>
            </div>
          </>
        ))}
      </div>

      <div class="hero-actions">
        <a href={withBase('/#accompagnements')} class="btn">Voir les accompagnements →</a>
        <a href={withBase('/contact/')} class="btn-outline">Échangeons ensemble</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 15%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
  }
  .hero-copy {
    max-width: 560px;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(2.6rem, 5vw, 4rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }

  .hero-steps {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .hero-step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hero-step-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    color: var(--color-orange-ink);
    flex-shrink: 0;
  }
  .hero-step-icon svg {
    width: 17px;
    height: 17px;
  }
  .hero-step span:last-child {
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-navy);
  }
  .step-dash {
    width: 20px;
    height: 0;
    border-top: 2px dashed rgba(18, 32, 51, 0.3);
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-10);
    }
    .hero :global(.hero-bg) {
      object-position: 75% 15%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding-top: var(--space-10);
    }
    .hero :global(.hero-bg) {
      position: static;
      width: 100%;
      height: 220px;
      order: 2;
      margin-top: var(--space-8);
      border-radius: var(--radius-md);
    }
    .hero-scrim {
      display: none;
    }
    .hero-inner {
      order: 1;
    }
    .hero-steps {
      gap: var(--space-2);
    }
    .step-dash {
      display: none;
    }
    .hero-step {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
