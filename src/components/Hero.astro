---
import { getImage } from 'astro:assets';
import { withBase } from '../utils/url';
import heroBg from '../assets/hero-mountain.jpg';
import heroBgMobile from '../assets/hero-mountain-mobile.png';

const desktopSrcset = (
  await Promise.all(
    [640, 1200, 1920].map(async (w) => {
      const img = await getImage({ src: heroBg, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileSrcset = (
  await Promise.all(
    [480, 750, 940].map(async (w) => {
      const img = await getImage({ src: heroBgMobile, width: w, format: 'webp' });
      return `${img.src} ${w}w`;
    })
  )
).join(', ');
const mobileFallback = await getImage({ src: heroBgMobile, width: 750, format: 'webp' });
---

<section class="hero" aria-labelledby="hero-title" data-section-name="Hero">
  <picture>
    <source media="(max-width: 640px)" srcset={mobileSrcset} sizes="100vw" />
    <img class="hero-bg" src={mobileFallback.src} srcset={desktopSrcset} sizes="100vw" alt="" aria-hidden="true" />
  </picture>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-copy">
      {/* Les trois verbes que vend ce site, posés avant le titre : converger,
          décider, agir. C'est la promesse en trois mots, et elle revient
          ensuite dans le lead et dans l'outil de diagnostic. */}
      <p class="hero-kicker">Converger · Décider · Agir</p>

      <h1 id="hero-title">
        Produire va désormais très vite.
        <span class="script-accent">Décider ensemble,</span>
        <span class="hero-tail">c'est là que tout ralentit.</span>
      </h1>

      <p class="hero-lead">
        L'IA a fait fondre le temps d'exécution. Le temps de décision, lui, n'a pas bougé&nbsp;: il se compte
        toujours en réunions, en arbitrages reportés et en sujets qui reviennent. J'accompagne vos collectifs
        à <strong>converger</strong>, <strong>décider</strong> et <strong>passer à l'acte</strong> — en semaines, pas en trimestres.
      </p>

      <div class="hero-actions">
        <a href={withBase('/offres/')} class="btn">Voir les accompagnements →</a>
        <a href={withBase('/contact/')} class="btn-outline">Échangeons ensemble</a>
      </div>

      {/* L'entrée de l'outil : une porte discrète, pas un troisième bouton.
          Le chiffre est le meilleur argument de cette page — mais c'est le
          visiteur qui doit le calculer, pas moi qui le promets. */}
      <p class="hero-tool">
        <a href={withBase('/outils/cout-de-linaction/')}>
          <span class="hero-tool-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7.4V12l3.2 1.9" />
            </svg>
          </span>
          <span>
            <strong>Combien vous coûte une décision reportée&nbsp;?</strong>
            <small>Le calcul en une minute, chiffré sur votre situation.</small>
          </span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: flex;
    align-items: center;
    padding: var(--space-16) 0;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 33%;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      var(--color-cream) 0%,
      color-mix(in srgb, var(--color-cream) 88%, transparent) 32%,
      color-mix(in srgb, var(--color-cream) 35%, transparent) 52%,
      transparent 68%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .hero-copy {
    max-width: 640px;
  }
  .hero-kicker {
    margin: 0 0 var(--space-4);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .hero-copy h1 {
    margin: 0 0 var(--space-6);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.2;
    color: var(--color-navy);
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .hero-lead {
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-6);
  }
  .hero-lead strong {
    color: var(--color-navy);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* L'entrée de l'outil : une carte très basse en intensité, posée sous les
     boutons. Elle ne doit jamais se lire comme la troisième action — elle
     attrape celui qui n'est pas prêt à cliquer sur les deux premières. */
  .hero-tool {
    margin: var(--space-6) 0 0;
  }
  .hero-tool a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 30rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-navy);
    text-decoration: none;
    transition: box-shadow var(--duration-hover) ease, background var(--duration-hover) ease;
  }
  .hero-tool strong {
    display: block;
    font-size: var(--text-base);
    line-height: 1.3;
  }
  .hero-tool small {
    display: block;
    margin-top: 0.1rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.35;
  }
  .hero-tool-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy);
  }
  .hero-tool-icon svg {
    width: 21px;
    height: 21px;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-tool a:hover {
      background: var(--color-surface);
      box-shadow: inset 0 0 0 1.5px var(--color-navy), var(--shadow-sm);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: var(--space-8);
    }
    .hero :global(.hero-bg) {
      object-position: 75% 33%;
    }
    .hero-scrim {
      background: linear-gradient(
        180deg,
        var(--color-cream) 0%,
        var(--color-cream) 58%,
        color-mix(in srgb, var(--color-cream) 75%, transparent) 74%,
        color-mix(in srgb, var(--color-cream) 30%, transparent) 100%
      );
    }
    .hero-copy {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      /* Le hero porte désormais une accroche, un titre en trois temps, deux
         boutons et l'entrée de l'outil : la hauteur suit le contenu au lieu
         d'être imposée, sinon le dernier bloc tombe sous la ligne de flottaison
         du dégradé et se lit sur la photo. */
      min-height: 0;
      align-items: flex-start;
      padding-top: var(--space-8);
    }
    .hero :global(.hero-bg) {
      object-position: 45% 15%;
    }
    .hero-tool a {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce), (max-width: 640px) {
    .hero-copy h1 {
      text-shadow: none;
    }
  }
</style>
