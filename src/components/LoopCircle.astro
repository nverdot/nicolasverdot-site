---
// Section "Vous tournez en rond ?" — après un diagramme circulaire (3
// passes) puis un bandeau en défilement horizontal (repris par erreur du
// même mécanisme que la section "Logos clients" juste au-dessus dans la
// page), nouveau départ : un panneau de diagnostic vertical, dans l'esprit
// d'une console/terminal. Un balayage lumineux descend la liste des 6
// situations en boucle continue, une ligne à la fois, pour de vrai — pas de
// marquee, pas de cercle, axe et mécanique différents de tout le reste de
// la page (grille d'icônes pour proof-band/value-prop/situations, bandeau
// défilant pour les logos, lignes alternées pour les offres).
import { withBase } from '../utils/url';

const icons: Record<string, string> = {
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  pencil: '<path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 6.5l2.5 2.5"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};

const situations = [
  { id: 1, text: "Les réunions se multiplient, mais rien n'avance vraiment." },
  { id: 2, text: 'Tout semble prioritaire.' },
  { id: 3, text: 'Les décisions sont prises, mais rarement appliquées.' },
  { id: 4, text: "Les équipes ne comprennent plus où l'on va." },
  { id: 5, text: 'Quelques personnes parlent, les autres décrochent.' },
  { id: 6, text: "Les transformations s'essoufflent après le lancement." },
];
const SCAN_DURATION = 9; // secondes pour un tour complet des 6 lignes
const STEP = SCAN_DURATION / situations.length;

const benefits = [
  { icon: 'people', title: 'Des méthodes participatives', text: 'Pour impliquer vraiment les bonnes personnes.' },
  { icon: 'pencil', title: 'Une facilitation visuelle', text: "Pour rendre l'essentiel visible et partagé." },
  { icon: 'target', title: 'Des décisions claires', text: "Pour sortir de l'incertitude et choisir une direction." },
  { icon: 'trending', title: 'Des actions qui comptent', text: 'Pour transformer les décisions en résultats concrets.' },
];
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Le diagnostic</p>
        <h2 data-loop-title>Vous tournez en rond ?</h2>
      </div>
      <p data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>

    <div class="loop-panel" data-loop-panel>
      <div class="loop-panel-head">
        <span class="loop-panel-live" aria-hidden="true"></span>
        <span>Ce qui revient, encore et encore</span>
      </div>
      <div class="loop-panel-list">
        {situations.map((s, i) => (
          <div class="loop-row" style={`--i: ${i}; --step: ${STEP}s; --duration: ${SCAN_DURATION}s;`}>
            <span class="loop-row-index">0{s.id}</span>
            <p class="loop-row-text">{s.text}</p>
            <span class="loop-row-status" aria-hidden="true"></span>
          </div>
        ))}
      </div>
    </div>

    <div class="loop-exit-wrap">
      <p class="loop-handwritten" data-loop-handwritten>Et si on sortait de cette boucle ?</p>
      <div class="loop-cta-wrap" data-loop-cta>
        <a href={withBase('/contact/')} class="btn">Sortons du cercle →</a>
      </div>
    </div>

    <div class="loop-benefits" data-loop-benefits>
      {benefits.map((b) => (
        <div class="loop-benefit">
          <svg class="loop-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      if (!section) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      // On anime l'opacité de `.loop-panel` (le panneau dans son ensemble),
      // jamais `.loop-row` : chaque ligne porte son propre pouls CSS infini
      // (balayage), et un gsap.set({...}) dessus entrerait en conflit avec
      // cette animation qui doit tourner en continu une fois révélée.
      const panel = section.querySelector('[data-loop-panel]');
      const handwritten = section.querySelector('[data-loop-handwritten]');
      const ctaWrap = section.querySelector('[data-loop-cta]');
      const benefits = gsap.utils.toArray<HTMLElement>('.loop-benefit');

      if (reduceMotion) {
        gsap.set([title, sub, panel, ...benefits], { opacity: 1, y: 0 });
        if (handwritten) gsap.set(handwritten, { opacity: 1 });
        if (ctaWrap) gsap.set(ctaWrap, { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(panel, { opacity: 0, y: 16 });
      gsap.set(benefits, { opacity: 0, y: 20 });
      if (handwritten) gsap.set(handwritten, { opacity: 0 });
      if (ctaWrap) gsap.set(ctaWrap, { opacity: 0, y: 12 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 70%', once: true },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25')
        .to(panel, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2');

      if (handwritten) {
        tl.to(handwritten, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.1');
      }
      if (ctaWrap) {
        tl.to(ctaWrap, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      tl.to(benefits, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.1');

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    padding: var(--space-16) 0;
    overflow: hidden;
  }

  /* --- Panneau : un objet contenu, délibérément sombre (registre
     "console/terminal"), posé sur la page — pas une section pleine largeur
     comme le bandeau clients juste au-dessus. --- */
  .loop-panel {
    max-width: 720px;
    margin: var(--space-10) auto 0;
    background: #0d1826;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 70px rgba(13, 24, 38, 0.35);
    overflow: hidden;
  }
  .loop-panel-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid rgba(252, 248, 239, 0.1);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--color-cream) 55%, transparent);
  }
  .loop-panel-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-orange) 25%, transparent);
    animation: loop-live-blink 1.8s ease-in-out infinite;
  }

  .loop-panel-list {
    padding: var(--space-2) 0;
  }
  .loop-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    animation: loop-row-scan var(--duration) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--step) * -1);
  }
  .loop-row-index {
    flex-shrink: 0;
    width: 2ch;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-cream) 40%, transparent);
  }
  .loop-row-text {
    flex: 1;
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }
  .loop-row-status {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--color-cream) 30%, transparent);
    animation: loop-status-scan var(--duration) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--step) * -1);
  }

  @keyframes loop-live-blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  /* La ligne "scannée" s'éclaire brièvement, texte inclus, puis retombe —
     la même ligne repassera au même endroit dans le cycle suivant : le
     constat ne change jamais, c'est tout le principe de la section. */
  @keyframes loop-row-scan {
    0%, 14%, 100% {
      background: transparent;
    }
    3% {
      background: color-mix(in srgb, var(--color-orange) 10%, transparent);
    }
  }
  @keyframes loop-status-scan {
    0%, 14%, 100% {
      background: transparent;
      border-color: color-mix(in srgb, var(--color-cream) 30%, transparent);
    }
    3% {
      background: var(--color-orange);
      border-color: var(--color-orange);
    }
  }

  .loop-exit-wrap {
    text-align: center;
    max-width: 480px;
    margin: var(--space-12) auto 0;
  }
  .loop-handwritten {
    margin: 0 0 var(--space-4);
    font-family: var(--font-script);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    color: var(--color-orange-ink);
  }

  .loop-cta-wrap {
    text-align: center;
  }

  .loop-benefits {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .loop-benefit {
    text-align: center;
  }
  .loop-benefit-icon {
    display: block;
    width: 32px;
    height: 32px;
    margin: 0 auto var(--space-3);
    color: var(--color-orange-ink);
  }
  .loop-benefit h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .loop-benefit p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .loop-panel-head {
      padding: var(--space-3) var(--space-4);
    }
    .loop-row {
      padding: var(--space-3) var(--space-4);
      gap: var(--space-3);
    }
    .loop-row-text {
      font-size: 0.9rem;
    }
    .loop-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .loop-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-panel-live {
      animation: none !important;
      opacity: 1 !important;
    }
    .loop-row,
    .loop-row-status {
      animation: none !important;
      background: transparent !important;
      border-color: color-mix(in srgb, var(--color-cream) 30%, transparent) !important;
    }
  }
</style>
