---
// Section "Vous tournez en rond ?" — construite à partir d'une illustration
// fournie (cercle peint à la main : 6 scènes, flèches, nœud central, sortie
// jaune). L'image ne contient aucun texte : le titre et les 6 légendes sont
// du vrai HTML, positionnés sur un anneau invisible à l'EXTÉRIEUR de
// l'image (jamais par-dessus, pour ne jamais masquer une scène) — voir
// RX/RY plus bas. Pas de numérotation : les légendes se lisent par leur
// position autour du cercle, pas par un ordre chiffré.
import { Image } from 'astro:assets';
import circleImg from '../assets/tourner-en-rond/cercle-illustration.png';
import img1 from '../assets/tourner-en-rond/01-reunions.png';
import img2 from '../assets/tourner-en-rond/02-post-its.png';
import img3 from '../assets/tourner-en-rond/03-decisions.png';
import img4 from '../assets/tourner-en-rond/04-signpost.png';
import img5 from '../assets/tourner-en-rond/05-group.png';
import img6 from '../assets/tourner-en-rond/06-walking.png';

// texte · position desktop, sur un anneau invisible EXTÉRIEUR à l'image
// (jamais par-dessus) — l'image elle-même est affichée plus petite,
// centrée dans une scène plus grande, pour laisser une marge tout autour
// où poser les légendes. Positions calculées par trigonométrie (angle 0 =
// haut, sens horaire) sur un rayon choisi juste au-delà du bord de
// l'image, pas calibrées scène par scène. Image individuelle utilisée
// uniquement dans le repli mobile (liste de cartes).
const situations = [
  { id: 1, lines: ["Les réunions se multiplient,", "mais rien n'avance vraiment."], angle: 0, image: img1 },
  { id: 2, lines: ['Tout semble prioritaire.'], angle: 60, image: img2 },
  { id: 3, lines: ['Les décisions sont prises,', 'mais rarement appliquées.'], angle: 120, image: img3 },
  { id: 4, lines: ["Les équipes ne comprennent plus", "où l'on va."], angle: 180, image: img4 },
  { id: 5, lines: ['Quelques personnes parlent,', 'les autres décrochent.'], angle: 240, image: img5 },
  { id: 6, lines: ["Les transformations s'essoufflent", 'après le lancement.'], angle: 300, image: img6 },
];
// Rayon elliptique (en % de la scène) juste au-delà du bord de l'image
// affichée à 68% de large, centrée — voir .loop-stage / .loop-illustration.
const RX = 40;
const RY = 35;
const toRad = (deg: number) => (deg * Math.PI) / 180;
const captionStyle = (angle: number) => {
  const left = 50 + RX * Math.sin(toRad(angle));
  const top = 50 - RY * Math.cos(toRad(angle));
  return `top: ${top.toFixed(1)}%; left: ${left.toFixed(1)}%; transform: translate(-50%, -50%);`;
};
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="loop-head">
      <h2 data-loop-title>
        Vous tournez
        <span class="accent-wrap">
          en rond
          <svg class="ink-underline" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 9 C 30 2, 70 12, 118 5" /></svg>
        </span>
        ?
      </h2>
      <p class="loop-sub" data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>

    <div class="loop-stage">
      <Image
        src={circleImg}
        alt="Cercle illustrant les problèmes récurrents qui empêchent une équipe d'avancer"
        widths={[500, 900, 1340, 1672]}
        sizes="(max-width: 900px) 100vw, 900px"
        class="loop-illustration"
      />

      {situations.map((s, i) => (
        <div class="loop-caption-pos" style={captionStyle(s.angle)}>
          <div class="loop-caption" data-loop-caption={i}>
            <p>{s.lines.map((line, li) => <>{li > 0 && <br />}{line}</>)}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Sortie : sous l'image plutôt qu'en position absolue par-dessus. -->
    <div class="loop-exit-wrap-desktop" data-loop-exit-desktop>
      <p class="loop-exit-text" data-loop-caption={situations.length}>Et si on sortait de ce cercle ?</p>
    </div>

    <!-- Repli mobile : mêmes 6 situations, en liste de cartes sous l'image
         décorative plutôt qu'en positionnement absolu illisible en dessous
         de 860px (voir CSS). -->
    <ol class="loop-mobile-list">
      {situations.map((s) => (
        <li class="loop-mobile-item">
          <Image src={s.image} alt="" width={400} height={280} loading="lazy" class="loop-mobile-img" />
          <div class="loop-mobile-content">
            <p>{s.lines.join(' ')}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="loop-exit-text loop-exit-text--mobile">Et si on sortait de ce cercle ?</p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      if (!section) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      // Ordre demandé : les 6 légendes dans l'ordre du cercle, puis le texte
      // de sortie, puis le bouton — uniquement les éléments desktop (repère
      // `[data-loop-caption]`), le repli mobile n'est jamais animé (liste
      // statique, toujours visible).
      const captions = gsap.utils.toArray<HTMLElement>('[data-loop-caption]').sort(
        (a, b) => Number(a.dataset.loopCaption) - Number(b.dataset.loopCaption)
      );

      // Trait sous "en rond" : même motif que "le collectif avance." dans le
      // bandeau bénéfices — se dessine de gauche à droite au scroll et se
      // redessine à chaque passage (toggleActions play/reverse), plutôt que
      // de rester acquis une fois pour toutes.
      const underlinePath = section.querySelector<SVGPathElement>('.ink-underline path');
      if (underlinePath) {
        const length = underlinePath.getTotalLength();
        gsap.set(underlinePath, { strokeDasharray: length, strokeDashoffset: reduceMotion ? 0 : length });
      }

      if (reduceMotion) {
        gsap.set([title, sub, ...captions], { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(captions, { opacity: 0, y: 10 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25')
        .to(captions, { opacity: 1, y: 0, duration: 0.4, stagger: 0.12, ease: 'power2.out' }, '-=0.15');

      let underlineTween: gsap.core.Tween | undefined;
      if (underlinePath) {
        underlineTween = gsap.to(underlinePath, {
          strokeDashoffset: 0,
          duration: 1,
          delay: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 65%',
            toggleActions: 'play none none reverse',
          },
        });
      }

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
        underlineTween?.scrollTrigger?.kill();
        underlineTween?.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    padding: var(--space-16) 0;
  }

  .loop-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }
  .loop-head h2 {
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }
  /* Même motif que le soulignement de "le collectif avance." dans le
     bandeau bénéfices (proof-band) : un seul mot souligné, pas tout le
     titre, tracé au scroll et effacé au retour en arrière. */
  .accent-wrap {
    display: inline-block;
    position: relative;
  }
  .accent-wrap .ink-underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.25em;
    stroke: var(--color-orange);
    stroke-width: 5;
    fill: none;
    overflow: visible;
  }
  .loop-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  /* --- Scène desktop : image réduite et centrée dans une zone plus grande,
     pour laisser une marge tout autour où poser les légendes sans jamais
     toucher l'illustration (voir RX/RY dans le frontmatter). --- */
  .loop-stage {
    position: relative;
    max-width: 900px;
    aspect-ratio: 1672 / 1200;
    margin: 0 auto;
  }
  .loop-stage :global(.loop-illustration) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  /* Le positionnement (top/left/translateX de centrage) vit sur ce wrapper,
     jamais sur `.loop-caption` : GSAP anime l'opacité/y de `.loop-caption`
     pour l'entrée, et un gsap.set({y}) écrit dans `transform` — s'il visait
     l'élément positionné, ça écraserait son translateX(-50%) de centrage. */
  .loop-caption-pos {
    position: absolute;
  }
  .loop-caption {
    /* Largeur plafonnée en px sur grand écran, mais qui doit rétrécir avec
       la scène (max-width:900px) plutôt que rester fixe — sinon, sous
       ~900px de large, les pastilles gardent leur taille pleine pendant que
       la scène rétrécit et finissent par se chevaucher. */
    max-width: min(170px, 21vw);
    /* Base en clamp(): padding et taille de texte ci-dessous sont en `em`,
       donc tout le bloc (texte + espace intérieur) rétrécit ensemble avec
       la scène plutôt que juste la largeur — sans ça, réduire uniquement
       max-width laisse le texte aussi grand et le bloc déborde en hauteur. */
    font-size: clamp(0.78rem, 1.6vw, 0.86rem);
    padding: 0.55em 0.85em;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(18, 32, 51, 0.08);
    backdrop-filter: blur(2px);
  }
  .loop-caption p {
    margin: 0;
    font-size: 0.95em;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--color-navy);
  }

  .loop-exit-wrap-desktop {
    text-align: center;
    margin: var(--space-8) auto 0;
  }
  .loop-exit-text {
    margin: 0;
    font-family: var(--font-script);
    font-size: clamp(1.3rem, 2.2vw, 1.6rem);
    color: var(--color-orange-ink);
  }

  /* --- Repli mobile : caché par défaut, activé sous 860px --- */
  .loop-mobile-list,
  .loop-exit-text--mobile {
    display: none;
  }

  @media (max-width: 860px) {
    /* Le cercle complet devient inutile en dessous de 860px : chaque
       situation a déjà sa propre image en tête de carte (voir plus bas). */
    .loop-stage {
      display: none;
    }
    .loop-exit-wrap-desktop {
      display: none;
    }

    .loop-mobile-list {
      display: grid;
      gap: var(--space-3);
      list-style: none;
      margin: 0 0 var(--space-6);
      padding: 0;
    }
    .loop-mobile-item {
      overflow: hidden;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }
    .loop-mobile-item :global(.loop-mobile-img) {
      display: block;
      width: 100%;
      height: 150px;
      object-fit: cover;
      object-position: center 25%;
    }
    .loop-mobile-content {
      padding: var(--space-4);
    }
    .loop-mobile-item p {
      margin: 0;
      font-weight: 600;
      color: var(--color-navy);
      line-height: 1.4;
    }

    .loop-exit-text--mobile {
      display: block;
      text-align: center;
      margin: 0;
      font-family: var(--font-script);
      font-size: 1.5rem;
      color: var(--color-orange-ink);
    }
  }
</style>
