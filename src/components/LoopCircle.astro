---
// Section "Vous tournez en rond ?" — cercle animé de 6 situations qui
// apparaissent progressivement, tournent légèrement (sens antihoraire),
// puis s'ouvrent sur une sortie jaune vers le CTA. Structure data-driven :
// modifier `situations` suffit à changer contenu/ordre/images.
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';

import img1 from '../assets/tourner-en-rond/01-reunions.png';
import img2 from '../assets/tourner-en-rond/03-tout-semble-prioritaire.png';
import img3 from '../assets/tourner-en-rond/06-decisions-peu-appliquees.png';
import img4 from '../assets/tourner-en-rond/05-equipe-sans-direction.png';
import img5 from '../assets/tourner-en-rond/04-quelques-personnes-parlent.png';
import img6 from '../assets/tourner-en-rond/02-transformation-essoufflee.png';
import imgKnot from '../assets/tourner-en-rond/07-noeud-central.png';
import picto1 from '../assets/tourner-en-rond/picto-methodes-participatives.png';
import picto2 from '../assets/tourner-en-rond/picto-facilitation-visuelle.png';
import picto3 from '../assets/tourner-en-rond/picto-decisions-claires.png';
import picto4 from '../assets/tourner-en-rond/picto-actions-qui-comptent.png';

// id · texte · image · angle (0 = haut, sens horaire) · délai relatif (s)
const situations = [
  { id: 1, text: "Les réunions se multiplient, mais rien n'avance vraiment.", image: img1, angle: 0, delay: 0 },
  { id: 2, text: 'Tout semble prioritaire.', image: img2, angle: 60, delay: 0.9 },
  { id: 3, text: 'Les décisions sont prises, mais rarement appliquées.', image: img3, angle: 120, delay: 1.8 },
  { id: 4, text: "Les équipes ne comprennent plus où l'on va.", image: img4, angle: 180, delay: 2.7 },
  { id: 5, text: 'Quelques personnes parlent, les autres décrochent.', image: img5, angle: 240, delay: 3.6 },
  { id: 6, text: "Les transformations s'essoufflent après le lancement.", image: img6, angle: 300, delay: 4.5 },
];

const benefits = [
  { image: picto1, title: 'Des méthodes participatives', text: 'Pour impliquer vraiment les bonnes personnes.' },
  { image: picto2, title: 'Une facilitation visuelle', text: "Pour rendre l'essentiel visible et partagé." },
  { image: picto3, title: 'Des décisions claires', text: "Pour sortir de l'incertitude et choisir une direction." },
  { image: picto4, title: 'Des actions qui comptent', text: 'Pour transformer les décisions en résultats concrets.' },
];

// Coordonnées des 6 points sur un cercle de rayon 350 dans un viewBox
// 1000×1000 centré en (500,500) — 0° = haut, sens horaire.
const R = 350;
const CX = 500;
const CY = 500;
const pt = (angleDeg: number) => {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: CX + R * Math.sin(rad), y: CY - R * Math.cos(rad) };
};
const points = situations.map((s) => pt(s.angle));
// Segments reliant les points consécutifs — le segment 3 (entre la
// situation 3 "bas-droite" et la situation 4 "bas") est volontairement
// omis : c'est la rupture du cercle, remplacée par la sortie jaune.
const arcs = [0, 1, 2, 3, 4, 5].map((i) => {
  const a = points[i];
  const b = points[(i + 1) % 6];
  return { id: i, d: `M${a.x.toFixed(1)},${a.y.toFixed(1)} A${R},${R} 0 0 1 ${b.x.toFixed(1)},${b.y.toFixed(1)}` };
});
const BROKEN_ARC = 2; // segment situation3 → situation4
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="loop-head">
      <h2 data-loop-title>Vous tournez en rond ?</h2>
      <p class="loop-sub" data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>

    <div class="loop-stage">
      <div class="loop-orbit" data-loop-orbit style={`--radius: clamp(150px, 27vw, 400px);`}>
        <svg class="loop-arrows" viewBox="0 0 1000 1000" aria-hidden="true">
          <defs>
            <marker id="loop-arrowhead" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="var(--color-navy)" />
            </marker>
          </defs>
          {arcs.map((arc) => (
            arc.id === BROKEN_ARC ? null : (
              <path
                class="loop-arc"
                data-loop-arc={arc.id}
                d={arc.d}
                marker-end="url(#loop-arrowhead)"
              />
            )
          ))}
        </svg>

        {situations.map((s) => (
          <div class="loop-node" style={`--angle: ${s.angle};`} data-loop-node={s.id}>
            <div class="loop-node-inner">
              <div class="loop-node-visual" data-loop-node-visual>
                <span class="loop-node-img"><Image src={s.image} alt="" width={235} height={170} loading="lazy" /></span>
                <p class="loop-node-text">{s.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="loop-knot" aria-hidden="true">
        <Image src={imgKnot} alt="" width={220} height={220} />
      </div>

      <svg class="loop-exit" viewBox="0 0 1000 1000" aria-hidden="true" data-loop-exit>
        <defs>
          <marker id="loop-exit-arrowhead" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--color-orange)" />
          </marker>
        </defs>
        <path
          class="loop-exit-path"
          data-loop-exit-path
          d={`M${points[2].x.toFixed(1)},${points[2].y.toFixed(1)} C ${(points[2].x + 140).toFixed(1)},${(points[2].y + 40).toFixed(1)} ${(points[2].x + 160).toFixed(1)},${(points[3].y - 60).toFixed(1)} ${(points[3].x + 40).toFixed(1)},${(points[3].y + 90).toFixed(1)}`}
          marker-end="url(#loop-exit-arrowhead)"
        />
      </svg>

      <p class="loop-handwritten" data-loop-handwritten>Et si on sortait de ce cercle ?</p>
    </div>

    <div class="loop-cta-wrap" data-loop-cta>
      <a href={withBase('/contact/')} class="btn">Sortons du cercle →</a>
    </div>

    <div class="loop-benefits" data-loop-benefits>
      {benefits.map((b) => (
        <div class="loop-benefit">
          <span class="loop-benefit-img"><Image src={b.image} alt="" width={64} height={64} /></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const ROTATION_STEP = -10; // degrés par apparition, sens antihoraire

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      const orbit = document.querySelector<HTMLElement>('[data-loop-orbit]');
      if (!section || !orbit) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      const knot = section.querySelector('.loop-knot');
      // Anime le wrapper visuel interne, jamais `.loop-node` : cet élément
      // porte déjà un transform rotate()+translateY() piloté par CSS pour le
      // placement sur le cercle, et gsap.set(..., {scale}) écrit directement
      // dans style.transform, ce qui écraserait ce placement.
      const nodes = gsap.utils.toArray<HTMLElement>('[data-loop-node-visual]');
      const arcs = gsap.utils.toArray<SVGPathElement>('[data-loop-arc]');
      const exitPath = section.querySelector<SVGPathElement>('[data-loop-exit-path]');
      const handwritten = section.querySelector('[data-loop-handwritten]');
      const ctaWrap = section.querySelector('[data-loop-cta]');
      const benefits = gsap.utils.toArray<HTMLElement>('.loop-benefit');

      // Longueur de chaque arc pour l'effet "dessiné au trait".
      arcs.forEach((arc) => {
        const len = arc.getTotalLength();
        gsap.set(arc, { strokeDasharray: len, strokeDashoffset: reduceMotion ? 0 : len });
      });
      if (exitPath) {
        const len = exitPath.getTotalLength();
        gsap.set(exitPath, { strokeDasharray: len, strokeDashoffset: reduceMotion ? 0 : len });
      }

      if (reduceMotion) {
        // Tout est affiché immédiatement, disposition circulaire conservée,
        // aucune rotation.
        gsap.set([title, sub, knot, ...nodes, ...benefits], { opacity: 1, y: 0, scale: 1 });
        gsap.set(orbit, { '--orbit-rot': '0deg' } as gsap.TweenVars);
        if (handwritten) gsap.set(handwritten, { opacity: 1 });
        if (ctaWrap) gsap.set(ctaWrap, { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(knot, { opacity: 0, scale: 0.7 });
      gsap.set(nodes, { opacity: 0, scale: 0.6 });
      gsap.set(benefits, { opacity: 0, y: 20 });
      if (handwritten) gsap.set(handwritten, { opacity: 0 });
      if (ctaWrap) gsap.set(ctaWrap, { opacity: 0, y: 12 });

      const rot = { value: 0 };
      const applyRot = () => orbit.style.setProperty('--orbit-rot', `${rot.value}deg`);
      applyRot();

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 60%',
          once: true,
        },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25')
        .to(knot, { opacity: 1, scale: 1, duration: 0.6, ease: 'back.out(1.6)' }, '-=0.15');

      nodes.forEach((node, i) => {
        tl.to(node, { opacity: 1, scale: 1, duration: 0.55, ease: 'back.out(1.5)' }, '+=0.1');

        // Arc reliant ce nœud au précédent (sauf le premier, et sauf la
        // rupture volontaire entre les situations 3 et 4).
        if (i > 0 && i - 1 !== 2) {
          const arc = arcs.find((a) => Number(a.dataset.loopArc) === i - 1);
          if (arc) {
            tl.to(arc, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.out' }, '<');
          }
        }
        // Après la 6ᵉ situation, referme aussi la boucle (segment 6 → 1).
        if (i === 5) {
          const closingArc = arcs.find((a) => Number(a.dataset.loopArc) === 5);
          if (closingArc) {
            tl.to(closingArc, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.out' }, '<');
          }
        }

        // Légère rotation antihoraire après chaque situation, sauf la
        // dernière : le cercle s'arrête dès que tout est visible.
        if (i < nodes.length - 1) {
          tl.to(rot, { value: rot.value + ROTATION_STEP, duration: 0.9, ease: 'sine.inOut', onUpdate: applyRot }, '+=0.05');
        }
      });

      if (exitPath) {
        tl.to(exitPath, { strokeDashoffset: 0, duration: 0.7, ease: 'power2.out' }, '+=0.2');
      }
      if (handwritten) {
        tl.to(handwritten, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      if (ctaWrap) {
        tl.to(ctaWrap, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      tl.to(benefits, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.1');

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    padding: var(--space-16) 0;
    background: var(--color-cream);
    overflow: hidden;
  }
  .loop-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-10);
  }
  .loop-head h2 {
    color: var(--color-navy);
    position: relative;
    display: inline-block;
    margin: 0 0 var(--space-3);
  }
  .loop-head h2::after {
    content: '';
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -0.15em;
    height: 0.2em;
    background: var(--color-orange);
    border-radius: 999px;
    transform: rotate(-1deg);
  }
  .loop-sub {
    color: var(--color-muted);
    font-size: var(--text-lg);
    margin: 0;
  }

  .loop-stage {
    position: relative;
    width: 100%;
    max-width: 950px;
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .loop-orbit {
    position: absolute;
    inset: 0;
    --orbit-rot: 0deg;
  }
  .loop-arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(var(--orbit-rot));
  }
  .loop-arc {
    fill: none;
    stroke: var(--color-navy);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .loop-node {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(calc(var(--angle) * 1deg + var(--orbit-rot))) translateY(calc(-1 * var(--radius)));
  }
  .loop-node-inner {
    position: absolute;
    transform: translate(-50%, -50%) rotate(calc(-1 * (var(--angle) * 1deg + var(--orbit-rot))));
    width: 150px;
  }
  .loop-node-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .loop-node-img {
    display: block;
    width: 118px;
    height: 86px;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .loop-node-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .loop-node-text {
    margin: 0;
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-navy);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.5em 0.75em;
    box-shadow: var(--shadow-sm);
  }

  .loop-knot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(90px, 15vw, 190px);
    z-index: 1;
  }
  .loop-knot :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .loop-exit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .loop-exit-path {
    fill: none;
    stroke: var(--color-orange);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .loop-handwritten {
    position: absolute;
    right: 2%;
    bottom: 6%;
    max-width: 200px;
    margin: 0;
    font-family: var(--font-script);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    color: var(--color-orange-ink);
    text-align: right;
    transform: rotate(-2deg);
  }

  .loop-cta-wrap {
    text-align: center;
    margin-top: var(--space-10);
  }

  .loop-benefits {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .loop-benefit {
    text-align: center;
  }
  .loop-benefit-img {
    display: block;
    width: 56px;
    height: 56px;
    margin: 0 auto var(--space-3);
  }
  .loop-benefit-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .loop-benefit h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .loop-benefit p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .loop-node-text {
      font-size: 0.68rem;
      width: 120px;
    }
    .loop-node-img {
      width: 92px;
      height: 67px;
    }
  }

  @media (max-width: 768px) {
    .loop-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Sous 480px : le cercle devient illisible, on bascule en boucle
     verticale — même contenu, même esprit de répétition, disposition en
     colonne avec le nœud au centre et la sortie jaune en bas. --- */
  @media (max-width: 480px) {
    .loop-stage {
      aspect-ratio: auto;
      max-width: 340px;
    }
    .loop-orbit {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-6);
    }
    .loop-arrows,
    .loop-exit {
      display: none;
    }
    .loop-node {
      position: static;
      width: auto;
      height: auto;
      transform: none !important;
    }
    .loop-node-inner {
      position: static;
      transform: none !important;
      width: auto;
    }
    .loop-node::after {
      content: '';
      display: block;
      width: 2px;
      height: 28px;
      margin: var(--space-2) auto 0;
      background: var(--color-navy);
      opacity: 0.4;
    }
    .loop-node:last-of-type::after {
      display: none;
    }
    .loop-knot {
      position: static;
      transform: none;
      width: 120px;
      order: 3;
      margin: var(--space-4) auto;
    }
    .loop-handwritten {
      position: static;
      text-align: center;
      max-width: none;
      margin: var(--space-6) 0 0;
      transform: none;
    }
    .loop-cta-wrap {
      margin-top: var(--space-6);
    }
    .loop-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-arc,
    .loop-exit-path {
      stroke-dashoffset: 0 !important;
    }
  }
</style>
