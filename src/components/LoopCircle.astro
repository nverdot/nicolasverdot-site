---
// Section "Vous tournez en rond ?" — après trois passes sur un diagramme
// circulaire jugées insuffisamment abouties, changement de langage visuel :
// un bandeau plein écran, navy, où les 6 situations défilent en boucle
// horizontale infinie. La métaphore "ça tourne en rond" devient un fait
// physique et continu (comme un ticker) plutôt qu'un diagramme à décoder —
// plus simple à rendre soigné, plus direct, réellement interactif (pause au
// survol). Structure data-driven : modifier `situations` suffit.
import { withBase } from '../utils/url';

const icons: Record<string, string> = {
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  pencil: '<path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 6.5l2.5 2.5"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};

const situations = [
  { id: 1, text: "Les réunions se multiplient, mais rien n'avance vraiment." },
  { id: 2, text: 'Tout semble prioritaire.' },
  { id: 3, text: 'Les décisions sont prises, mais rarement appliquées.' },
  { id: 4, text: "Les équipes ne comprennent plus où l'on va." },
  { id: 5, text: 'Quelques personnes parlent, les autres décrochent.' },
  { id: 6, text: "Les transformations s'essoufflent après le lancement." },
];

const benefits = [
  { icon: 'people', title: 'Des méthodes participatives', text: 'Pour impliquer vraiment les bonnes personnes.' },
  { icon: 'pencil', title: 'Une facilitation visuelle', text: "Pour rendre l'essentiel visible et partagé." },
  { icon: 'target', title: 'Des décisions claires', text: "Pour sortir de l'incertitude et choisir une direction." },
  { icon: 'trending', title: 'Des actions qui comptent', text: 'Pour transformer les décisions en résultats concrets.' },
];
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Le diagnostic</p>
        <h2 data-loop-title>Vous tournez en rond ?</h2>
      </div>
      <p data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>
  </div>

  <div class="loop-band" data-loop-band>
    <div class="loop-band-scan" aria-hidden="true"></div>
    <div class="loop-marquee">
      <div class="loop-track">
        {situations.map((s) => (
          <div class="loop-pill">
            <span class="loop-pill-index">0{s.id}</span>
            <p class="loop-pill-text">{s.text}</p>
          </div>
        ))}
        {situations.map((s) => (
          <div class="loop-pill" aria-hidden="true">
            <span class="loop-pill-index">0{s.id}</span>
            <p class="loop-pill-text">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="container">
    <div class="loop-exit-wrap">
      <p class="loop-handwritten" data-loop-handwritten>Et si on sortait de cette boucle ?</p>
      <div class="loop-cta-wrap" data-loop-cta>
        <a href={withBase('/contact/')} class="btn">Sortons du cercle →</a>
      </div>
    </div>

    <div class="loop-benefits" data-loop-benefits>
      {benefits.map((b) => (
        <div class="loop-benefit">
          <svg class="loop-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      if (!section) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      // On anime l'opacité de `.loop-band` (le bandeau dans son ensemble),
      // jamais `.loop-track` : ce dernier porte le défilement infini en CSS
      // (translateX), et un gsap.set({...}) dessus écraserait ou entrerait
      // en conflit avec cette animation qui doit tourner en continu.
      const band = section.querySelector('[data-loop-band]');
      const handwritten = section.querySelector('[data-loop-handwritten]');
      const ctaWrap = section.querySelector('[data-loop-cta]');
      const benefits = gsap.utils.toArray<HTMLElement>('.loop-benefit');

      if (reduceMotion) {
        gsap.set([title, sub, band, ...benefits], { opacity: 1, y: 0 });
        if (handwritten) gsap.set(handwritten, { opacity: 1 });
        if (ctaWrap) gsap.set(ctaWrap, { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(band, { opacity: 0, y: 16 });
      gsap.set(benefits, { opacity: 0, y: 20 });
      if (handwritten) gsap.set(handwritten, { opacity: 0 });
      if (ctaWrap) gsap.set(ctaWrap, { opacity: 0, y: 12 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 70%', once: true },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25')
        .to(band, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.2');

      if (handwritten) {
        tl.to(handwritten, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.1');
      }
      if (ctaWrap) {
        tl.to(ctaWrap, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      tl.to(benefits, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.1');

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    /* Section volontairement toujours claire (hors bandeau), indépendamment
       du thème : la référence n'a pas de variante sombre. */
    --color-navy: #122033;
    --color-cream: #fcf8ef;
    --color-surface: #fffdfa;
    --color-ink: #122033;
    --color-muted: #4c5158;
    --color-faint: #4c5158;
    --color-border: #cfc3b1;
    --shadow-sm: 0 12px 30px rgba(18, 32, 51, 0.08);
    --shadow-md: 0 26px 80px rgba(18, 32, 51, 0.12);
    padding: var(--space-16) 0;
    background: var(--color-cream);
    color: var(--color-ink);
    overflow: hidden;
  }

  /* --- Bandeau plein écran : rupture de contraste franche, comme le
     bandeau "problème" d'origine, mais qui sert maintenant le contenu
     défilant plutôt qu'une simple liste statique. --- */
  .loop-band {
    position: relative;
    margin: var(--space-10) 0;
    padding: var(--space-8) 0;
    background: var(--color-navy);
    overflow: hidden;
  }
  .loop-band-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 42%, color-mix(in srgb, var(--color-cream) 10%, transparent) 50%, transparent 58%);
    animation: loop-scan 7s ease-in-out infinite;
    pointer-events: none;
  }

  .loop-marquee {
    overflow: hidden;
  }
  .loop-marquee:hover .loop-track {
    animation-play-state: paused;
  }

  .loop-track {
    display: flex;
    width: max-content;
    gap: var(--space-4);
    animation: loop-scroll 34s linear infinite;
  }

  .loop-pill {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: color-mix(in srgb, var(--color-cream) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    border-radius: var(--radius-pill);
    padding: 0.6em 1.4em 0.6em 0.6em;
  }
  .loop-pill-index {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-orange);
    color: var(--color-navy);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .loop-pill-text {
    margin: 0;
    white-space: nowrap;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-cream);
  }

  @keyframes loop-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes loop-scan {
    0%, 100% {
      transform: translateX(-30%);
    }
    50% {
      transform: translateX(30%);
    }
  }

  .loop-exit-wrap {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }
  .loop-handwritten {
    margin: 0 0 var(--space-4);
    font-family: var(--font-script);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    color: var(--color-orange-ink);
  }

  .loop-cta-wrap {
    text-align: center;
  }

  .loop-benefits {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .loop-benefit {
    text-align: center;
  }
  .loop-benefit-icon {
    display: block;
    width: 32px;
    height: 32px;
    margin: 0 auto var(--space-3);
    color: var(--color-orange-ink);
  }
  .loop-benefit h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .loop-benefit p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 768px) {
    .loop-pill-text {
      font-size: 0.92rem;
    }
    .loop-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .loop-band {
      padding: var(--space-6) 0;
    }
    .loop-pill {
      padding: 0.5em 1.1em 0.5em 0.5em;
    }
    .loop-pill-index {
      width: 26px;
      height: 26px;
      font-size: 0.68rem;
    }
    .loop-pill-text {
      font-size: 0.85rem;
    }
    .loop-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-band-scan {
      display: none;
    }
    .loop-track {
      animation: none !important;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
    /* Les 6 dernières pastilles sont une copie dupliquée pour la boucle
       infinie (voir markup) — sans l'animation, on ne garde que l'original. */
    .loop-pill[aria-hidden='true'] {
      display: none;
    }
  }
</style>
