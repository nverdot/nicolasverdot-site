---
// Section "Vous tournez en rond ?" — construite à partir d'une illustration
// fournie (cercle peint à la main : 6 scènes, flèches, nœud central, sortie
// jaune). L'image ne contient aucun texte : tout le contenu (titre, 6
// légendes, texte de sortie, bouton) est du vrai HTML positionné par-dessus
// en absolu (desktop) via des pourcentages, pour rester lisible, accessible
// et modifiable sans toucher à l'image. Positions calibrées en analysant les
// pixels de l'image (centre de chaque scène, cf. historique de commit) puis
// ajustées à l'œil.
import { Image } from 'astro:assets';
import { withBase } from '../utils/url';
import circleImg from '../assets/tourner-en-rond/cercle-illustration.png';

// texte · position desktop (pourcentages, calibrés sur l'image 1672×941)
const situations = [
  { id: 1, lines: ["Les réunions se multiplient,", "mais rien n'avance vraiment."], style: 'top: 25%; left: 47%; transform: translateX(-50%);' },
  { id: 2, lines: ['Tout semble prioritaire.'], style: 'top: 47%; left: 75%; transform: translateX(-50%);' },
  { id: 3, lines: ['Les décisions sont prises,', 'mais rarement appliquées.'], style: 'top: 61%; left: 66%; transform: translateX(-50%);' },
  { id: 4, lines: ["Les équipes ne comprennent plus", "où l'on va."], style: 'bottom: 1%; left: 49%; transform: translateX(-50%);' },
  { id: 5, lines: ['Quelques personnes parlent,', 'les autres décrochent.'], style: 'top: 69%; left: 23%; transform: translateX(-50%);' },
  { id: 6, lines: ["Les transformations s'essoufflent", 'après le lancement.'], style: 'top: 47%; left: 22%; transform: translateX(-50%);' },
];
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="loop-head">
      <h2 data-loop-title>
        Vous tournez en rond ?
        <svg class="loop-underline" viewBox="0 0 260 14" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9 C 60 3, 140 12, 257 5" /></svg>
      </h2>
      <p class="loop-sub" data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>

    <div class="loop-stage">
      <Image
        src={circleImg}
        alt="Cercle illustrant les problèmes récurrents qui empêchent une équipe d'avancer"
        widths={[500, 900, 1340, 1672]}
        sizes="(max-width: 900px) 100vw, 900px"
        class="loop-illustration"
      />

      {situations.map((s, i) => (
        <div class="loop-caption-pos" style={s.style}>
          <div class="loop-caption" data-loop-caption={i}>
            <span class="loop-caption-index">0{s.id}</span>
            <p>{s.lines.map((line, li) => <>{li > 0 && <br />}{line}</>)}</p>
          </div>
        </div>
      ))}

      <div class="loop-exit-text-pos">
        <p class="loop-exit-text" data-loop-caption={situations.length}>Et si on sortait de ce cercle ?</p>
      </div>

      <a href={withBase('/contact/')} class="btn loop-exit-btn" data-loop-caption={situations.length + 1}>Sortons du cercle →</a>
    </div>

    <!-- Repli mobile : mêmes 6 situations, en liste de cartes sous l'image
         décorative plutôt qu'en positionnement absolu illisible en dessous
         de 860px (voir CSS). -->
    <ol class="loop-mobile-list">
      {situations.map((s) => (
        <li class="loop-mobile-item">
          <span class="loop-caption-index">0{s.id}</span>
          <p>{s.lines.join(' ')}</p>
        </li>
      ))}
    </ol>
    <p class="loop-exit-text loop-exit-text--mobile">Et si on sortait de ce cercle ?</p>
    <div class="loop-mobile-cta">
      <a href={withBase('/contact/')} class="btn">Sortons du cercle →</a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      if (!section) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      // Ordre demandé : les 6 légendes dans l'ordre du cercle, puis le texte
      // de sortie, puis le bouton — uniquement les éléments desktop (repère
      // `[data-loop-caption]`), le repli mobile n'est jamais animé (liste
      // statique, toujours visible).
      const captions = gsap.utils.toArray<HTMLElement>('[data-loop-caption]').sort(
        (a, b) => Number(a.dataset.loopCaption) - Number(b.dataset.loopCaption)
      );

      if (reduceMotion) {
        gsap.set([title, sub, ...captions], { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(captions, { opacity: 0, y: 10 });

      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25')
        .to(captions, { opacity: 1, y: 0, duration: 0.4, stagger: 0.12, ease: 'power2.out' }, '-=0.15');

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    padding: var(--space-16) 0;
  }

  .loop-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-8);
  }
  .loop-head h2 {
    position: relative;
    display: inline-block;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }
  .loop-underline {
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: -0.28em;
    width: 96%;
    height: 0.3em;
    overflow: visible;
  }
  .loop-underline path {
    fill: none;
    stroke: var(--color-orange);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .loop-sub {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  /* --- Scène desktop : image + légendes en position absolue --- */
  .loop-stage {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }
  .loop-stage :global(.loop-illustration) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  /* Le positionnement (top/left/translateX de centrage) vit sur ce wrapper,
     jamais sur `.loop-caption` : GSAP anime l'opacité/y de `.loop-caption`
     pour l'entrée, et un gsap.set({y}) écrit dans `transform` — s'il visait
     l'élément positionné, ça écraserait son translateX(-50%) de centrage. */
  .loop-caption-pos {
    position: absolute;
  }
  .loop-caption {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    /* Largeur plafonnée en px sur grand écran, mais qui doit rétrécir avec
       la scène (max-width:900px) plutôt que rester fixe — sinon, sous
       ~900px de large, les pastilles gardent leur taille pleine pendant que
       la scène rétrécit et finissent par se chevaucher. */
    max-width: min(190px, 24vw);
    /* Base en clamp(): padding et tailles de texte ci-dessous sont en `em`,
       donc tout le bloc (texte + espace intérieur) rétrécit ensemble avec
       la scène plutôt que juste la largeur — sans ça, réduire uniquement
       max-width laisse le texte aussi grand et le bloc déborde en hauteur. */
    font-size: clamp(0.78rem, 1.6vw, 0.86rem);
    padding: 0.55em 0.85em;
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 16px;
    box-shadow: 0 8px 20px rgba(18, 32, 51, 0.08);
    backdrop-filter: blur(2px);
  }
  .loop-caption-index {
    flex-shrink: 0;
    font-size: 0.85em;
    font-weight: 700;
    color: var(--color-orange-ink);
    font-variant-numeric: tabular-nums;
  }
  .loop-caption p {
    margin: 0;
    font-size: 0.95em;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-navy);
  }

  .loop-exit-text-pos {
    position: absolute;
    top: 71%;
    right: 0%;
    max-width: min(135px, 17vw);
    transform: rotate(-2deg);
  }
  .loop-exit-text {
    margin: 0;
    font-family: var(--font-script);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.15;
    color: var(--color-orange-ink);
    text-align: right;
  }
  .loop-exit-btn {
    position: absolute;
    bottom: 0.5%;
    right: 1%;
    font-size: clamp(0.75rem, 1.5vw, 0.95rem);
    padding: 0.7em 1.1em;
    white-space: nowrap;
  }

  /* --- Repli mobile : caché par défaut, activé sous 860px --- */
  .loop-mobile-list,
  .loop-exit-text--mobile,
  .loop-mobile-cta {
    display: none;
  }

  @media (max-width: 860px) {
    .loop-caption-pos,
    .loop-exit-text-pos,
    .loop-exit-btn {
      display: none;
    }
    .loop-stage {
      max-width: none;
      margin-bottom: var(--space-8);
    }

    .loop-mobile-list {
      display: grid;
      gap: var(--space-3);
      list-style: none;
      margin: 0 0 var(--space-6);
      padding: 0;
    }
    .loop-mobile-item {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }
    .loop-mobile-item p {
      margin: 0;
      font-weight: 600;
      color: var(--color-navy);
      line-height: 1.4;
    }

    .loop-exit-text--mobile {
      display: block;
      text-align: center;
      margin: 0 0 var(--space-4);
      font-family: var(--font-script);
      font-size: 1.5rem;
      color: var(--color-orange-ink);
    }
    .loop-mobile-cta {
      display: block;
      text-align: center;
    }
  }
</style>
