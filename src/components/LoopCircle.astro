---
// Section "Vous tournez en rond ?" — pas d'illustrations : un cercle tracé
// au trait, 6 situations en typographie pure disposées autour, et un signal
// qui tourne en continu (jamais scroll-gaté) pour montrer littéralement que
// le problème est une boucle sans fin. La rupture jaune vers le CTA est la
// seule chose qui NE boucle PAS — c'est la sortie. Structure data-driven :
// modifier `situations` suffit à changer contenu/ordre.
import { withBase } from '../utils/url';

const icons: Record<string, string> = {
  people: '<circle cx="8" cy="8" r="3"/><path d="M2 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 20c.2-2.6 2.1-4.7 4.6-5"/>',
  pencil: '<path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 6.5l2.5 2.5"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  trending: '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};

// id · texte · angle (0 = haut, sens horaire)
const situations = [
  { id: 1, text: "Les réunions se multiplient, mais rien n'avance vraiment." , angle: 0 },
  { id: 2, text: 'Tout semble prioritaire.', angle: 60 },
  { id: 3, text: 'Les décisions sont prises, mais rarement appliquées.', angle: 120 },
  { id: 4, text: "Les équipes ne comprennent plus où l'on va.", angle: 180 },
  { id: 5, text: 'Quelques personnes parlent, les autres décrochent.', angle: 240 },
  { id: 6, text: "Les transformations s'essoufflent après le lancement.", angle: 300 },
];

const benefits = [
  { icon: 'people', title: 'Des méthodes participatives', text: 'Pour impliquer vraiment les bonnes personnes.' },
  { icon: 'pencil', title: 'Une facilitation visuelle', text: "Pour rendre l'essentiel visible et partagé." },
  { icon: 'target', title: 'Des décisions claires', text: "Pour sortir de l'incertitude et choisir une direction." },
  { icon: 'trending', title: 'Des actions qui comptent', text: 'Pour transformer les décisions en résultats concrets.' },
];

// Coordonnées des 6 points sur un cercle de rayon 350 dans un viewBox
// 1000×1000 centré en (500,500) — 0° = haut, sens horaire.
const R = 350;
const CX = 500;
const CY = 500;
const pt = (angleDeg: number) => {
  const rad = (angleDeg * Math.PI) / 180;
  return { x: CX + R * Math.sin(rad), y: CY - R * Math.cos(rad) };
};
const points = situations.map((s) => pt(s.angle));
// Un seul tracé continu qui fait presque tout le tour, en partant juste
// après la rupture (entre situation 3 et situation 4) et en y revenant :
// c'est la boucle brisée, remplacée à cet endroit par la sortie jaune.
const BREAK_AFTER = 2; // rupture entre points[2] et points[3]
const order = [3, 4, 5, 0, 1, 2];
let ringPath = `M${points[order[0]].x.toFixed(1)},${points[order[0]].y.toFixed(1)} `;
for (let k = 0; k < order.length - 1; k++) {
  const b = points[order[k + 1]];
  ringPath += `A${R},${R} 0 0 1 ${b.x.toFixed(1)},${b.y.toFixed(1)} `;
}
---

<section class="loop-circle" data-reveal data-section-name="Vous tournez en rond ?">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">Le diagnostic</p>
        <h2 data-loop-title>Vous tournez en rond ?</h2>
      </div>
      <p data-loop-sub>Vous avez peut-être déjà vécu ça…</p>
    </div>

    <div class="loop-stage">
      <div class="loop-blob" aria-hidden="true"></div>

      <svg class="loop-ring" viewBox="0 0 1000 1000" aria-hidden="true">
        <circle class="loop-track" cx={CX} cy={CY} r={R} />
        <path class="loop-arc" data-loop-arc d={ringPath} />
      </svg>

      <div class="loop-beacon-orbit" data-loop-beacon aria-hidden="true">
        <span class="loop-beacon"></span>
      </div>

      <div class="loop-dots" aria-hidden="true">
        {situations.map((s) => (
          <span class="loop-dot" style={`--angle: ${s.angle};`}><span class="loop-dot-core"></span></span>
        ))}
      </div>

      <div class="loop-orbit">
        {situations.map((s) => (
          <div class="loop-node" style={`--angle: ${s.angle};`} data-loop-node={s.id}>
            <div class="loop-node-inner" data-loop-node-inner>
              <div class="loop-node-visual" style={`--angle: ${s.angle};`}>
                <p class="loop-node-text">
                  <span class="loop-node-index">0{s.id}</span>
                  {s.text}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <svg class="loop-exit" viewBox="0 0 1000 1000" aria-hidden="true" data-loop-exit>
        <defs>
          <marker id="loop-exit-arrowhead" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="var(--color-orange)" />
          </marker>
        </defs>
        <path
          class="loop-exit-path"
          data-loop-exit-path
          d={`M${points[2].x.toFixed(1)},${points[2].y.toFixed(1)} C ${(points[2].x + 140).toFixed(1)},${(points[2].y + 40).toFixed(1)} ${(points[2].x + 160).toFixed(1)},${(points[3].y - 60).toFixed(1)} ${(points[3].x + 40).toFixed(1)},${(points[3].y + 90).toFixed(1)}`}
          marker-end="url(#loop-exit-arrowhead)"
        />
      </svg>

      <p class="loop-handwritten" data-loop-handwritten>Et si on sortait de ce cercle ?</p>
    </div>

    <div class="loop-cta-wrap" data-loop-cta>
      <a href={withBase('/contact/')} class="btn">Sortons du cercle →</a>
    </div>

    <div class="loop-benefits" data-loop-benefits>
      {benefits.map((b) => (
        <div class="loop-benefit">
          <svg class="loop-benefit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add(
    {
      reduceMotion: '(prefers-reduced-motion: reduce)',
      fullMotion: '(prefers-reduced-motion: no-preference)',
    },
    (context) => {
      const { reduceMotion } = context.conditions ?? {};
      const section = document.querySelector<HTMLElement>('.loop-circle');
      if (!section) return;

      const title = section.querySelector('[data-loop-title]');
      const sub = section.querySelector('[data-loop-sub]');
      const arc = section.querySelector<SVGPathElement>('[data-loop-arc]');
      const exitPath = section.querySelector<SVGPathElement>('[data-loop-exit-path]');
      // On anime l'opacité de `.loop-node-inner`, jamais `.loop-node` (porte
      // le placement circulaire via transform, à ne jamais toucher) ni
      // `.loop-node-visual` (porte le pouls CSS infini indépendant) : le
      // moindre gsap.set({scale}) sur le mauvais élément casse soit le
      // placement, soit se fait immédiatement écraser par l'animation CSS.
      const nodeInners = gsap.utils.toArray<HTMLElement>('[data-loop-node-inner]');
      const beacon = section.querySelector('[data-loop-beacon]');
      const handwritten = section.querySelector('[data-loop-handwritten]');
      const ctaWrap = section.querySelector('[data-loop-cta]');
      const benefits = gsap.utils.toArray<HTMLElement>('.loop-benefit');

      if (arc) {
        const len = arc.getTotalLength();
        gsap.set(arc, { strokeDasharray: len, strokeDashoffset: reduceMotion ? 0 : len });
      }
      if (exitPath) {
        const len = exitPath.getTotalLength();
        gsap.set(exitPath, { strokeDasharray: len, strokeDashoffset: reduceMotion ? 0 : len });
      }

      if (reduceMotion) {
        // Tout est affiché immédiatement ; le signal tournant et les pouls
        // sont coupés (voir CSS) pour ne pas imposer de mouvement continu.
        gsap.set([title, sub, ...nodeInners, ...benefits], { opacity: 1, y: 0 });
        if (handwritten) gsap.set(handwritten, { opacity: 1 });
        if (ctaWrap) gsap.set(ctaWrap, { opacity: 1, y: 0 });
        return;
      }

      gsap.set(title, { opacity: 0, y: 16 });
      gsap.set(sub, { opacity: 0, y: 12 });
      gsap.set(nodeInners, { opacity: 0 });
      gsap.set(benefits, { opacity: 0, y: 20 });
      if (beacon) gsap.set(beacon, { opacity: 0 });
      if (handwritten) gsap.set(handwritten, { opacity: 0 });
      if (ctaWrap) gsap.set(ctaWrap, { opacity: 0, y: 12 });

      // Révélation ponctuelle une seule fois au scroll. Pas de pin ni de
      // scrub ici : le signal qui tourne en continu (CSS, toujours actif
      // une fois la section révélée) porte à lui seul la métaphore de la
      // boucle sans fin — bloquer le scroll par-dessus serait redondant.
      const tl = gsap.timeline({
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      tl.to(title, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' })
        .to(sub, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.25');

      if (arc) {
        tl.to(arc, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, '-=0.1');
      }
      tl.to(nodeInners, { opacity: 1, duration: 0.4, stagger: 0.08, ease: 'power1.out' }, '-=0.9');

      if (exitPath) {
        tl.to(exitPath, { strokeDashoffset: 0, duration: 0.7, ease: 'power2.out' }, '-=0.1');
      }
      if (handwritten) {
        tl.to(handwritten, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      if (ctaWrap) {
        tl.to(ctaWrap, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, '-=0.2');
      }
      if (beacon) {
        tl.to(beacon, { opacity: 1, duration: 0.5, ease: 'power2.out' }, '-=0.3');
      }
      tl.to(benefits, { opacity: 1, y: 0, duration: 0.5, stagger: 0.1, ease: 'power2.out' }, '-=0.1');

      return () => {
        tl.scrollTrigger?.kill();
        tl.kill();
      };
    }
  );
</script>

<style>
  .loop-circle {
    /* Section volontairement toujours claire, indépendamment du thème :
       les traits fins et le texte navy sur crème perdent tout contraste
       une fois les tokens inversés en mode sombre. */
    --color-navy: #122033;
    --color-cream: #fcf8ef;
    --color-surface: #fffdfa;
    --color-ink: #122033;
    --color-muted: #4c5158;
    --color-faint: #4c5158;
    --color-border: #cfc3b1;
    --shadow-sm: 0 12px 30px rgba(18, 32, 51, 0.08);
    --shadow-md: 0 26px 80px rgba(18, 32, 51, 0.12);
    padding: var(--space-16) 0;
    background: var(--color-cream);
    color: var(--color-ink);
    overflow: hidden;
  }

  .loop-stage {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 1;
    margin: 0 auto;
    --radius: clamp(160px, 24vw, 224px);
  }

  /* Tache respirante au centre : pas d'image, juste un dégradé flou qui
     pulse doucement — évoque le "flou" du problème sans l'illustrer. */
  .loop-blob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(90px, 14vw, 150px);
    height: clamp(90px, 14vw, 150px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-navy) 16%, transparent), transparent 72%);
    filter: blur(6px);
    animation: loop-breathe 5s ease-in-out infinite;
  }

  .loop-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .loop-track {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.5;
  }
  .loop-arc {
    fill: none;
    stroke: var(--color-navy);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.85;
  }

  /* Signal qui tourne en continu autour de l'anneau — jamais scroll-gaté
     une fois révélé : c'est la preuve visuelle, littérale, que ça tourne
     en rond, plutôt qu'une simple affirmation en toutes lettres. */
  .loop-beacon-orbit {
    position: absolute;
    inset: 0;
    animation: loop-spin 13s linear infinite;
  }
  .loop-beacon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--color-orange) 22%, transparent),
      0 0 16px 3px color-mix(in srgb, var(--color-orange) 55%, transparent);
    transform: translateY(calc(-1 * var(--radius)));
  }

  .loop-dots {
    position: absolute;
    inset: 0;
  }
  .loop-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(calc(var(--angle) * 1deg)) translateY(calc(-1 * var(--radius)));
  }
  .loop-dot-core {
    position: absolute;
    top: 0;
    left: 0;
    width: 7px;
    height: 7px;
    margin: -3.5px;
    border-radius: 50%;
    background: var(--color-navy);
    display: block;
    animation: loop-pulse 13s ease-in-out infinite;
    animation-delay: calc(var(--angle) / 360 * -13s);
  }

  .loop-orbit {
    position: absolute;
    inset: 0;
  }
  .loop-node {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(calc(var(--angle) * 1deg)) translateY(calc(-1 * (var(--radius) + 30px)));
  }
  .loop-node-inner {
    position: absolute;
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--angle) * 1deg));
    width: 180px;
  }
  .loop-node-visual {
    animation: loop-pulse 13s ease-in-out infinite;
    animation-delay: calc(var(--angle) / 360 * -13s);
  }
  .loop-node-text {
    margin: 0;
    text-align: center;
    line-height: 1.35;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
  }
  .loop-node-index {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-orange-ink);
    margin-bottom: 0.3em;
  }

  @keyframes loop-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes loop-pulse {
    0%, 88%, 100% {
      opacity: 0.42;
      transform: scale(0.96);
    }
    4% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  .loop-dot-core {
    transform-origin: center;
  }
  @keyframes loop-breathe {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.75;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.18);
      opacity: 1;
    }
  }

  .loop-exit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .loop-exit-path {
    fill: none;
    stroke: var(--color-orange);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .loop-handwritten {
    position: absolute;
    right: 2%;
    bottom: 4%;
    max-width: 200px;
    margin: 0;
    font-family: var(--font-script);
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    color: var(--color-orange-ink);
    text-align: right;
    transform: rotate(-2deg);
  }

  .loop-cta-wrap {
    text-align: center;
    margin-top: var(--space-10);
  }

  .loop-benefits {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .loop-benefit {
    text-align: center;
  }
  .loop-benefit-icon {
    display: block;
    width: 32px;
    height: 32px;
    margin: 0 auto var(--space-3);
    color: var(--color-orange-ink);
  }
  .loop-benefit h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-base);
  }
  .loop-benefit p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .loop-stage {
      --radius: clamp(120px, 20vw, 170px);
    }
    .loop-node {
      transform: rotate(calc(var(--angle) * 1deg)) translateY(calc(-1 * (var(--radius) + 22px)));
    }
    .loop-node-inner {
      width: 140px;
    }
    .loop-node-text {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 768px) {
    .loop-benefits {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- Sous 480px : le cercle devient trop serré, on bascule en liste
     verticale — même contenu, même esprit de répétition, disposition en
     colonne avec le signal tournant retiré (il n'a plus de piste à suivre)
     et la sortie jaune en bas. --- */
  @media (max-width: 480px) {
    .loop-stage {
      aspect-ratio: auto;
      max-width: 360px;
    }
    .loop-blob,
    .loop-ring,
    .loop-beacon-orbit,
    .loop-dots,
    .loop-exit {
      display: none;
    }
    .loop-orbit {
      position: static;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
    }
    .loop-node {
      position: static;
      width: auto;
      height: auto;
      transform: none !important;
    }
    .loop-node-inner {
      position: static;
      transform: none !important;
      width: auto;
    }
    .loop-node::after {
      content: '';
      display: block;
      width: 2px;
      height: 24px;
      margin: var(--space-2) auto 0;
      background: var(--color-navy);
      opacity: 0.35;
    }
    .loop-node:last-of-type::after {
      display: none;
    }
    .loop-handwritten {
      position: static;
      text-align: center;
      max-width: none;
      margin: var(--space-6) 0 0;
      transform: none;
    }
    .loop-cta-wrap {
      margin-top: var(--space-6);
    }
    .loop-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-arc,
    .loop-exit-path {
      stroke-dashoffset: 0 !important;
    }
    .loop-blob,
    .loop-beacon-orbit {
      animation: none !important;
    }
    .loop-beacon-orbit {
      opacity: 0 !important;
    }
    .loop-dot-core,
    .loop-node-visual {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
