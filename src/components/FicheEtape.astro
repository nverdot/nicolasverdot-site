---
/**
 * Une fiche d'etape du parcours IA : porte d'entree ou format pour les equipes.
 * Sortie de la page /accompagnement-ia-pme/ quand celle-ci a eu deux listes a
 * afficher avec la meme mise en forme.
 */
interface Etape {
  id: string;
  badge: string;
  phase: string;
  nom: string;
  duree: string;
  pourQui: string;
  resultat: string;
  promesse: string;
  contenu: string[];
  livrables: string[];
  preuve: string;
  deroule: string[][];
  prix?: string;
  inclus?: string;
  objectifs?: string[];
  prerequis?: string;
}

interface Props {
  e: Etape;
}

const { e } = Astro.props;
---

<li class="etape" id={e.id}>
  <div class="etape-rail" aria-hidden="true">
    <span class="etape-num">{e.badge}</span>
  </div>
  <article class="etape-carte">
    <header class="etape-tete">
      <p class="etape-phase">{e.phase}</p>
      <h3>{e.nom}</h3>
      <p class="etape-resultat">{e.resultat}</p>
      <ul class="etape-meta">
        <li><span>Durée</span> {e.duree}</li>
        <li><span>Tarif</span> {e.prix ?? 'Sur devis'}</li>
      </ul>
    </header>

    {e.inclus && <p class="etape-inclus"><strong>Compris dans le prix.</strong> {e.inclus}</p>}
    <p class="etape-pourqui"><strong>Pour qui.</strong> {e.pourQui}</p>
    <p class="etape-promesse">{e.promesse}</p>

    <div class="etape-cols">
      <div>
        <p class="etape-label">Ce qu'on y fait</p>
        <ul class="etape-liste">
          {e.contenu.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div>
        <p class="etape-label">Ce que vous gardez</p>
        <ul class="etape-liste etape-livrables">
          {e.livrables.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </div>

    {e.objectifs && (
      <div class="etape-objectifs">
        <p class="etape-label">Objectifs — chaque participant sera capable de</p>
        <ul class="etape-liste">
          {e.objectifs.map((o) => <li>{o}</li>)}
        </ul>
        {e.prerequis && <p class="etape-prerequis"><strong>Prérequis.</strong> {e.prerequis}</p>}
      </div>
    )}

    <p class="etape-preuve"><strong>Comment on sait que c'est réussi.</strong> {e.preuve}</p>

    <details class="etape-deroule">
      <summary>Le déroulé</summary>
      <dl>
        {e.deroule.map(([quand, quoi]) => (
          <>
            <dt>{quand}</dt>
            <dd>{quoi}</dd>
          </>
        ))}
      </dl>
    </details>
  </article>
</li>

<style>
  .etape {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr);
    gap: var(--space-4);
    scroll-margin-top: 110px;
  }
  .etape-rail {
    position: relative;
    display: flex;
    justify-content: center;
  }
  /* Le fil vertical qui prolonge le chemin du haut de page. */
  .etape:not(:last-child) .etape-rail::after {
    content: '';
    position: absolute;
    top: 46px;
    bottom: calc(-1 * var(--space-8));
    width: 3px;
    background: var(--color-orange);
    border-radius: 2px;
  }
  .etape-num {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-orange);
    color: #122033;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
  }
  .etape-carte {
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border), var(--shadow-sm);
  }
  .etape-phase {
    margin: 0 0 var(--space-1);
    color: var(--color-clay-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .etape-tete h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl, 1.6rem);
  }
  .etape-resultat {
    margin: 0 0 var(--space-4);
    color: var(--color-navy);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .etape-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  .etape-meta li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-cream);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-navy);
    font-weight: 700;
  }
  .etape-meta span {
    margin-right: var(--space-1);
    color: var(--color-muted);
    font-weight: 400;
  }
  .etape-inclus {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-muted);
  }
  .etape-inclus strong,
  .etape-prerequis strong {
    color: var(--color-navy);
  }
  .etape-objectifs {
    margin: 0 0 var(--space-6);
  }
  .etape-prerequis {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
  }
  .etape-pourqui,
  .etape-promesse {
    margin: 0 0 var(--space-4);
    color: var(--color-muted);
  }
  .etape-pourqui strong {
    color: var(--color-navy);
  }
  .etape-promesse {
    color: var(--color-navy);
  }
  .etape-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin: var(--space-6) 0;
  }
  .etape-label {
    margin: 0 0 var(--space-3);
    color: var(--color-blue);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .etape-liste {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-muted);
  }
  .etape-liste li {
    margin-bottom: var(--space-2);
  }
  .etape-livrables {
    padding-left: 0;
    list-style: none;
  }
  .etape-livrables li {
    position: relative;
    padding-left: 1.6rem;
  }
  .etape-livrables li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-clay);
    font-weight: 800;
  }
  .etape-preuve {
    margin: 0 0 var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    box-shadow: inset 3px 0 0 var(--color-blue);
    color: var(--color-muted);
  }
  .etape-preuve strong {
    color: var(--color-navy);
  }
  .etape-deroule summary {
    cursor: pointer;
    color: var(--color-blue);
    font-weight: 700;
  }
  .etape-deroule dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
  }
  .etape-deroule dt {
    color: var(--color-navy);
    font-weight: 700;
  }
  .etape-deroule dd {
    margin: 0;
    color: var(--color-muted);
  }


  @media (max-width: 640px) {
    .etape {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .etape-rail {
      justify-content: flex-start;
    }
    .etape:not(:last-child) .etape-rail::after {
      display: none;
    }
    .etape-carte {
      padding: var(--space-6) var(--space-4);
    }
    .etape-cols {
      grid-template-columns: minmax(0, 1fr);
    }
    .etape-deroule dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .etape-deroule dd {
      margin-bottom: var(--space-2);
    }
  }
</style>
