---
import { getCollection } from 'astro:content';
import { withBase } from '../utils/url';
import { factsheetIcon } from '../utils/factsheetIcons';
import { findPriorityByHref } from '../data/priorities';
import Lightbox from './Lightbox.astro';

const entries = await getCollection('caseStudies', ({ data }) => !data.draft);
const caseStudies = await Promise.all(
  entries.map(async (cs) => ({
    cs,
    Content: (await cs.render()).Content,
    relatedPriority: cs.data.offerHref ? findPriorityByHref(cs.data.offerHref) : undefined,
  }))
);
---

{caseStudies.map(({ cs, Content, relatedPriority }) => (
  <div
    class="case-modal"
    id={`case-modal-${cs.slug}`}
    data-case-modal={cs.slug}
    role="dialog"
    aria-modal="true"
    aria-labelledby={`case-modal-title-${cs.slug}`}
    hidden
  >
    <div class="case-modal-inner">
      <div class="case-modal-header">
        <button type="button" class="case-modal-close" data-case-modal-close aria-label="Fermer">✕</button>
        {cs.data.clientLogo && <img src={withBase(cs.data.clientLogo)} alt={cs.data.client} class="case-modal-logo" />}
        <p class="case-modal-eyebrow">Cas client — {cs.data.client}</p>
        <h2 id={`case-modal-title-${cs.slug}`}>{cs.data.title}</h2>
        <p class="case-modal-subtitle">{cs.data.subtitle}</p>

        {relatedPriority && (
          <a class="case-modal-offer-tag" href={withBase(cs.data.offerHref!)}>
            # {relatedPriority.title}
          </a>
        )}

        {cs.data.factsheet && cs.data.factsheet.length > 0 && (
          <dl class="case-modal-factsheet">
            {cs.data.factsheet.map((item) => (
              <div class="case-modal-factsheet-item">
                <dt><span aria-hidden="true">{factsheetIcon(item.label)}</span> {item.label}</dt>
                <dd>
                  {item.href ? <a href={item.href} target="_blank" rel="noopener noreferrer">{item.value}</a> : item.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
      <div class="case-modal-body">
        <div class="case-modal-question">
          <p>{cs.data.question}</p>
        </div>
        <div class="case-modal-content" data-lightbox-scope>
          <Content />
        </div>
        <a class="btn" href={withBase('/cas-clients/')}>Voir les autres cas clients →</a>
      </div>
    </div>
  </div>
))}

<Lightbox />

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-case-study-trigger]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-case-modal]'));

  // Certains cas clients regroupent plusieurs missions distinctes (cf.
  // Ressources : formation des formateurs / posture DSI / organisation RH-
  // finance), chacune structurée en <h2>mission</h2> puis des <h3> internes
  // (Le contexte, Le défi...). Un cas client à mission unique peut très bien
  // avoir lui aussi des <h3> (cf. Louis Vuitton : "Construire le bon
  // processus" etc., tous à l'intérieur d'une seule section "L'accompagnement
  // proposé") — la simple présence de <h3> ne suffit donc pas à distinguer
  // les deux cas. Le vrai signal : dans un cas multi-missions, le motif
  // <h2>+<h3> se répète sous au moins deux <h2> différents ; dans un cas à
  // mission unique, les <h3> ne vivent que sous une seule section.
  function setupMissionTabs(content: HTMLElement) {
    const h2s = Array.from(content.children).filter((el): el is HTMLElement => el.tagName === 'H2');
    if (h2s.length < 2) return;

    // Un <h2> ne compte comme "mission" que s'il a son propre <h3> interne —
    // un <h2> de clôture partagée (ex. "Une facilitation neutre...", "En
    // bref") n'en a pas et doit rester visible sous les onglets, pas devenir
    // un onglet de plus ni se faire avaler par le dernier onglet.
    const missionH2s = h2s.filter((h2, i) => {
      const nextH2 = h2s[i + 1];
      let node = h2.nextElementSibling;
      while (node && node !== nextH2) {
        if (node.tagName === 'H3') return true;
        node = node.nextElementSibling;
      }
      return false;
    });
    if (missionH2s.length < 2) return;

    const modalRoot = content.closest<HTMLElement>('[data-case-modal]');
    const slug = modalRoot?.dataset.caseModal ?? 'x';
    const tabs = document.createElement('div');
    tabs.className = 'case-tabs';
    tabs.setAttribute('role', 'tablist');

    // Marqueur stable inséré avant la première mission : les panneaux
    // reconstruits viendront s'insérer juste devant lui, ce qui laisse tout
    // contenu de clôture après la dernière mission exactement à sa place
    // d'origine plutôt qu'avalé ou repoussé en fin de document.
    const anchor = document.createComment('case-mission-anchor');
    content.insertBefore(anchor, missionH2s[0]);

    const missions = missionH2s.map((h2, i) => {
      const label = (h2.textContent || '').trim();
      const panel = document.createElement('div');
      panel.className = 'case-mission';
      panel.id = `case-mission-${slug}-${i}`;
      panel.setAttribute('role', 'tabpanel');
      panel.hidden = i !== 0;

      // La borne de fin est le prochain <h2> de la liste COMPLÈTE (mission
      // ou non) — pas le prochain missionH2 — pour que le contenu s'arrête
      // bien à la prochaine section de clôture le cas échéant.
      const nextH2 = h2s[h2s.indexOf(h2) + 1];
      let node: ChildNode | null = h2.nextSibling;
      while (node && node !== nextH2) {
        const next: ChildNode | null = node.nextSibling;
        panel.appendChild(node);
        node = next;
      }
      h2.remove();
      return { label, panel };
    });

    missions.forEach(({ label, panel }, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'case-tab';
      btn.id = `case-tab-${slug}-${i}`;
      btn.textContent = label;
      btn.title = label;
      btn.setAttribute('role', 'tab');
      btn.setAttribute('aria-selected', String(i === 0));
      btn.setAttribute('aria-controls', panel.id);
      panel.setAttribute('aria-labelledby', btn.id);
      btn.addEventListener('click', () => {
        missions.forEach((m, j) => {
          m.panel.hidden = j !== i;
        });
        Array.from(tabs.children).forEach((b, j) => b.setAttribute('aria-selected', String(j === i)));
        content.closest<HTMLElement>('.case-modal-inner')?.scrollTo({ top: 0 });
      });
      tabs.appendChild(btn);
    });

    // Les onglets vivent dans le bandeau sombre (à côté du titre), pas dans
    // le corps clair : ils servent à naviguer entre missions, pas à lire du
    // contenu — leur place est avec le reste de la navigation du panneau.
    const header = modalRoot?.querySelector<HTMLElement>('.case-modal-header');
    (header ?? content).appendChild(tabs);
    missions.forEach(({ panel }) => content.insertBefore(panel, anchor));
    anchor.remove();
  }

  document.querySelectorAll<HTMLElement>('.case-modal-content').forEach(setupMissionTabs);

  if (triggers.length && panels.length) {
    // Même raison que le panneau d'expertise : sortir les panneaux du flux
    // de la section pour échapper au containing block créé par un ancêtre
    // data-reveal animé (transform au repos).
    panels.forEach((panel) => document.body.appendChild(panel));

    let activeSlug: string | null = null;
    let lastFocused: HTMLElement | null = null;

    function closeActive() {
      if (!activeSlug) return;
      const panel = panels.find((p) => p.dataset.caseModal === activeSlug);

      if (panel) {
        panel.removeAttribute('data-open');
        const onEnd = (e: TransitionEvent) => {
          if (e.target !== panel) return;
          panel.hidden = true;
          panel.removeEventListener('transitionend', onEnd);
        };
        panel.addEventListener('transitionend', onEnd);
      }

      document.body.classList.remove('case-modal-lock-scroll');
      activeSlug = null;
      lastFocused?.focus();
    }

    function openPanel(slug: string, trigger: HTMLAnchorElement) {
      if (activeSlug === slug) {
        closeActive();
        return;
      }
      if (activeSlug) closeActive();

      const panel = panels.find((p) => p.dataset.caseModal === slug);
      if (!panel) return;

      lastFocused = trigger;
      panel.hidden = false;
      void panel.offsetHeight;
      panel.setAttribute('data-open', '');
      document.body.classList.add('case-modal-lock-scroll');

      activeSlug = slug;
      panel.querySelector<HTMLElement>('[data-case-modal-close]')?.focus();
    }

    triggers.forEach((trigger) => {
      const slug = trigger.dataset.caseStudyTrigger;
      if (!slug || !panels.some((p) => p.dataset.caseModal === slug)) return;
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openPanel(slug, trigger);
      });
    });

    panels.forEach((panel) => {
      panel.querySelector('[data-case-modal-close]')?.addEventListener('click', closeActive);
      const inner = panel.querySelector<HTMLElement>('.case-modal-inner');
      panel.addEventListener('click', (e) => {
        if (inner && !inner.contains(e.target as Node)) closeActive();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeSlug) closeActive();
    });
  }
</script>

<style is:global>
  body.case-modal-lock-scroll {
    overflow: hidden;
  }
  /* Astro n'expanse pas :global() imbriqué dans :has() — cette règle doit
     donc vivre dans un bloc is:global plutôt que dans le <style> scopé
     ci-dessous, sans quoi le sélecteur compilé reste invalide et le
     navigateur l'ignore silencieusement. */
  .case-modal-header:has(.case-tabs) {
    padding-bottom: 0;
  }
</style>

<style>
  .case-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background: rgba(11, 22, 39, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease-out;
  }
  .case-modal[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  .case-modal-inner {
    background: var(--color-surface);
    color: var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 720px;
    max-height: 85vh;
    overflow-y: auto;
    transform: scale(0.95);
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .case-modal[data-open] .case-modal-inner {
    transform: scale(1);
  }

  .case-modal-header {
    position: relative;
    background: var(--color-ink-solid);
    color: var(--color-white);
    padding: var(--space-6);
  }
  .case-modal-body {
    padding: var(--space-6);
  }
  /* Pas de filtre monochrome : brightness(0)+invert(1) aplatit tout logo à
     plusieurs tons (ex. LaMAREC, texte blanc sur forme colorée) en une
     silhouette blanche illisible, et rend carrément invisible un logo à
     fond opaque (ex. CEC, sans transparence) puisque fond et marque
     deviennent alors identiques. Un badge blanc affiche chaque logo dans
     ses couleurs d'origine, quel que soit son fond source. */
  .case-modal-logo {
    display: block;
    height: 28px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    margin-bottom: var(--space-3);
    padding: 6px 10px;
    background: var(--color-white);
    border-radius: var(--radius-sm);
  }
  .case-modal-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    font-size: var(--text-sm);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }
  .case-modal-close:hover {
    background: rgba(255, 255, 255, 0.24);
  }
  .case-modal-close:active {
    transform: scale(0.94);
  }
  .case-modal-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-orange);
    margin: 0 0 var(--space-1);
  }
  .case-modal-header h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
    color: var(--color-white);
    padding-right: var(--space-8);
  }
  .case-modal-subtitle {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-sm);
  }
  .case-modal-offer-tag {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: var(--space-2);
    padding: 4px var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease-out, color 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .case-modal-offer-tag:hover {
      background: rgba(255, 255, 255, 0.2);
      color: var(--color-white);
    }
  }
  .case-modal-factsheet {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-3) var(--space-4);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  .case-modal-factsheet-item dt {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 2px;
  }
  .case-modal-factsheet-item dd {
    margin: 0;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.4;
  }
  .case-modal-factsheet-item dd a {
    color: var(--color-white);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
  }
  .case-modal-question {
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    margin: 0 0 var(--space-6);
  }
  .case-modal-question p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-navy);
    line-height: 1.4;
  }
  .case-modal-content {
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }
  .case-modal-content :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
  }
  .case-modal-content :global(h3) {
    font-size: var(--text-base);
    color: var(--color-ink);
    margin-top: var(--space-4);
  }
  .case-modal-content :global(blockquote) {
    margin: var(--space-3) 0;
    padding-left: var(--space-3);
    border-left: 3px solid var(--color-orange);
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-navy);
    font-style: italic;
  }
  .case-modal-content :global(blockquote p) {
    margin: 0;
  }
  .case-modal-content :global(ul) {
    padding-left: var(--space-6);
  }
  .case-modal-content :global(li) {
    margin-bottom: var(--space-2);
  }
  .case-modal-content :global(p) {
    margin: 0 0 var(--space-3);
  }
  .case-modal-content :global(.case-gallery) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .case-modal-content :global(.case-gallery-wide) {
    margin: var(--space-4) 0;
  }
  .case-modal-content :global(.case-gallery figure),
  .case-modal-content :global(figure.case-gallery-wide) {
    margin: 0;
  }
  .case-modal-content :global(.case-gallery img),
  .case-modal-content :global(.case-gallery-wide img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    cursor: zoom-in;
    transition: opacity 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .case-modal-content :global(.case-gallery img:hover),
    .case-modal-content :global(.case-gallery-wide img:hover) {
      opacity: 0.85;
    }
  }
  .case-modal-content :global(figcaption) {
    margin-top: var(--space-1);
    font-size: 0.7rem;
    color: var(--color-muted);
    font-style: italic;
  }
  @media (max-width: 480px) {
    .case-modal-content :global(.case-gallery) {
      grid-template-columns: 1fr;
    }
  }
  /* Quand des onglets sont présents, le bandeau perd son padding bas (règle
     dans le <style is:global> plus haut) : les onglets viennent se coller
     exactement à la charnière avec le corps clair, pour qu'ils aient l'air
     de vrais onglets de classeur plutôt que des puces flottantes. */
  .case-modal-header :global(.case-tabs) {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    margin-top: var(--space-4);
  }
  .case-modal-header :global(.case-tab) {
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    text-align: left;
    line-height: 1.3;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-bottom: none;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    transition: background-color 160ms ease-out, color 160ms ease-out;
    /* Libellés longs tronqués sur une seule ligne plutôt que d'empiler le
       texte dans la pastille — garde les onglets compacts et lisibles,
       et augmente les chances qu'ils tiennent tous sur une seule ligne. */
    max-width: min(190px, 45vw);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (hover: hover) and (pointer: fine) {
    .case-modal-header :global(.case-tab:hover) {
      background: rgba(255, 255, 255, 0.16);
      color: rgba(255, 255, 255, 0.88);
    }
  }
  /* Même hauteur pour tous les onglets : c'est le conteneur (flush contre
     la charnière via padding-bottom:0 sur le bandeau) qui garantit que la
     dernière ligne touche le corps clair, quel que soit le nombre de
     lignes — robuste même quand des libellés longs forcent un retour à
     la ligne (ex. 3 onglets Air France-KLM). */
  .case-modal-header :global(.case-tab[aria-selected='true']) {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-navy);
  }
  @media (hover: hover) and (pointer: fine) {
    .case-modal-header :global(.case-tab[aria-selected='true']:hover) {
      background: var(--color-surface);
      color: var(--color-navy);
    }
  }
  .case-modal-content :global(.case-mission) {
    animation: case-mission-fade 200ms ease-out;
  }
  @keyframes case-mission-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
