---
/**
 * La barre d'onglets du téléphone : ce pour quoi l'on vient, sous le pouce.
 *
 * Portée depuis le site des Décoincés du Crayon, comme le Compagnon. Elle
 * n'existe qu'en dessous de 720 px. Chaque onglet est un vrai lien vers une
 * vraie page : Google les suit, le bouton retour fonctionne, et rien ne dépend
 * de JavaScript — sauf la case centrale, qui n'est qu'un repère sous le lanceur
 * du Compagnon (c'est lui, déplacé là par sa propre feuille de style, qui reste
 * le bouton).
 *
 * Quatre portes, pas huit. Le menu complet reste dans le burger de l'en-tête ;
 * la barre garde l'accueil (le point de départ de l'application, qui mène aux
 * explications et aux simulateurs), les offres, la preuve (les cas clients) et
 * la prise de contact.
 */
import { withBase } from '../utils/url';

// Même normalisation que dans l'en-tête : on compare sans le préfixe de base.
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');

const avant = [
  {
    href: '/',
    texte: 'Accueil',
    actif: currentPath === '/',
    trace: 'M4.5 11.2L12 5l7.5 6.2V19.5h-5v-5h-5v5h-5z',
  },
  {
    href: '/offres/',
    /* Les séminaires et la stratégie IA sont des offres : leurs pages
       allument cet onglet, pour qu'on sache toujours dans quelle partie
       de l'application l'on se trouve. */
    texte: 'Offres',
    actif:
      currentPath.startsWith('/offres/') ||
      currentPath.startsWith('/seminaire') ||
      currentPath === '/accompagnement-ia-pme/' ||
      currentPath === '/coaching-agile/' ||
      currentPath.startsWith('/formations/'),
    trace: 'M4.5 5h6v6h-6zM13.5 5h6v6h-6zM4.5 14h6v6h-6zM13.5 14h6v6h-6z',
  },
];

const apres = [
  {
    href: '/cas-clients/',
    texte: 'Cas clients',
    actif: currentPath.startsWith('/cas-clients/'),
    trace: 'M4 8h16v11H4zM9 8V6.2a1.2 1.2 0 0 1 1.2-1.2h3.6A1.2 1.2 0 0 1 15 6.2V8M4 12.5h16',
  },
  {
    href: '/contact/',
    texte: 'Contact',
    actif: currentPath === '/contact/',
    trace: 'M4 6.5h16v11H4zM4 8l8 5.5L20 8',
  },
];
---

<nav class="onglets" aria-label="Navigation rapide">
  {
    avant.map((o) => (
      <a href={withBase(o.href)} class="onglet" aria-current={o.actif ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d={o.trace} />
        </svg>
        <span>{o.texte}</span>
      </a>
    ))
  }

  {/* Le lanceur du Compagnon flotte au-dessus de cette case. Elle n'est pas un
      second bouton pour les lecteurs d'écran : le lanceur l'est déjà. */}
  <span class="onglet onglet--aide" aria-hidden="true" data-onglet-aide>
    <span>Aide</span>
  </span>

  {
    apres.map((o) => (
      <a href={withBase(o.href)} class="onglet" aria-current={o.actif ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d={o.trace} />
        </svg>
        <span>{o.texte}</span>
      </a>
    ))
  }
</nav>

<script>
  /* Le mot « Aide » sous le lanceur ouvre lui aussi le Compagnon : on vise le
     mot autant que le rond. */
  document.querySelector('[data-onglet-aide]')?.addEventListener('click', () => {
    (window as any).Compagnon?.ouvrir();
  });
</script>

<style is:global>
  .onglets {
    display: none;
  }

  @media (max-width: 719px) {
    .onglets {
      position: fixed;
      z-index: 40;
      inset-inline: 0;
      bottom: 0;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: 0.35rem 0.25rem calc(0.35rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--color-border);
      /* Opaque, comme l'en-tête : un flou d'arrière-plan sur un élément fixe
         coûte un recalcul à chaque image du défilement (voir Header.astro). */
      background: var(--color-surface);
    }

    /* La barre ne doit rien cacher : le bas de page glisse au-dessus. */
    body {
      padding-bottom: calc(4.2rem + env(safe-area-inset-bottom));
    }

    .onglet {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      gap: 0.2rem;
      min-height: 3.25rem;
      padding: 0.3rem 0.1rem 0.2rem;
      border-radius: var(--radius-sm);
      color: var(--color-muted);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: -0.01em;
      text-decoration: none;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .onglet span {
      max-width: 100%;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    /* Sous 360 px, « Cas clients » se resserre plutôt que de se faire couper. */
    @media (max-width: 359px) {
      .onglets {
        padding-inline: 0;
      }
      .onglet {
        padding-inline: 0;
        font-size: 0.75rem;
        letter-spacing: -0.02em;
      }
    }

    /*
     * L'onglet courant : le jaune se pose derrière la seule icône, pas sur
     * toute la case — en aplat plein, il ferait un second rond jaune à côté du
     * lanceur. L'ombre portée dessine le disque sans rien décaler. Le trait
     * reste en encre fixe : en mode sombre, l'encre du thème devient claire et
     * disparaîtrait sur le jaune.
     */
    .onglet[aria-current] {
      color: var(--color-navy);
    }
    .onglet[aria-current] svg {
      border-radius: var(--radius-pill);
      background: var(--color-orange);
      box-shadow: 0 0 0 7px var(--color-orange);
      color: var(--color-ink-solid);
      stroke-width: 2.2;
    }

    .onglet:focus-visible {
      outline: 3px solid var(--color-focus);
      outline-offset: -3px;
    }

    .onglet--aide {
      color: var(--color-navy);
    }
  }
</style>
