---
import { withBase } from '../utils/url';
import { clients } from '../data/clients';
import CaseStudyModal from './CaseStudyModal.astro';
---

<section class="client-strip" data-reveal data-section-name="Logos clients">
  <div class="client-marquee">
    <div class="client-marquee-track">
      {[...clients, ...clients].map((c, i) => {
        /* alt vide dans un lien : c'est l'aria-label du lien qui nomme.
           Hors lien, le logo porte le nom du client comme d'habitude. */
        const inner = c.logo ? (
          <img src={withBase(c.logo)} alt={c.href ? '' : c.name} loading="lazy" />
        ) : (
          <span class="client-text">{c.name}</span>
        );
        return c.href ? (
          /* Le nom accessible d'un logo cliquable ne peut pas etre le seul nom
             du client : a l'oreille, « Air France KLM, lien » ne dit pas ou
             l'on atterrit. L'aria-label prend le relais du alt, qui passe donc
             a vide pour ne pas etre annonce deux fois. */
          <a
            class="client-item"
            href={c.href}
            data-case-study-trigger={c.caseStudySlug}
            aria-label={`${c.name} — voir le cas client`}
            aria-hidden={i >= clients.length ? 'true' : undefined}
            tabindex={i >= clients.length ? -1 : undefined}
          >
            {inner}
          </a>
        ) : (
          <span class="client-item" aria-hidden={i >= clients.length ? 'true' : undefined}>
            {inner}
          </span>
        );
      })}
    </div>
  </div>
</section>

<CaseStudyModal />

<style>
  .client-strip {
    padding: var(--space-8) 0;
  }
  .client-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .client-marquee-track {
    display: flex;
    width: max-content;
    gap: var(--space-12);
    animation: marquee-scroll 28s linear infinite;
  }
  /*
   * Un contenu qui bouge tout seul plus de cinq secondes doit pouvoir etre
   * arrete (WCAG 2.2.2). La pause au survol ne servait qu'a la souris.
   *
   *   - au clavier : `:focus-within` arrete le defilement des qu'un logo est
   *     atteint en tabulant, sinon la cible fuit sous le focus ;
   *   - au tactile : pas de survol possible, et une cible qui se deplace est
   *     penible a viser. On coupe donc l'animation et on rend la bande
   *     glissable au doigt — le visiteur la parcourt a son rythme.
   */
  .client-marquee:hover .client-marquee-track,
  .client-marquee:focus-within .client-marquee-track {
    animation-play-state: paused;
  }

  @media (hover: none) {
    .client-marquee {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .client-marquee::-webkit-scrollbar {
      display: none;
    }
    .client-marquee-track {
      animation: none;
    }
  }
  .client-item {
    display: flex;
    align-items: center;
    height: 52px;
    flex-shrink: 0;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
  }
  .client-item img {
    max-height: 100%;
    max-width: 130px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition: opacity var(--duration-standard) var(--ease-standard), filter var(--duration-standard) var(--ease-standard);
  }
  .client-marquee:hover .client-item img {
    filter: grayscale(0);
    opacity: 1;
  }
  /* La pastille est en `--color-white`, une constante qui reste claire au
     theme sombre : son encre doit l'etre aussi. Avec `--color-navy`, qui
     bascule en creme, les sept clients sans logo disparaissaient purement et
     simplement (1,08:1). */
  .client-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-ink-solid);
    opacity: 0.7;
    white-space: nowrap;
  }
</style>
