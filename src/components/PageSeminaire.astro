---
// Gabarit commun aux pages « une situation, un séminaire » : kick-off, CODIR,
// Sophia Antipolis. Même ossature que /seminaires-alpes-maritimes/ (classes
// de global.css), pour que ces pages se ressemblent sans dupliquer le balisage.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import CTABlock from './CTABlock.astro';
import ClientLogoStrip from './ClientLogoStrip.astro';
import { withBase } from '../utils/url';

interface Bloc {
  title: string;
  text: string;
}

interface Props {
  seo: { title: string; description: string; path: string; fil: string; serviceType: string; serviceName: string };
  /** Villes ou zones pour le schema.org Service (areaServed). */
  zones?: string[];
  hero: {
    eyebrow: string;
    title: string;
    titleAccent?: string;
    titleTail?: string;
    summary: string;
    pills: string[];
    /** Vraie photo de mission (chemin dans public/). Absente s'il n'y en a pas : jamais d'image générée. */
    photo?: { src: string; alt: string; legende?: string; portrait?: boolean };
  };
  signaux: { eyebrow: string; title: string; intro: string; items: Bloc[]; chute: string };
  resultats: { eyebrow: string; title: string; intro: string; items: Bloc[]; citation: string };
  etapes: { eyebrow: string; title: string; intro: string; items: Bloc[] };
  /** Déroulé d'une mission réelle, séquence par séquence. Tiré des préparations
      de séance : aucun nom de personne, rien qui ne soit pas arrivé. */
  exemple?: { eyebrow: string; title: string; intro: string; items: Bloc[]; note?: string; href?: string; link?: string };
  formats?: { eyebrow: string; title: string; intro: string; items: (Bloc & { href?: string; link?: string })[] };
  /** Slugs de cas clients réels à montrer. Jamais de cas inventé. */
  cas?: string[];
  casIntro?: string;
  /** Slugs d'articles du blog à relier. */
  articles?: string[];
  faq: { q: string; a: string }[];
  cta: { eyebrow: string; title: string; subtitle: string };
}

const { seo, zones = ['France'], hero, signaux, resultats, etapes, exemple, formats, cas = [], casIntro, articles = [], faq, cta } = Astro.props;

const casClients = (await getCollection('caseStudies', ({ data }) => !data.draft))
  .filter((c) => cas.includes(c.slug))
  .sort((a, b) => cas.indexOf(a.slug) - cas.indexOf(b.slug));

const lectures = (await getCollection('articles', ({ data }) => !data.draft))
  .filter((a) => articles.includes(a.slug))
  .sort((a, b) => articles.indexOf(a.slug) - articles.indexOf(b.slug));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: seo.serviceType,
  name: seo.serviceName,
  description: seo.description,
  provider: { '@type': 'Person', name: 'Nicolas Verdot', url: new URL(withBase('/a-propos/'), Astro.site).toString() },
  areaServed: zones.map((z) => ({ '@type': 'Place', name: z })),
  url: new URL(withBase(seo.path), Astro.site).toString(),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Layout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  breadcrumbs={[
    { name: 'Accueil', path: '/' },
    { name: "Séminaires d'entreprise", path: '/seminaires-entreprise/' },
    { name: seo.fil, path: seo.path },
  ]}
>
  <PageHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    titleAccent={hero.titleAccent}
    titleTail={hero.titleTail}
    summary={hero.summary}
    pills={hero.pills}
    photo={hero.photo}
  />

  <section class="section" data-reveal data-section-name="Votre situation">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{signaux.eyebrow}</p>
          <h2>{signaux.title}</h2>
        </div>
        <p>{signaux.intro}</p>
      </div>
      <div class="cards">
        {signaux.items.map((s) => (
          <article class="card">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
      <div class="callout-box">
        <p set:html={signaux.chute} />
      </div>
    </div>
  </section>

  <section class="section alt" data-reveal data-section-name="Ce que vous obtenez">
    <div class="container split">
      <div>
        <p class="eyebrow">{resultats.eyebrow}</p>
        <h2>{resultats.title}</h2>
        <p class="hero-copy">{resultats.intro}</p>
        <div class="checks">
          {resultats.items.map((r, i) => (
            <div class="check"><i>{i + 1}</i><div><strong>{r.title}</strong><br /><span class="muted">{r.text}</span></div></div>
          ))}
        </div>
      </div>
      <div class="quote">
        <blockquote>{resultats.citation}</blockquote>
        <cite>Nicolas Verdot — facilitateur de séminaires, Nice</cite>
      </div>
    </div>
  </section>

  <ClientLogoStrip />

  <section class="section" data-reveal data-section-name="Comment ça se passe">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{etapes.eyebrow}</p>
          <h2>{etapes.title}</h2>
        </div>
        <p>{etapes.intro}</p>
      </div>
      <div class="cards">
        {etapes.items.map((e, i) => (
          <article class="card">
            <div class="num">Étape {i + 1}</div>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </article>
        ))}
      </div>
      <p class="page-seminaire-more">Le détail de la méthode, les délais de préparation et la taille des groupes sont sur la page <a href={withBase('/seminaires-entreprise/')}>séminaires d'entreprise</a>.</p>
    </div>
  </section>

  {exemple && (
    <section class="section alt" data-reveal data-section-name="Un exemple réel">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{exemple.eyebrow}</p>
            <h2>{exemple.title}</h2>
          </div>
          <p>{exemple.intro}</p>
        </div>
        <div class="cards">
          {exemple.items.map((e, i) => (
            <article class="card">
              <div class="num">Séquence {i + 1}</div>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </article>
          ))}
        </div>
        {exemple.note && <p class="page-seminaire-more">{exemple.note} {exemple.href && <a href={withBase(exemple.href)}>{exemple.link} →</a>}</p>}
      </div>
    </section>
  )}

  {formats && (
    <section class={`section${exemple ? '' : ' alt'}`} data-reveal data-section-name="Formats">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{formats.eyebrow}</p>
            <h2>{formats.title}</h2>
          </div>
          <p>{formats.intro}</p>
        </div>
        <div class="cards">
          {formats.items.map((f) => (
            <article class="card">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              {f.href && <a class="card-link" href={withBase(f.href)}>{f.link}</a>}
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {casClients.length > 0 && (
    <section class="section" data-reveal data-section-name="Cas clients">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Missions réelles</p>
            <h2>Ce que ça a donné concrètement</h2>
          </div>
          {casIntro && <p>{casIntro}</p>}
        </div>
        <div class="cards">
          {casClients.map((c) => (
            <article class="card">
              {c.data.clientLogo ? (
                <img src={withBase(c.data.clientLogo)} alt={c.data.client} class="page-seminaire-logo" />
              ) : (
                <div class="num">{c.data.client}</div>
              )}
              <h3>{c.data.title}</h3>
              <p>{c.data.summary}</p>
              <a class="card-link" href={withBase(`/cas-clients/${c.slug}/`)}>Découvrir le cas client</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section alt" data-reveal data-section-name="Questions fréquentes">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Questions fréquentes</p>
          <h2>Avant de nous appeler</h2>
        </div>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  {lectures.length > 0 && (
    <section class="section" data-reveal data-section-name="Pour aller plus loin">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">Pour préparer le terrain</p>
            <h2>À lire avant de vous lancer</h2>
          </div>
        </div>
        <div class="cards">
          {lectures.map((a) => (
            <article class="card">
              <div class="num">{a.data.pillar}</div>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <a class="card-link" href={withBase(`/blog/${a.slug}/`)}>Lire l'article</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <CTABlock eyebrow={cta.eyebrow} title={cta.title} subtitle={cta.subtitle} ctaLabel="Réserver un échange de cadrage" dark />
</Layout>

<style>
  .muted {
    color: var(--color-muted);
  }
  .callout-box {
    margin-top: var(--space-8);
  }
  .page-seminaire-more {
    margin: var(--space-8) 0 0;
  }
  .page-seminaire-logo {
    display: block;
    height: 40px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    object-position: left center;
    margin-bottom: var(--space-4);
  }
</style>
