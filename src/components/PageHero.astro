---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  pills?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  tall?: boolean;
}

const { eyebrow, title, summary, pills = [], image, imageAlt = '', tall = false } = Astro.props;
---

<section class={`page-hero${image ? ' has-image' : ''}${tall ? ' is-tall' : ''}`} data-reveal>
  {image && (
    <>
      <Image src={image} alt="" role="presentation" widths={[640, 1200, 1920]} sizes="100vw" class="page-hero-bg" />
      <div class="page-hero-scrim" aria-hidden="true"></div>
    </>
  )}
  <div class="container page-hero-inner">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
    </div>
    <div>
      <p class="page-summary">{summary}</p>
      {pills.length > 0 && (
        <div class="meta-pills">
          {pills.map((pill) => <span>{pill}</span>)}
        </div>
      )}
    </div>
  </div>
  {image && imageAlt && <p class="visually-hidden">{imageAlt}</p>}
</section>

<style>
  .page-hero {
    padding: var(--space-16) 0 var(--space-8);
  }
  .page-hero.has-image {
    position: relative;
    overflow: hidden;
    padding: var(--space-24) 0 var(--space-16);
  }
  /* Section plus haute pour laisser respirer l'illustration : object-fit:cover
     recadre d'autant moins que la boîte se rapproche du ratio de l'image. */
  .page-hero.is-tall {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(520px, 68vh, 780px);
  }
  /* Un seul bloc de texte, empilé et pleine largeur, plutôt qu'un résumé
     étriqué dans une colonne étroite à droite du titre. */
  .page-hero.is-tall .page-hero-inner {
    display: block;
  }
  .page-hero.is-tall .page-summary {
    margin-top: var(--space-4);
    max-width: 56ch;
    font-size: var(--text-xl);
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .page-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(18, 32, 51, 0.15) 0%, rgba(18, 32, 51, 0.55) 100%);
    z-index: 1;
  }
  .page-hero.has-image .page-hero-inner {
    position: relative;
    z-index: 2;
  }
  .page-hero.has-image .eyebrow {
    color: var(--color-orange);
  }
  .page-hero.has-image h1,
  .page-hero.has-image .page-summary {
    color: var(--color-white);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .page-hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-12);
    align-items: end;
  }
  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
  }
  .page-summary {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin: 0;
  }
  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .meta-pills span {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .page-hero-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
