---
// Octobre 2026 : plus aucune illustration générée en fond. Le hero est
// typographique ; quand une vraie photo de mission existe, elle se pose à
// côté du texte, avec sa légende. Jamais de photo recréée.
interface Props {
  eyebrow: string;
  title: string;
  /** Mot ou groupe de mots accentué en script orange, comme sur le hero de l'accueil. */
  titleAccent?: string;
  /** Fin de phrase après l'accent (optionnel, requiert titleAccent). */
  titleTail?: string;
  /** Rendu via set:html : les <strong> y sont acceptés. Contenu toujours fourni par le développeur, jamais par un utilisateur. */
  summary: string;
  pills?: string[];
  /** Vraie photo (chemin dans public/), affichée à droite du texte. */
  photo?: { src: string; alt: string; legende?: string; portrait?: boolean };
}

const { eyebrow, title, titleAccent, titleTail, summary, pills = [], photo } = Astro.props;
---

<section class={`page-hero${photo ? ' has-photo' : ''}`} data-reveal>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      {titleAccent ? (
        <h1>
          {title}
          <span class="script-accent">{titleAccent}</span>
          {titleTail && <span class="hero-tail">{titleTail}</span>}
        </h1>
      ) : (
        <h1>{title}</h1>
      )}
      <p class="page-summary" set:html={summary} />
      {pills.length > 0 && (
        <div class="meta-pills">
          {pills.map((pill) => <span>{pill}</span>)}
        </div>
      )}
    </div>
    {photo && (
      <figure class={`hero-figure${photo.portrait ? ' is-portrait' : ''}`}>
        <img src={photo.src} alt={photo.alt} loading="eager" decoding="async" />
        {photo.legende && <figcaption>{photo.legende}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero-inner {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }
  .page-hero.has-photo .page-hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }
  .page-hero.has-photo .page-hero-copy {
    flex: 1 1 0;
    min-width: 0;
  }
  .script-accent {
    display: block;
    font-family: var(--font-script);
    font-weight: 700;
    color: var(--color-orange-ink);
    font-size: clamp(3.2rem, 6vw, 5rem);
    line-height: 1;
    margin: 0.15em 0;
  }
  .hero-tail {
    display: block;
  }
  .page-hero h1 {
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    color: var(--color-navy);
  }
  .page-summary {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .page-summary :global(strong) {
    color: var(--color-navy);
  }
  /* Une ligne de repères, pas des pastilles : voir la note dans global.css. */
  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .meta-pills span + span::before {
    content: '·';
    margin-right: var(--space-2);
    color: var(--color-clay);
  }
  /* Téléphone : le titre, le paragraphe, et la suite tout de suite. La photo
     repoussait la liste des rubriques hors de l'écran. */
  @media (max-width: 719px) {
    .page-hero.page-hero {
      padding: var(--space-6) 0;
    }
    .page-hero h1 {
      font-size: 1.7rem;
      line-height: 1.15;
    }
    .script-accent {
      font-size: 2.5rem;
    }
    .page-summary {
      font-size: var(--text-base);
    }
    .hero-figure,
    .meta-pills {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .page-hero {
      padding: var(--space-8) 0;
    }
    .page-hero.has-photo .page-hero-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
  }
</style>
