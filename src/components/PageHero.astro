---
import { dims } from '../utils/imageDims';
// Octobre 2026 : plus aucune illustration générée en fond. Le hero est
// typographique ; quand une vraie photo de mission existe, elle se pose à
// côté du texte, avec sa légende. Jamais de photo recréée.
interface Props {
  eyebrow: string;
  title: string;
  /** Mot ou groupe de mots surligné au feutre jaune, comme sur le hero de l'accueil. */
  titleAccent?: string;
  /** Fin de phrase après l'accent (optionnel, requiert titleAccent). */
  titleTail?: string;
  /** Rendu via set:html : les <strong> y sont acceptés. Contenu toujours fourni par le développeur, jamais par un utilisateur. */
  summary: string;
  pills?: string[];
  /** Vraie photo (chemin dans public/), affichée à droite du texte. */
  photo?: { src: string; alt: string; legende?: string; portrait?: boolean; width?: number; height?: number };
}

const { eyebrow, title, titleAccent, titleTail, summary, pills = [], photo } = Astro.props;
---

<section class={`page-hero${photo ? ' has-photo' : ''}`} data-reveal>
  <div class="page-hero-inner">
    <div class="page-hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      {titleAccent ? (
        <h1>
          {title}
          <span class="title-accent">{titleAccent}</span>
          {titleTail && <span class="hero-tail">{titleTail}</span>}
        </h1>
      ) : (
        <h1>{title}</h1>
      )}
      <p class="page-summary" set:html={summary} />
      {pills.length > 0 && (
        <div class="meta-pills">
          {pills.map((pill) => <span>{pill}</span>)}
        </div>
      )}
    </div>
    {photo && (
      <figure class={`hero-figure${photo.portrait ? ' is-portrait' : ''}`}>
        <img src={photo.src} alt={photo.alt} width={photo.width ?? dims(photo.src).width} height={photo.height ?? dims(photo.src).height} loading="eager" decoding="async" />
        {photo.legende && <figcaption>{photo.legende}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero {
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero-inner {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }
  .page-hero.has-photo .page-hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }
  .page-hero.has-photo .page-hero-copy {
    flex: 1 1 0;
    min-width: 0;
  }
  .page-summary {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    color: var(--color-muted);
  }
  .page-summary :global(strong) {
    color: var(--color-navy);
  }
  .meta-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .meta-pills span {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  @media (max-width: 900px) {
    .page-hero {
      padding: var(--space-8) 0;
    }
    .page-hero.has-photo .page-hero-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
    }
  }
</style>
