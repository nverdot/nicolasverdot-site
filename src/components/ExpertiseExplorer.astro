---
import { expertisePanels } from '../data/expertise';
import { withBase } from '../utils/url';
---

<div class="expertise-explorer">
  <div class="expertise-tags">
    {expertisePanels.map((p) => (
      <button
        type="button"
        class="expertise-tag"
        data-expertise-trigger={p.slug}
        aria-expanded="false"
        aria-controls={`expertise-panel-${p.slug}`}
      >
        {p.label}
        <span class="expertise-tag-icon" aria-hidden="true">+</span>
      </button>
    ))}
  </div>

  {expertisePanels.map((p) => (
    <div
      class="expertise-panel"
      id={`expertise-panel-${p.slug}`}
      data-expertise-panel={p.slug}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`expertise-panel-title-${p.slug}`}
      hidden
    >
      <div class="expertise-panel-inner">
        <button type="button" class="expertise-panel-close" data-expertise-close aria-label="Fermer">✕</button>
        <p class="expertise-panel-eyebrow">Expertise</p>
        <h4 id={`expertise-panel-title-${p.slug}`}>{p.label}</h4>
        <p class="expertise-panel-definition">{p.definition}</p>
        <p class="expertise-panel-description">{p.description}</p>

        <p class="expertise-panel-subhead">Utile pour</p>
        <ul class="expertise-panel-list">
          {p.usefulFor.map((u) => <li>{u}</li>)}
        </ul>

        <p class="expertise-panel-subhead">Manières de travailler ensemble</p>
        <div class="expertise-panel-approaches">
          {p.approaches.map((a) => (
            <div class="expertise-approach">
              <strong>{a.title}</strong>
              <span>{a.text}</span>
            </div>
          ))}
        </div>

        <div class="expertise-panel-actions">
          {p.actions.map((action, i) => (
            <a class={i === 0 ? 'btn' : 'btn-outline'} href={withBase(action.href)}>{action.label}</a>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  const explorer = document.querySelector<HTMLElement>('.expertise-explorer');

  if (explorer) {
    const triggers = Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-expertise-trigger]'));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-expertise-panel]'));

    // Déplacés en enfants directs de <body> : un ancêtre animé au scroll
    // (data-reveal, via GSAP) garde une transform au repos, ce qui crée un
    // "containing block" pour tout descendant en position:fixed — le
    // panneau se retrouvait alors positionné/empilé par rapport à cet
    // ancêtre plutôt que par rapport au viewport. Le sortir du flux de la
    // section évite le problème quelle que soit l'animation appliquée plus haut.
    panels.forEach((panel) => document.body.appendChild(panel));

    let activeSlug: string | null = null;
    let lastFocused: HTMLElement | null = null;

    function closeActive() {
      if (!activeSlug) return;
      const panel = panels.find((p) => p.dataset.expertisePanel === activeSlug);
      const trigger = triggers.find((t) => t.dataset.expertiseTrigger === activeSlug);

      if (panel) {
        panel.removeAttribute('data-open');
        const onEnd = (e: TransitionEvent) => {
          if (e.target !== panel) return;
          panel.hidden = true;
          panel.removeEventListener('transitionend', onEnd);
        };
        panel.addEventListener('transitionend', onEnd);
      }
      trigger?.setAttribute('aria-expanded', 'false');

      document.body.classList.remove('expertise-lock-scroll');
      activeSlug = null;
      lastFocused?.focus();
    }

    function openPanel(slug: string, trigger: HTMLButtonElement) {
      if (activeSlug === slug) {
        closeActive();
        return;
      }
      if (activeSlug) closeActive();

      const panel = panels.find((p) => p.dataset.expertisePanel === slug);
      if (!panel) return;

      lastFocused = trigger;
      panel.hidden = false;
      void panel.offsetHeight; // force reflow so the entrance transition plays
      panel.setAttribute('data-open', '');
      trigger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('expertise-lock-scroll');

      activeSlug = slug;
      panel.querySelector<HTMLElement>('[data-expertise-close]')?.focus();
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const slug = trigger.dataset.expertiseTrigger;
        if (slug) openPanel(slug, trigger);
      });
    });

    panels.forEach((panel) => {
      panel.querySelector('[data-expertise-close]')?.addEventListener('click', closeActive);
      const inner = panel.querySelector<HTMLElement>('.expertise-panel-inner');
      panel.addEventListener('click', (e) => {
        if (inner && !inner.contains(e.target as Node)) closeActive();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeSlug) closeActive();
    });
  }
</script>

<style is:global>
  body.expertise-lock-scroll {
    overflow: hidden;
  }
</style>

<style>
  .expertise-explorer {
    position: relative;
  }
  .expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .expertise-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 160ms ease-out, transform 160ms ease-out, color 160ms ease-out, border-color 160ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .expertise-tag:hover {
      background: rgba(255, 255, 255, 0.22);
    }
  }
  .expertise-tag:active {
    transform: scale(0.97);
  }
  .expertise-tag[aria-expanded='true'] {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: var(--color-ink-solid);
  }
  .expertise-tag-icon {
    font-size: 0.85em;
    opacity: 0.75;
    transition: transform 200ms ease-out;
  }
  .expertise-tag[aria-expanded='true'] .expertise-tag-icon {
    transform: rotate(45deg);
  }

  /* Même traitement partout : une vraie boîte de dialogue centrée sur un
     fond assombri, plutôt qu'un popover ancré au clic (desktop) ou un
     tiroir (mobile). .expertise-panel est la couche plein viewport (fond
     assombri inclus) qui centre la carte visible via flexbox ; c'est
     .expertise-panel-inner qui porte le fond clair/l'ombre/le scroll. */
  .expertise-panel {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background: rgba(11, 22, 39, 0.6);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease-out;
  }
  .expertise-panel[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  .expertise-panel-inner {
    background: var(--color-surface);
    color: var(--color-ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 560px;
    max-height: 85vh;
    overflow-y: auto;
    padding: var(--space-6);
    transform: scale(0.95);
    transition: transform 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .expertise-panel[data-open] .expertise-panel-inner {
    transform: scale(1);
  }

  .expertise-panel-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-cream);
    color: var(--color-navy);
    font-size: var(--text-sm);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }
  .expertise-panel-close:hover {
    background: var(--color-border);
  }
  .expertise-panel-close:active {
    transform: scale(0.94);
  }

  .expertise-panel-eyebrow {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-orange-ink);
    margin: 0 0 var(--space-1);
  }
  .expertise-panel h4 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
    font-family: var(--font-display);
    color: var(--color-navy);
    padding-right: var(--space-8);
  }
  .expertise-panel-definition {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-navy);
    line-height: 1.4;
    margin: 0 0 var(--space-3);
  }
  .expertise-panel-description {
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }
  .expertise-panel-subhead {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 var(--space-3);
  }
  .expertise-panel-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  .expertise-panel-list li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }
  .expertise-panel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange-ink);
  }
  .expertise-panel-approaches {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
  }
  .expertise-approach {
    display: grid;
    gap: var(--space-1);
  }
  .expertise-approach strong {
    font-size: var(--text-sm);
    color: var(--color-navy);
  }
  .expertise-approach span {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.5;
  }
  .expertise-panel-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .expertise-panel-actions .btn,
  .expertise-panel-actions .btn-outline {
    text-align: center;
  }

  @media (max-width: 560px) {
    .expertise-panel-list {
      grid-template-columns: 1fr;
    }
  }
</style>
