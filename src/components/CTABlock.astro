---
import { SITE } from '../data/site';
import { withBase } from '../utils/url';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  dark?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  dark = false,
  ctaLabel = 'Prendre rendez-vous',
  ctaHref = SITE.bookingUrl,
  secondaryLabel = 'Envoyer un message',
  secondaryHref = withBase('/contact/'),
} = Astro.props;
const ctaExternal = ctaHref === SITE.bookingUrl;
---

<section data-reveal data-section-name="CTA final">
  <div class:list={['container', 'banner', { dark }]}>
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    <div class="banner-actions">
      <a href={ctaHref} class="btn" target={ctaExternal ? '_blank' : undefined} rel={ctaExternal ? 'noopener' : undefined}>{ctaLabel}</a>
      <a href={secondaryHref} class="btn-outline">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .banner .btn-outline {
    color: var(--color-ink-solid);
    box-shadow: inset 0 0 0 1.5px rgba(18, 32, 51, 0.3);
    background: transparent;
  }
  .banner .btn-outline:hover {
    background: var(--color-ink-solid);
    color: var(--color-white);
    box-shadow: none;
  }

  /* Variante "dark" : fond bleu nuit sobre, pour le CTA final de la home
     (le style jaune par défaut sert aux CTA intermédiaires ailleurs sur
     le site — cette variante ne les affecte pas). */
  .banner.dark {
    background: var(--color-ink-solid);
  }
  .banner.dark h2,
  .banner.dark p {
    color: var(--color-white);
  }
  .banner.dark .eyebrow {
    color: var(--color-orange);
  }
  .banner.dark .btn-outline {
    color: var(--color-white);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.35);
  }
  .banner.dark .btn-outline:hover {
    background: var(--color-white);
    color: var(--color-ink-solid);
    box-shadow: none;
  }

  @media (max-width: 680px) {
    .banner-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
