# Page 404 personnalisée.
ErrorDocument 404 /404.html

# Ancien dossier de test (avant bascule du site à la racine du domaine,
# 2026-08) : redirige toute URL /TESTSITENV/... vers son équivalent à la
# racine, pour éviter le contenu dupliqué tant que le dossier périmé n'a
# pas été supprimé côté FTP.
RewriteEngine On
RewriteRule ^TESTSITENV/(.*)$ /$1 [R=301,L]

# Sans ces règles, aucune des deux couches (ni le HTML, ni les assets) n'a
# d'en-tête Cache-Control explicite. Les navigateurs appliquent alors un
# cache heuristique sur le HTML lui-même : après un déploiement, un visiteur
# qui revient (ou nous en train de vérifier un correctif) peut recevoir un
# HTML mis en cache qui référence encore d'anciens fichiers _astro/*.HASH.*,
# potentiellement supprimés par le déploiement suivant. Deux règles opposées
# et complémentaires :
# 1. Le HTML ne doit JAMAIS être mis en cache sans revalidation : chaque
#    visite doit obtenir le dernier build, qui référence les bons hashes.
# 2. Les assets sous /_astro/ ont un hash dans leur nom : leur contenu ne
#    change jamais pour un nom donné, donc un cache long et immuable est à
#    la fois sûr et souhaitable (pas de flash de contenu périmé).
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
